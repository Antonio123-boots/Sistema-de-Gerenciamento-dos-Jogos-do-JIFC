<section class="profile-shell">
  <article class="profile-card profile-card--wide">
    <% 
      const campusVisual = typeof campusSelecionado !== 'undefined' && campusSelecionado ? campusSelecionado : usuarioLogado;
      const publicMode = typeof modoPublico !== 'undefined' && modoPublico;
      const viewer = typeof usuarioLogado !== 'undefined' && usuarioLogado ? usuarioLogado : { tipo: 'visitante', perfil: 'Visitante', nome: 'Visitante', email: '' };
      const isLoggedIn = viewer.tipo !== 'visitante';
      const logoCampus = campusVisual && campusVisual.logoTexto ? campusVisual.logoTexto : (viewer && viewer.nome ? viewer.nome.slice(0, 2).toUpperCase() : 'IF');
      const tituloCampus = campusVisual && campusVisual.nomeExibicao ? campusVisual.nomeExibicao : (viewer.nome || 'Campus');
      const perfilLabel = publicMode ? 'Campus' : viewer.perfil;
      const emailExibicao = campusVisual && campusVisual.email ? campusVisual.email : viewer.email;
      const fotoPerfil = campusVisual && campusVisual.fotoPerfil ? campusVisual.fotoPerfil : (viewer && viewer.fotoPerfil ? viewer.fotoPerfil : '');
      const listaModalidades = Array.isArray(modalidadesCampus) ? modalidadesCampus : [];
      const listaAtletas = Array.isArray(atletasCampus) ? atletasCampus : [];
    %>
    
    <header class="institution-header">
      <div class="institution-avatar-container">
        <% if (fotoPerfil) { %>
          <img src="<%= fotoPerfil %>" alt="Foto de perfil" class="institution-img institution-avatar-image campus-photo campus-photo--xl campus-photo--real">
        <% } else { %>
          <div class="institution-img institution-logo" style="--campus-color: <%= campusVisual && campusVisual.cor ? campusVisual.cor : 'var(--accent)' %>"><%= logoCampus %></div>
        <% } %>
      </div>
      
      <div class="institution-details">
        <div class="badge-row">
          <% if (!publicMode && statusInscricao) { %>
            <span class="badge badge--status">Status da Inscrição: <%= statusInscricao %></span>
          <% } %>
        </div>
        <h1 class="institution-title"><%= tituloCampus %></h1>

        <% if (!publicMode && isLoggedIn) { %>
          <% if (viewer.tipo) { %>
            <% if (typeof mensagemErro !== 'undefined' && mensagemErro) { %>
              <div class="auto-dismiss" style="background: rgba(255, 77, 77, 0.1); border: 1px solid #ff4d4d; color: #ff4d4d; padding: 0.8rem 0.9rem; border-radius: 10px; margin: 0.8rem 0 1rem; font-weight: 600;">
                <%= mensagemErro %>
              </div>
            <% } %>
            <% if (typeof mensagemSucesso !== 'undefined' && mensagemSucesso) { %>
              <div class="auto-dismiss" style="background: rgba(0, 255, 136, 0.1); border: 1px solid #00ff88; color: #00ff88; padding: 0.8rem 0.9rem; border-radius: 10px; margin: 0.8rem 0 1rem; font-weight: 600;">
                <%= mensagemSucesso %>
              </div>
            <% } %>
            <div class="profile-edit-actions">
              <button type="button" class="premium-upload-btn" onclick="document.getElementById('editProfilePanel').style.display = document.getElementById('editProfilePanel').style.display === 'none' ? 'block' : 'none'">Editar perfil</button>
            </div>
            <div id="editProfilePanel" class="profile-edit-panel" style="display:none;">
              <form action="/perfil/editar" method="POST" class="profile-photo-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="management-fields-row split-2" style="margin-bottom:0.8rem;">
                  <label class="premium-input-wrapper">
                    <span class="field-label-text">Nome completo</span>
                    <input type="text" name="nome" class="premium-text-input" value="<%= campusVisual && campusVisual.nome ? campusVisual.nome : '' %>">
                  </label>
                  <label class="premium-input-wrapper">
                    <span class="field-label-text">Nome de exibição</span>
                    <input type="text" name="nomeExibicao" class="premium-text-input" value="<%= campusVisual && campusVisual.nomeExibicao ? campusVisual.nomeExibicao : '' %>">
                  </label>
                </div>
                <div class="management-fields-row split-2" style="margin-bottom:0.8rem;">
                  <label class="premium-input-wrapper">
                    <span class="field-label-text">E-mail</span>
                    <input type="email" name="email" class="premium-text-input" value="<%= campusVisual && campusVisual.email ? campusVisual.email : '' %>">
                  </label>
                  <label class="premium-input-wrapper">
                    <span class="field-label-text">Senha</span>
                    <input type="password" name="senha" class="premium-text-input" placeholder="Deixe em branco para manter a atual">
                  </label>
                </div>
                <div class="management-fields-row" style="margin-bottom:0.8rem;">
                  <label class="premium-input-wrapper" style="width:100%;">
                    <span class="field-label-text">Cidade</span>
                    <input type="text" name="cidade" class="premium-text-input" value="<%= campusVisual && campusVisual.cidade ? campusVisual.cidade : '' %>">
                  </label>
                </div>
                <input type="hidden" name="fotoPerfil" id="fotoPerfilValue" value="<%= fotoPerfil %>">
                <div class="profile-photo-controls">
                  <label class="premium-input-wrapper profile-photo-input-row">
                    <span class="field-label-text">Foto de perfil</span>
                    <div class="profile-photo-picker" style="display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center;">
                      <input type="file" id="fotoPerfilInput" accept="image/*" class="hidden-input-state">
                      <label for="fotoPerfilInput" class="premium-upload-btn">Escolher foto</label>
                      <button type="button" id="removerFotoBtn" class="premium-upload-btn" style="background: rgba(var(--fg-rgb), 0.08); border-color: rgba(var(--fg-rgb), 0.16);">Remover foto</button>
                    </div>
                  </label>
                </div>
                <div class="profile-form-actions">
                  <button type="submit" class="btn btn-primary">Salvar alterações</button>
                  <button type="button" class="btn btn-secondary" onclick="document.getElementById('editProfilePanel').style.display='none'">Cancelar</button>
                </div>
              </form>
            </div>
          <% } %>
          <script>
            (() => {
              const fileInput = document.getElementById('fotoPerfilInput');
              const hiddenField = document.getElementById('fotoPerfilValue');
              const removerBtn = document.getElementById('removerFotoBtn');
              const form = fileInput ? fileInput.closest('form') : null;

              if (!fileInput || !hiddenField || !form) {
                return;
              }

              async function enviarFotoAutomaticamente(dataUrl) {
                try {
                  const resposta = await fetch(form.action, {
                    method: 'POST',
                    headers: {
                      'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                    },
                    body: new URLSearchParams({ fotoPerfil: dataUrl, _csrf: '<%= csrfToken %>' }).toString(),
                    credentials: 'same-origin'
                  });

                  if (resposta.ok || resposta.redirected) {
                    window.location.reload();
                  }
                } catch (error) {
                  console.error('Erro ao salvar foto automaticamente:', error);
                }
              }

              fileInput.addEventListener('change', function () {
                const [file] = this.files || [];
                if (!file) {
                  return;
                }

                if (!file.type || !file.type.startsWith('image/')) {
                  this.value = '';
                  return;
                }

                const reader = new FileReader();
                reader.onload = function () {
                  const img = new Image();
                  img.onload = function () {
                    const maxSize = 1600;
                    const canvas = document.createElement('canvas');
                    let width = img.width;
                    let height = img.height;

                    if (width > maxSize || height > maxSize) {
                      const scale = Math.min(maxSize / width, maxSize / height);
                      width = Math.round(width * scale);
                      height = Math.round(height * scale);
                    }

                    canvas.width = width;
                    canvas.height = height;

                    const context = canvas.getContext('2d');
                    context.clearRect(0, 0, canvas.width, canvas.height);
                    context.drawImage(img, 0, 0, width, height);

                    const dataUrl = canvas.toDataURL('image/jpeg', 0.88);
                    hiddenField.value = dataUrl;
                    enviarFotoAutomaticamente(dataUrl);
                  };
                  img.src = String(reader.result || '');
                };
                reader.readAsDataURL(file);
              });

              if (removerBtn) {
                removerBtn.addEventListener('click', async function () {
                  hiddenField.value = '';
                  try {
                    const resposta = await fetch(form.action, {
                      method: 'POST',
                      headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                      },
                      body: new URLSearchParams({ fotoPerfil: '', _csrf: '<%= csrfToken %>' }).toString(),
                      credentials: 'same-origin'
                    });

                    if (resposta.ok || resposta.redirected) {
                      window.location.reload();
                    }
                  } catch (error) {
                    console.error('Erro ao remover foto automaticamente:', error);
                  }
                });
              }
            })();
          </script>
        <% } %>
      </div>
    </header>


    <% if (!publicMode && viewer.tipo === 'admin') { %>
      <nav class="admin-actions-zone" aria-label="Gestão do evento">
        <h2>JIFC</h2>

        <% if (typeof statusJifcEncerrado !== 'undefined' && statusJifcEncerrado && typeof edicaoAnoAtualJaSalva !== 'undefined' && !edicaoAnoAtualJaSalva) { %>
          <section class="panel-card" style="margin: 0 0 0.8rem 0; border:1px solid rgba(var(--accent-rgb), 0.35); background:rgba(var(--accent-rgb), 0.08);">
            <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.8rem; padding:0.8rem 1rem;">
              <div>
                <div style="font-weight:800; color: var(--text); font-size:0.92rem;">O JIFC <%= typeof anoJifcAtual !== 'undefined' ? anoJifcAtual : (typeof anoJifc !== 'undefined' ? anoJifc : '') %> foi finalizado!</div>
                <div style="font-size:0.78rem; color:var(--text-muted); margin-top:0.2rem;">Deseja salvar esta edição em «Edições anteriores»? O campeonato fica disponível para consulta pelos anos.</div>
              </div>
              <form action="/admin/edicoes/salvar-ano-atual" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="ano_jifc" value="<%= typeof anoJifcAtual !== 'undefined' ? anoJifcAtual : (typeof anoJifc !== 'undefined' ? anoJifc : '') %>">
                <input type="hidden" name="redirect" value="/perfil">
                <button type="submit" class="btn btn-primary" style="font-size:0.78rem; font-weight:800; padding:0.55rem 1rem;">Salvar JIFC <%= typeof anoJifcAtual !== 'undefined' ? anoJifcAtual : (typeof anoJifc !== 'undefined' ? anoJifc : '') %></button>
              </form>
            </div>
          </section>
        <% } %>

        <div class="admin-nav-grid">
          <a class="admin-nav-card" href="/admin/configurar">JIFC <%= typeof anoJifc !== 'undefined' ? anoJifc : '2026' %></a>
          <a class="admin-nav-card" href="/admin/chaveamento">Chaveamento</a>
          <a class="admin-nav-card" href="/admin/boletins">Boletins</a>
          <a class="admin-nav-card" href="/admin/juizes">Juízes</a>
          <a class="admin-nav-card" href="/admin/laudos">Validar atletas</a>
          <a class="admin-nav-card" href="/admin/cadastroCampus">Cadastrar campus</a>
          <a class="admin-nav-card" href="/admin/banirCampus">Gerenciar punições</a>
        </div>
      </nav>
    <% } %>

    <% if (!publicMode && viewer.tipo === 'juiz') { %>
      <nav class="admin-actions-zone" aria-label="Painel do Juiz">
        <h2>Painel do Juiz</h2>
        <div class="profile-actions">
          <a class="btn btn-primary" href="/juiz">Acessar Painel</a>
        </div>
      </nav>
    <% } %>

    <% if (publicMode || viewer.tipo === 'campus') { %>
      <section class="dashboard-section">

        <style>
          .campus-panel-grid {
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            gap: 1rem;
            align-items: start;
          }

          .compact-panel {
            background: rgba(var(--fg-rgb), 0.02);
            padding: 1.1rem;
            border-radius: 16px;
            border: 1px solid rgba(var(--accent-rgb), 0.1);
          }

          .scroll-list {
            max-height: 320px;
            overflow: auto;
            padding-right: 0.35rem;
          }

          .day-chip-row {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
          }

          .day-chip {
            padding: 0.55rem 0.8rem;
            border-radius: 999px;
            border: 1px solid rgba(var(--fg-rgb), 0.1);
            color: rgba(var(--fg-rgb), 0.82);
            text-decoration: none;
            background: rgba(var(--fg-rgb), 0.03);
          }

          .day-chip.is-active {
            background: rgba(var(--accent-rgb), 0.16);
            border-color: rgba(var(--accent-rgb), 0.45);
            color: var(--accent);
          }

          @media (max-width: 900px) {
            .campus-panel-grid {
              grid-template-columns: 1fr;
            }
          }
        </style>

        <% if (!publicMode && viewer && viewer.tipo === 'campus') { %>
          <div style="margin-top: 0.5rem; margin-bottom: 1rem; padding: 1rem 1.1rem; border-radius: 16px; border: 1px solid rgba(var(--fg-rgb), 0.05); background: rgba(var(--fg-rgb), 0.02);">
            <h3 style="color: varcolor: var(--text); margin: 0 0 0.6rem; font-size: 1.05rem;">Painel do Competidor</h3>
            <p style="color: rgba(var(--fg-rgb), 0.6); font-size: 0.9rem; margin: 0 0 1rem;">Gerencie a participação do seu campus nas Olimpíadas Institucionais.</p>
            <a href="/campus/inscricoes" class="btn btn-primary btn-cta-jifc" style="display: block; text-align: center; text-decoration: none;">Acessar JIFC <%= typeof anoJifc !== 'undefined' ? anoJifc : '2026' %></a>
          </div>
        <% } %>

        <div class="campus-panel-grid" style="margin-top: 1rem;">
          <div class="compact-panel">
          <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.85rem;">
            <h3 style="color: varcolor: var(--text); margin: 0; font-size: 1.05rem;">Jogos do campus</h3>
            <span style="color: rgba(var(--fg-rgb), 0.65); font-size: 0.92rem;">Selecione um dia para ver os confrontos</span>
          </div>

          <% if (diasJogosCampus && diasJogosCampus.length) { %>
            <div class="day-chip-row" style="margin-bottom: 1rem;">
              <% diasJogosCampus.forEach((dia) => { %>
                <a href="<%= publicMode && campusSelecionado && campusSelecionado.slug ? '/equipes/' + campusSelecionado.slug : '/perfil' %>?dia=<%= encodeURIComponent(dia) %>#jogos-campus" class="day-chip <%= diaJogosSelecionado === dia ? 'is-active' : '' %>"><%= dia %></a>
              <% }) %>
            </div>

            <% const jogosDoDia = jogosCampusPorDia && diaJogosSelecionado ? (jogosCampusPorDia[diaJogosSelecionado] || []) : []; %>
            <div id="jogos-campus">
              <% if (jogosDoDia.length) { %>
                <div class="jogos-grid jogos-grid--fixa" style="margin-top: 0.25rem;">
                  <% jogosDoDia.forEach((jogo) => { %>
                    <%- include('partials/cardJogoHome', { jogo: jogo }) %>
                  <% }) %>
                </div>
              <% } else { %>
                <div class="feedback-empty"><p>Nenhum jogo encontrado para este dia.</p></div>
              <% } %>
            </div>
          <% } else { %>
            <div class="feedback-empty"><p>Não existem jogos do campus configurados.</p></div>
          <% } %>
          </div>

          <div class="compact-panel">
        <div class="dashboard-tabs" role="tablist" style="margin-top: 0;">
          <button type="button" class="tab-trigger is-active" data-target="meus-atletas"> Atletas Inscritos</button>
          <button type="button" class="tab-trigger" data-target="modalidades-campus"> Modalidades Inscritas</button>
        </div>

        <div class="dashboard-view is-active" id="meus-atletas">
          <% if (listaAtletas.length) { %>
            <ul class="data-list scroll-list">
              <% listaAtletas.forEach((atleta) => { %>
                <% const modalidadesAtleta = Array.isArray(atleta.modalidades) ? atleta.modalidades : String(atleta.modalidade || '').split(',').map((item) => item.trim()).filter(Boolean); %>
                <li class="data-item">
                  <div class="item-info">
                    <strong class="item-name"><%= atleta.nome %></strong>
                    <span class="item-subtext">Nascimento: <%= atleta.dataNascimento %></span>
                    <span class="item-subtext">Modalidades: <%= modalidadesAtleta.join(', ') %></span>
                  </div>
                  <% if (atleta.status === 'Regular') { %>
                    <span class="status-tag" style="background: rgba(0, 255, 136, 0.12); color: #00ff88;">✓ Validado</span>
                   <% } else if (atleta.status === 'Analise') { %>
                     <span class="status-tag" style="background: rgba(255, 183, 0, 0.12); color: #ffb700;">⏳ Em análise</span>
                   <% } else if (atleta.status === 'Reprovado') { %>
                     <span class="status-tag" style="background: rgba(255, 77, 77, 0.12); color: #ff4d4d;">✗ Reprovado</span>
                  <% } else { %>
                     <span class="status-tag" style="background: rgba(255, 183, 0, 0.12); color: #ffb700;">⏳ Em análise</span>
                  <% } %>
                </li>
              <% }) %>
            </ul>
          <% } else { %>
            <div class="feedback-empty">
              <p>Nenhum atleta inscrito neste campus até o momento.</p>
            </div>
          <% } %>
        </div>

        <div class="dashboard-view" id="modalidades-campus">
          <% if (listaModalidades.length) { %>
            <ul class="data-list scroll-list">
              <% listaModalidades.forEach((modalidade) => {
                  const nomeModalidadeItem = String(modalidade).replace(/\s+(Masculino|Feminino|Misto)$/i, '').trim();
                  const generoModalidadeItem = (String(modalidade).match(/\b(Masculino|Feminino|Misto)$/i) || [])[1] || '';
                %>
                <li class="data-item">
                  <div class="item-info">
                    <strong class="item-name"><%= nomeModalidadeItem %><% if (generoModalidadeItem) { %> <span style="font-size:0.65rem; font-weight:700; margin-left:0.3rem; padding:0.12rem 0.45rem; border-radius:999px; background:rgba(var(--accent-rgb), 0.16); color:var(--accent); text-transform:uppercase; vertical-align:middle;"><%= generoModalidadeItem %></span><% } %></strong>
                  </div>
                </li>
              <% }) %>
            </ul>
          <% } else { %>
            <div class="feedback-empty"><p>Nenhuma modalidade inscrita para este campus.</p></div>
          <% } %>
        </div>
          </div>
        </div>
      </section>
    <% } %>

    <footer class="dashboard-footer">
      <div class="utility-actions">
        <% if (publicMode) { %>
          <% if (isLoggedIn) { %>
            <a class="btn btn-secondary" href="/perfil">Voltar ao meu perfil</a>
          <% } else { %>
            <a class="btn btn-secondary" href="/equipes">Voltar às Equipes</a>
          <% } %>
        <% } else { %>
          <a class="btn btn-secondary" href="/">Voltar ao Início</a>
          <form action="/auth/logout" method="POST" style="display:inline; margin:0;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-danger" style="border:none; cursor:pointer;">Encerrar Sessão</button>
          </form>
        <% } %>
      </div>
    </footer>

  </article>
</section>

<script>
  // 1. Alternância Visual entre as Abas (Atletas / Modalidades)
  document.querySelectorAll('.tab-trigger').forEach((button) => {
    button.addEventListener('click', () => {
      const targetId = button.dataset.target;

      // Remove a classe ativa de todos e adiciona apenas no clicado
      document.querySelectorAll('.tab-trigger').forEach((item) => item.classList.toggle('is-active', item === button));
      document.querySelectorAll('.dashboard-view').forEach((view) => view.classList.toggle('is-active', view.id === targetId));
    });
  });

</script>