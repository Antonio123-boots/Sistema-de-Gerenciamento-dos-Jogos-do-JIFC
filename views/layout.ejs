<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JIFC - Jogos Internos</title>
    <link rel="stylesheet" href="/css/geral.css">
    <link rel="stylesheet" href="/css/login.css">
    <link rel="stylesheet" href="/css/perfil.css">
    <link rel="stylesheet" href="/css/cadastroCampus.css">
    <link rel="stylesheet" href="/css/banirCampus.css">
    <link rel="stylesheet" href="/css/responsive.css">
    <link rel="stylesheet" href="/css/chaveamento.css">
</head>
<body>

    <div class="menu-superior">
        <div class="menu-container">
            <div class="menu-left">
                <div class="logo-area">
                    <a href="/"><img src="/imagens/jifc original-Picsart-AiImageEnhancer.jfif" alt="logo" class="logo-menu"></a>
                </div>
                <div class="nav-buttons">
                    <a href="/about" class="nav-btn">SOBRE</a>
                    <a href="/ajuda" class="nav-btn">AJUDA</a>
                    <a href="/equipes" class="nav-btn">EQUIPES</a>
                    <% if (typeof usuarioLogado !== 'undefined' && usuarioLogado) { %>
                        <% if (usuarioLogado.tipo === 'admin') { %>
                            <a href="/admin/configurar" class="nav-btn">JIFC <%= typeof anoJifc !== 'undefined' ? anoJifc : '2026' %></a>
                            <a href="/admin/chaveamento" class="nav-btn">CHAVEAMENTO</a>
                        <% } %>
                        <% if (usuarioLogado.tipo === 'juiz') { %>
                            <a href="/juiz/tabelas" class="nav-btn">PLACARES</a>
                            <a href="/juiz/tabelas" class="nav-btn">TABELAS</a>
                        <% } %>
                        <% if (usuarioLogado.tipo === 'campus') { %>
                            <a href="/campus/atletas" class="nav-btn">ATLETAS</a>
                            <a href="/campus/jogos" class="nav-btn">MEUS JOGOS</a>
                        <% } %>
                    <% } %>
                </div>
            </div>
            <div class="menu-right">
                <div class="search-box">
                    <input type="text" placeholder="Pesquisar...">
                    <button>🔍</button>
                </div>
                
                <% if (typeof usuarioLogado !== 'undefined' && usuarioLogado) { %>
                    <% const avatarLayout = usuarioLogado.fotoPerfil || '/imagens/avatar.svg'; %>
                    <div class="perfil">
                        <a href="/perfil"><img src="<%= avatarLayout %>" alt="perfil" class="avatar"></a>
                    </div>
                <% } else { %>
                    <div class="login-area">
                        <a href="/login" class="login-btn">LOGIN</a>
                    </div>
                <% } %>
                
            </div>
        </div>
    </div>

    <% if (typeof mostrarFiltros !== 'undefined' && mostrarFiltros) { %>
        <div class="menu-modalidades">
            <div class="modalidades-container">
                <ul class="modalidades-list">
                    <% if (Array.isArray(modalidades) && modalidades.length) { %>
                        <% modalidades.forEach((mod) => {
                            const nomeBase = String(mod.nomeBase || mod.nome || '').trim();
                            const imagem = mod.imagem || '/imagens/atletismo1.svg';
                            const slugBase = String(mod.slugBase || mod.slug || '').trim();
                            const isActive = typeof modalidadeSelecionada !== 'undefined' && modalidadeSelecionada && modalidadeSelecionada === slugBase;
                            const query = new URLSearchParams();
                            if (slugBase) query.set('modalidade', slugBase);
                            if (typeof diaSelecionado !== 'undefined' && diaSelecionado) query.set('dia', diaSelecionado);
                        %>
                            <li class="modalidade-item <%= isActive ? 'is-active' : '' %>">
                                <a href="/<%= query.toString() ? '?' + query.toString() : '' %>">
                                    <img src="<%= imagem %>" style="height: 35px;" alt="<%= nomeBase %>">
                                    <span><%= nomeBase.toUpperCase() %></span>
                                </a>
                            </li>
                        <% }); %>
                    <% } else { %>
                        <li class="modalidade-item"><a href="/"><img src="/imagens/atletismo1.svg" style="height: 35px;"><span>ATLETISMO</span></a></li>
                        <li class="modalidade-item"><a href="/"><img src="/imagens/basquete1.svg" style="height: 35px;"><span>BASQUETE</span></a></li>
                        <li class="modalidade-item"><a href="/"><img src="/imagens/futsal1.svg" style="height: 35px;"><span>FUTSAL</span></a></li>
                        <li class="modalidade-item"><a href="/"><img src="/imagens/handebol1.svg" style="height: 35px;"><span>HANDEBOL</span></a></li>
                        <li class="modalidade-item"><a href="/"><img src="/imagens/tenisdemesa1.svg" style="height: 35px;"><span>TÊNIS DE MESA</span></a></li>
                        <li class="modalidade-item"><a href="/"><img src="/imagens/volei1.svg" style="height: 35px;"><span>VOLEIBOL</span></a></li>
                        <li class="modalidade-item"><a href="/"><img src="/imagens/areia1.svg" style="height: 35px;"><span>VOLEI DE PRAIA</span></a></li>
                        <li class="modalidade-item"><a href="/"><img src="/imagens/xadrez1.svg" style="height: 35px;"><span>XADREZ</span></a></li>
                    <% } %>
                </ul>
            </div>
        </div>

        <div class="menu-dias">
            <div class="dias-container">
                <ul class="dias-list">
                    <% const diasAtivos = Array.isArray(diasDisponiveis) && diasDisponiveis.length ? diasDisponiveis : ['24/06', '25/06', '26/06']; %>
                    <% diasAtivos.forEach((dia) => { %>
                        <% const queryDia = new URLSearchParams(); %>
                        <% if (typeof modalidadeSelecionada !== 'undefined' && modalidadeSelecionada) queryDia.set('modalidade', modalidadeSelecionada); %>
                        <% queryDia.set('dia', dia); %>
                        <% const isActiveDay = typeof diaSelecionado !== 'undefined' && diaSelecionado === dia; %>
                        <li class="dia-item <%= isActiveDay ? 'is-active' : '' %>"><a href="/<%= '?' + queryDia.toString() %>">DIA <%= dia %></a></li>
                    <% }); %>
                </ul>
            </div>
        </div>
    <% } %>

    <div class="main-content">
        <%- body %>
    </div>

</body>
</html>