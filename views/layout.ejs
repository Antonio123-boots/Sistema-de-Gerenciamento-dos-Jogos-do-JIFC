<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#1c1d3b">
    <title>JIFC - Jogos Internos</title>
    <script>
        (function () {
            var t = 'navy';
            try { t = localStorage.getItem('jifc-theme') || 'navy'; } catch (e) {}
            if (t !== 'navy' && t !== 'dark' && t !== 'light') t = 'navy';
            document.documentElement.setAttribute('data-theme', t);
        })();
    </script>
    <link rel="stylesheet" href="/css/themes.css?v=6">
    <link rel="stylesheet" href="/css/geral.css?v=24">
    <link rel="stylesheet" href="/css/login.css?v=2">
    <link rel="stylesheet" href="/css/perfil.css?v=2">
    <link rel="stylesheet" href="/css/cadastroCampus.css?v=2">
    <link rel="stylesheet" href="/css/banirCampus.css?v=2">
    <link rel="stylesheet" href="/css/chaveamento.css?v=2">
    <link rel="stylesheet" href="/css/boletim.css?v=1">
    <link rel="stylesheet" href="/css/responsive.css?v=7">
</head>
<body>

    <div class="menu-superior">
        <div class="menu-container">
            <div class="menu-left">
                <div class="logo-area">
                    <a href="/"><img src="/imagens/jifc original-Picsart-AiImageEnhancer.jfif" alt="logo" class="logo-menu"></a>
                </div>
                <div class="nav-buttons">
                    <a href="/equipes" class="nav-btn">EQUIPES</a>
                    <a href="/boletim" class="nav-btn">BOLETINS</a>
                    <% if (typeof usuarioLogado !== 'undefined' && usuarioLogado && usuarioLogado.tipo === 'admin') { %>
                        <a href="/admin/edicoes/nova" class="nav-btn" title="Cadastrar edição anterior"
                           style="background:var(--surface-2); color:var(--accent); border-radius:8px; line-height:1; display:inline-flex; align-items:center;">
                            <span style="font-size:1.05rem; font-weight:800; margin-right:0.35rem;">+</span>
                            <span style="font-size:0.68rem; letter-spacing:0.04em;">EDIÇÃO ANTERIOR</span>
                        </a>
                    <% } %>
                    <% if (typeof edicoesAnteriores !== 'undefined' && Array.isArray(edicoesAnteriores) && edicoesAnteriores.length) { %>
                        <select id="seletor-ano-edicao" onchange="window.location.href = this.value;"
                            style="background:var(--bg); color:var(--text-muted); border:1px solid rgba(var(--fg-rgb), 0.15); border-radius:8px; padding:0.34rem 0.7rem; font-size:0.7rem; font-weight:800; letter-spacing:0.06em; text-transform:uppercase; cursor:pointer; outline:none; font-family:inherit;">
                            <option value="/" <%= (typeof anoSelecionadoUnico === 'undefined' || !anoSelecionadoUnico) ? 'selected' : '' %>>JIFC <%= typeof anoAtualJifc !== 'undefined' ? anoAtualJifc : '' %></option>
                            <% edicoesAnteriores.forEach((ed) => { %>
                                <option value="/?ano=<%= ed.ano %>" <%= (typeof anoSelecionadoUnico !== 'undefined' && anoSelecionadoUnico === ed.ano) ? 'selected' : '' %>><%= ed.titulo %></option>
                            <% }); %>
                        </select>
                    <% } %>
                    <% if (typeof usuarioLogado !== 'undefined' && usuarioLogado) { %>
                        <% if (usuarioLogado.tipo === 'juiz') { %>
                            <a href="/juiz" class="nav-btn">MEUS JOGOS</a>
                        <% } %>
                        <% if (usuarioLogado.tipo === 'campus') { %>
                            <a href="/campus/atletas" class="nav-btn">ATLETAS</a>
                            <a href="/campus/jogos" class="nav-btn">MEUS JOGOS</a>
                        <% } %>
                    <% } %>
                </div>
            </div>
            <div class="menu-right">
                <div class="theme-switcher">
                    <button type="button" id="theme-palette-btn" class="nav-btn theme-palette-btn" title="Mudar tema de cores" aria-label="Mudar tema de cores" aria-haspopup="true" aria-expanded="false">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 3a9 9 0 0 0 0 18h1.2a1.8 1.8 0 0 0 1.2-3.1c-.7-.7-.3-1.9.7-1.9H17A4 4 0 0 0 21 12a9 9 0 0 0-9-9Z"></path>
                            <circle cx="7.5" cy="11.5" r="1"></circle>
                            <circle cx="10" cy="7.5" r="1"></circle>
                            <circle cx="15" cy="7.5" r="1"></circle>
                            <circle cx="17.5" cy="11" r="1"></circle>
                        </svg>
                    </button>
                    <div class="theme-dropdown" id="theme-dropdown" role="menu" aria-label="Temas de cores" hidden>
                        <button type="button" class="theme-option" role="menuitemradio" data-theme-choice="navy">
                            <span class="theme-swatch" style="background:#1c1d3b; box-shadow: inset 0 0 0 2px #ece42d;"></span> Azul Marinho
                        </button>
                        <button type="button" class="theme-option" role="menuitemradio" data-theme-choice="dark">
                            <span class="theme-swatch" style="background:#000000; box-shadow: inset 0 0 0 2px #21f8f6;"></span> Preto
                        </button>
                        <button type="button" class="theme-option" role="menuitemradio" data-theme-choice="light">
                            <span class="theme-swatch" style="background:#ffffff; box-shadow: inset 0 0 0 2px #000000;"></span> Branco
                        </button>
                    </div>
                </div>
                <% if (typeof usuarioLogado !== 'undefined' && usuarioLogado) { %>
                    <% const avatarLayout = usuarioLogado.fotoPerfil || '/imagens/avatar.svg'; %>
                    <% const avatarReal = !!((usuarioLogado.fotoPerfil || '') && (usuarioLogado.fotoPerfil || '') !== '/imagens/avatar.svg'); %>
                    <% const perfilHref = usuarioLogado.tipo === 'juiz' ? '/juiz' : '/perfil'; %>
                    <div class="perfil" style="display:flex; align-items:center; gap:0.6rem;">
                        <a href="<%= perfilHref %>"><img src="<%= avatarLayout %>" alt="perfil" class="avatar campus-photo <%= avatarReal ? 'campus-photo--real' : 'campus-photo--default' %>"></a>
                        <% if (usuarioLogado.tipo === 'juiz') { %>
                            <form action="/auth/logout" method="POST" style="display:inline; margin:0;">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="nav-btn" style="font-size:0.7rem; border:none; background:none; cursor:pointer;">SAIR</button>
                            </form>
                        <% } %>
                    </div>
                <% } else { %>
                    <div class="login-area">
                        <a href="/login" class="login-btn">LOGIN</a>
                    </div>
                <% } %>
                
            </div>
        </div>
    </div>

    <% if (typeof mostrarFiltros !== 'undefined' && mostrarFiltros) { %>
        <%
            const baseHome = (typeof anoSelecionadoUnico !== 'undefined' && anoSelecionadoUnico) ? '/?ano=' + anoSelecionadoUnico : '/';
            const montarHref = (p) => {
                const q = (p && p.toString) ? p.toString() : '';
                return baseHome + (baseHome === '/' ? (q ? '?' + q : '') : (q ? '&' + q : ''));
            };
        %>
        <div class="menu-modalidades">
            <div class="modalidades-container">
                <ul class="modalidades-list">
                    <% if (Array.isArray(modalidades) && modalidades.length) { %>
                        <% modalidades.forEach((mod) => {
                            const nomeBase = String(mod.nomeBase || mod.nome || '').trim();
                            const imagem = mod.imagem || '/imagens/atletismo1.svg';
                            const slugBase = String(mod.slugBase || mod.slug || '').trim();
                            const isActive = typeof modalidadeSelecionada !== 'undefined' && modalidadeSelecionada && (
                                modalidadeSelecionada === slugBase ||
                                modalidadeSelecionada === String(mod.slug || '').trim() ||
                                modalidadeSelecionada === String(mod.nomeBase || '').trim()
                            );
                            const query = new URLSearchParams();
                            if (typeof diaSelecionado !== 'undefined' && diaSelecionado) query.set('dia', diaSelecionado);
                            if (typeof generoSelecionado !== 'undefined' && generoSelecionado && String(generoSelecionado).trim()) query.set('genero', generoSelecionado);
                            if (!isActive && slugBase) query.set('modalidade', slugBase);
                            const href = isActive
                                ? montarHref((() => {
                                    const limpar = new URLSearchParams();
                                    if (typeof diaSelecionado !== 'undefined' && diaSelecionado) limpar.set('dia', diaSelecionado);
                                    if (typeof generoSelecionado !== 'undefined' && generoSelecionado && String(generoSelecionado).trim()) limpar.set('genero', generoSelecionado);
                                    return limpar;
                                })())
                                : montarHref(query);
                        %>
                            <li class="modalidade-item <%= isActive ? 'is-active active-sport' : '' %>">
                                <a href="<%= href %>" class="<%= isActive ? 'active-sport' : '' %>">
                                    <img src="<%= imagem %>" class="sport-icon" style="height: 35px;" alt="<%= nomeBase %>">
                                    <span><%= nomeBase.toUpperCase() %></span>
                                </a>
                            </li>
                        <% }); %>
                    <% } else { %>
                        <li class="modalidade-item"><a href="/"><img src="/imagens/atletismo1.svg" class="sport-icon" style="height: 35px;"><span>ATLETISMO</span></a></li>
                        <li class="modalidade-item"><a href="/"><img src="/imagens/basquete1.svg" class="sport-icon" style="height: 35px;"><span>BASQUETE</span></a></li>
                        <li class="modalidade-item"><a href="/"><img src="/imagens/futsal1.svg" class="sport-icon" style="height: 35px;"><span>FUTSAL</span></a></li>
                        <li class="modalidade-item"><a href="/"><img src="/imagens/handebol1.svg" class="sport-icon" style="height: 35px;"><span>HANDEBOL</span></a></li>
                        <li class="modalidade-item"><a href="/"><img src="/imagens/tenisdemesa1.svg" class="sport-icon" style="height: 35px;"><span>TÊNIS DE MESA</span></a></li>
                        <li class="modalidade-item"><a href="/"><img src="/imagens/volei1.svg" class="sport-icon" style="height: 35px;"><span>VOLEIBOL</span></a></li>
                        <li class="modalidade-item"><a href="/"><img src="/imagens/areia1.svg" class="sport-icon" style="height: 35px;"><span>VOLEI DE PRAIA</span></a></li>
                        <li class="modalidade-item"><a href="/"><img src="/imagens/xadrez1.svg" class="sport-icon" style="height: 35px;"><span>XADREZ</span></a></li>
                    <% } %>
                </ul>
            </div>
        </div>

        <div class="filtros-secundarios">
        <div class="menu-generos">
            <div class="modalidades-container">
                <ul class="filter-list">
                    <% const listaGenerosFiltro = Array.isArray(generosDisponiveis) && generosDisponiveis.length ? generosDisponiveis : ['Masculino', 'Feminino']; %>
                    <% listaGenerosFiltro.forEach((genero) => {
                        const queryGenero = new URLSearchParams();
                        if (typeof diaSelecionado !== 'undefined' && diaSelecionado) queryGenero.set('dia', diaSelecionado);
                        const baseModalidadeSelecionada = typeof modalidadeSelecionada !== 'undefined' && modalidadeSelecionada
                            ? String(modalidadeSelecionada).replace(/-(masculino|feminino|misto)$/i, '')
                            : '';
                        if (baseModalidadeSelecionada) queryGenero.set('modalidade', baseModalidadeSelecionada);
                        if (typeof mostrarSubFiltroTenis !== 'undefined' && mostrarSubFiltroTenis && typeof subCategoriaAtiva !== 'undefined' && subCategoriaAtiva) queryGenero.set('sub', subCategoriaAtiva);
                        const isActiveGenero = typeof generoSelecionado !== 'undefined' && generoSelecionado === genero;
                        if (!isActiveGenero) queryGenero.set('genero', genero);
                        const hrefGenero = isActiveGenero
                            ? montarHref((() => {
                                const limpar = new URLSearchParams();
                                if (typeof diaSelecionado !== 'undefined' && diaSelecionado) limpar.set('dia', diaSelecionado);
                                if (baseModalidadeSelecionada) limpar.set('modalidade', baseModalidadeSelecionada);
                                if (typeof mostrarSubFiltroTenis !== 'undefined' && mostrarSubFiltroTenis && typeof subCategoriaAtiva !== 'undefined' && subCategoriaAtiva) limpar.set('sub', subCategoriaAtiva);
                                return limpar;
                            })())
                            : montarHref(queryGenero);
                    %>
                        <li class="filter-item <%= isActiveGenero ? 'is-active' : '' %>"><a href="<%= hrefGenero %>"><%= genero.toUpperCase() %></a></li>
                    <% }); %>
                </ul>
            </div>
        </div>

        <% const mostrarDiasPublicos = !modalidadeSelecionada && (!generoSelecionado || generoSelecionado === 'Masculino' || generoSelecionado === 'Feminino' || generoSelecionado === 'Misto'); %>
        <% if (mostrarDiasPublicos) { %>
        <div class="menu-dias">
            <div class="dias-container">
                <ul class="dias-list">
                    <% const diasAtivos = Array.isArray(diasDisponiveis) && diasDisponiveis.length ? diasDisponiveis : ['24/06', '25/06', '26/06']; %>
                    <% diasAtivos.filter(Boolean).forEach((dia) => { %>
                        <% const queryDia = new URLSearchParams(); %>
                        <% if (typeof generoSelecionado !== 'undefined' && generoSelecionado) queryDia.set('genero', generoSelecionado); %>
                        <% const isActiveDay = typeof diaSelecionado !== 'undefined' && diaSelecionado === dia; %>
                        <% if (!isActiveDay) queryDia.set('dia', dia); %>
                        <% const hrefDia = isActiveDay ? montarHref((() => {
                            const limpar = new URLSearchParams();
                            if (typeof generoSelecionado !== 'undefined' && generoSelecionado) limpar.set('genero', generoSelecionado);
                            return limpar;
                        })()) : montarHref(queryDia); %>
                        <li class="dia-item <%= isActiveDay ? 'is-active' : '' %>"><a href="<%= hrefDia %>"><%= dia %></a></li>
                    <% }); %>
                </ul>
            </div>
        </div>
        <% } %>
        
        <% if (typeof mostrarSubFiltroTenis !== 'undefined' && mostrarSubFiltroTenis) { %>
        <div class="menu-generos">
            <div class="modalidades-container">
                <ul class="filter-list">
                    <% [{ label: 'Individual', valor: 'individual' }, { label: 'Em Dupla', valor: 'dupla' }].forEach((subFiltro) => {
                        const baseModalidadeSelecionada = typeof modalidadeSelecionada !== 'undefined' && modalidadeSelecionada
                            ? String(modalidadeSelecionada).replace(/-(masculino|feminino|misto)$/i, '')
                            : '';
                        const querySub = new URLSearchParams();
                        if (typeof diaSelecionado !== 'undefined' && diaSelecionado) querySub.set('dia', diaSelecionado);
                        if (baseModalidadeSelecionada) querySub.set('modalidade', baseModalidadeSelecionada);
                        if (typeof generoSelecionado !== 'undefined' && generoSelecionado) querySub.set('genero', generoSelecionado);
                        const isActiveSub = typeof subCategoriaAtiva !== 'undefined' && subCategoriaAtiva === subFiltro.valor;
                        if (!isActiveSub) querySub.set('sub', subFiltro.valor);
                        const hrefSub = isActiveSub
                            ? montarHref((() => {
                                const limpar = new URLSearchParams();
                                if (typeof diaSelecionado !== 'undefined' && diaSelecionado) limpar.set('dia', diaSelecionado);
                                if (baseModalidadeSelecionada) limpar.set('modalidade', baseModalidadeSelecionada);
                                if (typeof generoSelecionado !== 'undefined' && generoSelecionado) limpar.set('genero', generoSelecionado);
                                return limpar;
                            })())
                            : montarHref(querySub);
                    %>
                        <li class="filter-item <%= isActiveSub ? 'is-active' : '' %>"><a href="<%= hrefSub %>"><%= subFiltro.label.toUpperCase() %></a></li>
                    <% }); %>
                </ul>
            </div>
        </div>
        <% } %>
        </div>
    <% } %>

    <div class="main-content">
        <%- body %>
    </div>

    <script>
        /* ==========================================================
           GERENCIADOR DE VIEWPORT (JS)
           - Detecta o tamanho da tela e marca o <html> com
             data-viewport="mobile" | "tablet" | "desktop"
           - O CSS usa esse atributo para ajustar o layout
           ========================================================== */
        (function () {
            var mqMobile = window.matchMedia('(max-width: 600px)');
            var mqTablet = window.matchMedia('(min-width: 601px) and (max-width: 1024px)');

            function aplicarViewport() {
                var raiz = document.documentElement;
                var modo = 'desktop';
                if (mqMobile.matches) modo = 'mobile';
                else if (mqTablet.matches) modo = 'tablet';

                raiz.setAttribute('data-viewport', modo);
                raiz.classList.toggle('viewport-mobile', modo === 'mobile');
                raiz.classList.toggle('viewport-tablet', modo === 'tablet');
                raiz.classList.toggle('viewport-desktop', modo === 'desktop');
            }

            if (mqMobile.addEventListener) {
                mqMobile.addEventListener('change', aplicarViewport);
                mqTablet.addEventListener('change', aplicarViewport);
            } else if (mqMobile.addListener) {
                mqMobile.addListener(aplicarViewport);
                mqTablet.addListener(aplicarViewport);
            }

            aplicarViewport();
        })();

        /* ==========================================================
           CENTRALIZAR FILTRO ATIVO (sem deslocar a página)
           - Ajusta APENAS o scrollLeft da própria faixa de filtros
           - Nunca rola a página/site inteiro na horizontal
             (era isso que "cortava" o topo no celular)
           ========================================================== */
        (function () {
            function centralizarItemAtivo() {
                var ativo = document.querySelector('.modalidades-list .is-active, .filter-list .is-active, .dias-list .is-active');
                if (!ativo) return;

                var lista = ativo.closest('ul');
                if (!lista || lista.scrollWidth <= lista.clientWidth + 1) return;

                var retLista = lista.getBoundingClientRect();
                var retAtivo = ativo.getBoundingClientRect();
                var alvo = lista.scrollLeft + ((retAtivo.left + retAtivo.width / 2) - (retLista.left + retLista.clientWidth / 2));
                var maximo = lista.scrollWidth - lista.clientWidth;

                lista.scrollLeft = Math.max(0, Math.min(alvo, maximo));
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', centralizarItemAtivo);
            } else {
                centralizarItemAtivo();
            }
        })();

        /* ==========================================================
           AUTO-DISMISS DE MENSAGENS (ERRO / SUCESSO)
           - Toda mensagem marcada com a classe .auto-dismiss some
             sozinha apos ~5 segundos (com fade), sem precisar recarregar
           ========================================================== */
        (function () {
            var DURACAO_VISIVEL = 5000;
            var DURACAO_FADE = 400;

            function agendarRemocao(el) {
                if (!el || el.dataset.autoDismissAgendado === '1') return;
                el.dataset.autoDismissAgendado = '1';
                window.setTimeout(function () {
                    el.style.transition = 'opacity ' + DURACAO_FADE + 'ms ease';
                    el.style.opacity = '0';
                    window.setTimeout(function () {
                        el.style.display = 'none';
                    }, DURACAO_FADE);
                }, DURACAO_VISIVEL);
            }

            function iniciarAutoDismiss() {
                document.querySelectorAll('.auto-dismiss').forEach(agendarRemocao);
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', iniciarAutoDismiss);
            } else {
                iniciarAutoDismiss();
            }
        })();
    </script>

    <script>
        (function () {
            var META_CORES = { navy: '#1c1d3b', dark: '#000000', light: '#eef0f3' };
            var btn = document.getElementById('theme-palette-btn');
            var dropdown = document.getElementById('theme-dropdown');
            if (!btn || !dropdown) return;

            function temaAtual() {
                return document.documentElement.getAttribute('data-theme') || 'navy';
            }

            function sincronizarMeta() {
                var meta = document.querySelector('meta[name="theme-color"]');
                if (meta) meta.setAttribute('content', META_CORES[temaAtual()] || META_CORES.navy);
            }

            function marcarOpcaoAtiva() {
                dropdown.querySelectorAll('.theme-option').forEach(function (op) {
                    op.setAttribute('aria-checked', String(op.getAttribute('data-theme-choice') === temaAtual()));
                });
            }

            function fecharDropdown() {
                dropdown.hidden = true;
                btn.setAttribute('aria-expanded', 'false');
            }

            btn.addEventListener('click', function (evento) {
                evento.stopPropagation();
                var abrir = dropdown.hidden;
                dropdown.hidden = !abrir;
                btn.setAttribute('aria-expanded', String(abrir));
            });

            dropdown.addEventListener('click', function (evento) {
                var opcao = evento.target.closest('.theme-option');
                if (!opcao) return;
                var escolhido = opcao.getAttribute('data-theme-choice');
                var raiz = document.documentElement;
                raiz.classList.add('theme-anim');
                void raiz.offsetWidth;
                window.clearTimeout(window.__jifcThemeTimer);
                window.__jifcThemeTimer = window.setTimeout(function () {
                    raiz.classList.remove('theme-anim');
                }, 500);
                raiz.setAttribute('data-theme', escolhido);
                try { localStorage.setItem('jifc-theme', escolhido); } catch (e) {}
                sincronizarMeta();
                marcarOpcaoAtiva();
                fecharDropdown();
            });

            document.addEventListener('click', function () {
                if (!dropdown.hidden) fecharDropdown();
            });

            document.addEventListener('keydown', function (evento) {
                if (evento.key === 'Escape' && !dropdown.hidden) fecharDropdown();
            });

            sincronizarMeta();
            marcarOpcaoAtiva();
        })();
    </script>

</body>
</html>