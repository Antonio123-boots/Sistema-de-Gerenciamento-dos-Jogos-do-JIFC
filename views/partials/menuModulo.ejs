<div class="menu-modalidades-container">
  
  <div class="modalidades-grupo">
    <span class="grupo-label">Masculino</span>
    <ul class="modalidades-list">
      <% listaModalidadesCompleta.forEach((mod) => { %>
        <% if (mod.genero === 'Masculino') { %>
          <li class="modalidade-item">
            <a href="<%= isAdmin ? '/admin' : '' %>/chaveamento?modalidade=<%= mod.id %>" 
               class="<%= modalidadeAtiva.id === mod.id ? 'active-sport' : '' %>">
              <img src="<%= mod.icone && (mod.icone.startsWith('/') || mod.icone.startsWith('http')) ? mod.icone : (mod.imagem || '/imagens/atletismo1.svg') %>" alt="<%= mod.nome.replace('Masculino', '').trim() %>" style="width: 26px; height: 26px; object-fit: cover; border-radius: 50%; margin-right: 0.5rem;">
              <span><%= mod.nome.replace('Masculino', '').trim() %></span>
            </a>
          </li>
        <% } %>
      <% }) %>
    </ul>
  </div>

  <div class="modalidades-grupo">
    <span class="grupo-label">Feminino</span>
    <ul class="modalidades-list">
      <% listaModalidadesCompleta.forEach((mod) => { %>
        <% if (mod.genero === 'Feminino') { %>
          <li class="modalidade-item">
            <a href="<%= isAdmin ? '/admin' : '' %>/chaveamento?modalidade=<%= mod.id %>" 
               class="<%= modalidadeAtiva.id === mod.id ? 'active-sport' : '' %>">
              <img src="<%= mod.icone && (mod.icone.startsWith('/') || mod.icone.startsWith('http')) ? mod.icone : (mod.imagem || '/imagens/atletismo1.svg') %>" alt="<%= mod.nome.replace('Feminino', '').trim() %>" style="width: 26px; height: 26px; object-fit: cover; border-radius: 50%; margin-right: 0.5rem;">
              <span><%= mod.nome.replace('Feminino', '').trim() %></span>
            </a>
          </li>
        <% } %>
      <% }) %>
    </ul>
  </div>
</div>