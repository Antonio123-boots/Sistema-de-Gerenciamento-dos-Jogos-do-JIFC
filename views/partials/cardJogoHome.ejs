<article class="panel-card" style="position:relative; padding:1rem; background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.08); border-radius:18px; display:flex; flex-direction:column; justify-content:space-between; height:100%;">
    <% if (Boolean(jogo.wo)) { %>
        <span style="position:absolute; top:0.6rem; right:0.75rem; font-size:0.55rem; font-weight:800; letter-spacing:0.08em; padding:0.15rem 0.45rem; border-radius:6px; line-height:1.2; background:rgba(245,176,65,0.18); color:#f5b041;">W.O.</span>
    <% } %>
    <%
      const faseRotulo = jogo.fase === 'Fase de Grupos' ? 'Classificatórias'
        : jogo.fase === 'Terceiro Lugar' ? 'Disputa de 3°' : (jogo.fase || '');
      const fotoCasaReal = !!(jogo.fotoCasa && jogo.fotoCasa !== '/imagens/avatar.svg');
      const fotoForaReal = !!(jogo.fotoFora && jogo.fotoFora !== '/imagens/avatar.svg');
            const ehTenisMesa = String(jogo.modalidadeBaseSlug || '').startsWith('tenis-de-mesa')
                || /t[eê]nis\s+de\s+mesa/i.test(String(jogo.modalidade || ''));
            const cidadeCasa = String(jogo.cidadeCasa || jogo.casa || 'Campus não informado').replace(/^IFC\s+/i, '');
            const cidadeFora = String(jogo.cidadeFora || jogo.fora || 'Campus não informado').replace(/^IFC\s+/i, '');
    %>
    <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:0.75rem; margin-bottom:0.75rem; min-height:1.5rem;">
        <% if (faseRotulo) { %>
            <span style="align-self:flex-start; font-size:0.55rem; font-weight:800; letter-spacing:0.08em; text-transform:uppercase; padding:0.15rem 0.45rem; border-radius:6px; line-height:1.2; background:rgba(236,228,45,0.18); color:#ece42d;"><%= faseRotulo %></span>
        <% } %>
        <div style="text-align:right; font-size:0.75rem; color:#cfd8dc; text-transform:uppercase; letter-spacing:0.08em; line-height:1.3;">
            <% if (ehTenisMesa) { %>
                TÊNIS DE MESA <%= jogo.subCategoria === 'dupla' ? 'DUPLA' : 'INDIVIDUAL' %> · <%= jogo.genero %>
            <% } else { %>
                <%= jogo.modalidade %> · <%= jogo.genero %>
            <% } %>
        </div>
    </div>

    <div style="display:grid; grid-template-columns:minmax(0,1fr) auto minmax(0,1fr); gap:0.75rem; align-items:center; flex:1;">
        <div style="text-align:center; min-width:0;">
            <img src="<%= jogo.fotoCasa || '/imagens/avatar.svg' %>" alt="Foto do campus <%= jogo.casa %>" class="campus-photo campus-photo--md campus-photo--badge <%= fotoCasaReal ? 'campus-photo--real' : 'campus-photo--default' %>" style="margin:0 auto 0.55rem;">
            <% if (ehTenisMesa && jogo.atletaCasa) { %>
                <div style="font-size:0.75rem; color:#fff; font-weight:700; line-height:1.2; word-break:break-word;"><%= jogo.atletaCasa %></div>
                <div style="font-size:0.65rem; color:#cfd8dc; line-height:1.2; word-break:break-word;"><%= cidadeCasa %></div>
            <% } else { %>
                <div style="font-size:0.75rem; color:#fff; font-weight:600; line-height:1.2; word-break:break-word;"><%= (jogo.casa) ? jogo.casa : (jogo.rotuloCasa || 'A definir') %></div>
            <% } %>
        </div>

        <div style="display:flex; flex-direction:column; gap:0.25rem; justify-items:center; text-align:center; align-items:center; flex-shrink:0;">
            <% const temPlacar = jogo.status && jogo.status !== 'Agendado' && (Number(jogo.placar_casa) > 0 || Number(jogo.placar_fora) > 0 || jogo.status === 'Encerrado' || jogo.status === 'Em Andamento'); %>
            <% if (temPlacar) { %>
                <% const ehVolei = jogo.sets && jogo.sets.length > 0; %>
                <% if (ehVolei) { %>
                    <%
                      let s1 = 0, s2 = 0;
                      jogo.sets.forEach(s => {
                        if (Number(s.pontos_1 || 0) > Number(s.pontos_2 || 0)) s1++;
                        else if (Number(s.pontos_2 || 0) > Number(s.pontos_1 || 0)) s2++;
                      });
                    %>
                    <div style="font-size:1.25rem; font-weight:800; color:#fff; line-height:1.2; letter-spacing:0.02em;">
                        <span><%= s1 %></span>
                        <span style="color:#6c757d; margin:0 0.15rem; font-weight:400;">x</span>
                        <span><%= s2 %></span>
                        <span style="font-size:0.55rem; color:#8a9ab5; font-weight:600; margin-left:0.15rem;"></span>
                    </div>
                    <div style="font-size:0.55rem; color:#8a9ab5; line-height:1.4; margin-top:0.15rem;">
                        <% jogo.sets.forEach((s, idx) => { %>
                            <%= s.pontos_1 %>-<%= s.pontos_2 %><%= idx < jogo.sets.length - 1 ? ' · ' : '' %>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div style="font-size:1.15rem; font-weight:800; color:#fff; line-height:1.2; letter-spacing:0.02em;">
                        <span><%= jogo.placar_casa %></span>
                        <span style="color:#6c757d; margin:0 0.15rem; font-weight:400;">x</span>
                        <span><%= jogo.placar_fora %></span>
                    </div>
                <% } %>
                <%
                  const temDisputa = jogo.disputa_pontos_1 != null && jogo.disputa_pontos_2 != null
                    && Number(jogo.disputa_pontos_1) !== Number(jogo.disputa_pontos_2);
                %>
                <% if (temDisputa) { %>
                    <div style="font-size:0.6rem; font-weight:700; color:#f5b041; line-height:1.2; margin-top:0.2rem;">Pênaltis <%= jogo.disputa_pontos_1 %>-<%= jogo.disputa_pontos_2 %></div>
                <% } %>
                <div style="font-size:0.6rem; font-weight:700; padding:0.15rem 0.5rem; border-radius:6px; line-height:1.2; margin-top:0.2rem;
                    <%= jogo.status === 'Encerrado' ? 'background:rgba(88,214,141,0.18); color:#58d68d;' : 'background:rgba(241,196,39,0.18); color:#f5b041;' %>
                "><%= jogo.status %></div>
            <% } else { %>
                <div style="font-size:0.95rem; font-weight:700; color:#fff; line-height:1.2;"><%= jogo.horario %></div>
                <div style="font-size:0.65rem; color:#cfd8dc; text-transform:uppercase; letter-spacing:0.08em; line-height:1.2;"><%= jogo.local_jogo || 'A def' %></div>
                <div style="font-size:0.65rem; color:#cfd8dc; line-height:1.2;"><%= jogo.data %></div>
            <% } %>
        </div>

        <div style="text-align:center; min-width:0;">
            <img src="<%= jogo.fotoFora || '/imagens/avatar.svg' %>" alt="Foto do campus <%= jogo.fora %>" class="campus-photo campus-photo--md campus-photo--badge <%= fotoForaReal ? 'campus-photo--real' : 'campus-photo--default' %>" style="margin:0 auto 0.55rem;">
            <% if (ehTenisMesa && jogo.atletaFora) { %>
                <div style="font-size:0.75rem; color:#fff; font-weight:700; line-height:1.2; word-break:break-word;"><%= jogo.atletaFora %></div>
                <div style="font-size:0.65rem; color:#cfd8dc; line-height:1.2; word-break:break-word;"><%= cidadeFora %></div>
            <% } else { %>
                <div style="font-size:0.75rem; color:#fff; font-weight:600; line-height:1.2; word-break:break-word;"><%= (jogo.fora) ? jogo.fora : (jogo.rotuloFora || 'A definir') %></div>
            <% } %>
        </div>
    </div>
</article>