<%
  const ehNomeReal = (nome) => nome && nome !== 'Campus não informado' && nome !== 'Atleta não informado';
  const nomeCasa = ehNomeReal(jogo.casa) ? jogo.casa : (jogo.rotuloCasa || jogo.atletaCasa || 'A definir');
  const nomeFora = ehNomeReal(jogo.fora) ? jogo.fora : (jogo.rotuloFora || jogo.atletaFora || 'A definir');
  const temDisputa = jogo.disputa_pontos_1 != null && jogo.disputa_pontos_2 != null
                    && Number(jogo.disputa_pontos_1) !== Number(jogo.disputa_pontos_2);
  const fotoCasaReal = !!(jogo.fotoCasa && jogo.fotoCasa !== '/imagens/avatar.svg');
  const fotoForaReal = !!(jogo.fotoFora && jogo.fotoFora !== '/imagens/avatar.svg');
  const ehTenisMesa = /t[eê]nis\s+de\s+mesa/i.test(String(jogo.modalidade || ''));
  const cidadeCasa = String(jogo.cidadeCasa || jogo.casa || 'Campus não informado').replace(/^IFC\s+/i, '');
  const cidadeFora = String(jogo.cidadeFora || jogo.fora || 'Campus não informado').replace(/^IFC\s+/i, '');
%>
<article class="game-card">
  <div class="game-card-header">
    <p class="game-time">📅 <%= jogo.data %> · ⏰ <%= jogo.horario %></p>
    <div style="display:flex; gap:0.35rem; align-items:center;">
      <% if (Boolean(jogo.wo)) { %>
        <span style="font-size:0.55rem; font-weight:800; letter-spacing:0.08em; padding:0.15rem 0.45rem; border-radius:6px; line-height:1.2; background:rgba(245,176,65,0.18); color:#f5b041;">W.O.</span>
      <% } %>
      <span class="fase-badge"><%= jogo.fase %></span>
    </div>
  </div>

  <div class="game-matchup">
    <div class="match-team text-right">
      <% if (jogo.slugCasa) { %><a href="/equipes/<%= encodeURIComponent(jogo.slugCasa) %>" aria-label="Ver perfil de <%= nomeCasa %>" style="display:block;width:max-content;margin:0 auto;"><% } %>
      <img src="<%= jogo.fotoCasa || '/imagens/avatar.svg' %>" alt="Foto do campus <%= nomeCasa %>" class="campus-photo campus-photo--md campus-photo--badge <%= fotoCasaReal ? 'campus-photo--real' : 'campus-photo--default' %>" style="margin:0 auto 0.5rem;">
      <% if (jogo.slugCasa) { %></a><% } %>
      <% if (ehTenisMesa && jogo.atletaCasa) { %>
        <span class="player-name"><strong><%= jogo.atletaCasa %></strong></span>
        <span class="player-sub"><%= cidadeCasa %></span>
      <% } else if (jogo.tipoIndividual || jogo.atletaCasa) { %>
        <span class="player-sub"><%= nomeCasa %></span>
      <% } else { %>
        <span class="team-name"><strong><%= nomeCasa %></strong></span>
      <% } %>
    </div>

    <div class="match-score-block">
      <% const ehVolei = jogo.sets && jogo.sets.length > 0; %>
      <% if (ehVolei && jogo.status !== 'Agendado') { %>
        <%
          let s1 = 0, s2 = 0;
          jogo.sets.forEach(s => {
            if (Number(s.pontos_1 || 0) > Number(s.pontos_2 || 0)) s1++;
            else if (Number(s.pontos_2 || 0) > Number(s.pontos_1 || 0)) s2++;
          });
        %>
        <span class="score-pill" style="display:flex; flex-direction:column; align-items:center; line-height:1.3;">
          <span><%= s1 %> x <%= s2 %></span>
          <span style="font-size:0.55rem; opacity:0.7;"></span>
        </span>
      <% } else if (jogo.status !== 'Agendado' && jogo.placar) { %>
        <span class="score-pill" style="display:flex; flex-direction:column; align-items:center; line-height:1.3;">
          <span><%= jogo.placar %></span>
          <% if (temDisputa) { %>
            <span style="font-size:0.55rem; color:#f5b041; font-weight:700;">(<%= jogo.disputa_pontos_1 %>x<%= jogo.disputa_pontos_2 %>)</span>
          <% } %>
        </span>
      <% } else { %>
        <span class="score-pill">VS</span>
      <% } %>
    </div>

    <div class="match-team text-left">
      <% if (jogo.slugFora) { %><a href="/equipes/<%= encodeURIComponent(jogo.slugFora) %>" aria-label="Ver perfil de <%= nomeFora %>" style="display:block;width:max-content;margin:0 auto;"><% } %>
      <img src="<%= jogo.fotoFora || '/imagens/avatar.svg' %>" alt="Foto do campus <%= nomeFora %>" class="campus-photo campus-photo--md campus-photo--badge <%= fotoForaReal ? 'campus-photo--real' : 'campus-photo--default' %>" style="margin:0 auto 0.5rem;">
      <% if (jogo.slugFora) { %></a><% } %>
      <% if (ehTenisMesa && jogo.atletaFora) { %>
        <span class="player-name"><strong><%= jogo.atletaFora %></strong></span>
        <span class="player-sub"><%= cidadeFora %></span>
      <% } else if (jogo.tipoIndividual || jogo.atletaFora) { %>
        <span class="player-name"><strong><%= jogo.atletaFora || nomeFora %></strong></span>
        <% if (jogo.atletaFora) { %>
          <span class="player-sub"><%= jogo.fora %></span>
        <% } %>
      <% } else { %>
        <span class="team-name"><strong><%= nomeFora %></strong></span>
      <% } %>
    </div>
  </div>

  <div class="game-card-footer">
    <span class="status-pill status-<%= (jogo.status || 'Agendado').toLowerCase() %>">
      <%= jogo.status %>
    </span>

    <% if (typeof isJuiz !== 'undefined' && isJuiz) { %>
      <div class="profile-actions" style="margin-top: 0.5rem; width: 100%;">
        <a class="btn btn-secondary" style="font-size: 0.8rem; padding: 0.4rem; justify-content: center;" href="/juiz/jogos/<%= jogo.id %>/placar">
          Atualizar Placar
        </a>
      </div>
    <% } else if (typeof isAdmin !== 'undefined' && isAdmin) { %>
      <div class="profile-actions" style="margin-top: 0.5rem; width: 100%;">
        <a class="btn btn-secondary" style="font-size: 0.8rem; padding: 0.4rem; justify-content: center;" href="/admin/jogos/placar/<%= jogo.id %>">
          Lançar Resultado
        </a>
      </div>
    <% } %>
  </div>
</article>
