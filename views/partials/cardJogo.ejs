<article class="game-card">
  <div class="game-card-header">
    <p class="game-time">📅 <%= jogo.data %> · ⏰ <%= jogo.horario %></p>
    <span class="fase-badge"><%= jogo.fase %></span>
  </div>

  <div class="game-matchup">
    <div class="match-team text-right">
      <% if (jogo.tipoIndividual || jogo.atletaCasa) { %>
        <img src="<%= jogo.fotoCasa || '/imagens/avatar.svg' %>" alt="Foto do campus <%= jogo.casa %>" class="campus-avatar" style="width:42px; height:42px; object-fit:cover; border-radius:50%; margin:0 auto 0.5rem; display:block; border:1px solid rgba(255,255,255,0.12);">
        <span class="player-sub"><%= jogo.casa %></span>
      <% } else { %>
        <span class="team-name"><strong><%= jogo.casa || 'A Definir' %></strong></span>
      <% } %>
    </div>

    <div class="match-score-block">
      <span class="score-pill">
        <%= (jogo.placar && jogo.status !== 'Agendado') ? jogo.placar : 'VS' %>
      </span>
    </div>

    <div class="match-team text-left">
      <img src="<%= jogo.fotoFora || '/imagens/avatar.svg' %>" alt="Foto do campus <%= jogo.fora %>" class="campus-avatar" style="width:42px; height:42px; object-fit:cover; border-radius:50%; margin:0 auto 0.5rem; display:block; border:1px solid rgba(255,255,255,0.12);">
      <% if (jogo.tipoIndividual || jogo.atletaFora) { %>
        <span class="player-name"><strong><%= jogo.atletaFora %></strong></span>
        <span class="player-sub"><%= jogo.fora %></span>
      <% } else { %>
        <span class="team-name"><strong><%= jogo.fora || 'A Definir' %></strong></span>
      <% } %>
    </div>
  </div>

  <div class="game-card-footer">
    <span class="status-pill status-<%= (jogo.status || 'Agendado').toLowerCase() %>">
      <%= jogo.status %>
    </span>

    <% if (typeof isJuiz !== 'undefined' && isJuiz) { %>
      <div class="profile-actions" style="margin-top: 0.5rem; width: 100%;">
        <a class="btn btn-secondary" style="font-size: 0.8rem; padding: 0.4rem; justify-content: center;" href="/juiz/jogos/<%= jogo.id %>/placar">
          Atualizar Placar
        </a>
      </div>
    <% } else if (typeof isAdmin !== 'undefined' && isAdmin) { %>
      <div class="profile-actions" style="margin-top: 0.5rem; width: 100%;">
        <a class="btn btn-secondary" style="font-size: 0.8rem; padding: 0.4rem; justify-content: center;" href="/admin/jogos/placar/<%= jogo.id %>">
          Lançar Resultado
        </a>
      </div>
    <% } %>
  </div>
</article>