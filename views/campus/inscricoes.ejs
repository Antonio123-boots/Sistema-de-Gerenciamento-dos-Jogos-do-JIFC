<section class="profile-shell">
  <article class="profile-card profile-card--wide">
    <% 
      const modalidadesDisponiveisList = Array.isArray(modalidadesDisponiveis) ? modalidadesDisponiveis : [];
      const modalidadesPorEsporte = {};
      modalidadesDisponiveisList.forEach((modalidade) => {
        const nomeOriginal = String(modalidade.nome || '').trim();
        const nomeBase = nomeOriginal.replace(/\s+(Masculino|Feminino)$/i, '').trim() || nomeOriginal;
        const genero = String(modalidade.genero || '').trim();
        const icone = String(modalidade.icone || '').trim();
        const imagem = modalidade.imagem || '/imagens/atletismo1.svg';

        if (!modalidadesPorEsporte[nomeBase]) {
          modalidadesPorEsporte[nomeBase] = { nome: nomeBase, icone, imagem, masculino: null, feminino: null };
        }

        if (/masculino/i.test(genero)) {
          modalidadesPorEsporte[nomeBase].masculino = `${nomeBase} Masculino`;
        }
        if (/feminino/i.test(genero)) {
          modalidadesPorEsporte[nomeBase].feminino = `${nomeBase} Feminino`;
        }
      });
      const catalogoEsportes = Object.values(modalidadesPorEsporte);
      const modalidadesSalvas = Array.isArray(modalidadesInscritas) ? modalidadesInscritas : [];
      const atletasSalvos = Array.isArray(atletas) ? atletas : [];
      const mostrarModalidades = typeof prazoModalidadesAberto !== 'undefined' && prazoModalidadesAberto;
      const mostrarAtletas = typeof prazoAtletasAberto !== 'undefined' && prazoAtletasAberto;
      const totalAbas = (mostrarModalidades ? 1 : 0) + (mostrarAtletas ? 1 : 0);
      const limiteCampus = typeof limiteAtletasTotalCampus !== 'undefined' ? limiteAtletasTotalCampus : 0;
      const abaAtivaAtual = typeof abaAtiva !== 'undefined' && abaAtiva === 'atletas' ? 'atletas' : 'modalidades';
      const atletaEmEdicaoLocal = typeof atletaEmEdicao !== 'undefined' ? atletaEmEdicao : null;
      const isEditandoAtleta = !!(atletaEmEdicaoLocal && atletaEmEdicaoLocal.id);
      const rotaFormularioAtleta = isEditandoAtleta ? `/campus/atletas/atualizar/${atletaEmEdicaoLocal.id}` : '/campus/atletas/cadastrar';
      const textoFormularioAtleta = isEditandoAtleta ? 'Salvar alterações' : 'Adicionar Atleta';
      const generoFormulario = isEditandoAtleta
        ? (String(atletaEmEdicaoLocal.genero || '').toLowerCase() === 'feminino' ? 'Feminino' : 'Masculino')
        : (typeof atletaFormDraft !== 'undefined' && atletaFormDraft && atletaFormDraft.genero === 'Feminino' ? 'Feminino' : 'Masculino');
      const nomeFormulario = isEditandoAtleta
        ? (atletaEmEdicaoLocal.nome || '')
        : (typeof atletaFormDraft !== 'undefined' && atletaFormDraft && atletaFormDraft.nome ? atletaFormDraft.nome : '');
      const matriculaFormulario = isEditandoAtleta
        ? (atletaEmEdicaoLocal.matricula || '')
        : (typeof atletaFormDraft !== 'undefined' && atletaFormDraft && atletaFormDraft.matricula ? atletaFormDraft.matricula : '');
      const dataNascimentoFormulario = isEditandoAtleta
        ? (atletaEmEdicaoLocal.dataNascimento || '')
        : (typeof atletaFormDraft !== 'undefined' && atletaFormDraft && atletaFormDraft.dataNascimento ? atletaFormDraft.dataNascimento : '');
      const cpfFormulario = isEditandoAtleta
        ? (atletaEmEdicaoLocal.cpf || '')
        : (typeof atletaFormDraft !== 'undefined' && atletaFormDraft && atletaFormDraft.cpf ? atletaFormDraft.cpf : '');
      const statusFormulario = isEditandoAtleta
        ? (atletaEmEdicaoLocal.status || 'Analise')
        : (typeof atletaFormDraft !== 'undefined' && atletaFormDraft && atletaFormDraft.status ? atletaFormDraft.status : 'Analise');
      const modalidadesFormulario = isEditandoAtleta
        ? (Array.isArray(atletaEmEdicaoLocal.modalidades) ? atletaEmEdicaoLocal.modalidades : String(atletaEmEdicaoLocal.modalidade || '').split(',').map((item) => item.trim()).filter(Boolean))
        : (typeof atletaFormDraft !== 'undefined' && atletaFormDraft && Array.isArray(atletaFormDraft.modalidades) ? atletaFormDraft.modalidades : []);
      const provasAtletismoFormulario = isEditandoAtleta
        ? (Array.isArray(atletaEmEdicaoLocal.atletismoProvas) ? atletaEmEdicaoLocal.atletismoProvas : [])
        : (typeof atletaFormDraft !== 'undefined' && atletaFormDraft && Array.isArray(atletaFormDraft.atletismoProvas) ? atletaFormDraft.atletismoProvas : []);
      const participacoesTenisMesaFormulario = isEditandoAtleta
        ? (Array.isArray(atletaEmEdicaoLocal.tenisMesaParticipacoes) ? atletaEmEdicaoLocal.tenisMesaParticipacoes : [])
        : (typeof atletaFormDraft !== 'undefined' && atletaFormDraft && Array.isArray(atletaFormDraft.tenisMesaParticipacoes) ? atletaFormDraft.tenisMesaParticipacoes : []);
      const modalidadesPorGenero = {
        Masculino: modalidadesSalvas.filter((modalidade) => /masculino/i.test(modalidade)),
        Feminino: modalidadesSalvas.filter((modalidade) => /feminino/i.test(modalidade))
      };
      const generoSelecionadoPadrao = modalidadesPorGenero.Masculino.length ? 'Masculino' : 'Feminino';
    %>

    <% if (!mostrarModalidades && !mostrarAtletas) { %>
    <div style="background: rgba(255, 77, 77, 0.1); border: 1px solid #ff4d4d; color: #ff4d4d; padding: 1rem; border-radius: 12px; margin-bottom: 2rem; font-weight: bold; text-align: center; width: 100%;">
        ⚠ Fora do período de cadastro.
        <br>
        <small style="font-weight: normal; color: rgba(255,255,255,0.6);">
        Nenhuma etapa está disponível no período cadastrado globalmente.
        </small>
    </div>
    <% } %>

    <% if (typeof mensagemErro !== 'undefined' && mensagemErro) { %>
      <div style="background: rgba(255, 77, 77, 0.1); border: 1px solid #ff4d4d; color: #ff4d4d; padding: 1rem; border-radius: 12px; margin-bottom: 1.25rem; font-weight: 600;">
        <%= mensagemErro %>
      </div>
    <% } %>

    <% if (typeof mensagemSucesso !== 'undefined' && mensagemSucesso) { %>
      <div style="background: rgba(0, 255, 136, 0.1); border: 1px solid #00ff88; color: #00ff88; padding: 1rem; border-radius: 12px; margin-bottom: 1.25rem; font-weight: 600;">
        <%= mensagemSucesso %>
      </div>
    <% } %>

    <header class="institution-header" style="border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 1.5rem; margin-bottom: 2rem;">
      <div class="institution-details">
        <div class="badge-row">
          <span class="badge badge--role">Campus</span>
          <span class="badge badge--status">Painel de Inscrições</span>
        </div>
        <h1 class="institution-title" style="color: #ece42d;"><%= nomeCampus %></h1>
        <p class="institution-meta">Selecione as modalidades e cadastre os atletas do campus no mesmo painel.</p>
        <p class="institution-meta">Regulares: <strong><%= typeof quantidadeRegulares !== 'undefined' ? quantidadeRegulares : 0 %></strong> · Pendentes: <strong><%= typeof quantidadePendentes !== 'undefined' ? quantidadePendentes : 0 %></strong> · Limite regular: <strong><%= limiteCampus > 0 ? limiteCampus : 'sem limite' %></strong></p>
      </div>
    </header>

    <% if (mostrarModalidades || mostrarAtletas) { %>
      <% if (totalAbas === 1) { %>
      <div class="dashboard-tabs dashboard-tabs--unica" role="tablist">
        <% if (mostrarModalidades) { %>
          <button type="button" class="tab-trigger <%= abaAtivaAtual === 'modalidades' ? 'is-active' : '' %>" data-target="modalidades">Modalidades</button>
        <% } %>
        <% if (mostrarAtletas) { %>
          <button type="button" class="tab-trigger <%= abaAtivaAtual === 'atletas' ? 'is-active' : '' %>" data-target="atletas">Atletas</button>
        <% } %>
      </div>
      <% } else { %>
      <div class="dashboard-tabs" role="tablist">
        <% if (mostrarModalidades) { %>
          <button type="button" class="tab-trigger <%= abaAtivaAtual === 'modalidades' ? 'is-active' : '' %>" data-target="modalidades">Modalidades</button>
        <% } %>
        <% if (mostrarAtletas) { %>
          <button type="button" class="tab-trigger <%= abaAtivaAtual === 'atletas' ? 'is-active' : '' %>" data-target="atletas">Atletas</button>
        <% } %>
      </div>
      <% } %>

      <% if (mostrarModalidades) { %>
      <div class="dashboard-view <%= abaAtivaAtual === 'modalidades' ? 'is-active' : '' %>" id="modalidades">
        <section style="background: rgba(255, 255, 255, 0.02); padding: 1.5rem; border-radius: 16px; border: 1px solid rgba(236, 228, 45, 0.12); margin-bottom: 2rem;">
          <h3 style="color: #ffffff; margin-bottom: 1rem; font-size: 1.1rem;">Inscrição por Modalidade</h3>
          <p style="margin: 0 0 1.25rem; color: rgba(255,255,255,0.68);">Marque masculino, feminino ou ambos para cada esporte disponível.</p>

          <form action="/campus/inscricoes/salvar" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="game-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
              <% catalogoEsportes.forEach(function(esporte) { 
                  const selecionadoMasculino = esporte.masculino && modalidadesSalvas.includes(esporte.masculino);
                  const selecionadoFeminino = esporte.feminino && modalidadesSalvas.includes(esporte.feminino);
              %>
                <div class="mini-card" style="display: flex; flex-direction: column; gap: 0.9rem; padding: 1rem 1.1rem;">
                  <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.5rem;">
                    <img src="<%= esporte.icone && (esporte.icone.startsWith('/') || esporte.icone.startsWith('http')) ? esporte.icone : (esporte.imagem || '/imagens/atletismo1.svg') %>" alt="Ícone <%= esporte.nome %>" style="width: 28px; height: 28px; object-fit: cover; border-radius: 50%;">
                    <strong style="color: #ffffff; font-size: 1rem;"><%= esporte.nome %></strong>
                  </div>
                  <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem;">
                    <% if (esporte.masculino) { %>
                      <label style="display: flex; align-items: center; gap: 0.65rem; cursor: pointer; color: rgba(255,255,255,0.85); font-weight: 600;">
                        <input type="checkbox" name="modalidades" value="<%= esporte.masculino %>" <%= selecionadoMasculino ? 'checked' : '' %> style="width: 18px; height: 18px; accent-color: #ece42d;">
                        Masculino
                      </label>
                    <% } %>
                    <% if (esporte.feminino) { %>
                      <label style="display: flex; align-items: center; gap: 0.65rem; cursor: pointer; color: rgba(255,255,255,0.85); font-weight: 600;">
                        <input type="checkbox" name="modalidades" value="<%= esporte.feminino %>" <%= selecionadoFeminino ? 'checked' : '' %> style="width: 18px; height: 18px; accent-color: #ece42d;">
                        Feminino
                      </label>
                    <% } %>
                  </div>
                </div>
              <% }); %>
            </div>

            <footer class="dashboard-footer dashboard-footer--row" style="margin-top: 2.5rem;">
              <a class="btn btn-secondary" href="/perfil">Voltar ao Perfil</a>
              <button type="submit" class="btn btn-success primary-save-btn" style="border: none;">
                Salvar Inscrições
              </button>
            </footer>
          </form>
        </section>
      </div>
      <% } %>

      <% if (mostrarAtletas) { %>
      <div class="dashboard-view <%= abaAtivaAtual === 'atletas' ? 'is-active' : '' %>" id="atletas">
        <section style="background: rgba(255, 255, 255, 0.02); padding: 1.5rem; border-radius: 16px; border: 1px solid rgba(236, 228, 45, 0.12); margin-bottom: 2rem;">
          <h3 style="color: #ffffff; margin-bottom: 0.75rem; font-size: 1.1rem;">Cadastro de Atletas do Campus</h3>
          <p style="margin: 0 0 0.75rem; color: rgba(255,255,255,0.68);">Escolha o gênero do atleta e veja somente os esportes compatíveis para inscrição.</p>

          <form action="<%= rotaFormularioAtleta %>" method="POST" class="form-grid" style="align-items: flex-end; margin-bottom: 1.5rem;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label>
              Nome do Atleta
              <input type="text" name="nome" placeholder="Ex: Gabriel Silva" value="<%= nomeFormulario %>" required class="premium-text-input">
            </label>

            <label>
              Gênero
              <select name="genero" id="genero-atleta" required class="premium-text-input" style="height: 43px; background: #1c1d3b; color: white;">
                <option value="Masculino" <%= generoFormulario === 'Masculino' ? 'selected' : '' %>>Masculino</option>
                <option value="Feminino" <%= generoFormulario === 'Feminino' ? 'selected' : '' %>>Feminino</option>
              </select>
            </label>

            <label>
              Data de Nascimento
              <input type="date" name="dataNascimento" value="<%= dataNascimentoFormulario %>" required class="premium-text-input">
            </label>

            <label>
              Matrícula
              <input type="text" name="matricula" placeholder="Ex: 20261102" value="<%= matriculaFormulario %>" required class="premium-text-input" inputmode="numeric" maxlength="12" pattern="[0-9]{9,12}">
            </label>

            <label>
              CPF
              <input type="text" name="cpf" placeholder="Ex: 123.456.789-00" value="<%= cpfFormulario %>" class="premium-text-input" inputmode="numeric" maxlength="14" autocomplete="off">
            </label>

            <label>
              Situação
              <select name="status" required class="premium-text-input" style="height: 43px; background: #1c1d3b; color: white;">
                <option value="Analise" <%= statusFormulario === 'Analise' ? 'selected' : '' %>>Em análise</option>
                <option value="Pendente" <%= statusFormulario === 'Pendente' ? 'selected' : '' %>>Pendente</option>
                <option value="Regular" <%= statusFormulario === 'Regular' ? 'selected' : '' %>>Regular</option>
              </select>
            </label>

            <div style="grid-column: 1 / -1;">
              <span style="display:block; margin-bottom: 0.5rem;">Modalidades</span>
              <% if (modalidadesSalvas.length > 0) { %>
                <div class="modalidades-checkbox-grid" data-gender-grid="Masculino">
                  <% modalidadesPorGenero.Masculino.forEach(function(modalidade) { %>
                    <label class="modalidade-checkbox-card">
                      <input type="checkbox" name="modalidades" value="<%= modalidade %>" <%= modalidadesFormulario.includes(modalidade) ? 'checked' : '' %>>
                      <span><%= modalidade %></span>
                    </label>
                  <% }); %>
                </div>
                <div class="modalidades-checkbox-grid" data-gender-grid="Feminino" style="display:none;">
                  <% modalidadesPorGenero.Feminino.forEach(function(modalidade) { %>
                    <label class="modalidade-checkbox-card">
                      <input type="checkbox" name="modalidades" value="<%= modalidade %>" <%= modalidadesFormulario.includes(modalidade) ? 'checked' : '' %>>
                      <span><%= modalidade %></span>
                    </label>
                  <% }); %>
                </div>
              <% } else { %>
                <div style="padding: 1rem; border-radius: 14px; border: 1px dashed rgba(255,255,255,0.18); color: rgba(255,255,255,0.7);">
                  Salve as inscrições de modalidades para liberar esta seleção.
                </div>
              <% } %>
              <small style="display:block; margin-top: 0.55rem; color: rgba(255,255,255,0.6);">Preencha todos os campos e marque no máximo 3 opções.</small>
            </div>

            <div id="detalhes-atleta" style="display: none; grid-column: 1 / -1; margin-top: 0.25rem; padding: 1rem; border-radius: 14px; border: 1px solid rgba(236, 228, 45, 0.16); background: rgba(255,255,255,0.03);">
              <div id="detalhes-atletismo" style="display: none; margin-bottom: 1rem;">
                <strong style="display:block; margin-bottom: 0.6rem; color: #ffffff;">Provas de Atletismo</strong>
                <div class="prova-pills">
                  <% ['100m rasos', '200m rasos', '400m', '800m', '1500m', '3000m', '5000m', '4x100m', '4x400m', 'Salto em distância', 'Salto em altura', 'Salto Triplo', 'Disco', 'Dardo', 'Peso'].forEach(function(prova) { %>
                    <label class="prova-pill">
                      <input type="checkbox" name="atletismoProvas" value="<%= prova %>" <%= provasAtletismoFormulario.includes(prova) ? 'checked' : '' %>>
                      <span><%= prova %></span>
                    </label>
                  <% }); %>
                </div>
              </div>

              <div id="detalhes-tenis-mesa" style="display: none;">
                <strong style="display:block; margin-bottom: 0.6rem; color: #ffffff;">Participação no Tênis de Mesa</strong>
                <div class="prova-pills">
                  <% ['Individual', 'Duplas', 'Individual e Duplas'].forEach(function(participacao) { %>
                    <label class="prova-pill">
                      <input type="checkbox" name="tenisMesaParticipacoes" value="<%= participacao %>" <%= participacoesTenisMesaFormulario.includes(participacao) ? 'checked' : '' %>>
                      <span><%= participacao %></span>
                    </label>
                  <% }); %>
                </div>
              </div>
            </div>

            <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center; grid-column: 1 / -1;">
              <label style="display: flex; align-items: center; gap: 0.55rem; color: rgba(255,255,255,0.75); font-size: 0.95rem;">
                <input type="checkbox" name="validarImediatamente" value="true">
                Validar imediatamente
              </label>
              <button type="submit" class="btn btn-success primary-save-btn" style="border: none; height: 43px; align-self: end;">
                <%= textoFormularioAtleta %>
              </button>
              <% if (isEditandoAtleta) { %>
                <a class="btn btn-secondary" href="/campus/inscricoes?aba=atletas#atletas" style="height: 43px; display: inline-flex; align-items: center; text-decoration: none;">Cancelar</a>
              <% } %>
            </div>
          </form>

          <div style="overflow-x: auto;">
            <table class="score-table">
              <thead>
                <tr style="color: #ece42d; border-bottom: 2px solid rgba(255,255,255,0.1);">
                  <th style="padding: 0.75rem 0.5rem;">Nome</th>
                  <th>Matrícula</th>
                  <th>CPF</th>
                  <th>Modalidade</th>
                  <th>Status</th>
                  <th>Ações</th>
                </tr>
              </thead>
              <tbody>
                <% if (atletasSalvos.length > 0) { %>
                  <% atletasSalvos.forEach(function(atleta) { %>
                    <tr class="<%= atleta.status === 'Regular' ? 'row--regular' : (atleta.status === 'Pendente' || atleta.status === 'Pendente_Laudo') ? 'row--pending' : 'row--irregular' %>">
                      <td style="padding: 0.75rem 0.5rem; font-weight: 600;"><%= atleta.nome %></td>
                      <td style="color: rgba(255,255,255,0.7);"><%= atleta.matricula %></td>
                      <td style="color: rgba(255,255,255,0.7);"><%= atleta.cpf || '-' %></td>
                      <td>
                        <% const modalidadesAtleta = Array.isArray(atleta.modalidades) ? atleta.modalidades : String(atleta.modalidade || '').split(',').map((item) => item.trim()).filter(Boolean); %>
                        <div style="display:flex; flex-direction:column; gap:0.35rem;">
                          <span class="status-tag" style="background: rgba(255,255,255,0.05); color: #fff;"><%= modalidadesAtleta.join(', ') %></span>
                          <% if (Array.isArray(atleta.atletismoProvas) && atleta.atletismoProvas.length) { %>
                            <span class="status-tag" style="background: rgba(236, 228, 45, 0.15); color: #ece42d;">Atletismo: <%= atleta.atletismoProvas.join(', ') %></span>
                          <% } %>
                          <% if (Array.isArray(atleta.tenisMesaParticipacoes) && atleta.tenisMesaParticipacoes.length) { %>
                            <span class="status-tag" style="background: rgba(236, 228, 45, 0.15); color: #ece42d;">Tênis de Mesa: <%= atleta.tenisMesaParticipacoes.join(', ') %></span>
                          <% } %>
                        </div>
                      </td>
                      <td>
                        <% if (atleta.status === 'Regular') { %>
                          <span style="color: #00ff88; font-weight: bold;">✓ Regular</span>
                        <% } else if (atleta.status === 'Pendente' || atleta.status === 'Pendente_Laudo') { %>
                          <span style="color: #ffb700; font-weight: bold;">⏳ Pendente / Reserva</span>
                        <% } else { %>
                          <span style="color: #ff4d4d; font-weight: bold;">⚠ Irregular</span>
                        <% } %>
                      </td>
                      <td>
                        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                          <a class="btn btn-secondary" href="/campus/inscricoes?aba=atletas&editar=<%= atleta.id %>#atletas">Editar</a>
                          <form action="/campus/atletas/excluir/<%= atleta.id %>" method="POST" onsubmit="return confirm('Deseja excluir este atleta?');">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button type="submit" class="btn btn-danger">Excluir</button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="6" class="feedback-empty">
                      Nenhum atleta inscrito até o momento.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
      </div>
      <% } %>

      <% if (mostrarAtletas) { %>
      <script>
        (function () {
          const formAtleta = document.querySelector('#atletas form.form-grid');
          const campoMatricula = formAtleta ? formAtleta.querySelector('input[name="matricula"]') : null;
          const campoCpf = formAtleta ? formAtleta.querySelector('input[name="cpf"]') : null;

          function aplicarMascaraCpf(valor) {
            const apenasDigitos = String(valor || '').replace(/\D/g, '').slice(0, 11);
            if (apenasDigitos.length <= 3) return apenasDigitos;
            if (apenasDigitos.length <= 6) return `${apenasDigitos.slice(0, 3)}.${apenasDigitos.slice(3)}`;
            if (apenasDigitos.length <= 9) return `${apenasDigitos.slice(0, 3)}.${apenasDigitos.slice(3, 6)}.${apenasDigitos.slice(6)}`;
            return `${apenasDigitos.slice(0, 3)}.${apenasDigitos.slice(3, 6)}.${apenasDigitos.slice(6, 9)}-${apenasDigitos.slice(9, 11)}`;
          }

          function aplicarMascaraMatricula(valor) {
            return String(valor || '').replace(/\D/g, '').slice(0, 12);
          }

          if (campoCpf) {
            campoCpf.addEventListener('input', function () {
              campoCpf.value = aplicarMascaraCpf(campoCpf.value);
            });
            campoCpf.value = aplicarMascaraCpf(campoCpf.value);
          }

          if (campoMatricula) {
            campoMatricula.addEventListener('input', function () {
              campoMatricula.value = aplicarMascaraMatricula(campoMatricula.value);
            });
            campoMatricula.value = aplicarMascaraMatricula(campoMatricula.value);
          }
        })();
      </script>
      <% } %>

      <% if (mostrarAtletas && modalidadesSalvas.length > 0) { %>
      <script>
        (function () {
          const formAtletas = document.querySelector('#atletas form[action="/campus/atletas/cadastrar"]');
          const formAtletasEdicao = document.querySelector('#atletas form[action^="/campus/atletas/atualizar/"]');
          const formAtletaAtivo = formAtletasEdicao || formAtletas;
          const generoSelect = formAtletaAtivo ? formAtletaAtivo.querySelector('#genero-atleta') : null;
          const checkboxGrids = formAtletaAtivo ? Array.from(formAtletaAtivo.querySelectorAll('[data-gender-grid]')) : [];
          const checkboxes = formAtletaAtivo ? Array.from(formAtletaAtivo.querySelectorAll('input[name="modalidades"]')) : [];
          const detalhesAtleta = formAtletaAtivo ? formAtletaAtivo.querySelector('#detalhes-atleta') : null;
          const detalhesAtletismo = formAtletaAtivo ? formAtletaAtivo.querySelector('#detalhes-atletismo') : null;
          const detalhesTenisMesa = formAtletaAtivo ? formAtletaAtivo.querySelector('#detalhes-tenis-mesa') : null;
          const checkboxesAtletismo = formAtletaAtivo ? Array.from(formAtletaAtivo.querySelectorAll('input[name="atletismoProvas"]')) : [];
          const checkboxesTenisMesa = formAtletaAtivo ? Array.from(formAtletaAtivo.querySelectorAll('input[name="tenisMesaParticipacoes"]')) : [];
          if (!checkboxes.length) {
            return;
          }

          const maxSelecionadas = 3;

          function getGeneroAtual() {
            return generoSelect && generoSelect.value === 'Feminino' ? 'Feminino' : 'Masculino';
          }

          function atualizarGradeGenero() {
            const generoAtual = getGeneroAtual();

            checkboxGrids.forEach((grid) => {
              grid.style.display = grid.dataset.genderGrid === generoAtual ? '' : 'none';
            });

            checkboxes.forEach((item) => {
              if (item.closest('[data-gender-grid]')?.dataset.genderGrid !== generoAtual) {
                item.checked = false;
              }
            });

            atualizarEstado();
          }

          function atualizarEstado() {
            const generoAtual = getGeneroAtual();
            const visiveis = checkboxes.filter((item) => item.closest('[data-gender-grid]')?.dataset.genderGrid === generoAtual);
            const marcadas = visiveis.filter((item) => item.checked);
            const bloqueadas = marcadas.length >= maxSelecionadas;
            const modalidadesSelecionadas = visiveis.filter((item) => item.checked).map((item) => item.value);
            const temAtletismo = modalidadesSelecionadas.some((modalidade) => /atletismo/i.test(modalidade));
            const temTenisMesa = modalidadesSelecionadas.some((modalidade) => /tênis de mesa|tenis de mesa/i.test(modalidade));

            visiveis.forEach((item) => {
              if (!item.checked) {
                item.disabled = bloqueadas;
              } else {
                item.disabled = false;
              }
            });

            checkboxes.forEach((item) => {
              if (item.closest('[data-gender-grid]')?.dataset.genderGrid !== generoAtual) {
                item.disabled = true;
              }
            });

            if (detalhesAtleta) {
              detalhesAtleta.style.display = (temAtletismo || temTenisMesa) ? '' : 'none';
            }
            if (detalhesAtletismo) {
              detalhesAtletismo.style.display = temAtletismo ? '' : 'none';
            }
            if (detalhesTenisMesa) {
              detalhesTenisMesa.style.display = temTenisMesa ? '' : 'none';
            }
          }

          checkboxes.forEach((item) => {
            item.addEventListener('change', () => {
              const generoAtual = getGeneroAtual();
              const marcadas = checkboxes.filter((checkbox) => checkbox.closest('[data-gender-grid]')?.dataset.genderGrid === generoAtual && checkbox.checked);
              if (marcadas.length > maxSelecionadas) {
                item.checked = false;
                alert('Selecione no máximo 3 modalidades.');
              }
              atualizarEstado();
            });
          });

          [...checkboxesAtletismo, ...checkboxesTenisMesa].forEach((item) => {
            item.addEventListener('change', atualizarEstado);
          });

          if (generoSelect) {
            generoSelect.addEventListener('change', atualizarGradeGenero);
          }

          atualizarGradeGenero();
          atualizarEstado();
        })();
      </script>
      <% } %>

      <% if (totalAbas > 1) { %>
      <script>
        document.querySelectorAll('.tab-trigger').forEach((button) => {
          button.addEventListener('click', () => {
            const targetId = button.dataset.target;

            document.querySelectorAll('.tab-trigger').forEach((item) => item.classList.toggle('is-active', item === button));
            document.querySelectorAll('.dashboard-view').forEach((view) => view.classList.toggle('is-active', view.id === targetId));
          });
        });
      </script>
      <% } %>
    <% } else { %>
      <section style="min-height: 40vh; display: flex; align-items: center; justify-content: center; text-align: center; background: rgba(255, 255, 255, 0.02); padding: 2rem; border-radius: 16px; border: 1px solid rgba(236, 228, 45, 0.12); color: rgba(255,255,255,0.8);">
        <div>
          <h3 style="color: #ffffff; margin-bottom: 0.75rem; font-size: 1.2rem;">Fora do período de cadastro</h3>
          <p style="margin: 0;">Nenhuma aba está disponível no período cadastrado globalmente.</p>
        </div>
      </section>
    <% } %>

  </article>
</section>