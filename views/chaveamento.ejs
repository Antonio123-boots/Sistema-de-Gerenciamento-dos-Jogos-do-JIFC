<section class="panel-card">
  <div class="profile-header">
    <div>
      <h1>Chaveamento e Resultados</h1>
      <p class="panel-subtitle">Acompanhe as chaves oficiais, pontuações atualizadas e o andamento do mata-mata em tempo real.</p>
    </div>
  </div>

  <div class="menu-modalidades" style="margin-top: 0; background: rgba(var(--fg-rgb), 0.02); border-radius: 12px;">
    <div class="modalidades-container">
      <ul class="modalidades-list">
        <% listaModalidadesCompleta.forEach((mod) => { %>
          <li class="modalidade-item">
            <a href="/chaveamento?modalidade=<%= mod.id %>" class="<%= modalidadeAtiva.id === mod.id ? 'active-sport' : '' %>">
              <span class="modalidade-icon">
                <img src="<%= mod.icone && (mod.icone.startsWith('/') || mod.icone.startsWith('http')) ? mod.icone : (mod.imagem || '/imagens/atletismo1.svg') %>" alt="<%= mod.nome %>" class="sport-icon" style="width: 26px; height: 26px; border-radius: 50%;">
              </span>
              <span><%= mod.nome %></span>
            </a>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>

  <% if (modalidadeAtiva.categoria === 'tenis-de-mesa') { %>
    <div class="sub-tabs-container" style="margin-top: 1.5rem;">
      <a href="/chaveamento?modalidade=<%= modalidadeAtiva.id %>&sub=individual" class="btn-sub-tab <%= subCategoriaAtiva === 'individual' ? 'active' : '' %>">Individual</a>
      <a href="/chaveamento?modalidade=<%= modalidadeAtiva.id %>&sub=dupla" class="btn-sub-tab <%= subCategoriaAtiva === 'dupla' ? 'active' : '' %>">Em Dupla</a>
    </div>
  <% } %>

  <div style="margin-top: 2rem;">

    <% if (modalidadeAtiva.categoria === 'atletismo') { %>
      <div class="chaves-container">
        <% provasAtletismo.forEach((prova) => { %>
          <div class="chave-card">
            <div class="chave-title">🏃 <%= prova.nomeProva %></div>
            <ul class="chave-equipes-list">
              <% prova.atletas.forEach((atleta, index) => { %>
                <li class="chave-equipe-item">
                  <span><span class="chave-equipe-pos">#<%= index + 1 %></span> <%= atleta.nome %></span>
                  <span class="item-subtext"><%= atleta.campus %><%= atleta.detalhe ? ' · ' + atleta.detalhe : '' %></span>
                </li>
              <% }) %>
            </ul>
          </div>
        <% }) %>
        <% if (atletasAtletismo && atletasAtletismo.length > 0) { %>
          <div class="chave-card">
            <div class="chave-title">Atletas inscritos nas equipes</div>
            <p class="panel-subtitle" style="margin-bottom: 1rem;">Atletas dos campi inscritos no atletismo.</p>
            <ul class="chave-equipes-list">
              <% atletasAtletismo.forEach((atleta, index) => { %>
                <li class="chave-equipe-item">
                  <span><span class="chave-equipe-pos">#<%= index + 1 %></span> <%= atleta.nome %></span>
                  <span class="item-subtext"><%= atleta.campus %></span>
                </li>
              <% }) %>
            </ul>
          </div>
        <% } %>
      </div>
    <% } %>

    <% if (modalidadeAtiva.categoria === 'xadrez') { %>
      <% if (classificadosXadrez && classificadosXadrez.length > 0) { %>
        <div class="chave-card" style="max-width: 900px; margin: 0 auto; overflow-x: auto;">
          <div class="chave-title">♟️ Tabela de Classificação</div>
          <div style="min-width: 620px;">
            <div style="display:grid; grid-template-columns:42px minmax(0,1.8fr) minmax(0,1.3fr) 52px 44px 40px 40px 40px; gap:0.3rem; align-items:center; font-size:0.75rem; font-weight:700; text-transform:uppercase; letter-spacing:0.04em; color:var(--text-muted); padding:0.55rem 0.4rem; border-bottom:1px solid rgba(var(--fg-rgb), 0.1);">
              <div style="text-align:center;">#</div>
              <div style="text-align:left;">Atleta</div>
              <div style="text-align:left;">Campus</div>
              <div style="text-align:center; color:#58d68d;">P</div>
              <div style="text-align:center;">J</div>
              <div style="text-align:center; color:#58d68d;">V</div>
              <div style="text-align:center; color:#f5b041;">E</div>
              <div style="text-align:center; color:#f1948a;">D</div>
            </div>
            <% classificadosXadrez.forEach((enxadrista, index) => { %>
              <div style="display:grid; grid-template-columns:42px minmax(0,1.8fr) minmax(0,1.3fr) 52px 44px 40px 40px 40px; gap:0.3rem; align-items:center; font-size:0.8rem; padding:0.5rem 0.4rem; border-top:1px solid rgba(var(--fg-rgb), 0.06); <%= index < 3 ? 'background:rgba(88,214,141,0.04);' : '' %>">
                <div style="font-weight:700; color:var(--text-muted); text-align:center;"><%= index + 1 %>º</div>
                <div style="color: var(--text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= enxadrista.nomeAtleta %></div>
                <div style="color:rgba(var(--fg-rgb), 0.6); font-size:0.75rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= enxadrista.nomeCampus %></div>
                <div style="font-weight:700; color:#58d68d; text-align:center;"><%= enxadrista.pontuacaoAtual %></div>
                <div style="text-align:center; color:var(--text-muted);"><%= enxadrista.jogos || 0 %></div>
                <div style="text-align:center; color:#58d68d;"><%= enxadrista.vitorias || 0 %></div>
                <div style="text-align:center; color:#f5b041;"><%= enxadrista.empates || 0 %></div>
                <div style="text-align:center; color:#f1948a;"><%= enxadrista.derrotas || 0 %></div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } else { %>
        <div class="feedback-empty">
          <p>♟️ A tabela de classificação do xadrez será exibida assim que o juiz lançar os primeiros resultados.</p>
        </div>
      <% } %>
    <% } else { %>
      <% if (chavesGeradas && chavesGeradas.length > 0) { %>
        <div class="chaves-container">
          <% chavesGeradas.forEach((chave) => { %>
            <div class="chave-card">
              <div class="chave-title">Grupo <%= chave.letra %></div>
              <ul class="chave-equipes-list">
                <% chave.integrantes.forEach((equipe, idx) => { %>
                  <li class="chave-equipe-item">
                    <div>
                      <span class="chave-equipe-pos"><%= idx + 1 %>º</span>
                      <% if (subCategoriaAtiva === 'individual') { %>
                        <span><%= equipe.nomeAtleta %> <small style="color:rgba(var(--fg-rgb), 0.5);">(<%= equipe.nomeCampus %>)</small></span>
                      <% } else { %>
                        <span><%= equipe.nomeCampus %></span>
                      <% } %>
                    </div>
                    <span class="chave-equipe-pontos"><%= equipe.pontosFaseDeGrupos %> Pts</span>
                  </li>
                <% }) %>
              </ul>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="feedback-empty">
          <p>🏁 O chaveamento inicial desta modalidade está aguardando a liberação da comissão organizadora.</p>
        </div>
      <% } %>
    <% } %>

  </div>

  <% if (fasesEliminatoria && fasesEliminatoria.length > 0) { %>
    <div style="margin-top: 3.5rem; border-top: 1px solid rgba(var(--fg-rgb), 0.08); padding-top: 2rem;">
      <h2 style="margin-bottom: 0.5rem;">🏆 Eliminatória</h2>
      <p class="panel-subtitle" style="margin-bottom: 1.5rem;">Confrontos preenchem automaticamente conforme os resultados são confirmados.</p>

      <% fasesEliminatoria.forEach((faseGrupo) => { %>
        <div style="margin-bottom: 2rem;">
          <h3 style="font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); margin-bottom: 0.75rem;"><%= faseGrupo.fase %></h3>
          <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            <% faseGrupo.jogos.forEach((jogo) => { %>
              <%
                const nomeCasa = (jogo.campus_1_exibicao || jogo.campus_1_nome || jogo.atleta_1_nome);
                const nomeFora = (jogo.campus_2_exibicao || jogo.campus_2_nome || jogo.atleta_2_nome);
                const labelCasa = nomeCasa || jogo.rotulo_casa || 'A definir';
                const labelFora = nomeFora || jogo.rotulo_fora || 'A definir';
                const ehEncerrado = jogo.status === 'Encerrado';
                const ehWO = Boolean(jogo.wo);
                const temPlacar = ehEncerrado && jogo.placar_1 != null && jogo.placar_2 != null;
                const temDisputa = jogo.disputa_pontos_1 != null && jogo.disputa_pontos_2 != null
                                  && Number(jogo.disputa_pontos_1) !== Number(jogo.disputa_pontos_2);
              %>
              <div class="chave-card" style="margin: 0; padding: 0.75rem 1rem;">
                <div style="display: grid; grid-template-columns: 1fr auto 1fr; gap: 0.75rem; align-items: center;">
                  <div style="text-align: right; min-width: 0;">
                    <span style="font-size: 0.8rem; font-weight: 600; color: var(--text); word-break: break-word; <%= !nomeCasa ? 'color:var(--text-muted); font-style:italic;' : '' %>"><%= labelCasa %></span>
                  </div>
                  <div style="text-align: center; flex-shrink: 0;">
                    <% if (temPlacar) { %>
                      <div style="font-size: 1.1rem; font-weight: 800; color: var(--text); line-height: 1.2;">
                        <span><%= jogo.placar_1 %></span>
                        <span style="color:var(--text-muted); margin:0 0.15rem; font-weight:400;">x</span>
                        <span><%= jogo.placar_2 %></span>
                      </div>
                      <% if (temDisputa) { %>
                        <div style="font-size: 0.65rem; color: #f5b041; font-weight: 700; margin-top: 0.15rem;">(<%= jogo.disputa_pontos_1 %>x<%= jogo.disputa_pontos_2 %>)</div>
                      <% } %>
                    <% } else { %>
                      <span style="font-size: 0.8rem; font-weight: 700; color: rgba(var(--fg-rgb), 0.35);">VS</span>
                    <% } %>
                  </div>
                  <div style="text-align: left; min-width: 0;">
                    <span style="font-size: 0.8rem; font-weight: 600; color: var(--text); word-break: break-word; <%= !nomeFora ? 'color:var(--text-muted); font-style:italic;' : '' %>"><%= labelFora %></span>
                  </div>
                </div>
                <% if (ehWO) { %>
                  <div style="text-align: center; margin-top: 0.35rem;">
                    <span style="font-size: 0.55rem; font-weight: 800; letter-spacing: 0.08em; padding: 0.15rem 0.45rem; border-radius: 6px; background: rgba(245,176,65,0.18); color: #f5b041;">W.O.</span>
                  </div>
                <% } %>
              </div>
            <% }) %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <% if (jogosProgramados && jogosProgramados.length > 0) { %>
    <div style="margin-top: 3.5rem; border-top: 1px solid rgba(var(--fg-rgb), 0.08); padding-top: 2rem;">
      <h2 style="margin-bottom: 0.5rem;">Agenda de Confrontos & Resultados</h2>
      <p class="panel-subtitle" style="margin-bottom: 1.5rem;">Acompanhe abaixo os horários e placares das partidas.</p>
      
      <div class="game-grid">
        <% jogosProgramados.forEach((jogo) => { %>
          <%- include('partials/cardJogo', { jogo: jogo }) %>
        <% }) %>
      </div>
    </div>
  <% } %>
</section>