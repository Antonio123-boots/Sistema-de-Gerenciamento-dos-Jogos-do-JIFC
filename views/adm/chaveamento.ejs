<section class="panel-card">
  <div class="profile-header">
    <div>
      <h1>Painel de Chaveamento — JIFC <%= typeof anoJifc !== 'undefined' ? anoJifc : '2026' %></h1>
      <p class="panel-subtitle">Gerencie o sorteio, configure divisões de chaves e publique os cronogramas oficiais.</p>
    </div>
    <div>
      <% if (inscricoesAbertas) { %>
        <span class="status-tag" style="background: rgba(255,75,75,0.15); color: #ff6b6b;">Inscrições Abertas</span>
      <% } else { %>
        <span class="status-tag">Inscrições Finalizadas</span>
      <% } %>
    </div>
  </div>

  <% if (typeof chaveamentoBloqueado !== 'undefined' && chaveamentoBloqueado) { %>
    <section class="panel-card" style="margin-top:1.5rem; border:1px solid rgba(255,107,107,0.35); background:rgba(255,107,107,0.08);">
      <div class="welcome-card" style="padding:1.5rem; background:transparent; border:none;">
        <h2 style="margin-bottom:0.5rem;">Chaveamento ainda indisponível</h2>
        <p class="panel-subtitle">Aguarde o encerramento das inscrições de modalidades e atletas para abrir o painel de chaveamento.</p>
      </div>
    </section>
  <% } else { %>

  <div class="menu-modalidades premium" style="margin-top: 0;">
    <div class="modalidades-container">
      <ul class="modalidades-list compact premium-list">
        <% listaModalidadesCompleta.forEach((mod) => { %>
          <li class="modalidade-item compact premium-item">
            <a href="/admin/chaveamento?modalidade=<%= mod.id %>" class="<%= modalidadeAtiva.id === mod.id ? 'active-sport premium-active' : '' %>">
              <img src="<%= mod.imagem || '/imagens/atletismo1.svg' %>" alt="<%= mod.nome %>" onerror="this.src='/imagens/atletismo1.svg'">
              <span class="sport-card-name"><%= mod.nome %></span>
              <span class="sport-card-gender"><%= String(mod.genero || '').toUpperCase() %></span>
            </a>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>

  <% if (modalidadeAtiva.categoria === 'tenis-de-mesa') { %>
    <div class="sub-tabs-container" style="margin-top: 1.5rem;">
      <a href="/admin/chaveamento?modalidade=<%= modalidadeAtiva.id %>&sub=individual" class="btn-sub-tab <%= subCategoriaAtiva === 'individual' ? 'active' : '' %>">Individual</a>
      <a href="/admin/chaveamento?modalidade=<%= modalidadeAtiva.id %>&sub=dupla" class="btn-sub-tab <%= subCategoriaAtiva === 'dupla' ? 'active' : '' %>">Em Dupla</a>
    </div>
  <% } else if (modalidadeAtiva.categoria === 'atletismo') { %>
    <div class="sub-tabs-container" style="margin-top: 1.5rem;">
      <a href="/admin/chaveamento?modalidade=<%= modalidadeAtiva.id %>&sub=geral" class="btn-sub-tab <%= subCategoriaAtiva === 'geral' ? 'active' : '' %>">Geral</a>
      <a href="/admin/chaveamento?modalidade=<%= modalidadeAtiva.id %>&sub=corrida" class="btn-sub-tab <%= subCategoriaAtiva === 'corrida' ? 'active' : '' %>">Corrida</a>
      <a href="/admin/chaveamento?modalidade=<%= modalidadeAtiva.id %>&sub=salto" class="btn-sub-tab <%= subCategoriaAtiva === 'salto' ? 'active' : '' %>">Salto</a>
      <a href="/admin/chaveamento?modalidade=<%= modalidadeAtiva.id %>&sub=arremesso" class="btn-sub-tab <%= subCategoriaAtiva === 'arremesso' ? 'active' : '' %>">Arremesso</a>
    </div>
  <% } %>

  <div class="admin-actions-zone" style="margin-top: 1rem; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.75rem; padding:0.7rem 0.8rem; border:1px solid rgba(255,255,255,0.08); border-radius:14px; background:rgba(255,255,255,0.03);">
    <div class="mini-summary-line">
      <span class="item-subtext">Inscritos mapeados: <strong><%= inscritosPendentes.length %></strong></span>
    </div>
    <div style="display:flex; flex-wrap:wrap; gap:0.6rem;">
      <% if (inscricoesAbertas) { %>
        <button class="btn btn-ghost" disabled title="Aguarde o encerramento das inscrições">Aguardando Fim das Inscrições</button>
      <% } else if (chavesGeradas && chavesGeradas.length > 0) { %>
        <form action="/admin/chaveamento/limpar" method="POST" style="display: inline-block;">
          <input type="hidden" name="modalidadeId" value="<%= modalidadeAtiva.id %>">
          <input type="hidden" name="subCategoria" value="<%= subCategoriaAtiva %>">
          <button type="submit" class="btn btn-danger">Refazer Sorteio</button>
        </form>
      <% } else { %>
        <form action="/admin/chaveamento/gerar" method="POST" style="display: inline-block;">
          <input type="hidden" name="modalidadeId" value="<%= modalidadeAtiva.id %>">
          <input type="hidden" name="subCategoria" value="<%= subCategoriaAtiva %>">
          <button type="submit" class="btn btn-success">🎲 Realizar Sorteio Dinâmico</button>
        </form>
      <% } %>
    </div>
  </div>

  <div class="chaveamento-layout">
    <main class="chaveamento-content">
      
      <% if (modalidadeAtiva.categoria === 'atletismo') { %>
        <h2>Provas e Atletas Confirmados</h2>
        <p class="panel-subtitle" style="margin-bottom: 1.5rem;">Escolha a categoria de prova para ver o agrupamento dos atletas abaixo.</p>

        <div style="display:grid; grid-template-columns: 220px 1fr; gap:1rem; align-items:start; margin-bottom: 1.5rem;">
          <div class="chave-card" style="padding: 1rem;">
            <div class="chave-title" style="font-size: 0.95rem; margin-bottom: 0.75rem;">Categorias</div>
            <div style="display:flex; flex-direction:column; gap:0.5rem;">
              <% provasAtletismo.forEach((prova) => { %>
                <a href="/admin/chaveamento?modalidade=<%= modalidadeAtiva.id %>&sub=<%= prova.slug %>" class="btn <%= prova.ativa ? 'btn-success' : 'btn-ghost' %>" style="justify-content:center; text-align:center;">
                  <%= prova.nomeProva %>
                </a>
              <% }) %>
            </div>
          </div>

          <% const provaAtivaAtual = provasAtletismo.find((prova) => prova.ativa) || provasAtletismo[0]; %>
          <div class="chave-card">
            <div class="chave-title">🏃 <%= provaAtivaAtual.nomeProva %></div>
            <p class="panel-subtitle" style="margin: 0 0 1rem; font-size: 0.8rem;"><%= provaAtivaAtual.descricao %></p>

            <% if (provaAtivaAtual.subprovas && provaAtivaAtual.subprovas.length) { %>
              <div style="display:flex; flex-wrap:wrap; gap:0.5rem; margin-bottom: 1rem;">
                <% provaAtivaAtual.subprovas.forEach((subprova) => { %>
                  <a href="/admin/chaveamento?modalidade=<%= modalidadeAtiva.id %>&sub=<%= provaAtivaAtual.slug %>&subProva=<%= subprova.slug %>" class="btn <%= (typeof subProvaAtiva !== 'undefined' && subProvaAtiva === subprova.slug) ? 'btn-success' : 'btn-ghost' %>" style="font-size:0.8rem; padding:0.45rem 0.7rem;">
                    <%= subprova.nomeProva %>
                  </a>
                <% }) %>
              </div>
            <% } %>

            <ul class="chave-equipes-list">
              <% provaAtivaAtual.atletas.forEach((atleta, index) => { %>
                <li class="chave-equipe-item">
                  <span><span class="chave-equipe-pos">#<%= index + 1 %></span> <%= atleta.nomeAtleta || atleta.nome %></span>
                  <span class="item-subtext"><%= atleta.nomeCampus || atleta.campus || 'Campus não informado' %></span>
                </li>
              <% }) %>
              <% if(provaAtivaAtual.atletas.length === 0) { %>
                <li class="feedback-empty">Sem atletas nesta prova.</li>
              <% } %>
            </ul>
          </div>
        </div>

      <% } else if (modalidadeAtiva.categoria === 'xadrez') { %>
        <h2>Chaveamento Inicial — Sistema Suíço</h2>
        <p class="panel-subtitle" style="margin-bottom: 1.5rem;">Lista Geral de Enxadristas aptos para o pareamento das rodadas.</p>
        
        <div class="chave-card" style="max-width: 100%;">
          <div class="chave-title">♟️ Tabela de Mestres Inscritos</div>
          <ul class="chave-equipes-list">
            <% inscritosPendentes.forEach((enxadrista, index) => { %>
              <li class="chave-equipe-item">
                <span><span class="chave-equipe-pos"><%= index + 1 %>º</span> <strong><%= enxadrista.nomeAtleta %></strong> (<%= enxadrista.nomeCampus %>)</span>
                <span class="chave-equipe-pontos"><%= enxadrista.pontuacaoAtual || '0.0' %> pts</span>
              </li>
            <% }) %>
          </ul>
        </div>

      <% } else { %>
        <h2>Distribuição de Grupos Oficiais</h2>
        <p class="panel-subtitle" style="margin-bottom: 1.5rem;">Sorteio realizado seguindo as regras de prioridade em chaves iniciais (resto alocado no topo).</p>

        <% if (chavesGeradas && chavesGeradas.length > 0) { %>
          <div class="chaves-container">
            <% chavesGeradas.forEach((chave) => { %>
              <div class="chave-card">
                <div class="chave-title">Grupo <%= chave.letra %></div>
                <ul class="chave-equipes-list">
                  <% chave.integrantes.forEach((equipe, idx) => { %>
                    <li class="chave-equipe-item">
                      <div>
                        <span class="chave-equipe-pos"><%= idx + 1 %></span>
                        <% if (subCategoriaAtiva === 'individual') { %>
                          <span><%= equipe.nomeAtleta %> <small style="color:rgba(255,255,255,0.5);">(<%= equipe.nomeCampus %> - <%= equipe.numeroInscrito %>)</small></span>
                        <% } else { %>
                          <span><%= equipe.nomeCampus %></span>
                        <% } %>
                      </div>
                      <span class="chave-equipe-pontos"><%= equipe.pontosFaseDeGrupos || 0 %> Pts</span>
                    </li>
                  <% }) %>
                </ul>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="welcome-card" style="padding: 2rem;">
            <p>O chaveamento desta categoria ainda não foi gerado pelo sistema.</p>
            <p style="font-size: 0.85rem; color: rgba(255,255,255,0.4); margin-top: 0.5rem;">Clique no botão superior "Realizar Sorteio Dinâmico" para rodar a distribuição automática.</p>
          </div>
        <% } %>

      <% } %>

      <% if (jogosProgramados && jogosProgramados.length > 0) { %>
        <div style="margin-top: 2rem;">
          <h2 style="margin-bottom: 0.75rem;">Confrontos</h2>
          <div class="game-grid">
            <% jogosProgramados.forEach((jogo) => { %>
              <article class="game-card">
                <p class="game-time"><%= jogo.data %> · <%= jogo.horario %></p>
                <h3>
                  <%= jogo.tipoIndividual ? jogo.atletaCasa : jogo.casa %> 
                  x 
                  <%= jogo.tipoIndividual ? jogo.atletaFora : jogo.fora %>
                </h3>
                <p class="game-result" style="font-size: 0.85rem;">Fase: <%= jogo.fase %></p>
                <p class="game-result">Placar: <strong style="color: #ece42d;"><%= jogo.placar || 'vs' %></strong></p>
                <span class="status-pill"><%= jogo.status %></span>
                
                <div class="profile-actions" style="margin-top: 1rem;">
                  <a class="btn btn-secondary" style="font-size: 0.8rem; padding: 0.5rem;" href="/admin/jogos/placar/<%= jogo.id %>">Atualizar Resultado</a>
                </div>
              </article>
            <% }) %>
          </div>
        </div>
      <% } %>

      <% if (resumoDisponivel) { %>
        <section class="panel-card compact-summary-card" style="margin-top: 1.5rem; padding: 0.9rem 1rem;">
          <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.75rem; margin-bottom:0.75rem;">
            <h3 style="margin:0; font-size: 1rem;">Campus</h3>
            <a class="btn btn-secondary" style="padding:0.45rem 0.7rem; font-size:0.8rem;" href="/admin/chaveamento/exportar">CSV</a>
          </div>
          <% if (resumoInscricoes && resumoInscricoes.campi && resumoInscricoes.campi.length) { %>
            <div class="resumo-campi-list compact">
              <% resumoInscricoes.campi.forEach((campus) => { %>
                <% const totalAtletasCampus = campus.modalidades.reduce((acc, modalidade) => acc + ((modalidade.atletas && modalidade.atletas.length) ? modalidade.atletas.length : 0), 0); %>
                <div class="resumo-campus-item-compact">
                  <div>
                    <strong><%= campus.nome %></strong>
                    <div class="item-subtext"><%= totalAtletasCampus %> atletas</div>
                  </div>
                  <a class="btn btn-ghost" href="/admin/chaveamento/campus/<%= campus.id %>">Detalhes</a>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <p class="panel-subtitle" style="margin:0;">Nenhuma inscrição encontrada.</p>
          <% } %>
        </section>
      <% } %>

    </main>

  </div>
  <% } %>
</section>