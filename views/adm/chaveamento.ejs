<section class="panel-card">
  <div class="profile-header">
    <div>
      <h1>Painel de Chaveamento JIFC <%= typeof anoJifc !== 'undefined' ? anoJifc : '2026' %></h1>
    </div>
    <div>
      <% if (inscricoesAbertas) { %>
        <span class="status-tag" style="background: rgba(255,75,75,0.15); color: #ff6b6b;">Inscrições Abertas</span>
      <% } else { %>
        <span class="status-tag">Inscrições Finalizadas</span>
      <% } %>
    </div>
  </div>

  <% if (typeof chaveamentoBloqueado !== 'undefined' && chaveamentoBloqueado) { %>
    <section class="panel-card" style="margin-top:1.5rem; border:1px solid rgba(255,107,107,0.35); background:rgba(255,107,107,0.08);">
      <div class="welcome-card" style="padding:1.5rem; background:transparent; border:none;">
        <h2 style="margin-bottom:0.5rem;">Chaveamento ainda indisponível</h2>
        <p class="panel-subtitle">Aguarde o encerramento das inscrições de modalidades e atletas para abrir o painel de chaveamento.</p>
      </div>
    </section>
  <% } else { %>

  <div class="menu-modalidades premium" style="margin-top: 0;">
    <div class="modalidades-container">
      <ul class="modalidades-list compact premium-list">
        <% listaModalidadesCompleta.forEach((mod) => { %>
          <li class="modalidade-item compact premium-item">
            <a href="/admin/chaveamento?modalidade=<%= mod.id %>#modalidade" class="<%= modalidadeAtiva.id === mod.id ? 'active-sport premium-active' : '' %>">
              <img src="<%= mod.icone && (mod.icone.startsWith('/') || mod.icone.startsWith('http')) ? mod.icone : (mod.imagem || '/imagens/atletismo1.svg') %>" alt="<%= mod.nome %>" onerror="this.src='/imagens/atletismo1.svg'">
              <span class="sport-card-name"><%= mod.nome %></span>
            </a>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>

  <% if (modalidadeAtiva.categoria === 'tenis-de-mesa') { %>
    <div class="sub-tabs-container" style="margin-top: 1.5rem;">
      <a href="/admin/chaveamento?modalidade=<%= modalidadeAtiva.id %>&sub=individual#modalidade" class="btn-sub-tab <%= subCategoriaAtiva === 'individual' ? 'active' : '' %>">Individual</a>
      <a href="/admin/chaveamento?modalidade=<%= modalidadeAtiva.id %>&sub=dupla#modalidade" class="btn-sub-tab <%= subCategoriaAtiva === 'dupla' ? 'active' : '' %>">Em Dupla</a>
    </div>
  <% } else if (modalidadeAtiva.categoria === 'atletismo') { %>
    <div id="modalidade" class="sub-tabs-container" style="margin-top: 1.5rem;">
      <a href="/admin/chaveamento?modalidade=<%= modalidadeAtiva.id %>&sub=geral#modalidade" class="btn-sub-tab <%= subCategoriaAtiva === 'geral' ? 'active' : '' %>">Geral</a>
      <a href="/admin/chaveamento?modalidade=<%= modalidadeAtiva.id %>&sub=corrida#modalidade" class="btn-sub-tab <%= subCategoriaAtiva === 'corrida' ? 'active' : '' %>">Corrida</a>
      <a href="/admin/chaveamento?modalidade=<%= modalidadeAtiva.id %>&sub=salto#modalidade" class="btn-sub-tab <%= subCategoriaAtiva === 'salto' ? 'active' : '' %>">Salto</a>
      <a href="/admin/chaveamento?modalidade=<%= modalidadeAtiva.id %>&sub=arremesso#modalidade" class="btn-sub-tab <%= subCategoriaAtiva === 'arremesso' ? 'active' : '' %>">Arremesso</a>
    </div>
  <% } %>

  <div class="acoes-sorteio">
    <div class="as-info">
      <span class="as-label">Sorteio</span>
      <span class="as-contagem"><strong><%= inscritosPendentes.length %></strong> inscritos mapeados</span>
    </div>
    <div class="as-botoes">
      <% if (inscricoesAbertas) { %>
        <button class="btn btn-ghost" disabled title="Aguarde o encerramento das inscrições">Aguardando Fim das Inscrições</button>
      <% } else if (chavesGeradas && chavesGeradas.length > 0) { %>
        <form action="/admin/chaveamento/limpar" method="POST" style="display: inline-block;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="modalidadeId" value="<%= modalidadeAtiva.id %>">
          <input type="hidden" name="subCategoria" value="<%= subCategoriaAtiva %>">
          <button type="submit" class="btn btn-danger" onclick="return confirm('Refazer o sorteio de <%= modalidadeAtiva.nome %>? ATENCAO: todos os jogos, resultados e classificação desta modalidade serao apagados. Esta acao nao pode ser desfeita.');">Refazer Sorteio</button>
        </form>
      <% } else if (!modalidadeSorteavel) { %>
        <button class="btn btn-ghost" disabled title="Esta modalidade não possui sorteio automático">Sorteio automático indisponível</button>
      <% } else if (!permitirGerarSorteio) { %>
        <button class="btn btn-ghost" disabled title="Sorteio bloqueado até a data definida">Sorteio será liberado em breve</button>
      <% } else { %>
        <button id="generate-draw-button" type="button" class="btn btn-primary">Realizar Sorteio</button>
      <% } %>
      <form id="generate-draw-form" action="/admin/chaveamento/gerar" method="POST" style="display: inline-block;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="modalidadeId" value="<%= modalidadeAtiva.id %>">
        <input type="hidden" name="subCategoria" value="<%= subCategoriaAtiva %>">
      </form>
      <% if (rodadasJogos && rodadasJogos.length > 0) { %>
        <button id="confirm-publish-button" type="button" class="btn btn-secondary">Publicar Jogos</button>
      <% } %>
      <form id="publish-draw-form" action="/admin/chaveamento/publicar" method="POST" style="display: inline-block;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="modalidadeId" value="<%= modalidadeAtiva.id %>">
        <input type="hidden" name="subCategoria" value="<%= subCategoriaAtiva %>">
      </form>
      <form id="cancel-draw-form" action="/admin/chaveamento/cancelar" method="POST" style="display: inline-block;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="modalidadeId" value="<%= modalidadeAtiva.id %>">
        <input type="hidden" name="subCategoria" value="<%= subCategoriaAtiva %>">
        <button type="submit" class="btn btn-danger" onclick="return confirm('Cancelar TODOS os sorteios (exceto atletismo e xadrez)? ATENCAO: todos os jogos, resultados e classificações das demais modalidades serao apagados. Esta acao nao pode ser desfeita.');">Cancelar Sorteio</button>
      </form>

      <div id="generate-draw-modal" class="confirm-modal-overlay" hidden>
        <div class="confirm-modal-card" role="dialog" aria-modal="true" aria-labelledby="generate-draw-title">
          <div class="confirm-modal-icon">🎲</div>
          <h3 id="generate-draw-title">Refazer o sorteio?</h3>
          <p>O sistema vai sortear novamente somente <strong><%= modalidadeAtiva.nome %></strong><% if (modalidadeAtiva.categoria === 'tenis-de-mesa') { %> (<%= subCategoriaAtiva === 'dupla' ? 'aba Em Dupla' : 'aba Individual' %>)<% } %>, sem alterar as demais modalidades.</p>
          <div class="confirm-modal-actions">
            <button type="button" class="btn btn-ghost" data-generate-cancel>Cancelar</button>
            <button type="button" class="btn btn-success" data-generate-confirm>Confirmar</button>
          </div>
        </div>
      </div>

      <div id="cancel-draw-modal" class="confirm-modal-overlay" hidden>
        <div class="confirm-modal-card" role="dialog" aria-modal="true" aria-labelledby="cancel-draw-title">
          <div class="confirm-modal-icon">🗑️</div>
          <h3 id="cancel-draw-title">Cancelar sorteio?</h3>
          <p>Essa ação apagará todos os sorteios já gerados para os esportes com chaves, exceto Atletismo e Xadrez.</p>
          <div class="confirm-modal-actions">
            <button type="button" class="btn btn-ghost" data-modal-cancel>Cancelar</button>
            <button type="button" class="btn btn-danger" data-modal-confirm>Confirmar</button>
          </div>
        </div>
      </div>

      <div id="publish-draw-modal" class="confirm-modal-overlay" hidden>
        <div class="confirm-modal-card" role="dialog" aria-modal="true" aria-labelledby="publish-draw-title">
          <div class="confirm-modal-icon">✅</div>
          <h3 id="publish-draw-title">Confirmar publicação?</h3>
          <p>Essa ação publicará todos os jogos gerados e tornará o calendário oficial visível para o público.</p>
          <div class="confirm-modal-actions">
            <button type="button" class="btn btn-ghost" data-publish-cancel>Cancelar</button>
            <button type="button" class="btn btn-primary" data-publish-confirm>Confirmar</button>
          </div>
        </div>
      </div>

      <script>
        (function () {
          const generateButton = document.getElementById('generate-draw-button');
          const generateForm = document.getElementById('generate-draw-form');
          const generateModal = document.getElementById('generate-draw-modal');
          const cancelForm = document.getElementById('cancel-draw-form');
          const cancelModal = document.getElementById('cancel-draw-modal');
          const publishButton = document.getElementById('confirm-publish-button');
          const publishForm = document.getElementById('publish-draw-form');
          const publishModal = document.getElementById('publish-draw-modal');

          if (generateButton && generateForm && generateModal) {
            generateButton.addEventListener('click', function () {
              generateModal.hidden = false;
              generateModal.classList.add('active');
            });

            generateModal.querySelector('[data-generate-cancel]')?.addEventListener('click', function () {
              generateModal.hidden = true;
              generateModal.classList.remove('active');
            });

            generateModal.querySelector('[data-generate-confirm]')?.addEventListener('click', function () {
              generateForm.submit();
            });
          }

          if (cancelForm && cancelModal) {
            cancelForm.addEventListener('submit', function (event) {
              event.preventDefault();
              cancelModal.hidden = false;
              cancelModal.classList.add('active');
            });

            cancelModal.querySelector('[data-modal-cancel]')?.addEventListener('click', function () {
              cancelModal.hidden = true;
              cancelModal.classList.remove('active');
            });

            cancelModal.querySelector('[data-modal-confirm]')?.addEventListener('click', function () {
              cancelForm.submit();
            });
          }

          if (publishButton && publishForm && publishModal) {
            publishButton.addEventListener('click', function () {
              publishModal.hidden = false;
              publishModal.classList.add('active');
            });

            publishModal.querySelector('[data-publish-cancel]')?.addEventListener('click', function () {
              publishModal.hidden = true;
              publishModal.classList.remove('active');
            });

            publishModal.querySelector('[data-publish-confirm]')?.addEventListener('click', function () {
              publishForm.submit();
            });
          }
        })();
      </script>
    </div>
  </div>
  <% if (mensagemErro) { %>
    <section class="panel-card" style="margin-top:1rem; border:1px solid rgba(255,107,107,0.35); background:rgba(255,107,107,0.08);">
      <div class="welcome-card" style="padding:1rem; background:transparent; border:none; color:#fff;">
        <p class="panel-subtitle" style="color:#ffb3b3;"><strong>Erro:</strong> <%= mensagemErro %></p>
      </div>
    </section>
  <% } %>
  <% if (mensagemSucesso) { %>
    <section class="panel-card" style="margin-top:1rem; border:1px solid rgba(75,255,135,0.3); background:rgba(75,255,135,0.08);">
      <div class="welcome-card" style="padding:1rem; background:transparent; border:none; color:#fff;">
        <p class="panel-subtitle" style="color:#d4ffd4;"><strong>Sucesso:</strong> <%= mensagemSucesso %></p>
      </div>
    </section>
  <% } %>
  <% if (!inscricoesAbertas && !permitirGerarSorteio) { %>
    <section class="panel-card" style="margin-top:1rem; border:1px solid rgba(255,255,255,0.08); background:rgba(255,255,255,0.03);">
      <div class="welcome-card" style="padding:1rem; background:transparent; border:none;">
        <p class="panel-subtitle">O painel de chaveamento exibe as inscrições, mas o sorteio só estará liberado a partir de <strong><%= inicioSorteio || 'após o fim das inscrições' %></strong>.</p>
      </div>
    </section>
  <% } %>

  <div class="chaveamento-layout">
    <main class="chaveamento-content">
      
      <% if (modalidadeAtiva.categoria === 'atletismo') { %>
        <h2>Provas e Atletas Confirmados</h2>
        <p class="panel-subtitle" style="margin-bottom: 1.5rem;">Escolha a categoria de prova para ver o agrupamento dos atletas abaixo.</p>

        <div class="atletismo-layout" style="margin-bottom: 1.5rem;">
          <div class="chave-card" style="padding: 1rem;">
            <div class="chave-title" style="font-size: 0.95rem; margin-bottom: 0.75rem;">Categorias</div>
            <div style="display:flex; flex-direction:column; gap:0.5rem;">
              <% provasAtletismo.forEach((prova) => { %>
                <a href="/admin/chaveamento?modalidade=<%= modalidadeAtiva.id %>&sub=<%= prova.slug %>#modalidade" class="btn <%= prova.ativa ? 'btn-success' : 'btn-ghost' %>" style="justify-content:center; text-align:center;">
                  <%= prova.nomeProva %>
                </a>
              <% }) %>
            </div>
          </div>

          <% const provaAtivaAtual = provasAtletismo.find((prova) => prova.ativa) || provasAtletismo[0]; %>
          <div class="chave-card">
            <div class="chave-title"> <%= provaAtivaAtual.nomeProva %></div>
            <p class="panel-subtitle" style="margin: 0 0 1rem; font-size: 0.8rem;"><%= provaAtivaAtual.descricao %></p>

            <% if (provaAtivaAtual.slug === 'geral') { %>
              <div class="tabela-scroll" style="border:1px solid rgba(255,255,255,0.08); border-radius:10px;">
                <table style="width:100%; min-width:420px; border-collapse:collapse;">
                <thead>
                  <tr>
                    <th style="text-align:left; padding:0.5rem 0.75rem; border-bottom:1px solid rgba(255,255,255,0.2); font-size:0.8rem;">Posição</th>
                    <th style="text-align:left; padding:0.5rem 0.75rem; border-bottom:1px solid rgba(255,255,255,0.2); font-size:0.8rem;">Campus</th>
                    <th style="text-align:center; padding:0.5rem 0.75rem; border-bottom:1px solid rgba(255,255,255,0.2); font-size:0.8rem;">Provas Pontuadas</th>
                    <th style="text-align:right; padding:0.5rem 0.75rem; border-bottom:1px solid rgba(255,255,255,0.2); font-size:0.8rem;">Pontos</th>
                  </tr>
                </thead>
                <tbody>
                  <% (provaAtivaAtual.campi || []).forEach((campus, index) => { %>
                    <tr>
                      <td style="padding:0.55rem 0.75rem; border-bottom:1px solid rgba(255,255,255,0.08);"><span class="chave-equipe-pos"><%= index + 1 %>º</span></td>
                      <td style="padding:0.55rem 0.75rem; border-bottom:1px solid rgba(255,255,255,0.08);"><strong><%= campus.campus_nome || campus.nome || 'Campus sem nome' %></strong></td>
                      <td style="padding:0.55rem 0.75rem; border-bottom:1px solid rgba(255,255,255,0.08); text-align:center;"><%= Number(campus.provas_pontuadas || 0) %></td>
                      <td style="padding:0.55rem 0.75rem; border-bottom:1px solid rgba(255,255,255,0.08); text-align:right;"><span class="chave-equipe-pontos"><%= Number(campus.pontos || 0) %> pts</span></td>
                    </tr>
                  <% }) %>
                  <% if (!provaAtivaAtual.campi || provaAtivaAtual.campi.length === 0) { %>
                    <tr><td colspan="4" class="feedback-empty">Nenhum campus inscrito no atletismo ainda.</td></tr>
                  <% } %>
                </tbody>
              </table>
              </div>
            <% } else { %>

            <% if (provaAtivaAtual.subprovas && provaAtivaAtual.subprovas.length) { %>
              <div style="display:flex; flex-wrap:wrap; gap:0.5rem; margin-bottom: 1rem;">
                <% provaAtivaAtual.subprovas.forEach((subprova) => { %>
                  <a href="/admin/chaveamento?modalidade=<%= modalidadeAtiva.id %>&sub=<%= provaAtivaAtual.slug %>&subProva=<%= subprova.slug %>#modalidade" class="btn <%= (provaAtivaAtual.subProvaSelecionada && provaAtivaAtual.subProvaSelecionada.slug === subprova.slug) ? 'btn-success' : 'btn-ghost' %>" style="font-size:0.8rem; padding:0.45rem 0.7rem;">
                    <%= subprova.nomeProva %>
                  </a>
                <% }) %>
              </div>
            <% } %>

            <% const atletasExibidos = provaAtivaAtual.subProvaSelecionada ? provaAtivaAtual.subProvaSelecionada.atletas : provaAtivaAtual.atletas; %>
            <% if (provaAtivaAtual.subProvaSelecionada) { %>
              <p class="panel-subtitle" style="margin: 0 0 0.75rem; font-size: 0.8rem;">Prova selecionada: <strong><%= provaAtivaAtual.subProvaSelecionada.nomeProva %></strong> — <%= provaAtivaAtual.subProvaSelecionada.descricao %></p>
            <% } %>

            <ul class="chave-equipes-list">
              <% (atletasExibidos || []).forEach((atleta, index) => { %>
                <li class="chave-equipe-item">
                  <span><span class="chave-equipe-pos">#<%= index + 1 %></span> <%= atleta.nomeAtleta || atleta.nome %></span>
                  <% if (Number(atleta.pontosAtletismo || 0) > 0) { %>
                    <span class="chave-equipe-pontos"><%= Number(atleta.pontosAtletismo) %> pts</span>
                  <% } %>
                  <span class="item-subtext"><%= atleta.nomeCampus || atleta.campus || 'Campus não informado' %></span>
                </li>
              <% }) %>
              <% if(!atletasExibidos || atletasExibidos.length === 0) { %>
                <li class="feedback-empty">Sem atletas inscritos nesta prova.</li>
              <% } %>
            </ul>
            <% } %>
          </div>
        </div>

      <% } else if (modalidadeAtiva.categoria === 'xadrez') { %>
        <h2>Chaveamento Inicial — Sistema Suíço</h2>
        <p class="panel-subtitle" style="margin-bottom: 1.5rem;">Lista Geral de Enxadristas aptos para o pareamento das rodadas.</p>
        
        <div class="chave-card" style="max-width: 100%;">
          <div class="chave-title">♟️ Tabela de Mestres Inscritos</div>
          <ul class="chave-equipes-list">
            <% inscritosPendentes.forEach((enxadrista, index) => { %>
              <li class="chave-equipe-item">
                <span><span class="chave-equipe-pos"><%= index + 1 %>º</span> <strong><%= enxadrista.nomeAtleta %></strong> (<%= enxadrista.nomeCampus %>)</span>
                <span class="chave-equipe-pontos"><%= enxadrista.pontuacaoAtual || '0.0' %> pts</span>
              </li>
            <% }) %>
          </ul>
        </div>

      <% } else { %>
        <div class="chaveamento-visualizacao">
          <aside class="painel-tabela">
            <h2>Tabela de Grupos</h2>

        <% if (chavesGeradas && chavesGeradas.length > 0) { %>
          <div class="chaves-container">
            <% chavesGeradas.forEach((chave) => { %>
              <div class="chave-card">
                <div class="chave-title">Chave <%= chave.letra %></div>
                <ul class="chave-equipes-list">
                  <% chave.integrantes.forEach((equipe, idx) => { %>
                    <li class="chave-equipe-item">
                      <div>
                        <span class="chave-equipe-pos"><%= idx + 1 %></span>
                        <% if (subCategoriaAtiva === 'individual') { %>
                          <span><%= equipe.nomeAtleta %> <small style="color:rgba(255,255,255,0.5);">(<%= equipe.nomeCampus %> - <%= equipe.numeroInscrito %>)</small></span>
                        <% } else { %>
                          <span><%= equipe.nomeCampus %></span>
                        <% } %>
                      </div>
                      <span class="chave-equipe-pontos"><%= equipe.pontosFaseDeGrupos || 0 %> Pts</span>
                    </li>
                  <% }) %>
                </ul>
              </div>
            <% }) %>
          </div>
        <% } else if (inscritosPendentes && inscritosPendentes.length > 0) { %>
          <div class="welcome-card" style="padding: 2rem;">
            <h3 style="margin: 0 0 1rem;">Inscrições Confirmadas</h3>
            <% if (isIndividualModalidade) { %>
              <p style="margin-bottom: 1rem; color: rgba(255,255,255,0.7);">Atletas já inscritos nesta modalidade estão disponíveis para análise. O sorteio será gerado na data agendada.</p>
            <% } else { %>
              <p style="margin-bottom: 1rem; color: rgba(255,255,255,0.7);">Campi já inscritos nesta modalidade estão disponíveis para análise. O sorteio será gerado na data agendada.</p>
            <% } %>
            <ul class="chave-equipes-list">
              <% inscritosPendentes.forEach((inscrito, idx) => { %>
                <li class="chave-equipe-item">
                  <div>
                    <span class="chave-equipe-pos"><%= idx + 1 %></span>
                    <% if (isIndividualModalidade) { %>
                      <span><%= inscrito.nomeAtleta || inscrito.nome || 'Atleta não identificado' %></span>
                      <span class="item-subtext"><%= inscrito.nomeCampus || inscrito.campus || 'Campus não informado' %></span>
                    <% } else { %>
                      <span><%= inscrito.nomeCampus || inscrito.nome || 'Campus não identificado' %></span>
                    <% } %>
                  </div>
                </li>
              <% }) %>
            </ul>
          </div>
        <% } else { %>
          <div class="welcome-card" style="padding: 2rem;">
            <p>O chaveamento desta categoria ainda não foi gerado pelo sistema.</p>
            <p style="font-size: 0.85rem; color: rgba(255,255,255,0.4); margin-top: 0.5rem;">Clique no botão superior "Realizar Sorteio Dinâmico" para rodar a distribuição automática.</p>
          </div>
        <% } %>
        </aside>
        <div class="painel-jogos">

      <% const temEliminatoria = typeof fasesEliminatoria !== 'undefined' && fasesEliminatoria && fasesEliminatoria.length > 0; %>
      <% if ((rodadasJogos && rodadasJogos.length > 0) || temEliminatoria) { %>
        <div class="match-carousel-wrapper" id="match-carousel-<%= modalidadeAtiva.id %>" style="margin-top: 0;">
          <div class="match-carousel-header">
            <h2 style="margin: 0;">Confrontos por rodada</h2>
            <div class="round-pills">
              <% if (rodadasJogos && rodadasJogos.length > 0) { %>
                <% rodadasJogos.forEach((rodada, index) => { %>
                  <button type="button" class="round-pill <%= index === 0 ? 'active' : '' %>" data-slide-index="<%= index %>"><%= index + 1 %>ª Rodada</button>
                <% }) %>
              <% } %>
              <% if (temEliminatoria) { %>
                <button type="button" class="round-pill <%= !(rodadasJogos && rodadasJogos.length > 0) ? 'active' : '' %>" data-slide-index="<%= rodadasJogos ? rodadasJogos.length : 0 %>">Eliminatória</button>
              <% } %>
            </div>
          </div>

          <div class="match-carousel">
            <% rodadasJogos.forEach((rodada, index) => { %>
              <section class="match-slide <%= index === 0 ? 'active' : '' %>" data-slide-index="<%= index %>">
                <div class="game-grid">
                  <% rodada.jogos.forEach((jogo) => { %>
                    <article class="game-card admin-game-card">
                      <div class="agc-meta">
                        <span><%= jogo.data %> · <%= jogo.horario %></span>
                        <span class="agc-chave">Chave <%= typeof jogo.chaveLabel !== 'undefined' && jogo.chaveLabel ? jogo.chaveLabel : '—' %></span>
                      </div>
                      <div class="agc-confronto">
                        <span class="agc-nome"><%= jogo.tipoIndividual ? jogo.atletaCasa : jogo.casa %></span>
                        <span class="agc-placar <%= jogo.placar ? 'com-placar' : '' %>"><%= jogo.placar || 'vs' %></span>
                        <span class="agc-nome"><%= jogo.tipoIndividual ? jogo.atletaFora : jogo.fora %></span>
                      </div>
                      <form action="/admin/chaveamento/jogo/<%= jogo.id %>/salvar" method="POST" class="agc-form">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="agc-campos">
                          <% if (Array.isArray(datasEventoDisponiveis) && datasEventoDisponiveis.length) { %>
                            <% const dataPadrao = jogo.dataInput && datasEventoDisponiveis.includes(jogo.dataInput)
                              ? jogo.dataInput
                              : datasEventoDisponiveis[0]; %>
                            <label>
                              <span>Data</span>
                              <select name="dataJogo">
                                <% datasEventoDisponiveis.forEach((data) => { %>
                                  <option value="<%= data %>" <%= dataPadrao === data ? 'selected' : '' %>><%= data.split('-').reverse().join('/') %></option>
                                <% }) %>
                              </select>
                            </label>
                          <% } else { %>
                            <label>
                              <span>Data</span>
                              <input type="date" name="dataJogo" value="<%= jogo.dataInput || '' %>">
                            </label>
                          <% } %>
                          <label>
                            <span>Horário</span>
                            <input type="time" name="horarioJogo" value="<%= jogo.horarioInput || '' %>">
                          </label>
                          <label>
                            <span>Local</span>
                            <input type="text" name="localJogo" value="<%= jogo.localJogo || 'A definir' %>">
                          </label>
                        </div>
                        <button class="btn btn-secondary agc-salvar" type="submit">Salvar</button>
                      </form>
                    </article>
                  <% }) %>
                </div>
              </section>
            <% }) %>
            <% if (temEliminatoria) { %>
              <section class="match-slide <%= !(rodadasJogos && rodadasJogos.length > 0) ? 'active' : '' %>" data-slide-index="<%= rodadasJogos ? rodadasJogos.length : 0 %>">
                <% fasesEliminatoria.forEach((fase) => { %>
                  <h3 style="margin: 0.25rem 0 0.75rem; font-size: 1rem;"><%= fase.fase %></h3>
                  <div class="game-grid" style="margin-bottom: 1.5rem;">
                    <% fase.jogos.forEach((jogo) => { %>
                      <% const dhKo = jogo.data_hora ? new Date(jogo.data_hora) : null;
                         const dataInputKo2 = dhKo ? `${dhKo.getFullYear()}-${String(dhKo.getMonth() + 1).padStart(2, '0')}-${String(dhKo.getDate()).padStart(2, '0')}` : '';
                         const horarioInputKo = dhKo ? `${String(dhKo.getHours()).padStart(2, '0')}:${String(dhKo.getMinutes()).padStart(2, '0')}` : '';
                         const nomeCasaKo = jogo.campus_1_nome || jogo.atleta_1_nome || null;
                         const nomeForaKo = jogo.campus_2_nome || jogo.atleta_2_nome || null; %>
                      <article class="game-card admin-game-card">
                        <div class="agc-meta">
                          <span>#<%= jogo.numero_jogo %> · <%= jogo.status || 'Agendado' %></span>
                          <span class="agc-chave"><%= fase.fase %></span>
                        </div>
                        <div class="agc-confronto">
                          <span class="agc-nome"><%= nomeCasaKo || jogo.rotulo_casa || 'A definir' %></span>
                          <span class="agc-placar">vs</span>
                          <span class="agc-nome"><%= nomeForaKo || jogo.rotulo_fora || 'A definir' %></span>
                        </div>
                        <form action="/admin/chaveamento/jogo/<%= jogo.id %>/salvar" method="POST" class="agc-form">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <div class="agc-campos">
                            <% if (Array.isArray(datasEventoDisponiveis) && datasEventoDisponiveis.length) { %>
                              <% const dataPadraoKo = dataInputKo2 && datasEventoDisponiveis.includes(dataInputKo2) ? dataInputKo2 : datasEventoDisponiveis[0]; %>
                              <label>
                                <span>Data</span>
                                <select name="dataJogo">
                                  <% datasEventoDisponiveis.forEach((data) => { %>
                                    <option value="<%= data %>" <%= dataPadraoKo === data ? 'selected' : '' %>><%= data.split('-').reverse().join('/') %></option>
                                  <% }) %>
                                </select>
                              </label>
                            <% } else { %>
                              <label>
                                <span>Data</span>
                                <input type="date" name="dataJogo" value="<%= dataInputKo2 %>">
                              </label>
                            <% } %>
                            <label>
                              <span>Horário</span>
                              <input type="time" name="horarioJogo" value="<%= horarioInputKo %>">
                            </label>
                            <label>
                              <span>Local</span>
                              <input type="text" name="localJogo" value="<%= jogo.local_jogo || 'A definir' %>">
                            </label>
                          </div>
                          <button class="btn btn-secondary agc-salvar" type="submit">Salvar</button>
                        </form>
                      </article>
                    <% }) %>
                  </div>
                <% }) %>
              </section>
            <% } %>
          </div>

          <script>
            (function () {
              const wrapper = document.getElementById('match-carousel-<%= modalidadeAtiva.id %>');
              if (!wrapper) return;

              const slides = Array.from(wrapper.querySelectorAll('.match-slide'));
              const pills = Array.from(wrapper.querySelectorAll('.round-pill'));
              let activeIndex = 0;

              function mostrarSlide(index) {
                activeIndex = (index + slides.length) % slides.length;
                slides.forEach((slide, slideIndex) => {
                  slide.classList.toggle('active', slideIndex === activeIndex);
                });
                pills.forEach((pill, pillIndex) => {
                  pill.classList.toggle('active', pillIndex === activeIndex);
                });
              }

              pills.forEach((pill) => {
                pill.addEventListener('click', () => {
                  mostrarSlide(Number(pill.dataset.slideIndex || 0));
                });
              });
            })();
          </script>
        </div>
      <% } %>
        </div>
      </div>
      <% } %>

    </main>

  </div>
  <% } %>
</section>