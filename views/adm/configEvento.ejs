<div class="profile-shell">
  <div class="profile-card--wide configuration-dashboard">
    
    <div class="config-dashboard-header">
      <h1 class="config-main-title">Configurações Gerais do Evento</h1>
      <p class="config-main-subtitle">
        Controle prazos críticos, limites operacionais por delegação e o catálogo de modalidades oficiais do JIFC.
      </p>
    </div>

    <% if (typeof mensagemErro !== 'undefined' && mensagemErro) { %>
      <div style="background: rgba(255, 77, 77, 0.1); border: 1px solid #ff4d4d; color: #ff4d4d; padding: 1rem; border-radius: 12px; margin-bottom: 1rem; font-weight: 600;">
        <%= mensagemErro %>
      </div>
    <% } %>

    <% if (typeof mensagemSucesso !== 'undefined' && mensagemSucesso) { %>
      <div style="background: rgba(0, 255, 136, 0.1); border: 1px solid #00ff88; color: #00ff88; padding: 1rem; border-radius: 12px; margin-bottom: 1rem; font-weight: 600;">
        <%= mensagemSucesso %>
      </div>
    <% } %>

    <form action="/admin/configurar/salvar" method="POST" class="modern-config-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      
      <div class="inner-management-card">
        <div class="card-context-header">
          <div>
            <h2 class="context-title">Duração Oficial</h2>
            <p class="context-subtitle">Defina o intervalo de realização dos jogos no calendário.</p>
          </div>
        </div>
        
        <div class="management-fields-row split-2">
          <label class="premium-input-wrapper">
            <span class="field-label-text">Data de Início do Evento</span>
            <input type="date" class="premium-date-input" name="inicio_evento" value="<%= (typeof configuracoes !== 'undefined' && configuracoes.inicio_evento) ? configuracoes.inicio_evento : '' %>" required>
          </label>
          <label class="premium-input-wrapper">
            <span class="field-label-text">Data de Término do Evento</span>
            <input type="date" class="premium-date-input" name="fim_evento" value="<%= (typeof configuracoes !== 'undefined' && configuracoes.fim_evento) ? configuracoes.fim_evento : '' %>" required>
          </label>
        </div>
      </div>

      <div class="inner-management-card">
        <div class="card-context-header">
          <div>
            <h2 class="context-title">Prazos de Inscrições e Processos</h2>
            <p class="context-subtitle">Gerencie as janelas de tempo permitidas para cada etapa do sistema.</p>
          </div>
        </div>
        
        <div class="management-fields-row split-2">
          <label class="premium-input-wrapper">
            <span class="field-label-text">Abertura (Inscrição de Modalidades)</span>
            <input type="date" class="premium-date-input" name="inicioInscricoesModalidades" value="<%= (typeof configuracoes !== 'undefined' && configuracoes.inicio_inscricao_modalidades) ? configuracoes.inicio_inscricao_modalidades : '' %>" required>
          </label>
          <label class="premium-input-wrapper">
            <span class="field-label-text">Fechamento (Inscrição de Modalidades)</span>
            <input type="date" class="premium-date-input" name="fimInscricoesModalidades" value="<%= (typeof configuracoes !== 'undefined' && configuracoes.fim_inscricao_modalidades) ? configuracoes.fim_inscricao_modalidades : '' %>" required>
          </label>
        </div>

        <div class="management-fields-row split-2" style="margin-top: 1.25rem;">
          <label class="premium-input-wrapper">
            <span class="field-label-text">Abertura (Inscrição de Atletas)</span>
            <input type="date" class="premium-date-input" name="inicioInscricoesAtletas" value="<%= (typeof configuracoes !== 'undefined' && configuracoes.inicio_inscricao_atletas) ? configuracoes.inicio_inscricao_atletas : '' %>" required>
          </label>
          <label class="premium-input-wrapper">
            <span class="field-label-text">Fechamento (Inscrição de Atletas)</span>
            <input type="date" class="premium-date-input" name="fimInscricoesAtletas" value="<%= (typeof configuracoes !== 'undefined' && configuracoes.fim_inscricao_atletas) ? configuracoes.fim_inscricao_atletas : '' %>" required>
          </label>
        </div>

        <div class="management-fields-row split-2" style="margin-top: 1.25rem;">
          <label class="premium-input-wrapper">
            <span class="field-label-text">Início do Sorteio de Chaves</span>
            <input type="date" class="premium-date-input" name="inicioSorteio" value="<%= (typeof configuracoes !== 'undefined' && configuracoes.inicio_sorteio_chaves) ? configuracoes.inicio_sorteio_chaves : '' %>" required>
          </label>
          <label class="premium-input-wrapper">
            <span class="field-label-text">Fim do Sorteio de Chaves</span>
            <input type="date" class="premium-date-input" name="fimSorteio" value="<%= (typeof configuracoes !== 'undefined' && configuracoes.fim_sorteio_chaves) ? configuracoes.fim_sorteio_chaves : '' %>" required>
          </label>
        </div>
      </div>

      <div class="inner-management-card">
        <div class="card-context-header">
          <div>
            <h2 class="context-title">Restrições Gerais do Campus</h2>
            <p class="context-subtitle">Definição do limite máximo de participantes que um campus pode enviar no total.</p>
          </div>
        </div>
        
        <div class="management-fields-row">
          <label class="premium-input-wrapper" style="width: 100%;">
            <span class="field-label-text">Quantidade Total Máxima da Delegação (Todos os esportes somados)</span>
            <input type="number" class="premium-number-input" name="limite_atletas_total_campus" min="1" value="<%= (typeof configuracoes !== 'undefined' && configuracoes.limite_atletas_total_campus) ? configuracoes.limite_atletas_total_campus : 0 %>" placeholder="Ex: 50 atletas no total" required>
          </label>
        </div>
      </div>

      <div class="config-submit-bar">
        <button type="submit" class="premium-action-btn primary-save-btn">
          <span>Gravar Parâmetros Globais</span>
        </button>
      </div>
    </form>

    <div class="inner-management-card isolated-module">
      <div class="card-context-header">
        <div>
          <h2 class="context-title">Gerenciar Catálogo de Esportes</h2>
          <p class="context-subtitle">Cadastre novos esportes oficiais e remova aqueles que não fazem parte do JIFC.</p>
        </div>
      </div>

      <form action="/admin/modalidades/cadastrar" method="POST" class="clean-register-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="dynamic-registration-flow">
          <div class="flow-element input-container">
            <span class="field-label-text">Nome do Esporte</span>
            <input type="text" name="nome_modalidade" class="premium-text-input" placeholder="Ex: Badminton" required>
          </div>

          <div class="flow-element input-container">
            <span class="field-label-text">Gênero</span>
            <select name="genero_modalidade" class="premium-text-input" required>
              <option value="">Selecione</option>
              <option value="Masculino">Masculino</option>
              <option value="Feminino">Feminino</option>
              <option value="Misto">Misto</option>
            </select>
          </div>

          <div class="flow-element input-container">
            <span class="field-label-text">Tipo de Esporte</span>
            <select name="tipo_confronto" class="premium-text-input" required>
              <option value="">Selecione</option>
              <option value="Coletivo">Coletivo</option>
              <option value="Individual">Individual</option>
            </select>
          </div>

          <div class="flow-element input-container" style="flex: 1 1 100%;">
            <span class="field-label-text">Upload de imagem da modalidade</span>
            <input type="file" id="iconeModalidadeInput" accept="image/*" class="hidden-input-state">
            <label for="iconeModalidadeInput" class="premium-upload-btn">Escolher arquivo</label>
            <input type="hidden" name="icone_modalidade_data" id="iconeModalidadeValue">
          </div>

          <div class="flow-element button-container">
            <button type="submit" class="premium-action-btn addition-btn">
              <span>+ Adicionar</span>
            </button>
          </div>
        </div>
      </form>

      <% if (typeof modalidades !== 'undefined' && modalidades && modalidades.length) { %>
        <div style="margin-top: 1.25rem; display: grid; gap: 0.65rem;">
          <% modalidades.forEach((modalidade) => { %>
            <div style="display:flex; justify-content:space-between; align-items:center; gap:1rem; padding:0.75rem 0.9rem; border:1px solid rgba(255,255,255,0.08); border-radius:12px; background:rgba(255,255,255,0.03); flex-wrap:wrap;">
              <div style="display:flex; align-items:center; gap:0.8rem;">
                <img src="<%= modalidade.icone && (modalidade.icone.startsWith('/') || modalidade.icone.startsWith('http')) ? modalidade.icone : (modalidade.imagem || '/imagens/atletismo1.svg') %>" alt="Ícone <%= modalidade.nome %>" class="sport-icon" style="width: 36px; height: 36px; border-radius: 50%; border: 1px solid rgba(255,255,255,0.08);">
                <div>
                  <strong style="display:block; color:#fff;"><%= modalidade.nome %></strong>
                  <span style="font-size:0.8rem; color:rgba(255,255,255,0.7);"><%= modalidade.genero %> • <%= modalidade.tipo_confronto %></span>
                </div>
              </div>
              <form action="/admin/modalidades/excluir/<%= modalidade.id %>" method="POST" onsubmit="return confirm('Deseja remover este esporte do catálogo?');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-danger" style="padding:0.45rem 0.7rem; font-size:0.82rem;">Excluir</button>
              </form>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="panel-subtitle" style="margin-top:1rem;">Nenhum esporte cadastrado ainda.</p>
      <% } %>
    </div>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const fileInput = document.getElementById('iconeModalidadeInput');
    const hiddenField = document.getElementById('iconeModalidadeValue');

    if (fileInput && hiddenField) {
      fileInput.addEventListener('change', function () {
        const [file] = this.files || [];
        if (!file) {
          hiddenField.value = '';
          return;
        }

        if (!file.type || !file.type.startsWith('image/')) {
          this.value = '';
          hiddenField.value = '';
          return;
        }

        const reader = new FileReader();
        reader.onload = function () {
          hiddenField.value = String(reader.result || '');
        };
        reader.readAsDataURL(file);
      });
    }
  });
</script>