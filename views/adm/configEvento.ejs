<div class="profile-shell">
  <div class="profile-card--wide configuration-dashboard">
    
    <div class="config-dashboard-header">
      <h1 class="config-main-title">Configurações Gerais do Evento</h1>
      <p class="config-main-subtitle">
        Controle prazos críticos, limites operacionais por delegação e o catálogo de modalidades oficiais do JIFC.
      </p>
    </div>

    <% if (typeof mensagemErro !== 'undefined' && mensagemErro) { %>
      <div class="auto-dismiss" style="background: rgba(255, 77, 77, 0.1); border: 1px solid #ff4d4d; color: #ff4d4d; padding: 1rem; border-radius: 12px; margin-bottom: 1rem; font-weight: 600;">
        <%= mensagemErro %>
      </div>
    <% } %>

    <% if (typeof mensagemSucesso !== 'undefined' && mensagemSucesso) { %>
      <div class="auto-dismiss" style="background: rgba(0, 255, 136, 0.1); border: 1px solid #00ff88; color: #00ff88; padding: 1rem; border-radius: 12px; margin-bottom: 1rem; font-weight: 600;">
        <%= mensagemSucesso %>
      </div>
    <% } %>

    <form action="/admin/configurar/salvar" method="POST" class="modern-config-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      
      <div class="inner-management-card">
        <div class="card-context-header">
          <div>
            <h2 class="context-title">Duração Oficial</h2>
          </div>
        </div>
        
        <div class="management-fields-row split-2">
          <label class="premium-input-wrapper">
            <span class="field-label-text">Data de Início do Evento</span>
            <input type="date" class="premium-date-input" name="inicio_evento" value="<%= (typeof configuracoes !== 'undefined' && configuracoes.inicio_evento) ? configuracoes.inicio_evento : '' %>" required>
          </label>
          <label class="premium-input-wrapper">
            <span class="field-label-text">Data de Término do Evento</span>
            <input type="date" class="premium-date-input" name="fim_evento" value="<%= (typeof configuracoes !== 'undefined' && configuracoes.fim_evento) ? configuracoes.fim_evento : '' %>" required>
          </label>
        </div>
      </div>

      <div class="inner-management-card">
        <div class="card-context-header">
          <div>
            <h2 class="context-title">Prazos de Inscrições e Processos</h2>
          </div>
        </div>
        
        <div class="management-fields-row split-2">
          <label class="premium-input-wrapper">
            <span class="field-label-text">Abertura (Inscrição de Modalidades)</span>
            <input type="date" class="premium-date-input" name="inicioInscricoesModalidades" value="<%= (typeof configuracoes !== 'undefined' && configuracoes.inicio_inscricao_modalidades) ? configuracoes.inicio_inscricao_modalidades : '' %>" required>
          </label>
          <label class="premium-input-wrapper">
            <span class="field-label-text">Fechamento (Inscrição de Modalidades)</span>
            <input type="date" class="premium-date-input" name="fimInscricoesModalidades" value="<%= (typeof configuracoes !== 'undefined' && configuracoes.fim_inscricao_modalidades) ? configuracoes.fim_inscricao_modalidades : '' %>" required>
          </label>
        </div>

        <div class="management-fields-row split-2" style="margin-top: 1.25rem;">
          <label class="premium-input-wrapper">
            <span class="field-label-text">Abertura (Inscrição de Atletas)</span>
            <input type="date" class="premium-date-input" name="inicioInscricoesAtletas" value="<%= (typeof configuracoes !== 'undefined' && configuracoes.inicio_inscricao_atletas) ? configuracoes.inicio_inscricao_atletas : '' %>" required>
          </label>
          <label class="premium-input-wrapper">
            <span class="field-label-text">Fechamento (Inscrição de Atletas)</span>
            <input type="date" class="premium-date-input" name="fimInscricoesAtletas" value="<%= (typeof configuracoes !== 'undefined' && configuracoes.fim_inscricao_atletas) ? configuracoes.fim_inscricao_atletas : '' %>" required>
          </label>
        </div>

        <div class="management-fields-row split-2" style="margin-top: 1.25rem;">
          <label class="premium-input-wrapper">
            <span class="field-label-text">Abertura (Substituição de Atletas)</span>
            <input type="date" class="premium-date-input" name="inicioSubstituicaoAtletas" value="<%= (typeof configuracoes !== 'undefined' && configuracoes.inicio_substituicao_atletas) ? configuracoes.inicio_substituicao_atletas : '' %>">
          </label>
          <label class="premium-input-wrapper">
            <span class="field-label-text">Fechamento (Substituição de Atletas)</span>
            <input type="date" class="premium-date-input" name="fimSubstituicaoAtletas" value="<%= (typeof configuracoes !== 'undefined' && configuracoes.fim_substituicao_atletas) ? configuracoes.fim_substituicao_atletas : '' %>">
          </label>
        </div>

        <div class="management-fields-row split-2" style="margin-top: 1.25rem;">
          <label class="premium-input-wrapper">
            <span class="field-label-text">Início do Sorteio de Chaves</span>
            <input type="date" class="premium-date-input" name="inicioSorteio" value="<%= (typeof configuracoes !== 'undefined' && configuracoes.inicio_sorteio_chaves) ? configuracoes.inicio_sorteio_chaves : '' %>" required>
          </label>
          <label class="premium-input-wrapper">
            <span class="field-label-text">Fim do Sorteio de Chaves</span>
            <input type="date" class="premium-date-input" name="fimSorteio" value="<%= (typeof configuracoes !== 'undefined' && configuracoes.fim_sorteio_chaves) ? configuracoes.fim_sorteio_chaves : '' %>" required>
          </label>
        </div>
      </div>

      <div class="inner-management-card">
        <div class="card-context-header">
          <div>
            <h2 class="context-title">Restrições Gerais do Campus</h2>
          </div>
        </div>
        
        <div class="management-fields-row">
          <label class="premium-input-wrapper" style="width: 100%;">
            <span class="field-label-text">Quantidade Total Máxima da Delegação (Todos os esportes somados)</span>
            <input type="number" class="premium-number-input" name="limite_atletas_total_campus" min="1" value="<%= (typeof configuracoes !== 'undefined' && configuracoes.limite_atletas_total_campus) ? configuracoes.limite_atletas_total_campus : 0 %>" placeholder="Ex: 50 atletas no total" required>
          </label>
        </div>
      </div>

      <div class="config-submit-bar">
        <button type="submit" class="premium-action-btn primary-save-btn">
          <span>Gravar Parâmetros Globais</span>
        </button>
      </div>
    </form>

    <div class="inner-management-card isolated-module">
      <div class="card-context-header">
        <div>
          <h2 class="context-title">Gerenciar Catálogo de Esportes</h2>
        </div>
      </div>

      <form action="/admin/modalidades/cadastrar" method="POST" class="clean-register-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="dynamic-registration-flow">
          <div class="flow-element input-container">
            <span class="field-label-text">Nome do Esporte</span>
            <input type="text" name="nome_modalidade" class="premium-text-input" placeholder="Ex: Fut7" required>
          </div>

          <div class="flow-element input-container">
            <span class="field-label-text">Gênero</span>
            <select name="genero_modalidade" class="premium-text-input" required>
              <option value="">Selecione</option>
              <option value="Masculino">Masculino</option>
              <option value="Feminino">Feminino</option>
              <option value="Misto">Misto</option>
            </select>
          </div>

          <div class="flow-element input-container">
            <span class="field-label-text">Tipo de Esporte</span>
            <select name="tipo_confronto" class="premium-text-input" required>
              <option value="">Selecione</option>
              <option value="Coletivo">Coletivo</option>
              <option value="Individual">Individual</option>
            </select>
          </div>

          <div style="flex: 1 1 100%; border: 1px solid rgba(255,255,255,0.12); border-radius: 14px; padding: 1.25rem 1.25rem 1.4rem; margin-top: 0.75rem; background: radial-gradient(circle at top, rgba(255,255,255,0.05), transparent), linear-gradient(180deg, rgba(255,255,255,0.02) 0%, rgba(255,255,255,0.01) 100%); box-shadow: 0 18px 40px -28px rgba(255,255,255,0.4);">
            <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; flex-wrap:wrap; margin-bottom:1rem;">
              <div>
                <strong style="color: var(--text); font-size: 1rem; display:block;">Regras do esporte</strong>
                <span style="font-size:0.88rem; color:rgba(255,255,255,0.65); display:block; margin-top:0.25rem;">Defina como esse esporte vai funcionar. Opcional — se não preencher, o sistema usa o padrão por nome.</span>
              </div>
              <span style="display:inline-flex; align-items:center; gap:0.4rem; padding:0.35rem 0.7rem; border-radius:999px; border:1px solid rgba(255,255,255,0.16); font-size:0.82rem; color:rgba(255,255,255,0.8);">Configuração avançada</span>
            </div>
            <div class="dynamic-registration-flow" style="gap:1rem; align-items:stretch;">
              <div class="flow-element input-container" style="flex:1 1 260px;">
                <span class="field-label-text">Tipo de apuração</span>
                <select name="tipo_apuracao" class="premium-text-input" style="color:#fff;">
                  <option value="" style="color:#000;">Padrão</option>
                  <option value="gols" style="color:#000;">Por gols/placar</option>
                  <option value="pontos" style="color:#000;">Por pontos</option>
                  <option value="sets" style="color:#000;">Por sets</option>
                  <option value="medida" style="color:#000;">Por resultado individual (tempo/distância)</option>
                  <option value="pontuacao_individual" style="color:#000;">Por pontuação individual</option>
                </select>
              </div>
              <div class="flow-element input-container" style="flex:1 1 240px;">
                <span class="field-label-text">Padrão da eliminatória</span>
                <select name="padrao_eliminatoria" class="premium-text-input" style="color:#fff;">
                  <option value="alternado" style="color:#000;">Alternado (mando alternado)</option>
                  <option value="sequencial" style="color:#000;">Sequencial (mesmo lado)</option>
                </select>
              </div>
              <div class="flow-element input-container" style="flex:1 1 220px; display:flex; flex-direction:column; gap:0.6rem;">
                <span class="field-label-text">Regras extras</span>
                <label style="display:flex; align-items:center; gap:0.6rem; padding:0.6rem 0.8rem; border-radius:10px; border:1px solid rgba(255,255,255,0.14); background:rgba(255,255,255,0.01); color:#fff; cursor:pointer;">
                  <input type="checkbox" name="usa_sets" value="1" style="accent-color: var(--primary);"> Usa sets (divide em sets)
                </label>
                <label style="display:flex; align-items:center; gap:0.6rem; padding:0.6rem 0.8rem; border-radius:10px; border:1px solid rgba(255,255,255,0.14); background:rgba(255,255,255,0.01); color:#fff; cursor:pointer;">
                  <input type="checkbox" name="usa_cartoes" value="1" style="accent-color: var(--primary);"> Usa cartões/sanções
                </label>
              </div>
              <div class="flow-element input-container" style="flex:1 1 200px;">
                <span class="field-label-text">Pontos por vitória</span>
                <input type="number" name="pontos_vitoria" class="premium-text-input" value="3" min="0" style="color:#fff;">
              </div>
              <div class="flow-element input-container" style="flex:1 1 200px;">
                <span class="field-label-text">Pontos por empate</span>
                <input type="number" name="pontos_empate" class="premium-text-input" value="1" min="0" style="color:#fff;">
              </div>
              <div class="flow-element input-container" style="flex:1 1 200px;">
                <span class="field-label-text">Pontos por derrota</span>
                <input type="number" name="pontos_derrota" class="premium-text-input" value="0" min="0" style="color:#fff;">
              </div>
              <div class="flow-element input-container" style="flex:1 1 100%;">
                <span class="field-label-text">Critérios de desempate</span>
                <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap:0.7rem; padding:0.9rem 1rem; border-radius:12px; border:1px solid rgba(255,255,255,0.14); background:rgba(15,15,20,0.9);">
                  <label style="display:flex; align-items:center; gap:0.6rem; color:#fff; cursor:pointer;">
                    <input type="checkbox" name="criterios_desempate" value="pontos" checked style="accent-color: var(--primary);"> Pontos
                  </label>
                  <label style="display:flex; align-items:center; gap:0.6rem; color:#fff; cursor:pointer;">
                    <input type="checkbox" name="criterios_desempate" value="confronto_direto" checked style="accent-color: var(--primary);"> Confronto direto
                  </label>
                  <label style="display:flex; align-items:center; gap:0.6rem; color:#fff; cursor:pointer;">
                    <input type="checkbox" name="criterios_desempate" value="vitorias" checked style="accent-color: var(--primary);"> Vitórias
                  </label>
                  <label style="display:flex; align-items:center; gap:0.6rem; color:#fff; cursor:pointer;">
                    <input type="checkbox" name="criterios_desempate" value="saldo_gols" checked style="accent-color: var(--primary);"> Saldo de gols/pontos
                  </label>
                  <label style="display:flex; align-items:center; gap:0.6rem; color:#fff; cursor:pointer;">
                    <input type="checkbox" name="criterios_desempate" value="maior_gols_feitos" style="accent-color: var(--primary);"> Maior gols/feitos
                  </label>
                  <label style="display:flex; align-items:center; gap:0.6rem; color:#fff; cursor:pointer;">
                    <input type="checkbox" name="criterios_desempate" value="menor_gols_sofridos" style="accent-color: var(--primary);"> Menor sofridos
                  </label>
                  <label style="display:flex; align-items:center; gap:0.6rem; color:#fff; cursor:pointer;">
                    <input type="checkbox" name="criterios_desempate" value="sets_average" style="accent-color: var(--primary);"> Sets average (se usa sets)
                  </label>
                  <label style="display:flex; align-items:center; gap:0.6rem; color:#fff; cursor:pointer;">
                    <input type="checkbox" name="criterios_desempate" value="pontos_average" style="accent-color: var(--primary);"> Pontos average (se usa sets)
                  </label>
                  <label style="display:flex; align-items:center; gap:0.6rem; color:#fff; cursor:pointer;">
                    <input type="checkbox" name="criterios_desempate" value="menor_cartoes_vermelhos" style="accent-color: var(--primary);"> Menor cartões vermelhos
                  </label>
                  <label style="display:flex; align-items:center; gap:0.6rem; color:#fff; cursor:pointer;">
                    <input type="checkbox" name="criterios_desempate" value="menor_cartoes_amarelos" style="accent-color: var(--primary);"> Menor cartões amarelos
                  </label>
                  <label style="display:flex; align-items:center; gap:0.6rem; color:#fff; cursor:pointer;">
                    <input type="checkbox" name="criterios_desempate" value="sancoes" style="accent-color: var(--primary);"> Sanções (total)
                  </label>
                  <label style="display:flex; align-items:center; gap:0.6rem; color:#fff; cursor:pointer;">
                    <input type="checkbox" name="criterios_desempate" value="sorteio" checked style="accent-color: var(--primary);"> Sorteio
                  </label>
                </div>
                <small style="color:rgba(255,255,255,0.6);">Pode marcar um ou vários. A ordem é definida pela lista acima.</small>
              </div>
            </div>
          </div>

          <div class="flow-element input-container">
            <span class="field-label-text">Limite de atletas por campus</span>
            <input type="number" name="limite_inscritos" class="premium-number-input" min="1" placeholder="Sem limite">
          </div>

          <div class="flow-element input-container" style="flex: 1 1 100%;">
            <span class="field-label-text">Upload de imagem da modalidade</span>
            <input type="file" id="iconeModalidadeInput" accept="image/*" class="hidden-input-state">
            <label for="iconeModalidadeInput" class="premium-upload-btn">Escolher arquivo</label>
            <input type="hidden" name="icone_modalidade_data" id="iconeModalidadeValue">
          </div>

          <div class="flow-element button-container">
            <button type="submit" class="premium-action-btn addition-btn">
              <span>+ Adicionar</span>
            </button>
          </div>
        </div>
      </form>

      <% if (typeof modalidades !== 'undefined' && modalidades && modalidades.length) { %>
        <div style="margin-top: 1.25rem; display: grid; gap: 0.65rem;">
          <% modalidades.forEach((modalidade) => { %>
            <div style="display:flex; justify-content:space-between; align-items:center; gap:1rem; padding:0.75rem 0.9rem; border:1px solid rgba(var(--fg-rgb), 0.08); border-radius:12px; background:rgba(var(--fg-rgb), 0.03); flex-wrap:wrap;">
              <div style="display:flex; align-items:center; gap:0.8rem;">
                <img src="<%= modalidade.icone && (modalidade.icone.startsWith('/') || modalidade.icone.startsWith('http')) ? modalidade.icone : (modalidade.imagem || '/imagens/atletismo1.svg') %>" alt="Ícone <%= modalidade.nome %>" class="sport-icon" style="width: 36px; height: 36px; border-radius: 50%; border: 1px solid rgba(var(--fg-rgb), 0.08);">
                <div>
                  <strong style="display:block; color: var(--text);"><%= modalidade.nome %></strong>
                  <span style="font-size:0.8rem; color:rgba(var(--fg-rgb), 0.7);"><%= modalidade.genero %> • <%= modalidade.tipo_confronto %></span>
                </div>
              </div>
              <form action="/admin/modalidades/excluir/<%= modalidade.id %>" method="POST" onsubmit="return confirm('Deseja remover este esporte do catálogo?');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-danger" style="padding:0.45rem 0.7rem; font-size:0.82rem;">Excluir</button>
              </form>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="panel-subtitle" style="margin-top:1rem;">Nenhum esporte cadastrado ainda.</p>
      <% } %>
    </div>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const fileInput = document.getElementById('iconeModalidadeInput');
    const hiddenField = document.getElementById('iconeModalidadeValue');

    if (fileInput && hiddenField) {
      fileInput.addEventListener('change', function () {
        const [file] = this.files || [];
        if (!file) {
          hiddenField.value = '';
          return;
        }

        if (!file.type || !file.type.startsWith('image/')) {
          this.value = '';
          hiddenField.value = '';
          return;
        }

        const reader = new FileReader();
        reader.onload = function () {
          hiddenField.value = String(reader.result || '');
        };
        reader.readAsDataURL(file);
      });
    }
  });
</script>