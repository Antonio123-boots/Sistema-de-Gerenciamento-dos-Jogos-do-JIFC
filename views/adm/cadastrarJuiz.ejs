<div class="profile-shell">
  <div class="profile-card--wide configuration-dashboard">
    <div class="config-dashboard-header">
      <h1 class="config-main-title"><%= juizEdicao ? 'Editar Juiz' : 'Cadastrar Juiz' %></h1>
      <p class="config-main-subtitle"><%= juizEdicao ? 'Altere os dados e os esportes atribuídos.' : 'Preencha os dados e selecione os esportes que o juiz irá apitar.' %></p>
    </div>

    <% if (mensagemErro) { %>
      <div class="alert alert-error"><%= mensagemErro %></div>
    <% } %>

    <form action="<%= juizEdicao ? '/admin/juizes/editar/' + juizEdicao.id : '/admin/juizes/cadastrar' %>" method="POST" class="modern-config-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="inner-management-card">
        <div class="card-context-header">
          <div>
            <h2 class="context-title">Dados pessoais</h2>
            <p class="context-subtitle">Nome, e-mail de login e senha.</p>
          </div>
        </div>

        <div class="management-fields-row split-2">
          <label class="premium-input-wrapper">
            <span class="field-label-text">Nome completo</span>
            <input type="text" name="nome" class="premium-text-input" placeholder="João da Silva" value="<%= juizEdicao ? juizEdicao.nome : '' %>" required>
          </label>
          <label class="premium-input-wrapper">
            <span class="field-label-text">E-mail</span>
            <input type="email" name="email" class="premium-text-input" placeholder="joao@ifc.edu.br" value="<%= juizEdicao ? juizEdicao.email : '' %>" required>
          </label>
        </div>

        <div class="management-fields-row split-2" style="margin-top:1.25rem;">
          <label class="premium-input-wrapper">
            <span class="field-label-text">Senha</span>
            <input type="password" name="senha" class="premium-text-input" placeholder="<%= juizEdicao ? 'Deixe em branco para manter' : 'Senha de acesso' %>" <%= juizEdicao ? '' : 'required' %>>
          </label>
        </div>
      </div>

      <div class="inner-management-card">
        <div class="card-context-header">
          <div>
            <h2 class="context-title">Esporte</h2>
            <p class="context-subtitle">Selecione o esporte que este juiz irá apitar.</p>
          </div>
        </div>

        <% if (esportes && esportes.length) { %>
          <div class="management-fields-row">
            <label class="premium-input-wrapper" style="width:100%;">
              <span class="field-label-text">Esporte</span>
              <select name="esportes" class="premium-text-input" required>
                <option value="">Selecione o esporte</option>
                <% esportes.forEach((esp) => { %>
                  <option value="<%= esp %>" <%= (juizEdicao && juizEdicao.esportes && juizEdicao.esportes.includes(esp)) ? 'selected' : '' %>><%= esp %></option>
                <% }) %>
              </select>
            </label>
          </div>
        <% } else { %>
          <p style="font-size:0.85rem; color:rgba(255,255,255,0.5); margin:0;">Nenhuma modalidade cadastrada no sistema.</p>
        <% } %>
      </div>

      <div class="config-submit-bar" style="justify-content:space-between; gap:1rem;">
        <a href="/admin/juizes" class="premium-action-btn" style="background:rgba(255,255,255,0.12); color:#f8fafc; text-decoration:none;">
          <span>Cancelar</span>
        </a>
        <button type="submit" class="premium-action-btn primary-save-btn">
          <span><%= juizEdicao ? 'Salvar alterações' : 'Cadastrar Juiz' %></span>
        </button>
      </div>
    </form>
  </div>
</div>
