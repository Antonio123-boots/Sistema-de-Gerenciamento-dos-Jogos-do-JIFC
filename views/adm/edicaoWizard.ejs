              <div class="wz-res-grp__head"><span>Chave <%= letraChave %></span></div>
              <div style="overflow-x:auto">
              <table class="wz-table">
                <thead><tr><th>#</th><th>Campus</th><th>Pts</th><th>PJ</th><th>V</th><th>E</th><th>D</th><th>GP</th><th>GC</th><th>SG</th><% if(temSets){ %><th>SG s</th><th>SP s</th><% } %></tr></thead>
                <tbody>
                  <% tabelaPorChave[ci].forEach(function(l){ %>
                  <tr><td><%= l.posicao %></td><td><%= l.campus %></td><td><%= l.pontos %></td><td><%= l.jogos_jogados %></td><td><%= l.vitorias %></td><td><%= l.empates %></td><td><%= l.derrotas %></td><td><%= l.pontos_pro %></td><td><%= l.pontos_contra %></td><td><%= l.saldo_pontuacao %></td><% if(temSets){ %><td><%= l.sets_ganhos %></td><td><%= l.sets_perdidos %></td><% } %></tr>
                  <% }) %>
                </tbody>
              </table>
              </div>
            </div>
          <% }) %>
      <% } %>

      <% if(chavesKeys.length || (classificacaoGeral&&classificacaoGeral.length)){ %>
