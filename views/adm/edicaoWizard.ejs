                  <td><input class="wz-input" type="time" name="jogo_<%= j.id %>_horario" value="<%= j.horario||'' %>" style="min-width:80px"></td>
                  <td><input class="wz-input" name="jogo_<%= j.id %>_local" value="<%= j.local||'' %>" style="min-width:90px"></td>
                  <td style="font-weight:600"><%= bloco.nomeDoParticipante(j.participanteAId) %></td>
                  <td style="white-space:nowrap">
                    <input class="wz-input" type="number" name="jogo_<%= j.id %>_placarA" min="0" value="<%= j.placarA!=null?j.placarA:'' %>" style="width:52px;text-align:center">
                    ×
                    <input class="wz-input" type="number" name="jogo_<%= j.id %>_placarB" min="0" value="<%= j.placarB!=null?j.placarB:'' %>" style="width:52px;text-align:center">
                  </td>
                  <td style="font-weight:600"><%= bloco.nomeDoParticipante(j.participanteBId) %></td>
                  <% if(temSets){ %>
                  <td style="white-space:nowrap">
                    <% var alvoSet=ehTenis?11:21; %>
                    <% for(var si=0;si<3;si++){ var sa=(j.sets&&j.sets[si])?j.sets[si].pontosA:''; var sb=(j.sets&&j.sets[si])?j.sets[si].pontosB:''; %>
                      <span style="display:inline-flex;flex-direction:column;align-items:center;margin:0 2px">
                        <span style="font-size:.55rem;color:rgba(var(--fg-rgb), .5);line-height:1">Set <%= si+1 %></span>
                        <span style="display:inline-flex;gap:1px;margin-top:1px">
                          <input class="wz-input" type="number" name="jogo_<%= j.id %>_setA" min="0" max="99" value="<%= sa %>" style="width:34px;text-align:center;font-size:.7rem" placeholder="<%= alvoSet %>">
                          <input class="wz-input" type="number" name="jogo_<%= j.id %>_setB" min="0" max="99" value="<%= sb %>" style="width:34px;text-align:center;font-size:.7rem" placeholder="<%= alvoSet %>">
                        </span>
                      </span>
                    <% } %>
                  </td>
                  <% } %>
                  <td><input type="checkbox" name="jogo_<%= j.id %>_wo" value="1" <%= j.wo?'checked':'' %> onchange="wzSyncWo(this)"></td>
                  <td>
                    <select class="wz-select" name="jogo_<%= j.id %>_vencedor" style="max-width:130px;font-size:.75rem" <%= j.wo?'':'disabled' %>>
                      <option value="">—</option>
                      <option value="<%= j.participanteAId %>" <%= j.vencedorId==j.participanteAId?'selected':'' %>><%= bloco.nomeDoParticipante(j.participanteAId) %></option>
                      <option value="<%= j.participanteBId %>" <%= j.vencedorId==j.participanteBId?'selected':'' %>><%= bloco.nomeDoParticipante(j.participanteBId) %></option>
                    </select>
                  </td>
                  <td><select class="wz-select" name="jogo_<%= j.id %>_status" style="min-width:90px;font-size:.75rem">
                    <% ['Agendado','Em Andamento','Encerrado','Cancelado'].forEach(function(st){ %><option value="<%= st %>" <%= (j.status||'Agendado')===st?'selected':'' %>><%= st %></option><% }) %>
                  </select></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
          </div>
          <% } %>
        </div>
      <% }) %>

      <% if(!jogosAgrupados||!jogosAgrupados.length||jogosAgrupados.every(function(b){return !b.jogos.length})){ %>
        <div class="wz-empty">Nenhum confronto para lançar resultados.</div>
      <% } %>

      <% var tabelaPorChave={}; (tabela||[]).forEach(function(l){ (tabelaPorChave[String(l.chaveIndice)]=tabelaPorChave[String(l.chaveIndice)]||[]).push(l); }); var chavesKeys=Object.keys(tabelaPorChave).sort(function(a,b){return Number(a)-Number(b);}); %>
      <% if(chavesKeys.length>1){ %>
          <div class="wz-pills" style="margin-top:18px"><span class="wz-pill wz-pill--gold">Classificação por chave</span></div>
          <% chavesKeys.forEach(function(ci){ var chaveIdx=Number(ci); var letraChave=(grupos[chaveIdx]&&grupos[chaveIdx].letra)||('Chave '+(chaveIdx+1)); %>
