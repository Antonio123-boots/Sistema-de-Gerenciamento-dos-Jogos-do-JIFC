          <% if(mod.vice){ %><div class="wz-prize__item"><div class="wz-prize__pos">Vice</div><div class="wz-prize__campus"><%= mod.vice %></div></div><% } %>
          <% if(mod.terceiro){ %><div class="wz-prize__item"><div class="wz-prize__pos">Terceiro</div><div class="wz-prize__campus"><%= mod.terceiro %></div></div><% } %>
        </div>
      <% } %>

      <div class="wz-footer">
        <button class="wz-btn wz-btn-ghost wz-btn-sm" type="submit" form="wzFormVoltarConfr">← Confrontos</button>
        <button class="wz-btn wz-btn-primary" type="submit">Salvar</button>
      </div>
    </form>
  <% } %>

  <% /* === Eliminatórias === */ %>
  <% if(subPasso==='eliminatorias'){ %>
    <% var elimCtx=eliminatoriaCtx||null; var elim=null; if(elimCtx) elim=elimCtx.eliminatoria; var elimTemSets=!!(regras&&regras.temSets); var alvoElim=elimTemSets?(ehTenis?11:21):null; %>
    <% if(!elimCtx||!elimCtx.temEliminatoria){ %>
