<script src="/js/edicaoWizard.js"></script>
<script>
function wzRevFiltra(){
  var sel=document.getElementById('wzRevFiltro');
  var f=(sel&&sel.value)||'';
  document.querySelectorAll('#wzRevTabela tbody tr[data-wzmod]').forEach(function(tr){
    tr.style.display=(!f||tr.getAttribute('data-wzmod')===f)?'':'none';
  });
  document.querySelectorAll('.wz-card[data-wzmod]').forEach(function(card){
    card.style.display=(!f||card.getAttribute('data-wzmod')===f)?'':'none';
  });
}
document.addEventListener('DOMContentLoaded', function(){
  var sel=document.getElementById('wzRevFiltro');
  if(sel) sel.addEventListener('change', wzRevFiltra);
});
</script>
<script>
function wzToggleProvas(btn){
  var boxes=[].slice.call(document.querySelectorAll('input[name="prova_selecionada"]'));
  if(!boxes.length) return;
  var marcados=boxes.filter(function(b){return b.checked;});
  var ligar=marcados.length<boxes.length;
  boxes.forEach(function(b){
    b.checked=ligar;
    var label=b.closest('.wz-check');
    if(label) label.classList.toggle('wz-check--on',b.checked);
  });
  btn.textContent=ligar?'Limpar seleção':'Selecionar todos';
}
function wzAddAtletaProva(pi){
  var block=document.querySelector('[data-prova-block="'+pi+'"]');
  if(!block) return;
  var tpl=block.querySelector('template[data-prova-template="'+pi+'"]');
  var tbody=block.querySelector('tbody[data-rows]');
  if(!tpl||!tbody) return;
  var empty=tbody.querySelector('tr[data-empty]');
  if(empty) empty.remove();
  var row=tpl.content.firstElementChild.cloneNode(true);
  tbody.appendChild(row);
  var inp=row.querySelector('input[name$="_nome[]"]');
  if(inp) inp.focus();
}
function wzEmptyProva(block){
  if(!block) return;
  var tbody=block.querySelector('tbody[data-rows]');
  if(tbody && !tbody.querySelector('tr:not([data-empty])')){
    tbody.innerHTML='<tr data-empty="1"><td colspan="7" style="color:var(--muted);text-align:center">Nenhum atleta lançado nesta prova. Use “+ Adicionar atleta”.</td></tr>';
  }
}
function wzAddAtletaIndividual(){
  var lista=document.getElementById('wzAtletasIndividuais');
  if(!lista)return;
  var modelo=lista.querySelector('.wz-atleta-individual');
  if(!modelo)return;
  var clone=modelo.cloneNode(true);
  clone.querySelectorAll('input').forEach(function(input){
    input.value=input.name==='atleta_nome'?'':(input.name.indexOf('xadrez_')===0?'0':'');
  });
  clone.querySelectorAll('select').forEach(function(select){ select.selectedIndex=0; });
  lista.appendChild(clone);
  var rows=lista.querySelectorAll('.wz-atleta-individual');
  rows.forEach(function(row,index){
    row.querySelectorAll('input[name^="xadrez_"]').forEach(function(input){ input.name=input.name.replace(/_\d+$/, '_'+index); });
  });
}
</script>