<%
var LT='ABCDEFGHIJKLMNOPQRSTUVWXYZ';
var _map=mapCampusId;
function _lc(arr){ return Array.isArray(arr)?arr:[]; }
function _nc(id){ var o=_map.get(Number(id)); return o?(o.nomeExibicao||o.nome||'Campus '+id):('Campus '+id); }
function _foto(id){ var o=_map.get(Number(id)); return (o&&(o.foto||o.fotoPerfil))||'/imagens/avatar.svg'; }
function _campiParticipantes(){ var lista=(mod&&Array.isArray(mod.participantes))?mod.participantes:[]; return _lc(dados.campi).filter(function(c){ return lista.some(function(p){ return Number(p)===Number(c.id); }); }); }
function _datas(){ return typeof periodDates!=='undefined'&&Array.isArray(periodDates)?periodDates:[]; }
function _fmtData(d){ if(!d) return ''; var p=String(d).split('-'); return p.length===3?(p[2]+'/'+p[1]+'/'+p[0]):d; }
function _dataOpts(sel){
  var ds=_datas().slice();
  var s=String(sel||'');
  if(s&&ds.indexOf(s)<0) ds.push(s);
  var h='<option value="">—</option>';
  ds.forEach(function(d){ h+='<option value="'+d+'"'+(s===String(d)?' selected':'')+'>'+_fmtData(d)+'</option>'; });
  return h;
}
var mainSteps=[
  ['dados','Dados'],
  ['campi','Campi'],
  ['modalidades','Modalidades'],
  ['modalidade','Modalidade'],
  ['revisao','Revisão']
];
%>
<style>
.wz-page{--acc:var(--accent);--acc-ink:var(--accent-ink);--line:rgba(var(--fg-rgb), .1);--muted:rgba(var(--fg-rgb), .58);font-family:inherit;margin:0 0 40px;color: var(--text)}
.wz-page *,.wz-page *::before,.wz-page *::after{box-sizing:border-box}
.wz-hero{position:relative;overflow:hidden;border-radius:18px;background:linear-gradient(135deg,var(--surface-2) 0%,var(--accent-ink) 100%);border:1px solid rgba(var(--fg-rgb), .1);padding:26px 30px 24px;margin:0 0 24px}
.wz-hero::before{content:'';position:absolute;left:0;top:0;bottom:0;width:4px;background:linear-gradient(180deg,var(--accent),var(--accent-hover))}
.wz-hero::after{content:'';position:absolute;right:-40px;top:-40px;width:200px;height:200px;background:radial-gradient(circle,rgba(var(--accent-rgb), .16),transparent 70%);pointer-events:none}
.wz-hero h1{margin:0 0 6px;font-size:1.35rem;font-weight:800;letter-spacing:-.3px;line-height:1.25;color: var(--text)}
.wz-hero p{margin:0;font-size:.8rem;color:var(--muted)}
.wz-stepper{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 24px}
.wz-step{display:inline-flex;align-items:center;gap:8px;padding:7px 14px 7px 8px;border-radius:999px;font-size:.76rem;font-weight:700;background:rgba(var(--fg-rgb), .06);color:var(--muted);border:1px solid transparent;transition:all .22s;pointer-events:none}
.wz-step>span:first-child{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;background:rgba(var(--fg-rgb), .1);font-size:.68rem;color:inherit}
.wz-step--active{background:var(--acc);color:var(--acc-ink);border-color:var(--acc);box-shadow:0 6px 18px rgba(var(--accent-rgb), .35)}
.wz-step--active>span:first-child{background:rgba(16,17,36,.16);color:var(--acc-ink)}
.wz-step--done{color:var(--text);border-color:rgba(var(--accent-rgb), .4);background:rgba(var(--accent-rgb), .12)}
.wz-step--done>span:first-child{background:var(--acc);color:var(--acc-ink)}
.wz-card{background:rgba(var(--fg-rgb), .045);border:1px solid var(--line);border-radius:18px;padding:26px 28px;box-shadow:0 16px 36px rgba(0,0,0,.18);margin:0 0 24px}
.wz-card h2{margin:0 0 20px;font-size:1.04rem;font-weight:800;color: var(--text);border-bottom:1px solid var(--line);padding-bottom:12px}
.wz-alert{padding:12px 16px;border-radius:10px;font-size:.8rem;margin-bottom:10px;display:flex;align-items:flex-start;gap:8px;border:1px solid transparent}
.wz-alert-err{background:rgba(255,75,75,.12);color:#ff9d9d;border-color:rgba(255,75,75,.3)}
.wz-alert-ok{background:rgba(0,255,136,.1);color:#8fffc9;border-color:rgba(0,255,136,.3)}
.wz-row{display:flex;flex-wrap:wrap;gap:14px;margin-bottom:18px}
.wz-field{display:flex;flex-direction:column;flex:1 1 220px;min-width:180px;gap:5px}
.wz-field label{font-size:.7rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
.wz-input,.wz-select{padding:10px 12px;border:1px solid rgba(var(--fg-rgb), .16);border-radius:10px;font-size:.85rem;background:var(--panel-soft);color:var(--text);transition:border-color .2s,box-shadow .2s;outline:none;width:100%}
.wz-select{appearance:none;background-image:url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6'%3E%3Cpath fill='%23aab2c2' d='M0 0l5 6 5-6z'/%3E%3C/svg%3E");background-repeat:no-repeat;background-position:right 12px center;padding-right:30px}
.wz-select option{color:var(--text);background:var(--surface-2)}
.wz-input:focus,.wz-select:focus{border-color:var(--acc);box-shadow:0 0 0 3px rgba(var(--accent-rgb), .18)}
.wz-input[readonly]{background:rgba(var(--fg-rgb), .04);color:var(--muted)}
.wz-sm{font-size:.75rem}
.wz-nota{font-size:.78rem;color:#ffd08a;background:rgba(var(--accent-rgb), .1);border:1px solid rgba(var(--accent-rgb), .35);padding:9px 14px;border-radius:10px;margin:0 0 16px}
.wz-btn{padding:9px 16px;border-radius:10px;border:1px solid transparent;font-weight:700;font-size:.8rem;cursor:pointer;display:inline-flex;align-items:center;gap:6px;transition:all .18s;justify-content:center;line-height:1.2}
.wz-btn:disabled{opacity:.55;pointer-events:none}
.wz-btn-primary{background:linear-gradient(135deg,var(--accent-hover),var(--accent));color:var(--acc-ink)}
.wz-btn-primary:hover{box-shadow:0 6px 16px rgba(var(--accent-rgb), .35);transform:translateY(-1px);filter:brightness(1.06)}
.wz-btn-ghost{background:rgba(var(--fg-rgb), .05);border-color:rgba(var(--fg-rgb), .2);color: var(--text)}
.wz-btn-ghost:hover{background:rgba(var(--fg-rgb), .1);border-color:rgba(var(--fg-rgb), .3)}
.wz-btn-gold{background:rgba(var(--accent-rgb), .08);border:1px solid rgba(var(--accent-rgb), .45);color:var(--accent)}
.wz-btn-gold:hover{background:rgba(var(--accent-rgb), .16);box-shadow:0 4px 14px rgba(var(--accent-rgb), .22)}
.wz-btn-danger{background:rgba(255,75,75,.12);color:#ff8d8d;border-color:rgba(255,75,75,.3)}
.wz-btn-danger:hover{background:rgba(255,75,75,.2)}
.wz-btn-sm{padding:7px 12px;font-size:.74rem;border-radius:8px}
.wz-pills{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:18px}
.wz-pill{padding:5px 12px;border-radius:999px;font-size:.72rem;font-weight:700;background:rgba(var(--fg-rgb), .07);color:var(--text);border:1px solid rgba(var(--fg-rgb), .12)}
.wz-pill--gold{background:rgba(var(--accent-rgb), .12);color:var(--accent);border-color:rgba(var(--accent-rgb), .4)}
.wz-logo{width:30px;height:30px;border-radius:50%;object-fit:cover;border:1px solid rgba(var(--fg-rgb), .18);flex:0 0 auto}
.wz-checklist{display:grid;grid-template-columns:repeat(auto-fill,minmax(235px,1fr));gap:9px;margin-bottom:14px}
.wz-checklist--tools{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;margin:0 0 12px}
.wz-check{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:11px;border:1px solid rgba(var(--fg-rgb), .1);cursor:pointer;transition:all .18s;background:rgba(var(--fg-rgb), .05)}
.wz-check:hover{border-color:rgba(var(--fg-rgb), .22);background:rgba(var(--fg-rgb), .08)}
.wz-check--on{border-color:var(--acc);background:rgba(var(--accent-rgb), .1)}
.wz-check input{accent-color:var(--acc);flex:0 0 auto}
.wz-chips{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:16px}
.wz-chip{padding:6px 13px;border-radius:999px;border:1px solid rgba(var(--fg-rgb), .2);background:transparent;font-size:.75rem;font-weight:600;cursor:pointer;transition:all .18s;color: var(--text)}
.wz-chip:hover{border-color:rgba(var(--fg-rgb), .35);background:rgba(var(--fg-rgb), .06)}
.wz-chip--sel{border-color:var(--acc);background:var(--acc);color:var(--acc-ink)}
.wz-r{position:relative}
.wz-r .wz-btn-remove{background:rgba(255,75,75,.12);border:1px solid rgba(255,75,75,.3);cursor:pointer;color:#ff8d8d;font-size:1rem;padding:4px 9px;border-radius:8px;flex:0 0 auto}
.wz-r .wz-btn-remove:hover{background:rgba(255,75,75,.22)}
.wz-mod-row{display:flex;align-items:center;gap:10px;padding:12px 14px;border-radius:11px;background:var(--panel-soft);border:1px solid var(--line);margin-bottom:8px;flex-wrap:wrap}
.wz-mod-row .wz-field{flex:1}
.wz-icone-preview{width:34px;height:34px;border-radius:10px;object-fit:cover;background:rgba(var(--fg-rgb), .08);border:1px solid rgba(var(--fg-rgb), .14);flex:0 0 auto}
.wz-upload-btn{cursor:pointer}
.wz-mod-tabs{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:24px;align-items:center}
.wz-mod-tab{padding:9px 18px;border-radius:999px;font-size:.76rem;font-weight:700;background:rgba(var(--fg-rgb), .06);color:rgba(var(--fg-rgb), .55);border:1px solid rgba(var(--fg-rgb), .1);pointer-events:none}
.wz-mod-tab--active{background:var(--acc);color:var(--acc-ink);border-color:var(--acc)}
.wz-mod-tab--done{background:rgba(var(--accent-rgb), .12);color:var(--accent);border-color:rgba(var(--accent-rgb), .4)}
.wz-mod-sel{display:flex;align-items:center;gap:12px;margin-bottom:20px;flex-wrap:wrap}
.wz-chave-grid{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 14px}
.wz-chave-card{flex:1 1 150px;max-width:220px;padding:14px;border:1px solid rgba(var(--fg-rgb), .14);border-radius:14px;background:rgba(var(--fg-rgb), .05);cursor:pointer;transition:all .18s;text-align:center}
.wz-chave-card:hover{border-color:var(--acc);background:rgba(var(--accent-rgb), .1);transform:translateY(-2px)}
.wz-chave-card__letra{font-size:1.35rem;font-weight:800;color:var(--acc)}
.wz-chave-card__qtd{font-size:.72rem;color:var(--muted)}
.wz-chave-chip{display:inline-flex;align-items:center;gap:5px;padding:3px 8px;border-radius:999px;background:rgba(var(--fg-rgb), .08);font-size:.7rem;margin:2px}
.wz-chave-chip img{width:16px;height:16px;border-radius:50%;object-fit:cover;flex:0 0 auto}
.wz-cfr{display:flex;align-items:flex-end;gap:8px;padding:10px 12px;border-radius:11px;background:var(--panel-soft);border:1px solid var(--line);margin-bottom:8px;flex-wrap:wrap}
.wz-cfr .wz-input,.wz-cfr .wz-select{padding:8px 10px;font-size:.78rem}
.wz-cfr label{font-size:.64rem;color:var(--muted)}
.wz-res-grp{border:1px solid var(--line);border-radius:14px;overflow:hidden;margin-bottom:24px;background:rgba(var(--fg-rgb), .03)}
.wz-res-grp__head{background:var(--surface-2);padding:14px 18px;font-weight:700;font-size:.85rem;color: var(--text);display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;border-bottom:1px solid rgba(var(--accent-rgb), .3)}
.wz-table{width:100%;border-collapse:collapse;font-size:.78rem}
.wz-table thead th{background:var(--surface-2);color:var(--accent);padding:10px 12px;text-align:left;white-space:nowrap;border-bottom:1px solid rgba(var(--accent-rgb), .3)}
.wz-table tbody td{padding:9px 10px;border-bottom:1px solid var(--line);vertical-align:middle;color:var(--text)}
.wz-table tbody tr:nth-child(even){background:rgba(var(--fg-rgb), .025)}
.wz-table tbody tr:hover{background:rgba(var(--accent-rgb), .05)}
.wz-prize{display:flex;flex-wrap:wrap;gap:14px;margin:18px 0 8px}
.wz-prize__item{padding:14px 18px;border-radius:12px;background:rgba(var(--fg-rgb), .05);border:1px solid rgba(var(--fg-rgb), .12);text-align:center;flex:1 1 160px}
.wz-prize__pos{font-size:.66rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:4px}
.wz-prize__campus{font-size:.95rem;font-weight:700;color: var(--text)}
.wz-footer{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;margin-top:24px}
.wz-empty{padding:18px;text-align:center;color:var(--muted);font-size:.82rem;border:1px dashed rgba(var(--fg-rgb), .28);border-radius:12px;margin-bottom:18px}
.wz-modal-backdrop{position:fixed;inset:0;background:rgba(8,9,20,.72);backdrop-filter:blur(4px);z-index:1200;display:flex;align-items:center;justify-content:center;padding:16px}
.wz-modal{background:var(--surface-2);border:1px solid rgba(var(--fg-rgb), .14);border-radius:16px;padding:22px;width:min(480px,94vw);max-height:82vh;overflow:auto;box-shadow:0 18px 60px rgba(0,0,0,.5)}
.wz-modal h3{margin:0 0 14px;font-size:1.02rem;color: var(--text)}
.wz-modal-item{display:flex;align-items:center;gap:10px;padding:8px 10px;border:1px solid rgba(var(--fg-rgb), .12);border-radius:10px;margin-bottom:7px;cursor:pointer;background:rgba(var(--fg-rgb), .05);transition:all .18s}
.wz-modal-item:hover{background:rgba(var(--fg-rgb), .09)}
.wz-modal-item.sel{border-color:var(--acc);background:rgba(var(--accent-rgb), .13)}
.wz-modal-item input{accent-color:var(--acc);flex:0 0 auto}
summary{cursor:pointer;font-size:.78rem;font-weight:700;color:var(--muted)}
/* ===== Revisão ===== */
.wz-card--rev{padding:20px 22px}
.wz-rev-sub{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid var(--line)}
.wz-rev-sub h3{margin:0;font-size:1.02rem;font-weight:800;color: var(--text)}
.wz-rev-sub__gen{color:var(--muted);font-weight:600}
.wz-rev-tag{display:inline-flex;align-items:center;gap:6px;padding:4px 12px;border-radius:999px;font-size:.68rem;font-weight:800;letter-spacing:.05em;text-transform:uppercase}
.wz-rev-tag--done{background:rgba(0,255,136,.12);color:#8fffc9;border:1px solid rgba(0,255,136,.35)}
.wz-rev-tag--pend{background:rgba(255,190,80,.12);color:#ffcf85;border:1px solid rgba(255,190,80,.35)}
.wz-rev-podium{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin:14px 0 6px}
.wz-podium-item{display:flex;align-items:center;gap:10px;padding:11px 13px;border-radius:12px;border:1px solid var(--line);background:rgba(var(--fg-rgb), .04)}
.wz-podium-item--1{border-color:rgba(var(--accent-rgb), .55);background:rgba(var(--accent-rgb), .1)}
.wz-podium-item--2{border-color:rgba(205,215,235,.4);background:rgba(205,215,235,.07)}
.wz-podium-item--3{border-color:rgba(226,160,94,.45);background:rgba(226,160,94,.09)}
.wz-podium__medal{width:30px;height:30px;flex:0 0 auto;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:.82rem;color:var(--accent-ink)}
.wz-podium-item--1 .wz-podium__medal{background:linear-gradient(135deg,var(--accent-hover),var(--accent-hover))}
.wz-podium-item--2 .wz-podium__medal{background:linear-gradient(135deg,var(--text),#b3bdd2);color:var(--surface-2)}
.wz-podium-item--3 .wz-podium__medal{background:linear-gradient(135deg,#e8a860,#ce7f2e)}
.wz-podium__labels{display:flex;flex-direction:column;min-width:0}
.wz-podium__pos{font-size:.6rem;font-weight:800;text-transform:uppercase;letter-spacing:.09em;color:var(--muted)}
.wz-podium__name{font-size:.92rem;font-weight:700;color: var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.wz-rev-section__title{display:flex;align-items:center;gap:8px;font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.07em;color:var(--acc);margin:18px 0 8px}
.wz-rev-section__title::before{content:'';width:18px;height:3px;border-radius:99px;background:var(--acc);flex:0 0 auto}
.wz-rev-chave .wz-table tbody td:first-child{color:var(--acc);font-weight:700}
.wz-table tbody tr:hover{background:rgba(var(--accent-rgb), .045)}
.wz-rev-jogos .wz-res-grp{margin-bottom:14px}
@media(max-width:640px){.wz-hero{padding:20px 18px}.wz-hero h1{font-size:1.12rem}.wz-card{padding:20px 18px}.wz-cfr{flex-direction:column;align-items:stretch}.wz-cfr .wz-field{flex:1 1 100%}}
</style>

<div class="wz-page">
  <div class="wz-hero">
    <h1>Nova Edição JIFC</h1>
    <p>Configure uma edição antiga dos jogos passo a passo.</p>
  </div>

  <div class="wz-stepper">
    <% mainSteps.forEach(function(s,si){ var ativo=passo===s[0]; %>
      <div class="wz-step <%= ativo?'wz-step--active':(mainSteps.findIndex(x=>x[0]===passo)>si?'wz-step--done':'') %>">
        <span><%= si+1 %></span>
        <span><%= s[1] %></span>
      </div>
    <% }) %>
  </div>

  <% if(erros&&erros.length){ %>
    <div class="wz-card" style="padding-top:18px;padding-bottom:18px">
      <% erros.forEach(function(e){ %><div class="wz-alert wz-alert-err"><%= e %></div><% }) %>
    </div>
  <% } %>
  <% if(mensagem){ %>
    <div class="wz-card" style="padding-top:18px;padding-bottom:18px"><div class="wz-alert wz-alert-ok"><%= mensagem %></div></div>
  <% } %>

<% /* ============ DADOS ============ */ %>
<% if(passo==='dados'){ %>
<div class="wz-card">
  <h2>Dados gerais</h2>
  <form action="/admin/edicoes/nova/dados" method="POST" id="wzFormDados">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="wz-row">
      <div class="wz-field" style="flex:0 1 140px">
        <label>Ano</label>
        <input class="wz-input" type="number" name="ano" min="2000" max="2100" required value="<%= dados.ano||'' %>">
      </div>
      <div class="wz-field">
        <label>Início</label>
        <input class="wz-input" type="date" name="dataInicio" required value="<%= dados.dataInicio||'' %>">
      </div>
      <div class="wz-field">
        <label>Fim</label>
        <input class="wz-input" type="date" name="dataFim" required value="<%= dados.dataFim||'' %>">
      </div>
    </div>
    <p class="wz-sm" style="color:rgba(var(--fg-rgb), .55);margin:-6px 0 0">O período define os dias disponíveis nos confrontos.</p>
    <div class="wz-footer" style="margin-top:30px">
      <button class="wz-btn wz-btn-danger wz-btn-sm" type="submit" form="wzFormCancelar">Cancelar</button>
      <button class="wz-btn wz-btn-gold" type="submit" form="wzFormPreencher">Preencher com exemplo</button>
      <button class="wz-btn wz-btn-primary" type="submit">Começar</button>
    </div>
  </form>
</div>
<% } %>

<% /* ============ CAMPI ============ */ %>
<% if(passo==='campi'){ %>
<div class="wz-card">
  <h2>Participantes</h2>
  <form action="/admin/edicoes/nova/campi" method="POST" id="wzFormCampi">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="wz-checklist--tools">
      <button type="button" class="wz-btn wz-btn-ghost wz-btn-sm" id="wzToggleCampus">Selecionar todos</button>
    </div>
    <div class="wz-checklist" id="wzCampusChecklist">
      <% campiAtuais.forEach(function(c){ var sel=(dados.campi||[]).some(function(x){return Number(x.id)===Number(c.id)}); %>
        <label class="wz-check <%= sel?'wz-check--on':'' %>">
          <input type="checkbox" name="campi_atual" value="<%= c.id %>" <%= sel?'checked':'' %>>
          <img class="wz-logo" src="<%= c.fotoPerfil||'/imagens/avatar.svg' %>" alt="">
          <span><%= c.nomeExibicao||c.nome %></span>
        </label>
      <% }) %>
    </div>

    <div id="wzCustomList">
      <% _lc(dados.campi).filter(function(c){return Number(c.id)>=100000}).forEach(function(c){ %>
        <div class="wz-mod-row wz-r">
          <img class="wz-logo" src="<%= c.foto||'/imagens/avatar.svg' %>" alt="">
          <div class="wz-field" style="flex:2 1 180px;min-width:150px"><label>Nome</label><input class="wz-input" name="custom_nome" value="<%= c.nomeExibicao||'' %>" required></div>
          <div class="wz-field" style="flex:0 1 130px"><label>Cidade</label><input class="wz-input" name="custom_cidade" value="<%= c.cidade||'' %>"></div>
          <div class="wz-field" style="flex:0 1 70px"><label>Cor</label><input class="wz-input" type="color" name="custom_cor" value="<%= c.cor||'#2980b9' %>"></div>
          <div class="wz-field" style="flex:0 1 160px">
            <label>Logo</label>
            <div style="display:flex;align-items:center;gap:8px">
              <input type="file" accept="image/*" data-role="wz-camp-logo" class="wz-file-input" style="display:none">
              <button type="button" class="wz-btn wz-btn-ghost wz-btn-sm wz-upload-btn">Escolher</button>
              <input type="hidden" name="custom_foto" value="<%= c.foto||'' %>">
            </div>
          </div>
          <input type="hidden" name="custom_slug" value="<%= c.slug||'' %>">
          <button type="button" class="wz-btn-remove" onclick="this.closest('.wz-r').remove()">×</button>
        </div>
      <% }) %>
    </div>
    <div style="margin-bottom:18px">
      <button type="button" class="wz-btn wz-btn-ghost wz-btn-sm" onclick="wzAddCustom()">+ Campus manual</button>
    </div>

    <div class="wz-footer">
      <button class="wz-btn wz-btn-ghost wz-btn-sm" type="submit" form="wzFormVoltarDados">← Voltar</button>
      <button class="wz-btn wz-btn-primary" type="submit">Salvar e continuar</button>
    </div>
  </form>
</div>

<div id="wzCustomTemplate" style="display:none">
  <div class="wz-mod-row wz-r">
    <img class="wz-logo" src="/imagens/avatar.svg" alt="">
    <div class="wz-field" style="flex:2 1 180px;min-width:150px"><label>Nome</label><input class="wz-input" name="custom_nome" required></div>
    <div class="wz-field" style="flex:0 1 130px"><label>Cidade</label><input class="wz-input" name="custom_cidade"></div>
    <div class="wz-field" style="flex:0 1 70px"><label>Cor</label><input class="wz-input" type="color" name="custom_cor" value="#2980b9"></div>
    <div class="wz-field" style="flex:0 1 160px">
      <label>Logo</label>
      <div style="display:flex;align-items:center;gap:8px">
        <input type="file" accept="image/*" data-role="wz-camp-logo" class="wz-file-input" style="display:none">
        <button type="button" class="wz-btn wz-btn-ghost wz-btn-sm wz-upload-btn">Escolher</button>
        <input type="hidden" name="custom_foto" value="">
      </div>
    </div>
    <input type="hidden" name="custom_slug" value="">
    <button type="button" class="wz-btn-remove" onclick="this.closest('.wz-r').remove()">×</button>
  </div>
</div>
<% } %>

<% /* ============ MODALIDADES ============ */ %>
<% if(passo==='modalidades'){ %>
<div class="wz-card">
  <h2>Modalidades</h2>
  <form action="/admin/edicoes/nova/modalidades" method="POST" id="wzFormModalidades">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div id="wzModList">
      <% _lc(dados.modalidades).forEach(function(m){ %>
        <div class="wz-mod-row wz-r">
          <div class="wz-field" style="flex:2 1 200px;min-width:170px"><label>Modalidade</label><input class="wz-input" name="mod_nome" value="<%= m.base||m.nome %>" readonly required></div>
          <div class="wz-field" style="flex:0 1 120px"><label>Gênero</label><select class="wz-select" name="mod_genero"><% ['Masculino','Feminino','Misto'].forEach(function(g){ %><option value="<%= g %>" <%= m.genero===g?'selected':'' %>><%= g %></option><% }) %></select></div>
          <img class="wz-icone-preview" src="<%= m.icone||'/imagens/atletismo1.svg' %>" alt="Ícone de <%= m.base||m.nome %>">
          <input type="hidden" name="mod_icone" value="<%= m.icone||'' %>">
        </div>
      <% }) %>
    </div>

    <div class="wz-footer">
      <button class="wz-btn wz-btn-ghost wz-btn-sm" type="submit" form="wzFormVoltarCampi">← Voltar</button>
      <button class="wz-btn wz-btn-primary" type="submit">Salvar e continuar</button>
    </div>
  </form>
</div>

<% } %>

<% /* ============ MODALIDADE (sub-steps) ============ */ %>
<% if(passo==='modalidade' && mod){
  var ehIndividual=/atletismo|xadrez/i.test(mod.nome||'');
  var ehTenis=/t[êe]nis de mesa/i.test(mod.nome||'');
%>
<div class="wz-card">
  <div class="wz-mod-sel">
    <form action="/admin/edicoes/nova/modalidades/ir" method="POST" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="wz-field" style="flex:1 1 320px;min-width:240px">
        <label style="font-size:.72rem;font-weight:700;color:rgba(var(--fg-rgb), .7);text-transform:uppercase">Modalidade ativa</label>
        <select class="wz-select" name="modalidadeFoco" onchange="this.form.submit()">
          <% _lc(modalidades).forEach(function(m,i){ %>
            <option value="<%= i %>" <%= i===modFoco?'selected':'' %>><%= m.nome %><%= m.finalizada?' (concluída)':'' %></option>
          <% }) %>
        </select>
      </div>
      <noscript><button class="wz-btn wz-btn-ghost wz-btn-sm" type="submit">Ir</button></noscript>
    </form>
  </div>

  <div class="wz-mod-tabs">
    <% var wzTabs=[{st:'participantes',lb:'Participantes'},{st:'grupos',lb:'Chaves'},{st:'confrontos',lb:'Confrontos'},{st:'resultados',lb:'Resultados'}].concat(ehIndividual?[]:[{st:'eliminatorias',lb:'Eliminatórias'}]).filter(function(t){return !ehIndividual||t.st==='participantes';}); %>
    <% wzTabs.forEach(function(t,i){ var done=mod.finalizada || ['participantes','grupos','confrontos'].indexOf(subPasso)>i; var active=subPasso===t.st; %>
      <div class="wz-mod-tab <%= active?'wz-mod-tab--active':(done?'wz-mod-tab--done':'') %>"><%= t.lb %></div>
    <% }) %>
    <% if(ehTenis){ %>
      <form action="/admin/edicoes/nova/modalidade/<%= modFoco %>/sub-etapa" method="POST" class="wz-mod-subtap" style="display:flex;gap:6px;align-items:center;margin-left:auto;flex-wrap:wrap">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <span class="wz-sm" style="color:rgba(var(--fg-rgb), .6);font-weight:700;text-transform:uppercase;font-size:.68rem">Etapa:</span>
        <button type="submit" name="subEtapa" value="individual" class="wz-pill <%= (mod.subEtapa||'individual')==='individual'?'wz-pill--gold':'' %>" style="border:1px solid rgba(var(--fg-rgb), .18);cursor:pointer;background:transparent;color:inherit">Individual <%= (typeof subEtapaTenis!=='undefined'&&subEtapaTenis.individualConcluida)?'✓':'' %></button>
        <button type="submit" name="subEtapa" value="dupla" class="wz-pill <%= mod.subEtapa==='dupla'?'wz-pill--gold':'' %>" style="border:1px solid rgba(var(--fg-rgb), .18);cursor:pointer;background:transparent;color:inherit">Em dupla <%= (typeof subEtapaTenis!=='undefined'&&subEtapaTenis.duplaConcluida)?'✓':'' %></button>
      </form>
    <% } %>
    <% if(mod.finalizada){ %>
      <span class="wz-pill wz-pill--gold">Finalizada</span>
    <% } %>
  </div>

  <% /* === Participantes === */ %>
  <% if(subPasso==='participantes'){ %>
    <form action="/admin/edicoes/nova/modalidade/<%= modFoco %>/participantes" method="POST" id="wzFormParticipantes">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="wz-checklist--tools">
        <button type="button" class="wz-btn wz-btn-ghost wz-btn-sm js-toggle-check" data-list="<%= modFoco %>">Selecionar todos</button>
      </div>
      <div class="wz-checklist">
        <% _lc(dados.campi).forEach(function(c){ var sel=(mod.participantes||[]).some(function(x){return Number(x)===Number(c.id)}); %>
          <label class="wz-check <%= sel?'wz-check--on':'' %>">
            <input type="checkbox" name="participantes" value="<%= c.id %>" <%= sel?'checked':'' %>>
            <img class="wz-logo" src="<%= c.foto||c.fotoPerfil||'/imagens/avatar.svg' %>" alt="">
            <span><%= c.nomeExibicao||c.nome %></span>
          </label>
        <% }) %>
      </div>
      <% if(ehIndividual){ %>
        <% if(/xadrez/i.test(mod.nome||'')){ %>
          <div class="wz-res-grp" style="margin-top:18px">
            <div class="wz-res-grp__head"><span>Atletas inscritos e resultados</span><span style="font-size:.7rem;color:rgba(var(--fg-rgb), .65)">Pontuação calculada automaticamente</span></div>
            <div id="wzAtletasIndividuais" style="padding:14px">
              <% var atletasWizard=_lc(mod.atletas); if(!atletasWizard.length){ atletasWizard=[{id:1,nome:'',campusId:''}]; } %>
              <% atletasWizard.forEach(function(atleta,ai){ %>
                <div class="wz-mod-row wz-r wz-atleta-individual">
                  <div class="wz-field" style="flex:1 1 220px"><label>Atleta</label><input class="wz-input" name="atleta_nome" value="<%= atleta.nome||'' %>" placeholder="Nome do atleta"></div>
                  <div class="wz-field" style="flex:1 1 180px"><label>Campus representado</label><select class="wz-select" name="atleta_campus"><option value="">Selecione</option><% _lc(dados.campi).forEach(function(c){ %><option value="<%= c.id %>" <%= Number(atleta.campusId)===Number(c.id)?'selected':'' %>><%= c.nomeExibicao||c.nome %></option><% }) %></select></div>
                  <div class="wz-field" style="flex:0 1 90px"><label>Pontos</label><input class="wz-input" type="number" min="0" step="0.5" name="xadrez_pontuacao_<%= ai %>" value="<%= atleta.pontuacao||0 %>"></div>
                  <div class="wz-field" style="flex:0 1 70px"><label>Vitórias</label><input class="wz-input" type="number" min="0" name="xadrez_vitorias_<%= ai %>" value="<%= atleta.vitorias||0 %>"></div>
                  <div class="wz-field" style="flex:0 1 70px"><label>Derrotas</label><input class="wz-input" type="number" min="0" name="xadrez_derrotas_<%= ai %>" value="<%= atleta.derrotas||0 %>"></div>
                  <div class="wz-field" style="flex:0 1 70px"><label>Empates</label><input class="wz-input" type="number" min="0" name="xadrez_empates_<%= ai %>" value="<%= atleta.empates||0 %>"></div>
                  <button type="button" class="wz-btn-remove" onclick="this.closest('.wz-r').remove()">×</button>
                </div>
              <% }) %>
            </div>
            <div style="padding:0 14px 14px"><button type="button" class="wz-btn wz-btn-ghost wz-btn-sm" onclick="wzAddAtletaIndividual()">+ Adicionar atleta</button></div>
          </div>
        <% } %>

        <% if(/atletismo/i.test(mod.nome||'')){ %>
          <div class="wz-res-grp" style="margin-top:18px">
            <div class="wz-res-grp__head"><span>1 · Provas de atletismo da edição</span><span style="font-size:.7rem;color:rgba(var(--fg-rgb), .65)">Confirme quais provas foram disputadas</span></div>
            <div class="wz-checklist--tools" style="padding:14px 14px 0">
              <button type="button" class="wz-btn wz-btn-ghost wz-btn-sm" onclick="wzToggleProvas(this)">Selecionar todos</button>
            </div>
            <div class="wz-checklist" style="padding:14px;margin:0">
              <% _lc(mod.provas).forEach(function(prova){ %>
                <label class="wz-check <%= prova.selecionada?'wz-check--on':'' %>">
                  <input type="checkbox" name="prova_selecionada" value="<%= prova.id %>" <%= prova.selecionada?'checked':'' %>>
                  <span><%= prova.nome %></span>
                  <small style="margin-left:auto;color:rgba(var(--fg-rgb), .55)"><%= prova.tipo==='tempo'?'Tempo':'Distância / altura' %><%= prova.final?' · final automática (8)':'' %></small>
                </label>
              <% }) %>
            </div>
          </div>

          <% if(_lc(mod.provas).some(function(p){return p.selecionada;})){ %>
          <div class="wz-res-grp" style="margin-top:18px">
            <div class="wz-res-grp__head"><span>2 · Atletas e resultados por prova</span><span style="font-size:.7rem;color:rgba(var(--fg-rgb), .65)">Em cada prova informe nome e campus do atleta e o resultado — tempo nas corridas, distância nos saltos e lançamentos</span></div>
            <div style="padding-top:14px">
              <% _lc(mod.provas).forEach(function(prova,pi){ if(!prova.selecionada) return; var resultadosProva=_lc(prova.resultados); var temBt=prova.tipo==='tempo'; %>
                <div class="wz-res-grp" style="margin:0 14px 14px" data-prova-block="<%= pi %>">
                  <div class="wz-res-grp__head">
                    <span><%= prova.nome %></span>
                    <span style="font-size:.7rem;color:rgba(var(--fg-rgb), .65)"><%= temBt?'Tempo (corrida)':'Distância / altura' %><%= prova.final?' · final automática com 8 (4 por bateria)':'' %></span>
                  </div>
                  <div style="overflow-x:auto">
                    <table class="wz-table">
                      <thead><tr><th>Atleta</th><th>Campus</th><% if(temBt){ %><th>Bateria</th><% } %><th><%= temBt?'Tempo':'Resultado' %></th><th>Col.</th><th>Pts</th><th></th></tr></thead>
                      <tbody data-rows>
                        <% if(resultadosProva.length){ %>
                          <% resultadosProva.forEach(function(r){ %>
                            <tr>
                              <td><input class="wz-input" name="atl_<%= pi %>_nome[]" value="<%= r.atleta||'' %>" placeholder="Nome do atleta"></td>
                              <td><select class="wz-select" name="atl_<%= pi %>_campus[]"><option value="">Selecione</option><% _campiParticipantes().forEach(function(c){ %><option value="<%= c.id %>" <%= Number(r.campusId)===Number(c.id)?'selected':'' %>><%= c.nomeExibicao||c.nome %></option><% }) %></select></td>
                              <% if(temBt){ %><td><input class="wz-input" type="number" min="1" name="atl_<%= pi %>_bateria[]" value="<%= r.bateria||'' %>" style="width:70px"></td><% } %>
                              <td><input class="wz-input" type="text" inputmode="decimal" name="atl_<%= pi %>_valor[]" value="<%= r.valor!=null?r.valor:'' %>" style="width:120px" placeholder="<%= temBt?'ex.: 12.38':'ex.: 5.62' %>"></td>
                              <td><%= r.posicao||'—' %></td><td><strong><%= r.pontos||0 %></strong></td>
                              <td><button type="button" class="wz-btn-remove" onclick="this.closest('tr').remove();wzEmptyProva(this.closest('[data-prova-block]'))">×</button></td>
                            </tr>
                          <% }) %>
                        <% } else { %>
                          <tr data-empty="1"><td colspan="7" style="color:var(--muted);text-align:center">Nenhum atleta lançado nesta prova. Use “+ Adicionar atleta”.</td></tr>
                        <% } %>
                      </tbody>
                      <template data-prova-template="<%= pi %>">
                        <tr>
                          <td><input class="wz-input" name="atl_<%= pi %>_nome[]" placeholder="Nome do atleta"></td>
                          <td><select class="wz-select" name="atl_<%= pi %>_campus[]"><option value="">Selecione</option><% _campiParticipantes().forEach(function(c){ %><option value="<%= c.id %>"><%= c.nomeExibicao||c.nome %></option><% }) %></select></td>
                          <% if(temBt){ %><td><input class="wz-input" type="number" min="1" name="atl_<%= pi %>_bateria[]" style="width:70px"></td><% } %>
                          <td><input class="wz-input" type="text" inputmode="decimal" name="atl_<%= pi %>_valor[]" style="width:120px" placeholder="<%= temBt?'ex.: 12.38':'ex.: 5.62' %>"></td>
                          <td>—</td><td>0</td>
                          <td><button type="button" class="wz-btn-remove" onclick="this.closest('tr').remove();wzEmptyProva(this.closest('[data-prova-block]'))">×</button></td>
                        </tr>
                      </template>
                    </table>
                  </div>
                  <div style="padding:10px 14px 14px;display:flex;align-items:center;gap:10px;flex-wrap:wrap">
                    <button type="button" class="wz-btn wz-btn-ghost wz-btn-sm" onclick="wzAddAtletaProva(<%= pi %>)">+ Adicionar atleta</button>
                    <span class="wz-sm" style="color:rgba(var(--fg-rgb), .5)">Colocação e pontuação (13 · 8 · 6 · 5 · 4 · 3 · 2 · 1) calculadas automaticamente.</span>
                  </div>
                  <% if(prova.final){ %>
                    <div style="padding:0 14px 10px;font-weight:700;color:var(--accent)">Final automática — 8 vagas (4 por bateria)</div>
                    <div style="overflow-x:auto;padding:0 14px 14px">
                      <table class="wz-table">
                        <thead><tr><th>Atleta</th><th>Campus</th><th>Tempo da final</th><th>Col.</th><th>Pts</th></tr></thead>
                        <tbody>
                          <% if(_lc(prova.finalistas).length){ %>
                            <% _lc(prova.finalistas).forEach(function(finalista){ var campusFinal=dados.campi.find(function(c){return Number(c.id)===Number(finalista.campusId);}); %>
                              <tr><td><%= finalista.atleta||'Atleta' %></td><td><%= campusFinal?(campusFinal.nomeExibicao||campusFinal.nome):'—' %></td><td><input class="wz-input" type="text" inputmode="decimal" name="atl_<%= pi %>_final[]" value="<%= finalista.valorFinal!=null?finalista.valorFinal:'' %>" style="width:120px" placeholder="ex.: 12.00"></td><td><%= finalista.posicao||'—' %></td><td><strong><%= finalista.pontos||0 %></strong></td></tr>
                            <% }) %>
                          <% } else { %>
                            <tr><td colspan="5" style="color:var(--muted);text-align:center">Salve após lançar até 8 atletas com tempo (4 por bateria) para liberar a final.</td></tr>
                          <% } %>
                        </tbody>
                      </table>
                    </div>
                  <% } %>
                </div>
              <% }) %>
            </div>
          </div>

          <div class="wz-res-grp" style="margin-top:18px">
            <div class="wz-res-grp__head"><span>Classificação geral do atletismo</span><span style="font-size:.7rem;color:rgba(var(--fg-rgb), .65)">Atualizada automaticamente pelos resultados</span></div>
            <% if(_lc(mod.tabelaAtletismo).length){ %>
              <div style="overflow-x:auto"><table class="wz-table"><thead><tr><th>#</th><th>Campus</th><th>Provas pontuadas</th><th>Pts</th></tr></thead><tbody>
                <% _lc(mod.tabelaAtletismo).forEach(function(linha){ %><tr><td><%= linha.posicao %></td><td><%= linha.campus||'Campus' %></td><td><%= linha.provas %></td><td><strong><%= linha.pontos %></strong></td></tr><% }) %>
              </tbody></table></div>
            <% } else { %>
              <div class="wz-empty" style="margin:14px">A classificação será preenchida assim que houver resultados pontuados.</div>
            <% } %>
          </div>
          <% } %>
        <% } %>
      <% } %>
      <div class="wz-footer">
        <button class="wz-btn wz-btn-ghost wz-btn-sm" type="submit" form="wzFormVoltarModalidades">← Modalidades</button>
        <button class="wz-btn wz-btn-primary" type="submit"><%= ehIndividual?'Salvar resultados':'Salvar e continuar' %></button>
      </div>
    </form>
  <% } %>

  <% /* === Grupos / Chaves (dinâmicas) === */ %>
  <% if(subPasso==='grupos'){
    var chavesData={participantes:(mod.participantes||[]).map(function(id){var c=dados.campi.find(function(x){return Number(x.id)===Number(id);});return {id:Number(id),nome:(c&&(c.nomeExibicao||c.nome))||('Campus '+id),foto:(c&&(c.foto||c.fotoPerfil))||'/imagens/avatar.svg'};}),grupos:(grupos||[]).map(function(g){return {letra:g.letra,participantes:(g.participantes||[]).map(Number)};})};
  %>
    <div id="wzData" style="display:none"><%= JSON.stringify(chavesData) %></div>
    <form action="/admin/edicoes/nova/modalidade/<%= modFoco %>/grupos" method="POST" id="wzFormGrupos">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="wz-row" style="align-items:flex-end;margin-bottom:8px">
        <div class="wz-field" style="flex:0 1 200px;min-width:160px">
          <label>Quantidade de chaves</label>
<select class="wz-select" id="wzChaveQtd">
  <% var maxQtd=Math.min(8,Math.max(1,Math.floor((mod.participantes||[]).length/2))); %>
  <% for(var qi=1;qi<=maxQtd;qi++){ %><option value="<%= qi %>" <%= (grupos.length&&grupos.length===qi)||(!grupos.length&&qi===1)?'selected':'' %>><%= qi %></option><% } %>
</select>
        </div>
        <button type="button" class="wz-btn wz-btn-gold" id="wzGerarChaves">Gerar chaves</button>
      </div>

      <div class="wz-chave-grid" id="wzChaveGrid"></div>
      <p class="wz-sm" id="wzChaveStatus" style="color:rgba(var(--fg-rgb), .6);margin:0 0 14px"></p>
      <div id="wzGrupoInputs" style="display:none"></div>

      <div class="wz-modal-backdrop" id="wzChaveModal" style="display:none">
        <div class="wz-modal">
          <h3 id="wzModalTitulo">Chave</h3>
          <div id="wzModalList"></div>
          <div class="wz-footer" style="margin-top:16px">
            <button type="button" class="wz-btn wz-btn-ghost wz-btn-sm" id="wzModalCancelar">Cancelar</button>
            <button type="button" class="wz-btn wz-btn-primary" id="wzModalConfirmar">Confirmar</button>
          </div>
        </div>
      </div>

      <div class="wz-footer">
        <button class="wz-btn wz-btn-ghost wz-btn-sm" type="submit" form="wzFormVoltarPart">← Participantes</button>
        <button type="submit" class="wz-btn wz-btn-primary" id="wzBtnSalvarChaves" disabled>Salvar e continuar</button>
      </div>
    </form>
  <% } %>

  <% /* === Confrontos === */ %>
  <% if(subPasso==='confrontos'){ %>
    <div id="wzData" style="display:none"><%= JSON.stringify({periodo:_datas(),grupos:grupos,participantes:(mod.participantes||[]).map(function(id){return {id:Number(id),nome:_nc(id)};})}) %></div>
    <form action="/admin/edicoes/nova/modalidade/<%= modFoco %>/confrontos" method="POST" id="wzFormConfrontos">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div id="wzCfrList">
        <% var jgs=_lc(mod.jogos); if(!jgs.length){ jgs=[{chaveIndice:grupos.length?grupos[0].indice:0,rodada:1,participanteAId:null,participanteBId:null,data:'',horario:'',local:''}]; } %>
        <% jgs.forEach(function(j){ %>
          <div class="wz-cfr wz-r">
            <div class="wz-field" style="flex:0 1 100px;min-width:80px"><label>Chave</label>
              <select class="wz-select" name="conf_grupo[]" onchange="wzUpdateCfrOpts(this.closest('.wz-r'))">
                <% _lc(grupos).forEach(function(g){ %><option value="<%= g.indice %>" <%= Number(j.chaveIndice)===Number(g.indice)?'selected':'' %>><%= g.letra %></option><% }) %>
              </select>
