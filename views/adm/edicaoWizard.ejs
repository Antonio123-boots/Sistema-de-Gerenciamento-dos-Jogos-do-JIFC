                <% } %>
                <td><%= jt.vencedorId?elimCtx.nomeElim(jt.vencedorId):'—' %></td>
                <td><select class="wz-select" name="jogo_<%= jt.id %>_status" style="min-width:90px;font-size:.75rem">
                  <% ['Agendado','Em Andamento','Encerrado'].forEach(function(st){ %><option value="<%= st %>" <%= (jt.status||'Agendado')===st?'selected':'' %>><%= st %></option><% }) %>
                </select></td>
              </tr>
            </tbody>
          </table>
          </div>
        <% } %>

        <div class="wz-pills" style="margin-top:22px"><span class="wz-pill wz-pill--gold">Pódio</span></div>
        <div class="wz-prize" style="margin-top:8px;margin-bottom:22px">
          <div class="wz-prize__item" style="border-color:rgba(var(--accent-rgb), .5);background:rgba(var(--accent-rgb), .1)"><div class="wz-prize__pos">Campeã</div><div class="wz-prize__campus"><%= elimCtx.elimPodio.campeao?elimCtx.nomeElim(elimCtx.elimPodio.campeao):'—' %></div></div>
          <div class="wz-prize__item"><div class="wz-prize__pos">Vice</div><div class="wz-prize__campus"><%= elimCtx.elimPodio.vice?elimCtx.nomeElim(elimCtx.elimPodio.vice):'—' %></div></div>
          <div class="wz-prize__item"><div class="wz-prize__pos">Terceiro</div><div class="wz-prize__campus"><%= elimCtx.elimPodio.terceiro?elimCtx.nomeElim(elimCtx.elimPodio.terceiro):'—' %></div></div>
        </div>

        <div class="wz-footer">
          <button class="wz-btn wz-btn-ghost wz-btn-sm" type="submit" form="wzFormVoltarElim">← Resultados</button>
          <button class="wz-btn wz-btn-primary" type="submit">Salvar</button>
        </div>
      </form>
    <% } %>
  <% } %>
</div>
<% } %>

<% /* ============ REVISÃO ============ */ %>
<% if(passo==='revisao'){ var df=dadosFinais; %>
<div class="wz-card">
  <h2>Revisão final</h2>

  <div class="wz-row" style="margin-bottom:22px">
    <div class="wz-field" style="flex:0 1 160px"><label>Ano</label><input class="wz-input" readonly value="<%= df.ano %>"></div>
    <div class="wz-field"><label>Título</label><input class="wz-input" readonly value="<%= df.titulo %>"></div>
  </div>

  <div class="wz-pills" style="margin-bottom:22px">
    <span class="wz-pill"><%= (df.campi||[]).length %> campus</span>
    <span class="wz-pill"><%= (df.modalidades||[]).length %> modalidade(s)</span>
    <span class="wz-pill"><%= (df.chaves||[]).length %> chave(s)</span>
    <span class="wz-pill"><%= (df.jogos||[]).length %> jogo(s)</span>
  </div>

  <% if((df.modalidades||[]).length){ %>
    <div class="wz-field" style="flex:0 1 320px;min-width:240px;margin-bottom:12px">
      <label style="font-size:.72rem;font-weight:700;color:rgba(var(--fg-rgb), .7);text-transform:uppercase">Filtrar modalidade</label>
      <select class="wz-select" id="wzRevFiltro"><option value="">Todas</option><% (dados.modalidades||[]).forEach(function(m,i){ %><option value="<%= i %>"><%= m.nome %></option><% }) %></select>
    </div>
    <div style="overflow-x:auto;margin-bottom:22px">
      <table class="wz-table" id="wzRevTabela">
        <thead><tr><th>Modalidade</th><th>Campeã</th><th>Vice</th><th>Terceiro</th><th>Clássificada</th></tr></thead>
        <tbody>
          <% (dados.modalidades||[]).forEach(function(m,i){ %>
          <tr data-wzmod="<%= i %>"><td><%= m.nome %></td><td><%= m.campeao||'—' %></td><td><%= m.vice||'—' %></td><td><%= m.terceiro||'—' %></td><td><%= m.finalizada?'Sim':'Não' %></td></tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% (dados.modalidades||[]).forEach(function(m,mi){
         var rev=(revisaoModalidades&&revisaoModalidades[mi])||null;
         var ehTenisCard=rev&&rev.ehTenis; %>
      <div class="wz-card wz-card--rev" style="margin-top:16px" data-wzmod="<%= mi %>">
        <div class="wz-rev-sub">
          <h3><%= m.nome %><% if(m.genero){ %> <span class="wz-rev-sub__gen">· <%= m.genero %></span><% } %></h3>
          <span class="wz-rev-tag <%= (rev&&rev.finalizada)?'wz-rev-tag--done':'wz-rev-tag--pend' %>"><%= (rev&&rev.finalizada)?'Classificada':'Pendente' %></span>
        </div>
        <% if(!ehTenisCard){
          var pd=[['Campeã','1',rev&&rev.campeao?rev.campeao:null],['Vice','2',rev&&rev.vice?rev.vice:null],['3º','3',rev&&rev.terceiro?rev.terceiro:null]]; %>
        <div class="wz-rev-podium">
          <% pd.forEach(function(par){ %>
          <div class="wz-podium-item wz-podium-item--<%= par[1] %>">
            <span class="wz-podium__medal"><%= par[1] %></span>
            <span class="wz-podium__labels">
              <span class="wz-podium__pos"><%= par[0] %></span>
              <span class="wz-podium__name"><%= par[2]||'—' %></span>
            </span>
          </div>
          <% }) %>
        </div>
        <% } %>

        <% if(rev&&rev.ehAtletismo){ %>
          <div style="margin-top:8px">
            <% if(rev.provas&&rev.provas.length){ %>
              <div class="wz-rev-section__title">Provas</div>
              <% rev.provas.forEach(function(p){ %>
                <div style="margin:8px 0">
                  <div class="wz-res-grp__head"><span><%= p.nome %><% if(p.final){ %> · Final<% } %></span></div>
                  <div style="overflow-x:auto">
                  <table class="wz-table">
                    <thead><tr><th>#</th><th>Atleta</th><th>Campus</th><th>Bateria</th><th>Resultado</th><% if(p.final){ %><th>Final</th><% } %><th>Pontos</th></tr></thead>
                    <tbody>
                      <% (p.resultados||[]).forEach(function(r){ %>
                        <tr>
                          <td><%= r.posicao||'—' %></td>
                          <td><%= r.atleta||'—' %></td>
                          <td><%= r.campus||'—' %></td>
                          <td><%= r.bateria||'—' %></td>
                          <td><%= r.valor!=null&&r.valor!==''?r.valor:'—' %></td>
                          <% if(p.final){ %><td><%= r.valorFinal!=null&&r.valorFinal!==''?r.valorFinal:'—' %></td><% } %>
                          <td><%= r.pontos||0 %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                  </div>
                </div>
              <% }) %>
            <% } %>
            <% if(rev.tabela&&rev.tabela.length){ %>
              <div class="wz-rev-section__title">Classificação geral</div>
              <div style="overflow-x:auto">
              <table class="wz-table">
                <thead><tr><th>#</th><th>Campus</th><th>Pontos</th><th>Provas</th></tr></thead>
                <tbody>
                  <% rev.tabela.forEach(function(l){ %>
                  <tr><td><%= l.posicao %></td><td><%= l.campus %></td><td><%= l.pontos %></td><td><%= l.provas %></td></tr>
                  <% }) %>
                </tbody>
              </table>
              </div>
            <% } %>
          </div>
        <% } else if(rev&&rev.ehXadrez){ %>
          <div class="wz-rev-section__title">Classificação</div>
          <div style="overflow-x:auto">
          <table class="wz-table">
            <thead><tr><th>#</th><th>Atleta</th><th>Campus</th><th>Vit.</th><th>Emp.</th><th>Der.</th><th>Pontos</th></tr></thead>
            <tbody>
              <% (rev.xadrez||[]).forEach(function(x){ %>
              <tr><td><%= x.posicao %></td><td><%= x.atleta||'—' %></td><td><%= x.campus||'—' %></td><td><%= x.vitorias||0 %></td><td><%= x.empates||0 %></td><td><%= x.derrotas||0 %></td><td><%= x.pontuacao||0 %></td></tr>
              <% }) %>
            </tbody>
          </table>
          </div>
        <% } else { (rev&&rev.blocos||[]).forEach(function(bloco,b){ %>
          <% if(bloco.rotulo){
            var pdB=[['Campeão','1',bloco.podio.campeao],['Vice','2',bloco.podio.vice],['3º','3',bloco.podio.terceiro]]; %>
            <div class="wz-rev-section__title">Sub-etapa <%= bloco.rotulo %></div>
            <div class="wz-rev-podium">
              <% pdB.forEach(function(par){ %>
              <div class="wz-podium-item wz-podium-item--<%= par[1] %>">
                <span class="wz-podium__medal"><%= par[1] %></span>
                <span class="wz-podium__labels">
                  <span class="wz-podium__pos"><%= par[0] %></span>
                  <span class="wz-podium__name"><%= par[2]||'—' %></span>
                </span>
              </div>
              <% }) %>
            </div>
          <% } %>
          <% (bloco.tabelas||[]).forEach(function(tb){ %>
            <div class="wz-rev-chave" style="margin:10px 0">
              <div class="wz-res-grp__head"><span><%= tb.rotuloChave %></span></div>
              <div style="overflow-x:auto">
              <table class="wz-table">
                <thead><tr><th>#</th><th>Campus</th><th>Pts</th><th>PJ</th><th>V</th><th>E</th><th>D</th><th>GP</th><th>GC</th><th>SG</th><% if(bloco.temSets){ %><th>SG s</th><th>SP s</th><% } %></tr></thead>
                <tbody>
                  <% tb.linhas.forEach(function(l){ %>
                  <tr><td><%= l.posicao %></td><td><%= l.campus %></td><td><%= l.pontos %></td><td><%= l.pj %></td><td><%= l.v %></td><td><%= l.e %></td><td><%= l.d %></td><td><%= l.gp %></td><td><%= l.gc %></td><td><%= l.sg %></td><% if(bloco.temSets){ %><td><%= l.setsGanhos %></td><td><%= l.setsPerdidos %></td><% } %></tr>
                  <% }) %>
                </tbody>
              </table>
              </div>
            </div>
          <% }) %>
          <% if(bloco.jogos.length){ %>
            <div class="wz-res-grp wz-rev-jogos" style="margin-top:12px">
              <div class="wz-res-grp__head"><span><%= bloco.jogos.length %> jogo(s)</span></div>
              <div style="overflow-x:auto">
              <table class="wz-table">
                <thead><tr>
                  <th>Fase</th><th>Rod.</th><th>Data</th><th>Hora</th><th>Local</th><th>Casa</th><th>Resultado</th><th>Fora</th><% if(bloco.temSets){ %><th>Sets</th><% } %><th>Status</th>
                </tr></thead>
                <tbody>
                  <% bloco.jogos.forEach(function(j){ %>
                  <tr>
                    <td><%= j.fase||'Grupos' %></td>
                    <td><%= j.rodada %></td>
                    <td><%= _fmtData(j.data) %></td>
                    <td><%= j.horario||'—' %></td>
                    <td><%= j.local||'—' %></td>
                    <td style="font-weight:600"><%= j.casa||'—' %></td>
                    <td style="text-align:center"><%= j.placarA!=null?j.placarA:'—' %> × <%= j.placarB!=null?j.placarB:'—' %></td>
                    <td style="font-weight:600"><%= j.fora||'—' %></td>
                    <% if(bloco.temSets){ %>
                    <td>
                      <% (j.sets||[]).forEach(function(s){ %><span style="display:inline-block;margin:0 2px;white-space:nowrap"><%= s.pontosA %>×<%= s.pontosB %></span><% }) %>
                    </td>
                    <% } %>
                    <td><%= j.status %><%= j.wo?' (WO)':'' %></td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
              </div>
            </div>
          <% } %>
        <% }) } %>
      </div>
    <% }) %>
  <% } %>

  <form action="/admin/edicoes/nova/salvar" method="POST" id="wzFormSalvar">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="wz-footer">
      <button class="wz-btn wz-btn-ghost wz-btn-sm" type="submit" form="wzFormVoltarRevisao">← Modalidade atual</button>
      <button class="wz-btn wz-btn-gold" type="submit">Salvar edição</button>
    </div>
  </form>
</div>
<% } %>
</div>

