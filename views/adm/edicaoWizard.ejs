            <div class="wz-field" style="flex:0 1 85px;min-width:80px"><label>Hora</label><input class="wz-input" type="time" name="conf_horario[]" value="<%= j.horario||'' %>"></div>
            <div class="wz-field" style="flex:1 1 110px;min-width:100px"><label>Local</label><input class="wz-input" name="conf_local[]" value="<%= j.local||'' %>"></div>
