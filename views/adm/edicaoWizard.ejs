                          <input class="wz-input" type="number" name="jogo_<%= jj.id %>_setB" min="0" max="99" value="<%= sb %>" style="width:34px;text-align:center;font-size:.7rem" placeholder="<%= alvoElim %>" <%= jj.participanteBId?'':'disabled' %>>
                        </span>
