                    ×
                    <input class="wz-input" type="number" name="jogo_<%= jj.id %>_placarB" min="0" value="<%= jj.placarB!=null?jj.placarB:'' %>" style="width:52px;text-align:center" <%= jj.participanteBId?'':'disabled' %>>
