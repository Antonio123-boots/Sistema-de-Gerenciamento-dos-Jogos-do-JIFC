        <% var elimTabelaPorChave={}; (tabela||[]).forEach(function(l){ (elimTabelaPorChave[String(l.chaveIndice)]=elimTabelaPorChave[String(l.chaveIndice)]||[]).push(l); }); var elimChavesKeys=Object.keys(elimTabelaPorChave).sort(function(a,b){return Number(a)-Number(b);}); %>
        <% if(elimChavesKeys.length){ %>
