                  <td><input type="checkbox" name="jogo_<%= jj.id %>_wo" value="1" <%= jj.wo?'checked':'' %> <%= (jj.participanteAId&&jj.participanteBId)?'':'disabled' %> onchange="wzSyncWo(this)"></td>
