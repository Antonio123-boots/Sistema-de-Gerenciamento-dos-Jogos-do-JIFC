<div class="profile-shell">
  <div class="profile-card--wide configuration-dashboard">
    <div class="config-dashboard-header">
      <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; flex-wrap:wrap;">
        <div>
          <h1 class="config-main-title">Edições Anteriores</h1>
          <p class="config-main-subtitle">Histórico oficial do JIFC por ano, com exportação e importação de edições finalizadas.</p>
        </div>
        <% if (statusJifc && statusJifc.encerrado) { %>
          <span class="status-tag">JIFC Encerrado</span>
        <% } else { %>
          <span class="status-tag" style="background: rgba(255,107,107,0.15); color:#ff6b6b;">JIFC em andamento</span>
        <% } %>
      </div>
    </div>

    <% if (typeof mensagemErro !== 'undefined' && mensagemErro) { %>
      <div class="alert alert-error auto-dismiss"><%= mensagemErro %></div>
    <% } %>
    <% if (typeof mensagemSucesso !== 'undefined' && mensagemSucesso) { %>
      <div class="alert alert-success auto-dismiss"><%= mensagemSucesso %></div>
    <% } %>

    <div class="admin-shell">
      <div class="management-grid management-grid--two">
        <section class="management-panel">
          <h2 class="context-title" style="margin-top:0;">Gerar edição de exemplo</h2>
          <form action="/admin/edicoes/gerar-exemplo" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-secondary" style="width:100%;" onclick="return confirm('Gerar uma edição demonstrativa no histórico de edições anteriores?');">Gerar edição de exemplo</button>
          </form>
          <p class="panel-info" style="margin-top:0.6rem; margin-bottom:0;">Cria uma edição fictícia com modalidades, jogos e resultados para testar o histórico.</p>
        </section>

        <section class="management-panel">
          <h2 class="context-title" style="margin-top:0;">Salvar edição atual</h2>
          <% if (statusJifc && statusJifc.encerrado) { %>
            <form action="/admin/edicoes/salvar-ano-atual" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="ano_jifc" value="<%= anoAtual %>">
              <button type="submit" class="btn btn-primary" style="width:100%;">Salvar JIFC <%= anoAtual %> em edições anteriores</button>
            </form>
            <p class="panel-info" style="margin-top:0.6rem; margin-bottom:0;">Arquiva o campeonato atual como edição consultável.</p>
          <% } else { %>
            <button type="button" class="btn btn-ghost" disabled title="Disponível quando todos os jogos forem encerrados" style="width:100%;">Salvar edição atual</button>
            <p class="panel-info" style="margin-top:0.6rem; margin-bottom:0;">Disponível quando todos os jogos forem encerrados.</p>
          <% } %>
        </section>

        <section class="management-panel">
          <h2 class="context-title" style="margin-top:0;">Importar edição antiga</h2>
          <form action="/admin/edicoes/importar" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="edicao_json_texto" id="edicaoJsonTexto">
            <label class="btn btn-secondary" for="edicaoJsonInput" style="width:100%; cursor:pointer; margin-bottom:0.5rem;">Escolher arquivo .json</label>
            <span id="edicaoJsonNome" style="display:block; font-size:0.78rem; color:rgba(var(--fg-rgb), 0.62); margin-bottom:0.5rem;"></span>
            <input type="file" id="edicaoJsonInput" accept=".json,application/json" style="display:none;">
            <button type="submit" class="btn btn-primary" style="width:100%;" id="edicaoImportarBtn" disabled>Importar edição</button>
          </form>
        </section>
      </div>
    </div>

    <div class="inner-management-card" style="margin-bottom:0;">
      <div class="card-context-header">
        <h2 class="context-title">Edições salvas</h2>
        <p class="context-subtitle"><%= Array.isArray(edicoes) ? edicoes.length : 0 %> edição(ões) no histórico.</p>
      </div>

      <% if (Array.isArray(edicoes) && edicoes.length) { %>
        <div class="management-card-list">
          <% edicoes.forEach((edicao) => { %>
            <div class="management-list-item">
              <div class="management-list-item__meta">
                <div style="display:flex; align-items:center; gap:0.6rem; flex-wrap:wrap;">
                  <strong style="color:var(--accent); font-size:1.05rem;">JIFC <%= edicao.ano %></strong>
                  <% if (edicao.origem === 'importada') { %>
                    <span class="status-tag" style="background:rgba(91,143,249,0.16); color:#8fb8ff; font-size:0.7rem; padding:0.2rem 0.55rem;">Importada</span>
                  <% } else { %>
                    <span class="status-tag" style="background:rgba(88,214,141,0.16); color:#58d68d; font-size:0.7rem; padding:0.2rem 0.55rem;">Automática</span>
                  <% } %>
                </div>
                <p><%= edicao.titulo %> — <%= edicao.modalidades %> modalidade(s) e <%= edicao.jogos %> jogo(s)</p>
              </div>
              <div class="management-actions">
                <a href="/admin/edicoes/exportar/<%= edicao.ano %>" class="btn btn-secondary">Exportar</a>
                <form action="/admin/edicoes/excluir/<%= edicao.ano %>" method="POST">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-danger" onclick="return confirm('Excluir a edição de <%= edicao.ano %>? Os usuários não poderão mais visualizá-la.');">Excluir</button>
                </form>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="panel-info" style="margin:0;">Ainda não há edições anteriores salvas. Quando o JIFC terminar, salve a edição atual ou importe um arquivo de uma edição antiga.</p>
      <% } %>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const input = document.getElementById('edicaoJsonInput');
    const hidden = document.getElementById('edicaoJsonTexto');
    const nome = document.getElementById('edicaoJsonNome');
    const botao = document.getElementById('edicaoImportarBtn');

    if (input && hidden && botao) {
      input.addEventListener('change', function () {
        const [arquivo] = this.files || [];
        if (!arquivo) {
          hidden.value = '';
          nome.textContent = '';
          botao.disabled = true;
          return;
        }

        const leitor = new FileReader();
        leitor.onload = function () {
          hidden.value = String(leitor.result || '');
          nome.textContent = arquivo.name + ' selecionado (' + (arquivo.size / 1024).toFixed(1) + ' KB)';
          botao.disabled = hidden.value.length === 0;
        };
        leitor.readAsText(arquivo, 'utf-8');
      });
    }
  });
</script>