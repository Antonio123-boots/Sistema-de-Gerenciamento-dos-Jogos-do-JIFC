<%
  const temSets = typeof regras !== 'undefined' && regras && regras.temSets;
  const setsSalvos = (jogo.sets || []);
  const modoEdicaoAtivo = typeof modoEdicao !== 'undefined' && modoEdicao;
  const fotoCasaReal = !!(jogo.fotoCasa && jogo.fotoCasa !== '/imagens/avatar.svg');
  const fotoForaReal = !!(jogo.fotoFora && jogo.fotoFora !== '/imagens/avatar.svg');
  const esporteVolta = typeof esporteVoltar !== 'undefined' && esporteVoltar ? esporteVoltar : jogo.modalidade.split(' ')[0];
%>

<section class="juiz-page">
  <header class="juiz-page-head">
    <div>
      <p class="juiz-page-kicker">Placar</p>
      <h1>Atualizar placar</h1>
      <p class="juiz-page-subtitle">Registre o resultado e o status do confronto.</p>
    </div>
    <a class="juiz-back-link" href="/juiz/<%= encodeURIComponent(esporteVolta) %>">← Voltar para <%= esporteVolta %></a>
  </header>

  <% if (jogo.status === 'Em Andamento') { %>
    <div class="juiz-status juiz-status--live" style="margin-top:1rem;">
      <span class="juiz-dot"></span>
      Em andamento
    </div>
  <% } %>

  <% if (typeof mensagemErro !== 'undefined' && mensagemErro) { %>
    <div class="juiz-alert juiz-alert--danger auto-dismiss"><%= mensagemErro %></div>
  <% } %>

  <% if (jogo.wo) { %>
    <div class="juiz-note juiz-note--warning" style="margin-top:1rem;">
      <div class="juiz-note__title" style="color:#f5b041;">W.O. aplicado</div>
      <p class="juiz-note__text">Este jogo foi finalizado por Walk Over.</p>
    </div>
  <% } %>

  <article class="juiz-match-card juiz-match-hero" style="margin-top:1rem;">
    <div class="juiz-match-card__meta"><%= jogo.modalidade %> · <%= jogo.genero %></div>

    <div class="juiz-versus">
      <div class="juiz-team">
        <img src="<%= jogo.fotoCasa || '/imagens/avatar.svg' %>"
             alt="Foto do campus <%= jogo.casa %>"
             class="campus-photo campus-photo--md campus-photo--badge <%= fotoCasaReal ? 'campus-photo--real' : 'campus-photo--default' %>">
        <div class="juiz-team__name <%= (jogo.casa && jogo.casa !== 'Atleta não informado' && jogo.casa !== 'Campus não informado') ? '' : 'juiz-team__name--muted' %>">
          <%= (jogo.casa && jogo.casa !== 'Atleta não informado' && jogo.casa !== 'Campus não informado') ? jogo.casa : (jogo.rotuloCasa || 'A definir') %>
        </div>
      </div>

      <div class="juiz-match-center">
        <div class="juiz-match-time"><%= jogo.horario %></div>
        <div class="juiz-match-place"><%= jogo.localJogo || 'A definir' %></div>
        <div class="juiz-match-date"><%= jogo.data %></div>
      </div>

      <div class="juiz-team">
        <img src="<%= jogo.fotoFora || '/imagens/avatar.svg' %>"
             alt="Foto do campus <%= jogo.fora %>"
             class="campus-photo campus-photo--md campus-photo--badge <%= fotoForaReal ? 'campus-photo--real' : 'campus-photo--default' %>">
        <div class="juiz-team__name <%= (jogo.fora && jogo.fora !== 'Atleta não informado' && jogo.fora !== 'Campus não informado') ? '' : 'juiz-team__name--muted' %>">
          <%= (jogo.fora && jogo.fora !== 'Atleta não informado' && jogo.fora !== 'Campus não informado') ? jogo.fora : (jogo.rotuloFora || 'A definir') %>
        </div>
      </div>
    </div>
  </article>

  <% if (jogo.bloqueado) { %>
    <div class="juiz-note juiz-note--blocked">
      <div class="juiz-note__title" style="color:#b4823c;">Aguardando encerramento da fase anterior</div>
      <p class="juiz-note__text">Este jogo será liberado automaticamente quando todos os jogos da fase anterior forem encerrados.</p>
    </div>
  <% } else if (!jogo.wo && (jogo.status !== 'Encerrado' || modoEdicaoAtivo)) { %>
    <form action="/juiz/jogos/<%= jogo.id %>/placar" method="POST" style="margin-top:1.25rem;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <% if (temSets) { %>
        <div id="setsSection">
          <div class="juiz-section-head" style="margin-bottom:0.6rem;">
            <h2 style="font-size:0.85rem;">Placar por sets</h2>
            <span class="juiz-hint">Melhor de 3</span>
          </div>

          <div id="setsContainer" style="display:flex; flex-direction:column; gap:0.5rem; margin-bottom:0.75rem;">
            <% for (let s = 1; s <= 3; s++) { %>
              <% const setSalvo = setsSalvos[s-1]; %>
              <% const confirmado = setSalvo && (Number(setSalvo.pontos_1 || 0) > 0 || Number(setSalvo.pontos_2 || 0) > 0); %>
              <div class="juiz-set-row <%= confirmado ? 'is-confirmed' : '' %> set-row" data-set="<%= s %>">
                <span class="juiz-set-row__index"><%= s %>º</span>
                <input type="number" name="sets[<%= s - 1 %>][pontos_1]" min="0" value="<%= setSalvo ? setSalvo.pontos_1 : 0 %>" class="set-input set-p1" <%= confirmado ? 'readonly' : '' %>>
                <span class="juiz-set-row__sep">x</span>
                <input type="number" name="sets[<%= s - 1 %>][pontos_2]" min="0" value="<%= setSalvo ? setSalvo.pontos_2 : 0 %>" class="set-input set-p2" <%= confirmado ? 'readonly' : '' %>>
                <button type="button" class="btn-confirmar-set juiz-btn <%= confirmado ? 'juiz-btn--success' : 'juiz-btn--ghost' %> juiz-btn--sm"
                        data-set="<%= s %>" onclick="confirmarSet(<%= s %>)" <%= confirmado ? 'style="pointer-events:none;"' : '' %>>
                  <%= confirmado ? '✓' : 'OK' %>
                </button>
              </div>
            <% } %>
          </div>

          <div id="setsSummary" class="juiz-scoreboard">
            <div>
              <div class="juiz-scoreboard__value" id="setsVencidos1">0</div>
              <div class="juiz-scoreboard__label">Sets</div>
            </div>
            <div class="juiz-scoreboard__mid">SETS</div>
            <div>
              <div class="juiz-scoreboard__value" id="setsVencidos2">0</div>
              <div class="juiz-scoreboard__label">Sets</div>
            </div>
          </div>

          <div class="juiz-scoreboard">
            <div>
              <div class="juiz-scoreboard__value" id="totalPontos1" style="color:var(--text);">0</div>
              <div class="juiz-scoreboard__label">Pontos totais</div>
            </div>
            <div class="juiz-scoreboard__mid">PLACAR</div>
            <div>
              <div class="juiz-scoreboard__value" id="totalPontos2" style="color:var(--text);">0</div>
              <div class="juiz-scoreboard__label">Pontos totais</div>
            </div>
          </div>

          <div class="juiz-balles">
            <% if (jogo.casa && jogo.casa !== '—') { %>
              <button type="button" class="juiz-btn juiz-btn--warning btn-wo" onclick="confirmarWO('<%= jogo.tipoIndividual && jogo.atleta_1_id ? jogo.atleta_1_id : jogo.campus_1_id %>', '<%= jogo.casa %>')">
                W.O. <%= jogo.casa %>
              </button>
            <% } %>
            <% if (jogo.fora && jogo.fora !== '—') { %>
              <button type="button" class="juiz-btn juiz-btn--warning btn-wo" onclick="confirmarWO('<%= jogo.tipoIndividual && jogo.atleta_2_id ? jogo.atleta_2_id : jogo.campus_2_id %>', '<%= jogo.fora %>')">
                W.O. <%= jogo.fora %>
              </button>
            <% } %>
          </div>
        </div>

        <input type="hidden" name="placar1" id="placar1Hidden" value="<%= setsSalvos.reduce((acc, s) => acc + Number(s.pontos_1 || 0), 0) %>">
        <input type="hidden" name="placar2" id="placar2Hidden" value="<%= setsSalvos.reduce((acc, s) => acc + Number(s.pontos_2 || 0), 0) %>">
      <% } else { %>
        <div class="juiz-versus" style="margin-bottom:1rem;">
          <div class="juiz-team">
            <input type="number" name="placar1" min="0" value="<%= jogo.placar_1 != null ? jogo.placar_1 : 0 %>" required class="juiz-score-input">
            <% if (jogo.casa && jogo.casa !== '—') { %>
              <button type="button" class="juiz-btn juiz-btn--warning juiz-btn--sm" onclick="confirmarWO('<%= jogo.tipoIndividual && jogo.atleta_1_id ? jogo.atleta_1_id : jogo.campus_1_id %>', '<%= jogo.casa %>')">W.O.</button>
            <% } %>
          </div>

          <div class="juiz-match-center">
            <span class="juiz-scoreboard__mid" style="font-size:1.1rem;">x</span>
          </div>

          <div class="juiz-team">
            <input type="number" name="placar2" min="0" value="<%= jogo.placar_2 != null ? jogo.placar_2 : 0 %>" required class="juiz-score-input">
            <% if (jogo.fora && jogo.fora !== '—') { %>
              <button type="button" class="juiz-btn juiz-btn--warning juiz-btn--sm" onclick="confirmarWO('<%= jogo.tipoIndividual && jogo.atleta_2_id ? jogo.atleta_2_id : jogo.campus_2_id %>', '<%= jogo.fora %>')">W.O.</button>
            <% } %>
          </div>
        </div>

        <% const fasesEliminatoria = ['Oitavas', 'Quartas', 'Semifinal', 'Final', 'Terceiro Lugar'];
          const ehBasquete = /basquete/i.test(String(jogo.modalidade || ''));
          if (fasesEliminatoria.includes(String(jogo.fase || '')) && !ehBasquete) { %>
          <div class="juiz-penalty">
            <label>Disputa (pênaltis / 7m / cesta livre)</label>
            <input type="number" name="disputa1" min="0" value="<%= jogo.disputa_pontos_1 != null ? jogo.disputa_pontos_1 : '' %>" placeholder="—">
            <span style="font-size:0.8rem; color:rgba(var(--fg-rgb), 0.4);">×</span>
            <input type="number" name="disputa2" min="0" value="<%= jogo.disputa_pontos_2 != null ? jogo.disputa_pontos_2 : '' %>" placeholder="—">
          </div>
        <% } %>
      <% } %>

      <% if (typeof regras !== 'undefined' && regras && regras.temCartoes && jogo.campus_1_id && jogo.campus_2_id) { %>
        <div id="cartoesSection" class="juiz-cards">
          <div class="juiz-cards__head">
            <span class="juiz-cards__title">Cartões (Fair Play)</span>
            <span class="juiz-cards__legend">Amarelo −1 · Vermelho −3</span>
          </div>

          <div style="display:flex; flex-direction:column; gap:0;">
            <div class="cartao-campus-block juiz-card-block" data-campus-id="<%= jogo.campus_1_id %>">
              <div class="juiz-card-block__head">
                <span class="juiz-card-block__name"><%= jogo.casa %></span>
                <button type="button" class="juiz-btn juiz-btn--success juiz-btn--sm" onclick="adicionarCartao(this.closest('.cartao-campus-block'))">+ Cartão</button>
              </div>
              <div class="cartao-rows juiz-card-rows"></div>
            </div>

            <div class="cartao-campus-block juiz-card-block" data-campus-id="<%= jogo.campus_2_id %>">
              <div class="juiz-card-block__head">
                <span class="juiz-card-block__name"><%= jogo.fora %></span>
                <button type="button" class="juiz-btn juiz-btn--success juiz-btn--sm" onclick="adicionarCartao(this.closest('.cartao-campus-block'))">+ Cartão</button>
              </div>
              <div class="cartao-rows juiz-card-rows"></div>
            </div>
          </div>
        </div>
      <% } %>

      <input type="hidden" name="status" value="Encerrado">

      <div style="margin-top:1.25rem;">
        <button type="submit" class="juiz-btn juiz-btn--primary juiz-btn--block" id="btnEncerrar">
          Encerrar jogo
        </button>
      </div>
    </form>

    <div style="margin-top:1rem; text-align:center;">
      <button type="button" id="btnAdiar" class="juiz-btn juiz-btn--warning" onclick="toggleAdiar()">
        Adiar partida
      </button>

      <div id="adiarPanel" class="juiz-adiar" hidden>
        <div class="juiz-adiar__title">Marcar novo dia e horário</div>
        <p class="juiz-adiar__current">Horário atual: <%= jogo.data %> às <%= jogo.horario %>.</p>
        <form action="/juiz/jogos/<%= jogo.id %>/adiar" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="juiz-adiar__fields">
            <div class="juiz-field">
              <label for="nova_data">Nova data</label>
              <input type="date" name="nova_data" id="nova_data" required class="juiz-input">
            </div>
            <div class="juiz-field">
              <label for="nova_hora">Novo horário</label>
              <input type="time" name="nova_hora" id="nova_hora" required class="juiz-input">
            </div>
          </div>
          <button type="submit" class="juiz-btn juiz-btn--warning juiz-btn--block" style="margin-top:0.85rem;">
            Confirmar adiamento
          </button>
        </form>
      </div>
    </div>
  <% } else if (jogo.status === 'Encerrado' && jogo.wo) { %>
    <div style="margin-top:1.25rem; text-align:center;">
      <div class="juiz-status juiz-status--wo">W.O. aplicado</div>
      <form id="desfazerWOForm" action="/juiz/jogos/<%= jogo.id %>/desfazer-wo" method="POST" style="margin-top:0.9rem;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="button" class="juiz-btn juiz-btn--ghost" onclick="abrirDesfazerWO()">Desfazer W.O.</button>
      </form>
    </div>
  <% } else if (jogo.status === 'Encerrado' && !jogo.wo) { %>
    <div style="margin-top:1.25rem; text-align:center;">
      <% if (temSets && setsSalvos.length > 0) { %>
        <div class="juiz-scoreboard__label" style="margin-bottom:0.5rem;">Resultado por sets</div>
        <div style="display:flex; flex-direction:column; gap:0.3rem; margin-bottom:0.6rem;">
          <% let v1 = 0, v2 = 0; %>
          <% setsSalvos.forEach((s, i) => { %>
            <%
              const s1 = Number(s.pontos_1 || 0);
              const s2 = Number(s.pontos_2 || 0);
              const ganhou1 = s1 > s2;
              const ganhou2 = s2 > s1;
              if (ganhou1) v1++;
              if (ganhou2) v2++;
            %>
            <div style="display:grid; grid-template-columns:0.6rem 1fr auto 1fr; gap:0.4rem; align-items:center; font-size:0.72rem;">
              <span style="color:var(--text-muted); text-align:center; font-weight:700;"><%= i + 1 %>º</span>
              <div style="text-align:right; font-weight:700; color:<%= ganhou1 ? '#58d68d' : 'var(--text-muted)' %>;"><%= s1 %></div>
              <span style="color:var(--text-muted); font-weight:400;">x</span>
              <div style="text-align:left; font-weight:700; color:<%= ganhou2 ? '#58d68d' : 'var(--text-muted)' %>;"><%= s2 %></div>
            </div>
          <% }); %>
        </div>
        <div class="juiz-score" style="margin-bottom:0.35rem;">
          <span><%= v1 %></span>
          <span class="sep">x</span>
          <span><%= v2 %></span>
          <span style="font-size:0.6rem; color:var(--text-muted); font-weight:600; margin-left:0.2rem;">sets</span>
        </div>
      <% } else { %>
        <div class="juiz-score" style="margin-bottom:0.5rem;">
          <span><%= jogo.placar_1 != null ? jogo.placar_1 : 0 %></span>
          <span class="sep">x</span>
          <span><%= jogo.placar_2 != null ? jogo.placar_2 : 0 %></span>
        </div>
      <% } %>
      <div class="juiz-status juiz-status--done">Encerrado</div>
      <div style="margin-top:0.9rem;">
        <a class="juiz-btn juiz-btn--ghost" href="/juiz/jogos/<%= jogo.id %>/placar?editar=1">Corrigir placar</a>
      </div>
    </div>
  <% } %>
</section>

<form id="formWO" action="/juiz/jogos/<%= jogo.id %>/wo" method="POST" style="display:none;">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="campus_vencedor" id="woCampusVencedor">
</form>

<div id="woConfirmModal" class="confirm-modal-overlay" hidden>
  <div class="confirm-modal-card" role="dialog" aria-modal="true" aria-labelledby="woConfirmTitle">
    <div class="confirm-modal-icon">⚠</div>
    <h3 id="woConfirmTitle">Confirmar W.O.</h3>
    <p id="woConfirmMessage"></p>
    <div class="confirm-modal-actions">
      <button type="button" class="btn btn-ghost" onclick="fecharConfirmacaoWO()">Cancelar</button>
      <button type="button" class="btn btn-primary" onclick="confirmarEnvioWO()">Aplicar W.O.</button>
    </div>
  </div>
</div>

<div id="desfazerWOConfirmModal" class="confirm-modal-overlay" hidden>
  <div class="confirm-modal-card" role="dialog" aria-modal="true" aria-labelledby="desfazerWOTitle">
    <div class="confirm-modal-icon">↩</div>
    <h3 id="desfazerWOTitle">Desfazer W.O.?</h3>
    <p>O placar do W.O. será removido e o jogo voltará para Agendado.</p>
    <div class="confirm-modal-actions">
      <button type="button" class="btn btn-ghost" onclick="fecharDesfazerWO()">Cancelar</button>
      <button type="button" class="btn btn-primary" onclick="confirmarDesfazerWO()">Desfazer W.O.</button>
    </div>
  </div>
</div>

<script>
let woCampusSelecionado = null;

function toggleAdiar() {
  const panel = document.getElementById('adiarPanel');
  const btn = document.getElementById('btnAdiar');
  if (!panel) return;
  const aberto = !panel.hidden;
  panel.hidden = aberto;
  btn.textContent = aberto ? 'Adiar partida' : 'Cancelar';
}
let cartaoIndex = 0;
function adicionarCartao(block) {
  const campusId = block.getAttribute('data-campus-id');
  const rows = block.querySelector('.cartao-rows');
  const i = cartaoIndex++;
  const row = document.createElement('div');
  row.className = 'cartao-row juiz-card-row';

  const btnStyle = 'font-size:0.68rem; padding:0.28rem 0.3rem; border-radius:6px; background:rgba(var(--fg-rgb), 0.06); border:1px solid rgba(var(--fg-rgb), 0.15); color: var(--text);';

  const select = document.createElement('select');
  select.name = 'cartoes[' + i + '][tipo]';
  select.style.cssText = btnStyle + ' cursor:pointer;';
  const optAmarelo = document.createElement('option');
  optAmarelo.value = 'amarelo';
  optAmarelo.textContent = 'Amarelo';
  const optVermelho = document.createElement('option');
  optVermelho.value = 'vermelho';
  optVermelho.textContent = 'Vermelho';
  select.appendChild(optAmarelo);
  select.appendChild(optVermelho);

  const inputNome = document.createElement('input');
  inputNome.type = 'text';
  inputNome.name = 'cartoes[' + i + '][jogador_nome]';
  inputNome.placeholder = 'Nome do jogador';
  inputNome.maxLength = 120;
  inputNome.style.cssText = btnStyle + ' min-width:0;';

  const inputMinuto = document.createElement('input');
  inputMinuto.type = 'number';
  inputMinuto.name = 'cartoes[' + i + '][minuto]';
  inputMinuto.placeholder = 'Min';
  inputMinuto.min = '0';
  inputMinuto.max = '200';
  inputMinuto.style.cssText = btnStyle + ' width:52px; text-align:center;';

  const inputCampus = document.createElement('input');
  inputCampus.type = 'hidden';
  inputCampus.name = 'cartoes[' + i + '][campus_id]';
  inputCampus.value = campusId;

  const btn = document.createElement('button');
  btn.type = 'button';
  btn.textContent = 'Remover';
  btn.style.cssText = 'font-size:0.62rem; font-weight:700; padding:0.25rem 0.45rem; border-radius:6px; background:rgba(231,76,60,0.12); border:1px solid rgba(231,76,60,0.3); color:#e74c3c; cursor:pointer; grid-column:span 4; width:100%;';
  btn.addEventListener('click', function () { row.remove(); });

  row.appendChild(select);
  row.appendChild(inputNome);
  row.appendChild(inputMinuto);
  row.appendChild(inputCampus);
  row.appendChild(btn);
  rows.appendChild(row);
}

function confirmarWO(campusId, campusNome) {
  woCampusSelecionado = campusId;
  const mensagem = document.getElementById('woConfirmMessage');
  const modal = document.getElementById('woConfirmModal');
  if (mensagem) mensagem.textContent = 'Aplicar W.O. a favor de ' + campusNome + '? Esta ação não pode ser desfeita.';
  if (modal) {
    modal.hidden = false;
    modal.classList.add('active');
  }
}

function fecharConfirmacaoWO() {
  const modal = document.getElementById('woConfirmModal');
  if (modal) {
    modal.hidden = true;
    modal.classList.remove('active');
  }
  woCampusSelecionado = null;
}

function confirmarEnvioWO() {
  if (!woCampusSelecionado) return;
  document.getElementById('woCampusVencedor').value = woCampusSelecionado;
  document.getElementById('formWO').submit();
}

function abrirDesfazerWO() {
  const modal = document.getElementById('desfazerWOConfirmModal');
  if (modal) {
    modal.hidden = false;
    modal.classList.add('active');
  }
}

function fecharDesfazerWO() {
  const modal = document.getElementById('desfazerWOConfirmModal');
  if (modal) {
    modal.hidden = true;
    modal.classList.remove('active');
  }
}

function confirmarDesfazerWO() {
  document.getElementById('desfazerWOForm')?.submit();
}

function confirmarSet(numeroSet) {
  const row = document.querySelector('.set-row[data-set="' + numeroSet + '"]');
  if (!row) return;
  const p1 = row.querySelector('.set-p1');
  const p2 = row.querySelector('.set-p2');
  const v1 = parseInt(p1.value) || 0;
  const v2 = parseInt(p2.value) || 0;

  if (v1 === 0 && v2 === 0) {
    alert('Preencha o placar deste set antes de confirmar.');
    return;
  }

  p1.readOnly = true;
  p2.readOnly = true;
  p1.style.opacity = '0.6';
  p1.style.cursor = 'default';
  p2.style.opacity = '0.6';
  p2.style.cursor = 'default';
  row.classList.add('is-confirmed');

  const btn = row.querySelector('.btn-confirmar-set');
  if (btn) {
    btn.textContent = '✓';
    btn.classList.remove('juiz-btn--ghost');
    btn.classList.add('juiz-btn--success');
    btn.style.pointerEvents = 'none';
  }

  calcularSets();

  if (numeroSet < 3) {
    const nextRow = document.querySelector('.set-row[data-set="' + (numeroSet + 1) + '"]');
    if (nextRow) {
      const nextP1 = nextRow.querySelector('.set-p1');
      if (nextP1 && !nextP1.readOnly) nextP1.focus();
    }
  }
}

function calcularSets() {
  if (typeof window._setInputs1 === 'undefined') return;
  const inputs1 = window._setInputs1;
  const inputs2 = window._setInputs2;
  const setsVencidos1El = document.getElementById('setsVencidos1');
  const setsVencidos2El = document.getElementById('setsVencidos2');
  const totalPontos1El = document.getElementById('totalPontos1');
  const totalPontos2El = document.getElementById('totalPontos2');
  const placar1Hidden = document.getElementById('placar1Hidden');
  const placar2Hidden = document.getElementById('placar2Hidden');

  let sets1 = 0, sets2 = 0, total1 = 0, total2 = 0;

  for (let i = 0; i < inputs1.length; i++) {
    const v1 = parseInt(inputs1[i].value) || 0;
    const v2 = parseInt(inputs2[i].value) || 0;

    total1 += v1;
    total2 += v2;

    if (v1 > v2) sets1++;
    else if (v2 > v1) sets2++;
  }

  setsVencidos1El.textContent = sets1;
  setsVencidos2El.textContent = sets2;
  totalPontos1El.textContent = total1;
  totalPontos2El.textContent = total2;

  if (placar1Hidden) placar1Hidden.value = total1;
  if (placar2Hidden) placar2Hidden.value = total2;

  for (let i = 0; i < inputs1.length; i++) {
    const v1 = parseInt(inputs1[i].value) || 0;
    const v2 = parseInt(inputs2[i].value) || 0;
    const row = inputs1[i].closest('.set-row');
    if (row && !inputs1[i].readOnly) {
      if (v1 > v2 || v2 > v1) {
        row.classList.add('is-confirmed');
      } else {
        row.classList.remove('is-confirmed');
      }
    }
  }
}

(function() {
  const temSets = <%= typeof temSets !== 'undefined' && temSets ? 'true' : 'false' %>;
  if (!temSets) return;

  window._setInputs1 = document.querySelectorAll('.set-p1');
  window._setInputs2 = document.querySelectorAll('.set-p2');

  window._setInputs1.forEach(inp => inp.addEventListener('input', calcularSets));
  window._setInputs2.forEach(inp => inp.addEventListener('input', calcularSets));

  calcularSets();
})();
</script>
