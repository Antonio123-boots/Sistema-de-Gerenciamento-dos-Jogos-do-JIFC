<%
  const temSets = typeof regras !== 'undefined' && regras && regras.temSets;
  const setsSalvos = (jogo.sets || []);
  const fotoCasaReal = !!(jogo.fotoCasa && jogo.fotoCasa !== '/imagens/avatar.svg');
  const fotoForaReal = !!(jogo.fotoFora && jogo.fotoFora !== '/imagens/avatar.svg');
%>

<section class="panel-card" style="max-width:520px; margin:1rem auto;">
  <div style="margin-bottom:1rem;">
    <a href="/juiz/<%= encodeURIComponent(typeof esporteVoltar !== 'undefined' && esporteVoltar ? esporteVoltar : jogo.modalidade.split(' ')[0]) %>" style="color:rgba(255,255,255,0.5); text-decoration:none; font-size:0.85rem;">← Voltar para <%= typeof esporteVoltar !== 'undefined' && esporteVoltar ? esporteVoltar : jogo.modalidade.split(' ')[0] %></a>
  </div>

  <h1 style="font-size:1.25rem; margin:0 0 0.25rem;">Atualizar Placar</h1>
  <p class="panel-subtitle" style="margin:0 0 1.25rem;">Registre o resultado e o status do confronto.</p>

  <% if (jogo.status === 'Em Andamento') { %>
    <div style="display:inline-flex; align-items:center; gap:0.4rem; font-size:0.7rem; font-weight:700; padding:0.25rem 0.7rem; border-radius:999px; background:rgba(241,196,39,0.18); color:#f5b041; margin-bottom:1rem;">
      <span style="width:0.5rem; height:0.5rem; border-radius:50%; background:#f5b041; animation: pulsarBool 1.2s infinite;"></span>
      Em Andamento
    </div>
    <style>@keyframes pulsarBool { 0%,100% { opacity:1; } 50% { opacity:0.25; } }</style>
  <% } %>

  <% if (typeof mensagemErro !== 'undefined' && mensagemErro) { %>
    <div class="alert alert-error"><%= mensagemErro %></div>
  <% } %>

  <% if (jogo.wo) { %>
    <div style="background:rgba(245,176,65,0.1); border:1px solid rgba(245,176,65,0.25); border-radius:12px; padding:0.75rem 1rem; margin-bottom:1.25rem; text-align:center;">
      <div style="font-size:0.9rem; font-weight:700; color:#f5b041;">W.O. aplicado</div>
      <p style="font-size:0.75rem; color:#b8c2cc; margin:0.3rem 0 0;">Este jogo foi finalizado por Walk Over.</p>
    </div>
  <% } %>

  <article class="panel-card" style="padding:1rem; background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.08); border-radius:18px; margin-bottom:1.25rem;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem; min-height:1.5rem;">
      <div style="font-size:0.75rem; color:#cfd8dc; text-transform:uppercase; letter-spacing:0.08em; line-height:1.3;"><%= jogo.modalidade %> · <%= jogo.genero %></div>
    </div>

    <div style="display:grid; grid-template-columns:minmax(0,1fr) auto minmax(0,1fr); gap:0.75rem; align-items:center; flex:1;">
      <div style="text-align:center; min-width:0;">
        <img src="<%= jogo.fotoCasa || '/imagens/avatar.svg' %>" alt="Foto do campus <%= jogo.casa %>" class="campus-photo campus-photo--md campus-photo--badge <%= fotoCasaReal ? 'campus-photo--real' : 'campus-photo--default' %>" style="margin:0 auto 0.55rem;">
        <div style="font-size:0.75rem; color:#fff; font-weight:600; line-height:1.2; word-break:break-word;"><%= (jogo.casa && jogo.casa !== 'Atleta não informado' && jogo.casa !== 'Campus não informado') ? jogo.casa : (jogo.rotuloCasa || 'A Definir') %></div>
      </div>

      <div style="display:flex; flex-direction:column; gap:0.25rem; justify-items:center; text-align:center; align-items:center; flex-shrink:0;">
        <div style="font-size:0.95rem; font-weight:700; color:#fff; line-height:1.2;"><%= jogo.horario %></div>
        <div style="font-size:0.65rem; color:#cfd8dc; text-transform:uppercase; letter-spacing:0.08em; line-height:1.2;"><%= jogo.localJogo || 'A def' %></div>
        <div style="font-size:0.65rem; color:#cfd8dc; line-height:1.2;"><%= jogo.data %></div>
      </div>

      <div style="text-align:center; min-width:0;">
        <img src="<%= jogo.fotoFora || '/imagens/avatar.svg' %>" alt="Foto do campus <%= jogo.fora %>" class="campus-photo campus-photo--md campus-photo--badge <%= fotoForaReal ? 'campus-photo--real' : 'campus-photo--default' %>" style="margin:0 auto 0.55rem;">
        <div style="font-size:0.75rem; color:#fff; font-weight:600; line-height:1.2; word-break:break-word;"><%= (jogo.fora && jogo.fora !== 'Atleta não informado' && jogo.fora !== 'Campus não informado') ? jogo.fora : (jogo.rotuloFora || 'A Definir') %></div>
      </div>
    </div>
  </article>

  <% if (jogo.bloqueado) { %>
    <div style="margin-top:1.25rem; text-align:center; padding:1.5rem 1rem; border-radius:12px; background:rgba(180,130,60,0.1); border:1px solid rgba(180,130,60,0.25);">
      <p style="font-size:0.85rem; color:#b4823c; font-weight:600; margin:0 0 0.3rem;">Aguardando encerramento da fase anterior</p>
      <p style="font-size:0.75rem; color:#8a7a5a; margin:0;">Este jogo será liberado automaticamente quando todos os jogos da fase anterior forem encerrados.</p>
    </div>
  <% } else if (!jogo.wo && jogo.status !== 'Encerrado') { %>
    <form action="/juiz/jogos/<%= jogo.id %>/placar" method="POST" style="margin-top:1.25rem;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <% if (temSets) { %>
        <div id="setsSection">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.6rem;">
            <span style="font-size:0.75rem; color:#cfd8dc; font-weight:600; text-transform:uppercase; letter-spacing:0.06em;">Placar por Sets</span>
            <span style="font-size:0.65rem; color:#8a9ab5;">Melhor de 3</span>
          </div>

          <div id="setsContainer" style="display:flex; flex-direction:column; gap:0.5rem; margin-bottom:0.75rem;">
            <% for (let s = 1; s <= 3; s++) { %>
              <% const setSalvo = setsSalvos[s-1]; %>
              <% const confirmado = setSalvo && (Number(setSalvo.pontos_1 || 0) > 0 || Number(setSalvo.pontos_2 || 0) > 0); %>
              <div class="set-row" data-set="<%= s %>" style="display:grid; grid-template-columns:0.6rem 1fr auto 1fr auto; gap:0.4rem; align-items:center; padding:0.45rem 0.6rem; border-radius:10px; background:rgba(255,255,255,0.03); border:1px solid <%= confirmado ? 'rgba(88,214,141,0.4)' : 'rgba(255,255,255,0.08)' %>;">
                <span style="font-size:0.65rem; font-weight:700; color:#8a9ab5; text-align:center;"><%= s %>º</span>
                <input type="number" name="sets[<%= s - 1 %>][pontos_1]" min="0" value="<%= setSalvo ? setSalvo.pontos_1 : 0 %>" class="set-input set-p1" <%= confirmado ? 'readonly' : '' %> style="width:100%; text-align:center; font-size:1rem; font-weight:700; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.15); border-radius:8px; color:#fff; padding:0.35rem 0.25rem; outline:none; <%= confirmado ? 'opacity:0.6; cursor:default;' : '' %>">
                <span style="font-size:0.8rem; font-weight:700; color:rgba(255,255,255,0.3);">x</span>
                <input type="number" name="sets[<%= s - 1 %>][pontos_2]" min="0" value="<%= setSalvo ? setSalvo.pontos_2 : 0 %>" class="set-input set-p2" <%= confirmado ? 'readonly' : '' %> style="width:100%; text-align:center; font-size:1rem; font-weight:700; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.15); border-radius:8px; color:#fff; padding:0.35rem 0.25rem; outline:none; <%= confirmado ? 'opacity:0.6; cursor:default;' : '' %>">
                <button type="button" class="btn-confirmar-set" data-set="<%= s %>" onclick="confirmarSet(<%= s %>)" style="font-size:0.6rem; font-weight:700; padding:0.3rem 0.5rem; border-radius:6px; background:<%= confirmado ? 'rgba(88,214,141,0.15)' : 'rgba(255,255,255,0.06)' %>; border:1px solid <%= confirmado ? 'rgba(88,214,141,0.35)' : 'rgba(255,255,255,0.12)' %>; color:<%= confirmado ? '#58d68d' : '#8a9ab5' %>; cursor:pointer; white-space:nowrap; transition:all 0.2s; <%= confirmado ? 'pointer-events:none;' : '' %>"><%= confirmado ? '✓' : 'OK' %></button>
              </div>
            <% } %>
          </div>

          <div id="setsSummary" style="display:grid; grid-template-columns:1fr auto 1fr; gap:0.5rem; align-items:center; text-align:center; margin-bottom:0.75rem; padding:0.5rem; border-radius:10px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06);">
            <div>
              <div style="font-size:1.3rem; font-weight:800; color:#58d68d;" id="setsVencidos1">0</div>
              <div style="font-size:0.55rem; color:#8a9ab5; text-transform:uppercase;">Sets</div>
            </div>
            <div style="font-size:0.65rem; color:#cfd8dc; font-weight:700;">SETS</div>
            <div>
              <div style="font-size:1.3rem; font-weight:800; color:#58d68d;" id="setsVencidos2">0</div>
              <div style="font-size:0.55rem; color:#8a9ab5; text-transform:uppercase;">Sets</div>
            </div>
          </div>

          <div style="display:grid; grid-template-columns:1fr auto 1fr; gap:0.5rem; align-items:center; text-align:center; margin-bottom:0.75rem;">
            <div>
              <div style="font-size:1rem; font-weight:700; color:#fff;" id="totalPontos1">0</div>
              <div style="font-size:0.55rem; color:#8a9ab5; text-transform:uppercase;">Pontos Total</div>
            </div>
            <div style="font-size:0.65rem; color:#cfd8dc; font-weight:700;">PLACAR</div>
            <div>
              <div style="font-size:1rem; font-weight:700; color:#fff;" id="totalPontos2">0</div>
              <div style="font-size:0.55rem; color:#8a9ab5; text-transform:uppercase;">Pontos Total</div>
            </div>
          </div>

          <div style="display:flex; justify-content:center; gap:0.75rem; margin-bottom:0.5rem; flex-wrap:wrap;">
            <% if (jogo.casa && jogo.casa !== '—') { %>
              <button type="button" class="btn-wo" onclick="confirmarWO('<%= jogo.tipoIndividual && jogo.atleta_1_id ? jogo.atleta_1_id : jogo.campus_1_id %>', '<%= jogo.casa %>')" style="font-size:0.65rem; font-weight:700; padding:0.3rem 0.6rem; border-radius:8px; background:rgba(245,176,65,0.1); border:1px solid rgba(245,176,65,0.25); color:#f5b041; cursor:pointer; white-space:nowrap; transition:all 0.2s;">W.O. <%= jogo.casa %></button>
            <% } %>
            <% if (jogo.fora && jogo.fora !== '—') { %>
              <button type="button" class="btn-wo" onclick="confirmarWO('<%= jogo.tipoIndividual && jogo.atleta_2_id ? jogo.atleta_2_id : jogo.campus_2_id %>', '<%= jogo.fora %>')" style="font-size:0.65rem; font-weight:700; padding:0.3rem 0.6rem; border-radius:8px; background:rgba(245,176,65,0.1); border:1px solid rgba(245,176,65,0.25); color:#f5b041; cursor:pointer; white-space:nowrap; transition:all 0.2s;">W.O. <%= jogo.fora %></button>
            <% } %>
          </div>
        </div>

        <input type="hidden" name="placar1" id="placar1Hidden" value="<%= setsSalvos.reduce((acc, s) => acc + Number(s.pontos_1 || 0), 0) %>">
        <input type="hidden" name="placar2" id="placar2Hidden" value="<%= setsSalvos.reduce((acc, s) => acc + Number(s.pontos_2 || 0), 0) %>">
      <% } else { %>
        <div style="display:grid; grid-template-columns:1fr auto 1fr; gap:0.5rem; align-items:start; margin-bottom:1rem;">
          <div style="display:flex; flex-direction:column; align-items:center; gap:0.5rem;">
            <input type="number" name="placar1" min="0" value="<%= jogo.placar_1 != null ? jogo.placar_1 : 0 %>" required style="width:80px; text-align:center; font-size:1.8rem; font-weight:700; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.15); border-radius:12px; color:#fff; padding:0.5rem; outline:none;">
            <% if (jogo.casa && jogo.casa !== '—') { %>
              <button type="button" onclick="confirmarWO('<%= jogo.tipoIndividual && jogo.atleta_1_id ? jogo.atleta_1_id : jogo.campus_1_id %>', '<%= jogo.casa %>')" style="font-size:0.65rem; font-weight:700; padding:0.3rem 0.6rem; border-radius:8px; background:rgba(245,176,65,0.1); border:1px solid rgba(245,176,65,0.25); color:#f5b041; cursor:pointer; white-space:nowrap; transition:all 0.2s;">W.O.</button>
            <% } %>
          </div>

          <div style="display:flex; align-items:center; padding-top:0.3rem;">
            <span style="font-size:1.1rem; font-weight:700; color:rgba(255,255,255,0.4);">x</span>
          </div>

          <div style="display:flex; flex-direction:column; align-items:center; gap:0.5rem;">
            <input type="number" name="placar2" min="0" value="<%= jogo.placar_2 != null ? jogo.placar_2 : 0 %>" required style="width:80px; text-align:center; font-size:1.8rem; font-weight:700; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.15); border-radius:12px; color:#fff; padding:0.5rem; outline:none;">
            <% if (jogo.fora && jogo.fora !== '—') { %>
              <button type="button" onclick="confirmarWO('<%= jogo.tipoIndividual && jogo.atleta_2_id ? jogo.atleta_2_id : jogo.campus_2_id %>', '<%= jogo.fora %>')" style="font-size:0.65rem; font-weight:700; padding:0.3rem 0.6rem; border-radius:8px; background:rgba(245,176,65,0.1); border:1px solid rgba(245,176,65,0.25); color:#f5b041; cursor:pointer; white-space:nowrap; transition:all 0.2s;">W.O.</button>
            <% } %>
          </div>
        </div>

        <% const fasesEliminatoria = ['Oitavas', 'Quartas', 'Semifinal', 'Final', 'Terceiro Lugar'];
           if (fasesEliminatoria.includes(String(jogo.fase || ''))) { %>
          <div style="display:flex; gap:0.6rem; justify-content:center; align-items:center; margin:-0.4rem 0 1rem; flex-wrap:wrap;">
            <span style="font-size:0.68rem; color:#8a9ab5; font-weight:600;">Disputa (pênaltis / 7m / cesta livre)</span>
            <input type="number" name="disputa1" min="0" value="<%= jogo.disputa_pontos_1 != null ? jogo.disputa_pontos_1 : '' %>" placeholder="—" style="width:52px; text-align:center; font-size:0.95rem; font-weight:700; background:rgba(245,176,65,0.08); border:1px solid rgba(245,176,65,0.3); border-radius:8px; color:#f5b041; padding:0.3rem; outline:none;">
            <span style="font-size:0.8rem; color:rgba(255,255,255,0.4);">×</span>
            <input type="number" name="disputa2" min="0" value="<%= jogo.disputa_pontos_2 != null ? jogo.disputa_pontos_2 : '' %>" placeholder="—" style="width:52px; text-align:center; font-size:0.95rem; font-weight:700; background:rgba(245,176,65,0.08); border:1px solid rgba(245,176,65,0.3); border-radius:8px; color:#f5b041; padding:0.3rem; outline:none;">
          </div>
        <% } %>
      <% } %>

      <% if (typeof regras !== 'undefined' && regras && regras.temCartoes && jogo.campus_1_id && jogo.campus_2_id) { %>
        <div id="cartoesSection" style="margin-bottom:1rem;">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.6rem;">
            <span style="font-size:0.75rem; color:#cfd8dc; font-weight:600; text-transform:uppercase; letter-spacing:0.06em;">Cartões (Fair Play)</span>
            <span style="font-size:0.65rem; color:#8a9ab5;">Amarelo -1 · Vermelho -3</span>
          </div>

          <div style="display:flex; flex-direction:column; gap:0.6rem;">
            <div class="cartao-campus-block" data-campus-id="<%= jogo.campus_1_id %>" style="padding:0.6rem 0.7rem; border-radius:10px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
              <div style="display:flex; justify-content:space-between; align-items:center;">
                <span style="font-size:0.72rem; font-weight:700; color:#fff;"><%= jogo.casa %></span>
                <button type="button" onclick="adicionarCartao(this.closest('.cartao-campus-block'))" style="font-size:0.62rem; font-weight:700; padding:0.25rem 0.5rem; border-radius:6px; background:rgba(88,214,141,0.12); border:1px solid rgba(88,214,141,0.3); color:#58d68d; cursor:pointer;">+ Cartão</button>
              </div>
              <div class="cartao-rows" style="display:flex; flex-direction:column; gap:0.35rem; margin-top:0.45rem;"></div>
            </div>

            <div class="cartao-campus-block" data-campus-id="<%= jogo.campus_2_id %>" style="padding:0.6rem 0.7rem; border-radius:10px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
              <div style="display:flex; justify-content:space-between; align-items:center;">
                <span style="font-size:0.72rem; font-weight:700; color:#fff;"><%= jogo.fora %></span>
                <button type="button" onclick="adicionarCartao(this.closest('.cartao-campus-block'))" style="font-size:0.62rem; font-weight:700; padding:0.25rem 0.5rem; border-radius:6px; background:rgba(88,214,141,0.12); border:1px solid rgba(88,214,141,0.3); color:#58d68d; cursor:pointer;">+ Cartão</button>
              </div>
              <div class="cartao-rows" style="display:flex; flex-direction:column; gap:0.35rem; margin-top:0.45rem;"></div>
            </div>
          </div>
        </div>
      <% } %>

      <input type="hidden" name="status" value="Encerrado">

      <div style="margin-top:1.25rem;">
        <button type="submit" class="premium-action-btn primary-save-btn" id="btnEncerrar" style="width:100%;">
          <span>Encerrar jogo</span>
        </button>
      </div>
    </form>

    <div style="margin-top:1rem; text-align:center;">
      <button type="button" id="btnAdiar" onclick="toggleAdiar()" style="font-size:0.85rem; font-weight:700; padding:0.55rem 1rem; border-radius:10px; background:rgba(245,176,65,0.1); border:1px solid rgba(245,176,65,0.35); color:#f5b041; cursor:pointer; transition:all 0.2s;">
        Adiar partida
      </button>

      <div id="adiarPanel" style="display:none; margin-top:0.85rem; text-align:left; padding:1rem; border:1px dashed rgba(245,176,65,0.35); border-radius:12px; background:rgba(245,176,65,0.06);">
        <div style="font-size:0.75rem; color:#cfd8dc; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.6rem;">Marcar novo dia e horário</div>
        <p style="font-size:0.7rem; color:#8a9ab5; margin:0 0 0.6rem;">Horário atual: <%= jogo.data %> às <%= jogo.horario %>.</p>
        <form action="/juiz/jogos/<%= jogo.id %>/adiar" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div style="display:flex; gap:0.6rem; flex-wrap:wrap;">
            <div style="flex:1; min-width:140px;">
              <label for="nova_data" style="display:block; font-size:0.65rem; color:#8a9ab5; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:0.3rem;">Nova data</label>
              <input type="date" name="nova_data" id="nova_data" required style="width:100%; font-size:0.85rem; font-weight:700; padding:0.45rem 0.5rem; border-radius:8px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.15); color:#fff; outline:none;">
            </div>
            <div style="flex:1; min-width:110px;">
              <label for="nova_hora" style="display:block; font-size:0.65rem; color:#8a9ab5; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:0.3rem;">Novo horário</label>
              <input type="time" name="nova_hora" id="nova_hora" required style="width:100%; font-size:0.85rem; font-weight:700; padding:0.45rem 0.5rem; border-radius:8px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.15); color:#fff; outline:none;">
            </div>
          </div>
          <button type="submit" style="margin-top:0.85rem; width:100%; font-size:0.85rem; font-weight:700; padding:0.55rem 1rem; border-radius:10px; background:rgba(245,176,65,0.18); border:1px solid rgba(245,176,65,0.45); color:#f5b041; cursor:pointer; transition:all 0.2s;">
            Confirmar adiamento
          </button>
        </form>
      </div>
    </div>
  <% } else if (jogo.status === 'Encerrado' && !jogo.wo) { %>
    <div style="margin-top:1.25rem; text-align:center;">
      <% if (temSets && setsSalvos.length > 0) { %>
        <div style="font-size:0.65rem; color:#8a9ab5; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.5rem;">Resultado por Sets</div>
        <div style="display:flex; flex-direction:column; gap:0.3rem; margin-bottom:0.6rem;">
          <% let v1 = 0, v2 = 0; %>
          <% setsSalvos.forEach((s, i) => { %>
            <%
              const s1 = Number(s.pontos_1 || 0);
              const s2 = Number(s.pontos_2 || 0);
              const ganhou1 = s1 > s2;
              const ganhou2 = s2 > s1;
              if (ganhou1) v1++;
              if (ganhou2) v2++;
            %>
            <div style="display:grid; grid-template-columns:0.5rem 1fr auto 1fr; gap:0.4rem; align-items:center; font-size:0.7rem;">
              <span style="color:#8a9ab5; text-align:center; font-weight:700;"><%= i + 1 %>º</span>
              <div style="text-align:right; font-weight:700; color:<%= ganhou1 ? '#58d68d' : '#dfe3e8' %>;"><%= s1 %></div>
              <span style="color:#8a9ab5; font-weight:400;">x</span>
              <div style="text-align:left; font-weight:700; color:<%= ganhou2 ? '#58d68d' : '#dfe3e8' %>;"><%= s2 %></div>
            </div>
          <% }); %>
        </div>
        <div style="font-size:1.15rem; font-weight:800; color:#fff; line-height:1.2; letter-spacing:0.02em; margin-bottom:0.2rem;">
          <span><%= v1 %></span>
          <span style="color:#6c757d; margin:0 0.25rem; font-weight:400;">x</span>
          <span><%= v2 %></span>
          <span style="font-size:0.6rem; color:#8a9ab5; font-weight:600; margin-left:0.2rem;">sets</span>
        </div>
      <% } else { %>
        <div style="font-size:1.15rem; font-weight:800; color:#fff; line-height:1.2; letter-spacing:0.02em; margin-bottom:0.5rem;">
          <span><%= jogo.placar_1 != null ? jogo.placar_1 : 0 %></span>
          <span style="color:#6c757d; margin:0 0.25rem; font-weight:400;">x</span>
          <span><%= jogo.placar_2 != null ? jogo.placar_2 : 0 %></span>
        </div>
      <% } %>
      <div style="font-size:0.75rem; font-weight:700; padding:0.2rem 0.7rem; border-radius:8px; display:inline-block; background:rgba(88,214,141,0.18); color:#58d68d;">Encerrado</div>
    </div>
  <% } %>
</section>

<form id="formWO" action="/juiz/jogos/<%= jogo.id %>/wo" method="POST" style="display:none;">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="campus_vencedor" id="woCampusVencedor">
</form>

<script>
function toggleAdiar() {
  const panel = document.getElementById('adiarPanel');
  const btn = document.getElementById('btnAdiar');
  if (!panel) return;
  const aberto = panel.style.display !== 'none';
  panel.style.display = aberto ? 'none' : 'block';
  btn.textContent = aberto ? 'Adiar partida' : 'Cancelar';
}
let cartaoIndex = 0;
function adicionarCartao(block) {
  const campusId = block.getAttribute('data-campus-id');
  const rows = block.querySelector('.cartao-rows');
  const i = cartaoIndex++;
  const row = document.createElement('div');
  row.className = 'cartao-row';
  row.style.cssText = 'display:grid; grid-template-columns:auto 1fr auto auto; gap:0.35rem; align-items:center;';

  const btnStyle = 'font-size:0.68rem; padding:0.28rem 0.3rem; border-radius:6px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.15); color:#fff;';

  const select = document.createElement('select');
  select.name = 'cartoes[' + i + '][tipo]';
  select.style.cssText = btnStyle + ' cursor:pointer;';
  const optAmarelo = document.createElement('option');
  optAmarelo.value = 'amarelo';
  optAmarelo.textContent = 'Amarelo';
  const optVermelho = document.createElement('option');
  optVermelho.value = 'vermelho';
  optVermelho.textContent = 'Vermelho';
  select.appendChild(optAmarelo);
  select.appendChild(optVermelho);

  const inputNome = document.createElement('input');
  inputNome.type = 'text';
  inputNome.name = 'cartoes[' + i + '][jogador_nome]';
  inputNome.placeholder = 'Nome do jogador';
  inputNome.maxLength = 120;
  inputNome.style.cssText = btnStyle + ' min-width:0;';

  const inputMinuto = document.createElement('input');
  inputMinuto.type = 'number';
  inputMinuto.name = 'cartoes[' + i + '][minuto]';
  inputMinuto.placeholder = 'Min';
  inputMinuto.min = '0';
  inputMinuto.max = '200';
  inputMinuto.style.cssText = btnStyle + ' width:52px; text-align:center;';

  const inputCampus = document.createElement('input');
  inputCampus.type = 'hidden';
  inputCampus.name = 'cartoes[' + i + '][campus_id]';
  inputCampus.value = campusId;

  const btn = document.createElement('button');
  btn.type = 'button';
  btn.textContent = 'Remover';
  btn.style.cssText = 'font-size:0.62rem; font-weight:700; padding:0.25rem 0.45rem; border-radius:6px; background:rgba(231,76,60,0.12); border:1px solid rgba(231,76,60,0.3); color:#e74c3c; cursor:pointer; grid-column:span 4; width:100%;';
  btn.addEventListener('click', function () { row.remove(); });

  row.appendChild(select);
  row.appendChild(inputNome);
  row.appendChild(inputMinuto);
  row.appendChild(inputCampus);
  row.appendChild(btn);
  rows.appendChild(row);
}

function confirmarWO(campusId, campusNome) {
  if (!confirm('Aplicar W.O. a favor de ' + campusNome + '? Esta ação não pode ser desfeita.')) return;
  document.getElementById('woCampusVencedor').value = campusId;
  document.getElementById('formWO').submit();
}

function confirmarSet(numeroSet) {
  const row = document.querySelector('.set-row[data-set="' + numeroSet + '"]');
  if (!row) return;
  const p1 = row.querySelector('.set-p1');
  const p2 = row.querySelector('.set-p2');
  const v1 = parseInt(p1.value) || 0;
  const v2 = parseInt(p2.value) || 0;

  if (v1 === 0 && v2 === 0) {
    alert('Preencha o placar deste set antes de confirmar.');
    return;
  }

  p1.readOnly = true;
  p2.readOnly = true;
  p1.style.opacity = '0.6';
  p1.style.cursor = 'default';
  p2.style.opacity = '0.6';
  p2.style.cursor = 'default';
  row.style.borderColor = 'rgba(88,214,141,0.4)';

  const btn = row.querySelector('.btn-confirmar-set');
  if (btn) {
    btn.textContent = '✓';
    btn.style.background = 'rgba(88,214,141,0.15)';
    btn.style.borderColor = 'rgba(88,214,141,0.35)';
    btn.style.color = '#58d68d';
    btn.style.pointerEvents = 'none';
  }

  calcularSets();

  if (numeroSet < 3) {
    const nextRow = document.querySelector('.set-row[data-set="' + (numeroSet + 1) + '"]');
    if (nextRow) {
      const nextP1 = nextRow.querySelector('.set-p1');
      if (nextP1 && !nextP1.readOnly) nextP1.focus();
    }
  }
}

function calcularSets() {
  if (typeof window._setInputs1 === 'undefined') return;
  const inputs1 = window._setInputs1;
  const inputs2 = window._setInputs2;
  const setsVencidos1El = document.getElementById('setsVencidos1');
  const setsVencidos2El = document.getElementById('setsVencidos2');
  const totalPontos1El = document.getElementById('totalPontos1');
  const totalPontos2El = document.getElementById('totalPontos2');
  const placar1Hidden = document.getElementById('placar1Hidden');
  const placar2Hidden = document.getElementById('placar2Hidden');

  let sets1 = 0, sets2 = 0, total1 = 0, total2 = 0;

  for (let i = 0; i < inputs1.length; i++) {
    const v1 = parseInt(inputs1[i].value) || 0;
    const v2 = parseInt(inputs2[i].value) || 0;

    total1 += v1;
    total2 += v2;

    if (v1 > v2) sets1++;
    else if (v2 > v1) sets2++;
  }

  setsVencidos1El.textContent = sets1;
  setsVencidos2El.textContent = sets2;
  totalPontos1El.textContent = total1;
  totalPontos2El.textContent = total2;

  if (placar1Hidden) placar1Hidden.value = total1;
  if (placar2Hidden) placar2Hidden.value = total2;

  for (let i = 0; i < inputs1.length; i++) {
    const v1 = parseInt(inputs1[i].value) || 0;
    const v2 = parseInt(inputs2[i].value) || 0;
    const row = inputs1[i].closest('.set-row');
    if (row && !inputs1[i].readOnly) {
      if (v1 > v2 || v2 > v1) {
        row.style.borderColor = 'rgba(245,176,65,0.4)';
      } else {
        row.style.borderColor = 'rgba(255,255,255,0.08)';
      }
    }
  }
}

(function() {
  const temSets = <%= typeof temSets !== 'undefined' && temSets ? 'true' : 'false' %>;
  if (!temSets) return;

  window._setInputs1 = document.querySelectorAll('.set-p1');
  window._setInputs2 = document.querySelectorAll('.set-p2');

  window._setInputs1.forEach(inp => inp.addEventListener('input', calcularSets));
  window._setInputs2.forEach(inp => inp.addEventListener('input', calcularSets));

  calcularSets();
})();
</script>
