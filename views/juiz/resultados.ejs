<section class="juiz-page">
  <header class="juiz-page-head">
    <div>
      <p class="juiz-page-kicker">Resultados</p>
      <h1><%= esporte %></h1>
      <p class="juiz-page-subtitle">
        <%= tipoEsporte === 'atletismo' ? 'Cadastre as provas e lance os resultados dos atletas.' : 'Registre a pontuação dos atletas.' %>
      </p>
    </div>
    <a class="juiz-back-link" href="/juiz/<%= encodeURIComponent(esporte) %>">← Voltar</a>
  </header>

  <% if (typeof mensagemSucesso !== 'undefined' && mensagemSucesso) { %>
    <div class="juiz-alert juiz-alert--success auto-dismiss"><%= mensagemSucesso %></div>
  <% } %>
  <% if (typeof mensagemErro !== 'undefined' && mensagemErro) { %>
    <div class="juiz-alert juiz-alert--danger auto-dismiss"><%= mensagemErro %></div>
  <% } %>

  <div class="juiz-toolbar">
    <span class="juiz-toolbar-label">Gênero</span>
    <% const generoEfetivo = generoFiltro || 'Masculino'; %>
    <% const filtros = [
      { label: 'Masculino', valor: 'Masculino' },
      { label: 'Feminino', valor: 'Feminino' }
    ]; %>
    <% filtros.forEach((f) => { %>
      <% const ativo = generoEfetivo === f.valor; %>
      <a class="juiz-chip <%= ativo ? 'is-active' : '' %>"
         href="/juiz/<%= encodeURIComponent(esporte) %>/resultados?genero=<%= encodeURIComponent(f.valor) %>">
        <%= f.label %>
      </a>
    <% }) %>
  </div>

  <% if (tipoEsporte === 'atletismo') { %>

    <div class="juiz-section">
      <div class="juiz-section-head">
        <div>
          <h2>Provas</h2>
          <p>Crie uma prova e clique em “Lançar” para registrar os resultados.</p>
        </div>
        <button type="button" class="juiz-btn juiz-btn--success" data-toggle-prova>
          + Nova prova
        </button>
      </div>

      <div id="formCriarProva" class="juiz-form-inline" hidden>
        <form method="POST" action="/juiz/<%= encodeURIComponent(esporte) %>/resultados/criar-prova" style="display:contents;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="modalidade_id" value="<%= modalidade.id %>">
          <div class="juiz-field juiz-field--grow">
            <label for="nomeProva">Nome da prova</label>
            <input id="nomeProva" name="nome" required placeholder="Ex: 100m rasos" class="juiz-input">
          </div>
          <div class="juiz-field">
            <label for="tipoResultadoSelect">Tipo</label>
            <select name="tipo_resultado" id="tipoResultadoSelect" class="juiz-select">
              <option value="medida">Distância / Altura</option>
              <option value="tempo">Tempo</option>
            </select>
          </div>
          <div id="formatoProvaWrapper" class="juiz-field" hidden>
            <label for="formatoProva">Formato</label>
            <select name="formato" id="formatoProva" class="juiz-select">
              <option value="final_por_tempo">Baterias · Final por tempo</option>
              <option value="baterias_com_final">Baterias · Com final</option>
              <option value="direta">Série única</option>
            </select>
          </div>
          <div class="juiz-field" style="max-width:100px;">
            <label for="ordemProva">Ordem</label>
            <input id="ordemProva" name="ordem" type="number" value="0" min="0" class="juiz-input">
          </div>
          <button type="submit" class="juiz-btn juiz-btn--primary">Criar prova</button>
        </form>
      </div>

      <% if (provas && provas.length > 0) { %>
        <div class="juiz-provas-grid" style="margin-top:1rem;">
          <% provas.forEach((prova) => { %>
            <article class="juiz-prova-card">
              <div>
                <div class="juiz-prova-card__title"><%= prova.nome %></div>
                <div class="juiz-prova-card__meta">
                  <%= prova.tipo_resultado === 'tempo' ? 'Tempo' : 'Distância / Altura' %>
                </div>
              </div>
              <div class="juiz-prova-card__actions">
                <a class="juiz-btn juiz-btn--success juiz-btn--sm"
                   href="/juiz/<%= encodeURIComponent(esporte) %>/resultados/prova/<%= prova.id %>">
                  Lançar
                </a>
                <form method="POST" action="/juiz/<%= encodeURIComponent(esporte) %>/resultados/excluir-prova/<%= prova.id %>"
                      onsubmit="return confirm('Excluir esta prova e todos os resultados?')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="juiz-btn juiz-btn--danger juiz-btn--sm" title="Excluir prova">✕</button>
                </form>
              </div>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <div class="juiz-empty" style="margin-top:1rem;">
          <h2>Nenhuma prova cadastrada</h2>
          <p>Crie a primeira prova para começar a lançar os resultados.</p>
        </div>
      <% } %>
    </div>

    <% if (classificacao && classificacao.length > 0) { %>
      <div class="juiz-section">
        <div class="juiz-section-head">
          <div>
            <h2>Classificação geral dos campus</h2>
            <p>Pontuação acumulada nas provas deste esporte.</p>
          </div>
        </div>
        <div class="juiz-table-wrap">
          <table class="juiz-table">
            <thead>
              <tr>
                <th style="width:3rem;">#</th>
                <th>Campus</th>
                <th class="is-center is-accent">PTS</th>
              </tr>
            </thead>
            <tbody>
              <% classificacao.forEach((c, idx) => { %>
                <tr>
                  <td><span class="juiz-rank-badge"><%= idx + 1 %>º</span></td>
                  <td class="cell-name"><%= c.campus_nome %></td>
                  <td class="cell-pts"><%= c.pontos %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

  <% } else if (tipoEsporte === 'xadrez') { %>

    <div class="juiz-section">
      <div class="juiz-section-head">
        <div>
          <h2>Pontuação dos atletas</h2>
          <p>Informe pontos, vitórias, derrotas e empates de cada atleta.</p>
        </div>
      </div>

      <form method="POST" action="/juiz/<%= encodeURIComponent(esporte) %>/resultados/salvar-xadrez">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="modalidade_id" value="<%= modalidade.id %>">
        <div class="juiz-table-wrap">
          <table class="juiz-table">
            <thead>
              <tr>
                <th>Atleta</th>
                <th>Campus</th>
                <th class="is-center is-accent">PTS</th>
                <th class="is-center">V</th>
                <th class="is-center">D</th>
                <th class="is-center">E</th>
              </tr>
            </thead>
            <tbody>
              <% atletas.forEach((atleta) => {
                const res = (resultados || []).find(r => r.atleta_id === atleta.id) || {};
              %>
                <tr>
                  <td class="cell-name"><%= atleta.nome %></td>
                  <td class="cell-muted"><%= atleta.campus_nome %></td>
                  <td class="is-center">
                    <input type="hidden" name="resultados[<%= atleta.id %>][atleta_id]" value="<%= atleta.id %>">
                    <input type="number" name="resultados[<%= atleta.id %>][pontuacao]" value="<%= res.pontuacao || 0 %>" step="0.5" min="0" style="width:72px;" class="is-accent">
                  </td>
                  <td class="is-center">
                    <input type="number" name="resultados[<%= atleta.id %>][vitorias]" value="<%= res.vitorias || 0 %>" min="0" style="width:56px;">
                  </td>
                  <td class="is-center">
                    <input type="number" name="resultados[<%= atleta.id %>][derrotas]" value="<%= res.derrotas || 0 %>" min="0" style="width:56px;">
                  </td>
                  <td class="is-center">
                    <input type="number" name="resultados[<%= atleta.id %>][empates]" value="<%= res.empates || 0 %>" min="0" style="width:56px;">
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div class="juiz-form-footer">
          <span class="juiz-hint">Os pontos são salvos por atleta e somados à classificação do campus.</span>
          <button type="submit" class="juiz-btn juiz-btn--primary">Salvar resultados</button>
        </div>
      </form>
    </div>

  <% } %>
</section>

<script>
  (function () {
    var toggleBtn = document.querySelector('[data-toggle-prova]');
    var form = document.getElementById('formCriarProva');
    if (toggleBtn && form) {
      toggleBtn.addEventListener('click', function () {
        var aberto = !form.hidden;
        form.hidden = aberto;
        toggleBtn.textContent = aberto ? '+ Nova prova' : 'Fechar';
      });
    }

    var tipoSelect = document.getElementById('tipoResultadoSelect');
    var formatoWrapper = document.getElementById('formatoProvaWrapper');
    if (tipoSelect && formatoWrapper) {
      tipoSelect.addEventListener('change', function () {
        formatoWrapper.hidden = this.value !== 'tempo';
      });
    }
  })();
</script>
