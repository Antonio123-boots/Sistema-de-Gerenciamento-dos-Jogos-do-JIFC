<section class="panel-card" style="max-width:980px; margin:1rem auto;">
  <div class="profile-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.75rem;">
    <div>
      <h1 style="font-size:1.3rem; margin:0;">
        <%= esporte %>
      </h1>
      <p class="panel-subtitle" style="margin:0.2rem 0 0;"><%= jogos.length %> jogo(s) encontrado(s)</p>
    </div>
  </div>

  <div style="display:flex; gap:0.5rem; margin-top:1rem; flex-wrap:wrap;">
    <% const filtros = [
      { label: 'Todos', valor: null },
      { label: 'Masculino', valor: 'Masculino' },
      { label: 'Feminino', valor: 'Feminino' }
    ]; %>
    <% filtros.forEach((f) => { %>
      <% const ativo = generoFiltro === f.valor; %>
      <a href="/juiz/<%= encodeURIComponent(esporte) %><%= f.valor ? '?genero=' + encodeURIComponent(f.valor) : '' %>"
         style="font-size:0.8rem; padding:0.4rem 0.9rem; border-radius:999px; font-weight:600; text-decoration:none;
                <%= ativo
                  ? 'background:rgba(88,214,141,0.25); color:#58d68d; border:1px solid rgba(88,214,141,0.4);'
                  : 'background:rgba(var(--fg-rgb), 0.06); color:rgba(var(--fg-rgb), 0.6); border:1px solid rgba(var(--fg-rgb), 0.1);' %>
                transition:all 0.2s;">
        <%= f.label %>
      </a>
    <% }) %>
  </div>

  <% if (typeof mostrarFiltroTipo !== 'undefined' && mostrarFiltroTipo) { %>
    <div style="display:flex; gap:0.5rem; margin-top:0.5rem; flex-wrap:wrap; align-items:center;">
      <span style="font-size:0.7rem; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.08em;">Formato:</span>
      <% const filtrosTipo = [
        { label: 'Todos', valor: '' },
        { label: 'Individual', valor: 'individual' },
        { label: 'Dupla', valor: 'dupla' }
      ]; %>
      <% filtrosTipo.forEach((f) => { %>
        <% const ativoTipo = (typeof tipoFiltro !== 'undefined' ? tipoFiltro : '') === f.valor; %>
        <% const paramsTipo = new URLSearchParams();
           if (generoFiltro) paramsTipo.set('genero', generoFiltro);
           if (f.valor) paramsTipo.set('tipo', f.valor);
           const hrefTipo = '/juiz/' + encodeURIComponent(esporte) + (paramsTipo.toString() ? '?' + paramsTipo.toString() : ''); %>
        <a href="<%= hrefTipo %>"
           style="font-size:0.8rem; padding:0.4rem 0.9rem; border-radius:999px; font-weight:600; text-decoration:none;
                  <%= ativoTipo
                    ? 'background:rgba(var(--accent-rgb), 0.18); color:var(--accent); border:1px solid rgba(var(--accent-rgb), 0.35);'
                    : 'background:rgba(var(--fg-rgb), 0.06); color:rgba(var(--fg-rgb), 0.6); border:1px solid rgba(var(--fg-rgb), 0.1);' %>
                  transition:all 0.2s;">
          <%= f.label %>
        </a>
      <% }) %>
    </div>
  <% } %>

  <% if (typeof mensagemSucesso !== 'undefined' && mensagemSucesso) { %>
    <div class="alert alert-success auto-dismiss" style="margin-top:1rem;"><%= mensagemSucesso %></div>
  <% } %>

  <% if (jogos && jogos.length) { %>
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(260px, 1fr)); gap:1rem; margin-top:1.25rem; width:100%;">
      <% jogos.forEach((jogo) => { %>
        <% const temPlacar = jogo.status !== 'Agendado' && (Number(jogo.placar_1) > 0 || Number(jogo.placar_2) > 0 || jogo.status === 'Encerrado' || jogo.status === 'Em Andamento'); %>
        <article class="panel-card" style="position:relative; padding:1rem; background:rgba(var(--fg-rgb), 0.02); border:1px solid rgba(var(--fg-rgb), 0.08); border-radius:18px; display:flex; flex-direction:column; justify-content:space-between; height:100%; <%= jogo.status === 'Encerrado' ? 'opacity:0.75;' : '' %>">
          <% if (Boolean(jogo.wo)) { %>
            <span style="position:absolute; top:0.6rem; right:0.75rem; font-size:0.55rem; font-weight:800; letter-spacing:0.08em; padding:0.15rem 0.45rem; border-radius:6px; line-height:1.2; background:rgba(245,176,65,0.18); color:#f5b041;">W.O.</span>
          <% } %>
          <% const fasesEliminatoria = ['Oitavas', 'Quartas', 'Semifinal', 'Final', 'Terceiro Lugar']; if (fasesEliminatoria.includes(String(jogo.fase || ''))) { %>
            <span style="position:absolute; top:0.6rem; <%= Boolean(jogo.wo) ? 'right:4.5rem;' : 'right:0.75rem;' %> font-size:0.55rem; font-weight:800; letter-spacing:0.08em; padding:0.15rem 0.45rem; border-radius:6px; line-height:1.2; background:rgba(var(--accent-rgb), 0.18); color:var(--accent);"><%= jogo.fase %></span>
          <% } %>
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem; min-height:1.5rem;">
            <div style="font-size:0.75rem; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.08em; line-height:1.3;"><%= jogo.modalidade %> · <%= jogo.genero %></div>
          </div>

          <div style="display:grid; grid-template-columns:minmax(0,1fr) auto minmax(0,1fr); gap:0.75rem; align-items:center; flex:1;">
            <div style="text-align:center; min-width:0;">
              <% const fotoCasaRealJ = !!(jogo.fotoCasa && jogo.fotoCasa !== '/imagens/avatar.svg'); %>
              <img src="<%= jogo.fotoCasa || '/imagens/avatar.svg' %>" alt="Foto do campus <%= jogo.casa %>" class="campus-photo campus-photo--md campus-photo--badge <%= fotoCasaRealJ ? 'campus-photo--real' : 'campus-photo--default' %>" style="margin:0 auto 0.55rem;">
              <div style="font-size:0.75rem; color: var(--text); font-weight:600; line-height:1.2; word-break:break-word;"><%= (jogo.casa && jogo.casa !== 'Atleta não informado' && jogo.casa !== 'Campus não informado') ? jogo.casa : (jogo.rotuloCasa || 'A Definir') %></div>
            </div>

            <div style="display:flex; flex-direction:column; gap:0.25rem; justify-items:center; text-align:center; align-items:center; flex-shrink:0;">
              <% if (temPlacar) { %>
                <% if (jogo.temSets && jogo.sets && jogo.sets.length > 0) { %>
                  <%
                    let s1 = 0, s2 = 0;
                    jogo.sets.forEach(s => {
                      if (Number(s.pontos_1 || 0) > Number(s.pontos_2 || 0)) s1++;
                      else if (Number(s.pontos_2 || 0) > Number(s.pontos_1 || 0)) s2++;
                    });
                  %>
                  <div style="font-size:1.25rem; font-weight:800; color: var(--text); line-height:1.2; letter-spacing:0.02em;">
                    <span><%= s1 %></span>
                    <span style="color:var(--text-muted); margin:0 0.15rem; font-weight:400;">x</span>
                    <span><%= s2 %></span>
                    <span style="font-size:0.55rem; color:var(--text-muted); font-weight:600; margin-left:0.15rem;"></span>
                  </div>
                  <div style="font-size:0.55rem; color:var(--text-muted); line-height:1.4; margin-top:0.15rem;">
                    <% jogo.sets.forEach((s, idx) => { %>
                      <%= s.pontos_1 %>-<%= s.pontos_2 %><%= idx < jogo.sets.length - 1 ? ' · ' : '' %>
                    <% }); %>
                  </div>
                <% } else { %>
                  <div style="font-size:1.15rem; font-weight:800; color: var(--text); line-height:1.2; letter-spacing:0.02em;">
                    <span><%= jogo.placar_1 != null ? jogo.placar_1 : 0 %></span>
                    <span style="color:var(--text-muted); margin:0 0.15rem; font-weight:400;">x</span>
                    <span><%= jogo.placar_2 != null ? jogo.placar_2 : 0 %></span>
                  </div>
                <% } %>
                <div style="font-size:0.6rem; font-weight:700; padding:0.15rem 0.5rem; border-radius:6px; line-height:1.2; margin-top:0.2rem;
                  <%= jogo.status === 'Encerrado' ? 'background:rgba(88,214,141,0.18); color:#58d68d;' : 'background:rgba(241,196,39,0.18); color:#f5b041;' %>
                "><%= jogo.status %></div>
              <% } else { %>
                <div style="font-size:0.95rem; font-weight:700; color: var(--text); line-height:1.2;"><%= jogo.horario %></div>
                <div style="font-size:0.65rem; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.08em; line-height:1.2;"><%= jogo.localJogo || 'A def' %></div>
                <div style="font-size:0.65rem; color:var(--text-muted); line-height:1.2;"><%= jogo.data %></div>
              <% } %>
            </div>

            <div style="text-align:center; min-width:0;">
              <% const fotoForaRealJ = !!(jogo.fotoFora && jogo.fotoFora !== '/imagens/avatar.svg'); %>
              <img src="<%= jogo.fotoFora || '/imagens/avatar.svg' %>" alt="Foto do campus <%= jogo.fora %>" class="campus-photo campus-photo--md campus-photo--badge <%= fotoForaRealJ ? 'campus-photo--real' : 'campus-photo--default' %>" style="margin:0 auto 0.55rem;">
              <div style="font-size:0.75rem; color: var(--text); font-weight:600; line-height:1.2; word-break:break-word;"><%= (jogo.fora && jogo.fora !== 'Atleta não informado' && jogo.fora !== 'Campus não informado') ? jogo.fora : (jogo.rotuloFora || 'A Definir') %></div>
            </div>
          </div>

          <div style="margin-top:0.75rem; display:flex; justify-content:space-between; align-items:center; gap:0.5rem; flex-wrap:wrap;">
            <% if (jogo.status === 'Encerrado') { %>
              <span style="font-size:0.7rem; padding:0.25rem 0.6rem; border-radius:999px; background:rgba(88,214,141,0.18); color:#58d68d; font-weight:700;">Encerrado</span>
              <% if (!jogo.wo) { %>
                <a class="btn btn-secondary" style="font-size:0.8rem; padding:0.4rem 0.8rem;" href="/juiz/jogos/<%= jogo.id %>/placar?editar=1">Corrigir placar</a>
              <% } else { %>
                <form action="/juiz/jogos/<%= jogo.id %>/desfazer-wo" method="POST" style="display:inline;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-secondary" style="font-size:0.8rem; padding:0.4rem 0.8rem;">Cancelar W.O.</button>
                </form>
              <% } %>
            <% } else if (jogo.bloqueado) { %>
              <span style="font-size:0.7rem; padding:0.25rem 0.6rem; border-radius:999px; background:rgba(var(--fg-rgb), 0.08); color:rgba(var(--fg-rgb), 0.7);"><%= jogo.status || 'Agendado' %></span>
              <span style="font-size:0.7rem; padding:0.35rem 0.7rem; border-radius:6px; background:rgba(180,130,60,0.15); color:#b4823c; font-weight:600; cursor:not-allowed;">Aguardando fase anterior</span>
            <% } else { %>
              <span style="font-size:0.7rem; padding:0.25rem 0.6rem; border-radius:999px; background:rgba(var(--fg-rgb), 0.08); color:rgba(var(--fg-rgb), 0.7);"><%= jogo.status || 'Agendado' %></span>
              <a class="btn btn-secondary" style="font-size:0.8rem; padding:0.4rem 0.8rem;" href="/juiz/jogos/<%= jogo.id %>/placar">Atualizar Placar</a>
            <% } %>
          </div>
        </article>
      <% }) %>
    </div>
  <% } else { %>
    <article class="mini-card" style="text-align:center; margin-top:1.5rem;">
      <h2 style="font-size:1.1rem;">Nenhum jogo encontrado</h2>
      <p class="panel-subtitle">Ainda não existem jogos para este esporte.</p>
    </article>
  <% } %>
</section>
