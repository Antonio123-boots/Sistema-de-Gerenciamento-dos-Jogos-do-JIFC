<section class="juiz-page">
  <header class="juiz-page-head">
    <div>
      <p class="juiz-page-kicker">Meus jogos</p>
      <h1><%= esporte %></h1>
      <p class="juiz-page-subtitle"><%= jogos.length %> jogo(s) encontrado(s)</p>
    </div>
  </header>

  <div class="juiz-toolbar">
    <% const filtros = [
      { label: 'Todos', valor: null },
      { label: 'Masculino', valor: 'Masculino' },
      { label: 'Feminino', valor: 'Feminino' }
    ]; %>
    <% filtros.forEach((f) => { %>
      <% const ativo = generoFiltro === f.valor; %>
      <a class="juiz-chip <%= ativo ? 'is-active' : '' %>"
         href="/juiz/<%= encodeURIComponent(esporte) %><%= f.valor ? '?genero=' + encodeURIComponent(f.valor) : '' %>">
        <%= f.label %>
      </a>
    <% }) %>
  </div>

  <% if (typeof mostrarFiltroTipo !== 'undefined' && mostrarFiltroTipo) { %>
    <div class="juiz-toolbar" style="margin-top:0.5rem;">
      <span class="juiz-toolbar-label">Formato</span>
      <% const filtrosTipo = [
        { label: 'Todos', valor: '' },
        { label: 'Individual', valor: 'individual' },
        { label: 'Dupla', valor: 'dupla' }
      ]; %>
      <% filtrosTipo.forEach((f) => { %>
        <% const ativoTipo = (typeof tipoFiltro !== 'undefined' ? tipoFiltro : '') === f.valor; %>
        <% const paramsTipo = new URLSearchParams();
           if (generoFiltro) paramsTipo.set('genero', generoFiltro);
           if (f.valor) paramsTipo.set('tipo', f.valor);
           const hrefTipo = '/juiz/' + encodeURIComponent(esporte) + (paramsTipo.toString() ? '?' + paramsTipo.toString() : ''); %>
        <a class="juiz-chip <%= ativoTipo ? 'is-active' : '' %>" href="<%= hrefTipo %>">
          <%= f.label %>
        </a>
      <% }) %>
    </div>
  <% } %>

  <% if (typeof mensagemSucesso !== 'undefined' && mensagemSucesso) { %>
    <div class="juiz-alert juiz-alert--success auto-dismiss"><%= mensagemSucesso %></div>
  <% } %>

  <% if (jogos && jogos.length) { %>
    <div class="juiz-matches-grid">
      <% jogos.forEach((jogo) => { %>
        <% const temPlacar = jogo.status !== 'Agendado' && (Number(jogo.placar_1) > 0 || Number(jogo.placar_2) > 0 || jogo.status === 'Encerrado' || jogo.status === 'Em Andamento'); %>
        <% const casaValida = jogo.casa && jogo.casa !== 'Atleta não informado' && jogo.casa !== 'Campus não informado'; %>
        <% const foraValida = jogo.fora && jogo.fora !== 'Atleta não informado' && jogo.fora !== 'Campus não informado'; %>
        <article class="juiz-match-card <%= jogo.status === 'Encerrado' ? 'is-done' : '' %>">
          <% if (Boolean(jogo.wo)) { %>
            <span class="juiz-tag juiz-tag--wo">W.O.</span>
          <% } %>
          <% const fasesEliminatoria = ['Oitavas', 'Quartas', 'Semifinal', 'Final', 'Terceiro Lugar']; if (fasesEliminatoria.includes(String(jogo.fase || ''))) { %>
            <span class="juiz-tag"><%= jogo.fase %></span>
          <% } %>

          <div class="juiz-match-card__meta"><%= jogo.modalidade %> · <%= jogo.genero %></div>

          <div class="juiz-versus">
            <div class="juiz-team">
              <% const fotoCasaRealJ = !!(jogo.fotoCasa && jogo.fotoCasa !== '/imagens/avatar.svg'); %>
              <img src="<%= jogo.fotoCasa || '/imagens/avatar.svg' %>"
                   alt="Foto do campus <%= jogo.casa %>"
                   class="campus-photo campus-photo--md campus-photo--badge <%= fotoCasaRealJ ? 'campus-photo--real' : 'campus-photo--default' %>">
              <div class="juiz-team__name <%= casaValida ? '' : 'juiz-team__name--muted' %>">
                <%= casaValida ? jogo.casa : (jogo.rotuloCasa || 'A definir') %>
              </div>
            </div>

            <div class="juiz-match-center">
              <% if (temPlacar) { %>
                <% if (jogo.temSets && jogo.sets && jogo.sets.length > 0) { %>
                  <%
                    let s1 = 0, s2 = 0;
                    jogo.sets.forEach(s => {
                      if (Number(s.pontos_1 || 0) > Number(s.pontos_2 || 0)) s1++;
                      else if (Number(s.pontos_2 || 0) > Number(s.pontos_1 || 0)) s2++;
                    });
                  %>
                  <div class="juiz-score">
                    <span><%= s1 %></span><span class="sep">x</span><span><%= s2 %></span>
                  </div>
                  <div class="juiz-score-sets">
                    <% jogo.sets.forEach((s, idx) => { %>
                      <%= s.pontos_1 %>-<%= s.pontos_2 %><%= idx < jogo.sets.length - 1 ? ' · ' : '' %>
                    <% }); %>
                  </div>
                <% } else { %>
                  <div class="juiz-score">
                    <span><%= jogo.placar_1 != null ? jogo.placar_1 : 0 %></span>
                    <span class="sep">x</span>
                    <span><%= jogo.placar_2 != null ? jogo.placar_2 : 0 %></span>
                  </div>
                <% } %>
                <div class="juiz-status <%= jogo.status === 'Encerrado' ? 'juiz-status--done' : 'juiz-status--live' %>">
                  <%= jogo.status %>
                </div>
              <% } else { %>
                <div class="juiz-match-time"><%= jogo.horario %></div>
                <div class="juiz-match-place"><%= jogo.localJogo || 'A definir' %></div>
                <div class="juiz-match-date"><%= jogo.data %></div>
              <% } %>
            </div>

            <div class="juiz-team">
              <% const fotoForaRealJ = !!(jogo.fotoFora && jogo.fotoFora !== '/imagens/avatar.svg'); %>
              <img src="<%= jogo.fotoFora || '/imagens/avatar.svg' %>"
                   alt="Foto do campus <%= jogo.fora %>"
                   class="campus-photo campus-photo--md campus-photo--badge <%= fotoForaRealJ ? 'campus-photo--real' : 'campus-photo--default' %>">
              <div class="juiz-team__name <%= foraValida ? '' : 'juiz-team__name--muted' %>">
                <%= foraValida ? jogo.fora : (jogo.rotuloFora || 'A definir') %>
              </div>
            </div>
          </div>

          <div class="juiz-match-card__foot">
            <% if (jogo.status === 'Encerrado') { %>
              <span class="juiz-status juiz-status--done">Encerrado</span>
              <% if (!jogo.wo) { %>
                <a class="juiz-btn juiz-btn--ghost juiz-btn--sm" href="/juiz/jogos/<%= jogo.id %>/placar?editar=1">Corrigir placar</a>
              <% } else { %>
                <form action="/juiz/jogos/<%= jogo.id %>/desfazer-wo" method="POST">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="juiz-btn juiz-btn--ghost juiz-btn--sm">Cancelar W.O.</button>
                </form>
              <% } %>
            <% } else if (jogo.bloqueado) { %>
              <span class="juiz-status juiz-status--pending"><%= jogo.status || 'Agendado' %></span>
              <span class="juiz-status juiz-status--blocked">Aguardando fase anterior</span>
            <% } else { %>
              <span class="juiz-status <%= jogo.status === 'Em Andamento' ? 'juiz-status--live' : 'juiz-status--pending' %>"><%= jogo.status || 'Agendado' %></span>
              <a class="juiz-btn juiz-btn--primary juiz-btn--sm" href="/juiz/jogos/<%= jogo.id %>/placar">Atualizar placar</a>
            <% } %>
          </div>
        </article>
      <% }) %>
    </div>
  <% } else { %>
    <div class="juiz-empty" style="margin-top:1.5rem;">
      <h2>Nenhum jogo encontrado</h2>
      <p>Ainda não existem jogos para este esporte.</p>
    </div>
  <% } %>
</section>
