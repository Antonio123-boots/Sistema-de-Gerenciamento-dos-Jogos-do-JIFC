<section class="panel-card" style="max-width:880px; margin:1rem auto;">
  <div class="profile-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.75rem;">
    <div>
      <h1 style="font-size:1.3rem; margin:0;">Painel do Juiz</h1>
      <p class="panel-subtitle" style="margin:0.2rem 0 0;">Selecione um esporte para ver e atualizar os placares.</p>
    </div>
    <span class="status-tag" style="font-size:0.78rem; background:rgba(236,228,45,0.15); color:#ece42d; padding:0.3rem 0.7rem; border-radius:8px;">Acesso exclusivo para juiz</span>
  </div>

  <% if (typeof mensagemSucesso !== 'undefined' && mensagemSucesso) { %>
    <div class="alert alert-success" style="margin-top:1rem;"><%= mensagemSucesso %></div>
  <% } %>

  <% if (esportes && esportes.length) { %>
    <div class="game-grid" style="margin-top:1.5rem;">
      <% const icons = { 'Futsal':'⚽', 'Vôlei':'🏐', 'Basquete':'🏀', 'Handebol':'🤾', 'Atletismo':'🏃', 'Tênis de Mesa':'🏓', 'Xadrez':'♟️', 'Badminton':'🏸', 'Natação':'🏊' }; %>
      <% esportes.forEach((esp) => { %>
        <a href="/juiz/<%= encodeURIComponent(esp) %>" class="game-card" style="text-decoration:none; text-align:center; padding:1.8rem 1rem; transition:transform 0.15s, border-color 0.15s; cursor:pointer;"
           onmouseenter="this.style.transform='translateY(-3px)'; this.style.borderColor='rgba(236,228,45,0.35)'"
           onmouseleave="this.style.transform=''; this.style.borderColor='rgba(255,255,255,0.08)'">
          <div style="font-size:2.4rem; margin-bottom:0.6rem;"><%= icons[esp] || '🏅' %></div>
          <h3 style="margin:0; font-size:1.05rem; color:#fff;"><%= esp %></h3>
          <p style="margin:0.3rem 0 0; font-size:0.78rem; color:rgba(255,255,255,0.5);">Ver jogos →</p>
        </a>
      <% }) %>
    </div>
  <% } else { %>
    <article class="mini-card" style="text-align:center; margin-top:1.5rem;">
      <h2 style="font-size:1.1rem;">Nenhum esporte atribuído</h2>
      <p class="panel-subtitle">Fale com o administrador para atribuir esportes ao seu perfil.</p>
    </article>
  <% } %>
</section>
