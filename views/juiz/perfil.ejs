<section class="juiz-dashboard-page">
  <div class="juiz-dashboard-header">
    <div>
      <h1 style="font-size:1.3rem; margin:0;">Painel do Juiz</h1>
      <p class="panel-subtitle" style="margin:0.2rem 0 0;">Selecione um esporte para ver e atualizar os placares.</p>
    </div>
    <span class="status-tag juiz-dashboard-status">Acesso exclusivo para juiz</span>
  </div>

  <% if (typeof mensagemSucesso !== 'undefined' && mensagemSucesso) { %>
    <div class="alert alert-success" style="margin-top:1rem;"><%= mensagemSucesso %></div>
  <% } %>

  <% if (esportes && esportes.length) { %>
    <div class="juiz-sports-grid">
      <% esportes.forEach((esp) => { %>
        <a href="/juiz/<%= encodeURIComponent(esp) %>" class="panel-card juiz-sport-card">
          <h3><%= esp %></h3>
          <p>Ver jogos <span aria-hidden="true">→</span></p>
        </a>
      <% }) %>
    </div>
  <% } else { %>
    <article class="mini-card juiz-empty-state">
      <h2 style="font-size:1.1rem;">Nenhum esporte atribuído</h2>
      <p class="panel-subtitle">Fale com o administrador para atribuir esportes ao seu perfil.</p>
    </article>
  <% } %>
</section>
