                                                            <% }) %>
                                                        </div>
                                                    </div>
                                                    <div style="text-align:center; font-family:monospace; color:rgba(var(--fg-rgb), 0.85); padding-top:0.1rem;"><%= grupoRev.resultadoTotal || '—' %></div>
                                                    <% if (grupoRev.pontosTotal > 0) { %>
                                                        <div style="text-align:center; font-weight:700; color:#58d68d; padding-top:0.1rem;"><%= grupoRev.pontosTotal %></div>
                                                    <% } else { %>
                                                        <div style="text-align:center; color:var(--text-muted); padding-top:0.1rem;">—</div>
                                                    <% } %>
                                                </div>
                                            <% }) %>
                                        <% } else { %>
                                            <div style="display:grid; grid-template-columns:minmax(0,0.5fr) minmax(0,1.9fr) minmax(0,1.3fr) minmax(0,1fr) minmax(0,0.7fr); align-items:center; gap:0.25rem; font-size:0.8rem; color:var(--text-muted); padding:0.45rem 0.35rem 0.4rem; border-bottom:1px solid rgba(var(--fg-rgb), 0.08); background:rgba(var(--fg-rgb), 0.02);">
                                                <div style="font-weight:700; color:var(--text-muted); text-align:center;">#</div>
                                                <div style="font-weight:700; color:var(--text-muted); padding-left:0.1rem;">Atleta</div>
                                                <div style="font-weight:700; color:var(--text-muted); text-align:left;">Campus</div>
                                                <div style="font-weight:700; color:var(--text-muted); text-align:center;">Resultado</div>
                                                <div style="font-weight:700; color:#58d68d; text-align:center;">PTS</div>
                                            </div>
                                            <% bateriasProva.forEach((bateria, indiceBateria) => { %>
                                                <% if (temBateriasLancadas) { %><div style="padding:0.45rem 0.6rem; color:var(--text-muted); font-size:0.7rem; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; border-bottom:1px solid rgba(var(--fg-rgb), 0.06);">Bateria <%= bateria[0] && bateria[0].numeroBateria ? bateria[0].numeroBateria : indiceBateria + 1 %></div><% } %>
                                                <% bateria.forEach((atleta, idx) => { %>
                                                <div style="display:grid; grid-template-columns:minmax(0,0.5fr) minmax(0,1.9fr) minmax(0,1.3fr) minmax(0,1fr) minmax(0,0.7fr); align-items:center; gap:0.25rem; font-size:0.8rem; color:var(--text-muted); padding:0.48rem 0.35rem; border-top:1px solid rgba(var(--fg-rgb), 0.06);">
                                                    <div style="font-weight:700; color:var(--text-muted); text-align:center;"><%= atleta.numeroRaia || '—' %></div>
                                                    <div style="color: var(--text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= atleta.nome || 'Atleta sem nome' %></div>
                                                    <div style="color:rgba(var(--fg-rgb), 0.6); font-size:0.75rem; overflow:hidden; text-overflow:ellipsis;"><%= atleta.campus || '—' %></div>
                                                    <div style="text-align:center; color:rgba(var(--fg-rgb), 0.85);"><%= atleta.resultado || '—' %></div>
                                                    <% if (Number(atleta.pontos || 0) > 0) { %>
                                                        <div style="text-align:center; font-weight:700; color:#58d68d;" title="<%= atleta.posicao ? (atleta.posicao + 'º lugar') : '' %>"><%= Number(atleta.pontos) %></div>
                                                    <% } else { %>
                                                        <div style="text-align:center; color:var(--text-muted);">—</div>
                                                    <% } %>
                                                </div>
                                                <% }) %>
                                            <% }) %>
                                        <% } %>
                                        <% if (!(Array.isArray(prova.atletas) && prova.atletas.length)) { %>
                                            <div style="padding:0.6rem 0.35rem; font-size:0.75rem; color:var(--text-muted); text-align:center;">Sem atletas inscritos nesta prova.</div>
                                        <% } %>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div style="padding:0.6rem 0.3rem; font-size:0.75rem; color:var(--text-muted);">Nenhum atleta inscrito no atletismo ainda.</div>
                        <% } %>
                    <% } else { %>
                        <div style="padding:0.6rem 0.3rem; font-size:0.75rem; color:var(--text-muted);">Nenhum atleta inscrito no atletismo ainda.</div>
                    <% } %>
                </div>

                <% if (provaFiltroAtual === '100m' && Object.values((typeof resultadosFinaisAtletismo === 'object' && resultadosFinaisAtletismo) ? resultadosFinaisAtletismo : {}).some((porSlugFinal) => Object.values(porSlugFinal || {}).some((linhasProva) => Array.isArray(linhasProva) && linhasProva.length > 0))) { %>
                <div style="margin-bottom:1.2rem;">
                    <div style="display:flex; align-items:center; justify-content:space-between; padding:0.5rem 0.3rem 0.4rem; border-bottom:1px solid rgba(var(--fg-rgb), 0.07); margin-bottom:0.6rem;">
                        <div style="font-size:0.85rem; color:var(--text-muted); font-weight:700; text-transform:uppercase; letter-spacing:0.04em;">Finais</div>
                    </div>
                    <%
                        const mapaFinaisGeneros = (typeof resultadosFinaisAtletismo === 'object' && resultadosFinaisAtletismo) ? resultadosFinaisAtletismo : {};
                        const ordemGenerosFinais = ['Masculino', 'Feminino'];
                        const provasFinaisMap = new Map();
                        (Array.isArray(provasAtletismo) ? provasAtletismo : []).forEach((provaFinal) => {
                            if (provaFinal && provaFinal.slug) provasFinaisMap.set(provaFinal.slug, provaFinal.nome || provaFinal.slug);
                        });
                        Object.values(mapaFinaisGeneros).forEach((porSlugFinal) => {
                            if (!porSlugFinal || typeof porSlugFinal !== 'object') return;
                            Object.keys(porSlugFinal).forEach((slugProvaFinal) => {
                                if (!provasFinaisMap.has(slugProvaFinal)) provasFinaisMap.set(slugProvaFinal, slugProvaFinal);
                            });
                        });
                        const generosComFinais = [
                            ...ordemGenerosFinais.filter((g) => {
                                const porSlugFinal = mapaFinaisGeneros[g] || {};
                                return [...provasFinaisMap.keys()].some((slugProvaFinal) => Array.isArray(porSlugFinal[slugProvaFinal]) && porSlugFinal[slugProvaFinal].length > 0);
                            }),
                            ...Object.keys(mapaFinaisGeneros).filter((g) => !ordemGenerosFinais.includes(g) && Object.values(mapaFinaisGeneros[g] || {}).some((linhasProva) => Array.isArray(linhasProva) && linhasProva.length > 0))
                        ];
                    %>
                    <% if (generosComFinais.length > 0) { %>
                        <% generosComFinais.forEach((generoFinal) => { %>
                            <% const porSlugFinal = mapaFinaisGeneros[generoFinal] || {}; %>
                            <% const slugsFinais = [...provasFinaisMap.keys()].filter((slugProvaFinal) => Array.isArray(porSlugFinal[slugProvaFinal]) && porSlugFinal[slugProvaFinal].length > 0); %>
                            <% slugsFinais.forEach((slugProvaFinal) => { %>
                                <%
                                    const provaFinalNome = provasFinaisMap.get(slugProvaFinal) || slugProvaFinal;
                                    const linhasFinais = porSlugFinal[slugProvaFinal];
                                    const coresFinalGenero = String(generoFinal).toLowerCase() === 'feminino'
                                        ? { bg: 'rgba(241,148,138,0.1)', bd: 'rgba(241,148,138,0.35)', tx: '#f5b7b1' }
                                        : { bg: 'rgba(93,173,226,0.1)', bd: 'rgba(93,173,226,0.35)', tx: '#aed6f1' };
                                %>
                                <div style="margin-bottom:0.7rem;">
                                    <div style="display:flex; align-items:center; gap:0.45rem; padding:0.32rem 0.2rem; color:var(--text-muted); font-size:0.78rem; font-weight:700; letter-spacing:0.04em; text-transform:uppercase; border-bottom:1px solid rgba(var(--fg-rgb), 0.06); margin-bottom:0.3rem;">
                                        <span style="font-size:0.62rem; font-weight:700; letter-spacing:0.03em; padding:0.16rem 0.55rem; border-radius:999px; background:<%= coresFinalGenero.bg %>; border:1px solid <%= coresFinalGenero.bd %>; color:<%= coresFinalGenero.tx %>;"><%= generoFinal %></span>
                                        <span><%= provaFinalNome %></span>
                                        <span style="margin-left:auto; font-size:0.62rem; font-weight:800; letter-spacing:0.03em; padding:0.16rem 0.55rem; border-radius:999px; background:rgba(88,214,141,0.12); border:1px solid rgba(88,214,141,0.4); color:#58d68d;">Final</span>
                                    </div>
                                    <div class="tabela-scroll tabela-scroll--media" style="border:1px solid rgba(88,214,141,0.25); border-radius:10px; background:rgba(88,214,141,0.03);">
                                        <div style="display:grid; grid-template-columns:minmax(0,0.5fr) minmax(0,1.8fr) minmax(0,1.2fr) minmax(0,1fr) minmax(0,0.7fr); align-items:center; gap:0.25rem; font-size:0.8rem; color:var(--text-muted); padding:0.45rem 0.35rem 0.4rem; border-bottom:1px solid rgba(var(--fg-rgb), 0.08); background:rgba(var(--fg-rgb), 0.02);">
                                            <div style="font-weight:700; color:var(--text-muted); text-align:center;">#</div>
                                            <div style="font-weight:700; color:var(--text-muted); padding-left:0.1rem;">Atleta</div>
                                            <div style="font-weight:700; color:var(--text-muted); text-align:left;">Campus</div>
                                            <div style="font-weight:700; color:var(--text-muted); text-align:center;">Tempo</div>
                                            <div style="font-weight:700; color:#58d68d; text-align:center;">PTS</div>
                                        </div>
                                        <% linhasFinais.forEach((linhaFinal) => { %>
                                            <div style="display:grid; grid-template-columns:minmax(0,0.5fr) minmax(0,1.8fr) minmax(0,1.2fr) minmax(0,1fr) minmax(0,0.7fr); align-items:center; gap:0.25rem; font-size:0.8rem; color:var(--text-muted); padding:0.48rem 0.35rem; border-top:1px solid rgba(var(--fg-rgb), 0.06);">
                                                <div style="font-weight:700; color:<%= linhaFinal.posicao && linhaFinal.posicao <= 3 ? '#58d68d' : 'var(--text-muted)' %>; text-align:center;"><%= linhaFinal.posicao ? (linhaFinal.posicao + 'º') : '—' %></div>
                                                <div style="color: var(--text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= linhaFinal.nome || 'Atleta sem nome' %></div>
                                                <div style="color:rgba(var(--fg-rgb), 0.6); font-size:0.75rem; overflow:hidden; text-overflow:ellipsis;"><%= linhaFinal.campus || '—' %></div>
                                                <div style="text-align:center; font-family:monospace; color:rgba(var(--fg-rgb), 0.85);"><%= linhaFinal.tempo || '—' %></div>
                                                <% if (Number(linhaFinal.pontos || 0) > 0) { %>
                                                    <div style="text-align:center; font-weight:700; color:#58d68d;"><%= Number(linhaFinal.pontos) %></div>
                                                <% } else { %>
                                                    <div style="text-align:center; color:var(--text-muted);">—</div>
                                                <% } %>
                                            </div>
                                        <% }) %>
                                    </div>
                                </div>
                            <% }) %>
                        <% }) %>
                    <% } else { %>
                        <div style="padding:0.6rem 0.3rem; font-size:0.75rem; color:var(--text-muted);">Nenhuma final lançada ainda.</div>
                    <% } %>
                </div>
                <% } %>
            <% } else if (!ehXadrez) { %>
                <%
                    const gruposBaseTabela = Array.isArray(grupos) && grupos.length ? grupos : [];
                    const ordemGenerosTabela = ['Masculino', 'Feminino'];
                    const generosNasTabelas = [...new Set(gruposBaseTabela.map((g) => String(g.genero_modalidade || '').trim()).filter(Boolean))];
                    const secoesGeneroTabela = (!generoSelecionado && generosNasTabelas.length > 1)
                        ? [
                            ...ordemGenerosTabela.filter((g) => generosNasTabelas.includes(g)),
                            ...generosNasTabelas.filter((g) => !ordemGenerosTabela.includes(g))
                          ].map((g) => ({ genero: g, lista: gruposBaseTabela.filter((gr) => String(gr.genero_modalidade || '').trim() === g) }))
                        : [{ genero: '', lista: gruposBaseTabela.length ? gruposBaseTabela : [defaultGrupo] }];
                    const corGeneroTabela = (g) => (String(g).toLowerCase() === 'feminino'
                        ? { bg: 'rgba(241,148,138,0.1)', bd: 'rgba(241,148,138,0.35)', tx: '#f5b7b1' }
                        : { bg: 'rgba(93,173,226,0.1)', bd: 'rgba(93,173,226,0.35)', tx: '#aed6f1' });
                %>
                <div style="margin-bottom:1.2rem;">
                    <div style="display:flex; align-items:center; justify-content:space-between; padding:0.5rem 0.3rem 0.4rem; border-bottom:1px solid rgba(var(--fg-rgb), 0.07); margin-bottom:0.5rem;">
                        <div style="font-size:0.85rem; color:var(--text-muted); font-weight:700; text-transform:uppercase; letter-spacing:0.04em;">
                            <%= ehXadrez ? 'Classificação Geral' : 'Classificação' %>
                        </div>
                        <div style="font-size:0.85rem; color: var(--text); font-weight:700;"><%= ehXadrez ? 'Pts' : 'Resultado' %></div>
                    </div>

                    <% secoesGeneroTabela.forEach((secaoGenero) => { %>
                        <% if (secaoGenero.genero) { %>
                            <% const coresGenero = corGeneroTabela(secaoGenero.genero); %>
                            <div style="margin:0.6rem 0 0.5rem;">
                                <span style="display:inline-block; font-size:0.78rem; font-weight:700; letter-spacing:0.05em; text-transform:uppercase; padding:0.28rem 0.75rem; border-radius:999px; background:<%= coresGenero.bg %>; border:1px solid <%= coresGenero.bd %>; color:<%= coresGenero.tx %>;"><%= secaoGenero.genero %></span>
                            </div>
                        <% } %>
                    <% (secaoGenero.lista.length ? secaoGenero.lista : [defaultGrupo]).forEach((grupo) => { %>
                        <div style="margin-bottom:0.8rem;">
                            <div style="padding:0.32rem 0.2rem; color:var(--text-muted); font-size:0.75rem; font-weight:700; letter-spacing:0.04em; text-transform:uppercase; border-bottom:1px solid rgba(var(--fg-rgb), 0.06); margin-bottom:0.3rem;">
                                <%= labelGrupo %> <%= grupo.letra || grupo.numero_chave || 'Geral' %>
                            </div>

                            <div class="tabela-scroll tabela-scroll--larga" style="border:1px solid rgba(var(--fg-rgb), 0.08); border-radius:10px; background:rgba(var(--fg-rgb), 0.02);">
                                <div style="display:grid; grid-template-columns:<%= mostraPontuacao ? '38px minmax(0, 1.9fr) repeat(' + totalColunasExtra + ', minmax(0, 0.56fr))' : '38px minmax(0, 2.1fr) minmax(0, 1.1fr)' %>; align-items:center; gap:0.25rem; font-size:0.8rem; color:var(--text-muted); padding:0.45rem 0.35rem 0.4rem; border-bottom:1px solid rgba(var(--fg-rgb), 0.08); background:rgba(var(--fg-rgb), 0.02);">
                                    <div style="font-weight:700; color:var(--text-muted); text-align:center;">#</div>
                                    <div style="font-weight:700; color:var(--text-muted); padding-left:0.1rem;">Campus</div>
                                    <% if (mostraPontuacao) { %>
                                        <% colunasExibicao.forEach((col) => { %>
                                            <div style="font-weight:700; color:var(--text-muted); text-align:center;"><%= col %></div>
                                        <% }); %>
                                    <% } else { %>
                                        <div style="font-weight:700; color:var(--text-muted); text-align:center;">Resultado</div>
                                    <% } %>
                                </div>

                                <% const classifGrupo2 = Array.isArray(classificacao) ? classificacao.filter(c => Number(c.chave_id || c.numero_chave) === Number(grupo.id || 0)) : []; %>
                                <% const integrantesMap2 = Array.isArray(grupo.integrantes) ? new Map(grupo.integrantes.map(i => [Number(i.id || i.campus_id || i.campusId), i])) : new Map(); %>
                                <% const participacoes = classifGrupo2.length ? classifGrupo2.map((c) => { const integ = integrantesMap2.get(Number(c.campus_id)); return { ...c, nome: (integ && integ.nome) || c.participante_nome || 'Campus', foto: (integ && integ.foto) || c.participante_foto || c.foto_perfil || c.fotoPerfil || '/imagens/avatar.svg' }; }) : (Array.isArray(grupo.integrantes) && grupo.integrantes.length ? grupo.integrantes.map(i => ({ campus_id: i.id || i.campus_id, nome: i.nome || 'Campus', foto: i.foto || '/imagens/avatar.svg', pontos: 0, jogos_jogados: 0, vitorias: 0, empates: 0, derrotas: 0, pontos_pro: 0, pontos_contra: 0, saldo_pontuacao: 0, cartoes_amarelos: 0, cartoes_vermelhos: 0, sets_ganhos: 0, sets_perdidos: 0, resultado: '' })) : defaultGrupo.integrantes); %>
                                <% participacoes.forEach((integrante, idx) => { %>
                                    <% const nomeCampus = integrante.nome || integrante.participante_nome || 'Campus'; %>
                                    <% const fotoCampus = integrante.foto || integrante.participante_foto || integrante.foto_perfil || '/imagens/avatar.svg'; %>
                                    <% const fotoReal = fotoCampus && fotoCampus !== '/imagens/avatar.svg'; %>
                                    <% const pontos = Number(integrante.pontos || 0); %>
                                    <% const jogos = Number(integrante.jogos_jogados || 0); %>
                                    <% const vitorias = Number(integrante.vitorias || 0); %>
                                    <% const empates = Number(integrante.empates || 0); %>
                                    <% const derrotas = Number(integrante.derrotas || 0); %>
                                    <% const pro = Number(integrante.pontos_pro || 0); %>
                                    <% const contra = Number(integrante.pontos_contra || 0); %>
                                    <% const saldo = Number(integrante.saldo_pontuacao || 0); %>
                                    <% const amarelos = Number(integrante.cartoes_amarelos || 0); %>
                                    <% const vermelhos = Number(integrante.cartoes_vermelhos || 0); %>
                                    <% const setsG = Number(integrante.sets_ganhos || 0); %>
                                    <% const setsP = Number(integrante.sets_perdidos || 0); %>
                                    <% const resultado = String(integrante.resultado || integrante.tempo || integrante.distancia || integrante.desempenho || integrante.medida || (mostraPontuacao ? '' : '—')).trim() || '—'; %>
                                    <div style="display:grid; grid-template-columns:<%= mostraPontuacao ? '38px minmax(0, 1.9fr) repeat(' + totalColunasExtra + ', minmax(0, 0.56fr))' : '38px minmax(0, 2.1fr) minmax(0, 1.1fr)' %>; align-items:center; gap:0.25rem; font-size:0.8rem; color:var(--text-muted); padding:0.48rem 0.35rem; border-top:1px solid rgba(var(--fg-rgb), 0.06);">
                                        <div style="font-weight:700; color:var(--text-muted); text-align:center;"><%= idx + 1 %></div>
                                        <div style="display:flex; align-items:center; gap:0.4rem; min-width:0; overflow:hidden;">
                                            <img src="<%= fotoCampus %>" alt="Foto do campus <%= nomeCampus %>" class="campus-photo campus-photo--sm campus-photo--badge <%= fotoReal ? 'campus-photo--real' : 'campus-photo--default' %>">
                                            <span style="color: var(--text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; font-size:0.8rem;"><%= nomeCampus %></span>
                                        </div>
                                        <% if (mostraPontuacao) { %>
                                            <% colunasExibicao.forEach((col) => { %>
                                                <% 
                                                    let valor = '';
                                                    switch(col) {
                                                        case 'Pts': valor = pontos; break;
                                                        case 'PJ': valor = jogos; break;
                                                        case 'V': valor = vitorias; break;
                                                        case 'E': valor = empates; break;
                                                        case 'D': valor = derrotas; break;
                                                        case 'GP': case 'PF': valor = pro; break;
                                                        case 'GC': case 'PC': valor = contra; break;
                                                        case 'SG': valor = setsG > 0 || setsP > 0 ? setsG : saldo; break;
                                                        case 'SP': valor = setsG > 0 || setsP > 0 ? setsP : saldo; break;
                                                        case 'SA': valor = setsP > 0 ? (setsG / setsP).toFixed(2) : (setsG > 0 ? setsG.toFixed(2) : '0.00'); break;
                                                        case 'PA': valor = contra > 0 ? (pro / contra).toFixed(2) : (pro > 0 ? pro.toFixed(2) : '0.00'); break;
                                                        case 'CF': valor = amarelos + 'A ' + vermelhos + 'V'; break;
                                                        default: valor = '';
                                                    }
                                                %>
                                                <div style="text-align:center; color:<%= col === 'V' ? '#58d68d' : (col === 'E' ? '#f5b041' : (col === 'D' ? '#f1948a' : 'var(--text-muted)')) %>; font-weight:<%= col === 'Pts' ? '700' : '400' %>;"><%= valor %></div>
                                            <% }); %>
                                        <% } else { %>
                                            <div style="text-align:center; color:var(--text-muted); font-weight:700;"><%= resultado %></div>
                                        <% } %>
                                    </div>
                                <% }); %>
                            </div>
                        </div>
                    <% }); %>
                    <% }); %>
                </div>
            <% } %>

            <% if (temClassificacaoIndividual && (tipoClassificacaoIndividual === 'atletismo' || tipoClassificacaoIndividual === 'xadrez')) { %>
                    <div style="font-size:0.85rem; color:var(--text-muted); font-weight:700; text-transform:uppercase; letter-spacing:0.04em; margin-bottom:0.5rem;">
                        <%= tipoClassificacaoIndividual === 'xadrez' ? 'Tabela de Classificação — Xadrez' : 'Classificação Geral' %>
                    </div>
                    <%
                        const ordemGenerosGeral = ['Masculino', 'Feminino'];
                        const mapaGeralGenero = (tipoClassificacaoIndividual === 'atletismo' && typeof classificacaoAtletismoPorGenero === 'object' && classificacaoAtletismoPorGenero)
                            ? classificacaoAtletismoPorGenero
                            : ((tipoClassificacaoIndividual === 'xadrez' && typeof classificacaoXadrezPorGenero !== 'undefined' && classificacaoXadrezPorGenero && typeof classificacaoXadrezPorGenero === 'object') ? classificacaoXadrezPorGenero : null);
                        const secoesGeralTabela = mapaGeralGenero
                            ? [
                                ...ordemGenerosGeral.filter((g) => Array.isArray(mapaGeralGenero[g]) && mapaGeralGenero[g].length > 0),
                                ...Object.keys(mapaGeralGenero).filter((g) => !ordemGenerosGeral.includes(g) && Array.isArray(mapaGeralGenero[g]) && mapaGeralGenero[g].length > 0)
                              ].map((g) => ({ genero: g, dados: mapaGeralGenero[g] }))
                            : [{ genero: '', dados: Array.isArray(classificacaoIndividual) ? classificacaoIndividual : [] }];
                        const corGeneroGeral = (g) => (String(g).toLowerCase() === 'feminino'
                            ? { bg: 'rgba(241,148,138,0.1)', bd: 'rgba(241,148,138,0.35)', tx: '#f5b7b1' }
                            : { bg: 'rgba(93,173,226,0.1)', bd: 'rgba(93,173,226,0.35)', tx: '#aed6f1' });
                    %>
                    <% secoesGeralTabela.forEach((secaoGeral) => { %>
                        <% if (secaoGeral.genero && secoesGeralTabela.length > 1) { %>
                            <% const coresGeral = corGeneroGeral(secaoGeral.genero); %>
                            <div style="margin:0.7rem 0 0.45rem;">
                                <span style="display:inline-block; font-size:0.78rem; font-weight:700; letter-spacing:0.05em; text-transform:uppercase; padding:0.28rem 0.75rem; border-radius:999px; background:<%= coresGeral.bg %>; border:1px solid <%= coresGeral.bd %>; color:<%= coresGeral.tx %>;"><%= secaoGeral.genero %></span>
                            </div>
                        <% } %>
                        <div class="tabela-scroll tabela-scroll--media" style="border:1px solid rgba(var(--fg-rgb), 0.08); border-radius:10px; background:rgba(var(--fg-rgb), 0.02); <%= secaoGeral.genero && secoesGeralTabela.length > 1 ? 'margin-bottom:0.9rem;' : '' %>">
                            <% if (tipoClassificacaoIndividual === 'atletismo') { %>
                                <div style="display:grid; grid-template-columns:minmax(0,0.5fr) minmax(0,2fr) minmax(0,1.1fr) minmax(0,0.7fr); align-items:center; gap:0.25rem; font-size:0.8rem; color:var(--text-muted); padding:0.45rem 0.35rem 0.4rem; border-bottom:1px solid rgba(var(--fg-rgb), 0.08); background:rgba(var(--fg-rgb), 0.02);">
                                    <div style="font-weight:700; color:var(--text-muted); text-align:center;">#</div>
                                    <div style="font-weight:700; color:var(--text-muted); padding-left:0.1rem;">Campus</div>
                                    <div style="font-weight:700; color:var(--text-muted); text-align:center;">Provas</div>
                                    <div style="font-weight:700; color:#58d68d; text-align:center;">PTS</div>
                                </div>
                            <% } else { %>
                                <div style="display:grid; grid-template-columns:24px minmax(0,1.4fr) minmax(0,1fr) 30px 26px 24px 24px 26px; align-items:center; gap:0.2rem; font-size:0.72rem; color:var(--text-muted); padding:0.45rem 0.35rem 0.4rem; border-bottom:1px solid rgba(var(--fg-rgb), 0.08); background:rgba(var(--fg-rgb), 0.02);">
                                    <div style="font-weight:700; color:var(--text-muted); text-align:center;">#</div>
                                    <div style="font-weight:700; color:var(--text-muted); padding-left:0.1rem;">Atleta</div>
                                    <div style="font-weight:700; color:var(--text-muted); text-align:left;">Campus</div>
                                    <div style="font-weight:700; color:#58d68d; text-align:center;">P</div>
                                    <div style="font-weight:700; color:var(--text-muted); text-align:center;">J</div>
                                    <div style="font-weight:700; color:#58d68d; text-align:center;">V</div>
                                    <div style="font-weight:700; color:#f5b041; text-align:center;">E</div>
                                    <div style="font-weight:700; color:#f1948a; text-align:center;">D</div>
                                </div>
                            <% } %>
                            <% secaoGeral.dados.forEach((c, idx) => { %>
                            <% const fotoRealAtletismo = (c.foto_perfil && c.foto_perfil !== '/imagens/avatar.svg'); %>
                            <% if (tipoClassificacaoIndividual === 'atletismo') { %>
                                <div style="display:grid; grid-template-columns:minmax(0,0.5fr) minmax(0,2fr) minmax(0,1.1fr) minmax(0,0.7fr); align-items:center; gap:0.25rem; font-size:0.8rem; padding:0.48rem 0.35rem; border-top:1px solid rgba(var(--fg-rgb), 0.06); <%= idx < 3 ? 'background:rgba(88,214,141,0.04);' : '' %>">
                                    <div style="font-weight:700; color:var(--text-muted); text-align:center;"><%= idx + 1 %>º</div>
                                    <div style="display:flex; align-items:center; gap:0.4rem; min-width:0;">
                                        <img src="<%= c.foto_perfil || '/imagens/avatar.svg' %>" alt="Foto do campus <%= c.campus_nome || '' %>" class="campus-photo campus-photo--sm campus-photo--badge <%= fotoRealAtletismo ? 'campus-photo--real' : 'campus-photo--default' %>">
                                        <span style="color: var(--text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= c.campus_nome || 'Campus sem nome' %></span>
                                    </div>
                                    <div style="text-align:center; color:rgba(var(--fg-rgb), 0.6);"><%= Number(c.provas_pontuadas || 0) %></div>
                                    <div style="text-align:center; font-weight:700; color:#58d68d;"><%= Number(c.pontos || 0) %></div>
                                </div>
                            <% } else { %>
                                <%
                                    const jogosXadrez = (Number(c.vitorias) || 0) + (Number(c.empates) || 0) + (Number(c.derrotas) || 0);
                                %>
                                <div style="display:grid; grid-template-columns:24px minmax(0,1.4fr) minmax(0,1fr) 30px 26px 24px 24px 26px; align-items:center; gap:0.2rem; font-size:0.72rem; padding:0.48rem 0.35rem; border-top:1px solid rgba(var(--fg-rgb), 0.06); <%= idx < 3 ? 'background:rgba(88,214,141,0.04);' : '' %>">
                                    <div style="font-weight:700; color:var(--text-muted); text-align:center;"><%= idx + 1 %>º</div>
                                    <div style="color: var(--text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= c.atleta_nome %></div>
                                    <div style="color:rgba(var(--fg-rgb), 0.6); font-size:0.7rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= c.campus_nome %></div>
                                    <div style="text-align:center; font-weight:700; color:#58d68d;"><%= c.pontos || 0 %></div>
                                    <div style="text-align:center; color:var(--text-muted);"><%= jogosXadrez %></div>
                                    <div style="text-align:center; color:#58d68d;"><%= Number(c.vitorias) || 0 %></div>
                                    <div style="text-align:center; color:#f5b041;"><%= Number(c.empates) || 0 %></div>
                                    <div style="text-align:center; color:#f1948a;"><%= Number(c.derrotas) || 0 %></div>
                                </div>
                            <% } %>
                            <% }); %>
                        </div>
                    <% }); %>
            <% } %>
        </aside>
    <% } %>


    <div class="painel-jogos">

        <% if (Array.isArray(jogos) && jogos.length > 0) { %>
                <% if (temEsporteAtivo) {
                    const ehGrupo = (j) => String(j.fase || '').trim() === 'Fase de Grupos';
                    const ehEliminatoria = (j) => !ehGrupo(j);
                    const numerosRodadas = [...new Set(jogos.filter(ehGrupo).map((j) => Number(j.rodada || 1)))].filter((n) => Number.isFinite(n) && n > 0).sort((a, b) => a - b);
                    const gruposRodadas = numerosRodadas.map((num) => ({
                        chave: String(num),
                        label: num + 'ª Rodada',
                        jogos: jogos.filter((j) => ehGrupo(j) && Number(j.rodada || 1) === num)
                    }));
                    const gruposJogos = [
                        ...gruposRodadas,
                        { chave: 'E', label: 'Eliminatórias', jogos: jogos.filter(ehEliminatoria) }
                    ].filter((grupo) => grupo.jogos.length > 0);
                %>
                    <div class="filtro-rodadas-jogos" id="filtroRodadasJogos">
                        <% gruposJogos.forEach((grupo, gi) => { %>
                            <button type="button" class="round-pill rodada-pill <%= gi === 0 ? 'active' : '' %>" data-rodada="<%= grupo.chave %>">
                                <span class="rodada-indice"><%= grupo.chave === 'E' ? 'E' : grupo.chave %></span>
                                <span class="rodada-nome"><%= grupo.chave === 'E' ? 'Eliminatórias' : 'Rodada' %></span>
                            </button>
                        <% }) %>
                    </div>
                    <% gruposJogos.forEach((grupo, gi) => { %>
                        <div class="carrossel-jogos grupo-rodada" id="carrosselJogos-<%= grupo.chave %>" data-rodada="<%= grupo.chave %>" <%= gi === 0 ? '' : 'hidden' %>>
                            <button type="button" class="carrossel-btn carrossel-anterior" aria-label="Jogo anterior">&#10094;</button>
                            <div class="carrossel-trilho">
                                <% grupo.jogos.forEach((jogo) => { %>
                                    <%- include('partials/cardJogoHome', { jogo: jogo }) %>
                                <% }) %>
                            </div>
                            <button type="button" class="carrossel-btn carrossel-proximo" aria-label="Próximo jogo">&#10095;</button>
                            <div class="carrossel-dots"></div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="jogos-grid jogos-grid--fixa">
                        <% jogos.forEach((jogo) => { %>
                            <%- include('partials/cardJogoHome', { jogo: jogo }) %>
                        <% }) %>
                    </div>
                <% } %>
        <% } else if ((ehAtletismo || ehXadrez) && !temClassificacaoIndividual) { %>
            <% if (ehAtletismo) { %>
            <% } else { %>
                <%
                    const mapaXadrezGeneros = (typeof classificacaoXadrezPorGenero === 'object' && classificacaoXadrezPorGenero) ? classificacaoXadrezPorGenero : {};
                    const ordemGenerosXadrez = ['Masculino', 'Feminino'];
                    const generosXadrez = [
                        ...ordemGenerosXadrez.filter((g) => Array.isArray(mapaXadrezGeneros[g]) && mapaXadrezGeneros[g].length > 0),
                        ...Object.keys(mapaXadrezGeneros).filter((g) => !ordemGenerosXadrez.includes(g) && Array.isArray(mapaXadrezGeneros[g]) && mapaXadrezGeneros[g].length > 0)
                    ];
                    const temResultadoXadrez = generosXadrez.length > 0;
                %>
                    <% if (temResultadoXadrez) { %>
                        <% generosXadrez.forEach((generoXadrez) => { %>
                            <% const resultadosGeneroXadrez = mapaXadrezGeneros[generoXadrez] || []; %>
                            <% if (resultadosGeneroXadrez.length > 0) { %>
                                <div style="font-size:0.82rem; color:var(--text-muted); font-weight:700; text-transform:uppercase; letter-spacing:0.04em; margin:0.85rem 0 0.45rem;">
                                    <%= generoXadrez %>
                                </div>
                                <div class="tabela-scroll tabela-scroll--larga" style="border:1px solid rgba(var(--fg-rgb), 0.08); border-radius:10px; background:rgba(var(--fg-rgb), 0.02); margin-bottom:0.9rem;">
                                        <div style="display:grid; grid-template-columns:minmax(0,0.5fr) minmax(0,1.6fr) minmax(0,1.1fr) repeat(4,minmax(0,0.65fr)); align-items:center; gap:0.25rem; font-size:0.8rem; color:var(--text-muted); padding:0.45rem 0.35rem 0.4rem; border-bottom:1px solid rgba(var(--fg-rgb), 0.08); background:rgba(var(--fg-rgb), 0.02);">
                                            <div style="font-weight:700; color:var(--text-muted); text-align:center;">#</div>
                                            <div style="font-weight:700; color:var(--text-muted); padding-left:0.1rem;">Atleta</div>
                                            <div style="font-weight:700; color:var(--text-muted); text-align:left;">Campus</div>
                                            <div style="font-weight:700; color:#58d68d; text-align:center;">PTS</div>
                                            <div style="font-weight:700; color:#58d68d; text-align:center;">V</div>
                                            <div style="font-weight:700; color:#f1948a; text-align:center;">D</div>
                                            <div style="font-weight:700; color:#f5b041; text-align:center;">E</div>
                                        </div>
                                        <% resultadosGeneroXadrez.forEach((linhaXadrez, idxXadrez) => { %>
                                        <div style="display:grid; grid-template-columns:minmax(0,0.5fr) minmax(0,1.6fr) minmax(0,1.1fr) repeat(4,minmax(0,0.65fr)); align-items:center; gap:0.25rem; font-size:0.8rem; padding:0.48rem 0.35rem; border-top:1px solid rgba(var(--fg-rgb), 0.06); <%= idxXadrez < 3 ? 'background:rgba(88,214,141,0.04);' : '' %>">
                                            <div style="font-weight:700; color:var(--text-muted); text-align:center;"><%= idxXadrez + 1 %>º</div>
                                            <div style="color: var(--text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= linhaXadrez.atleta_nome %></div>
                                            <div style="color:rgba(var(--fg-rgb), 0.6); font-size:0.75rem; overflow:hidden; text-overflow:ellipsis;"><%= linhaXadrez.campus_nome %></div>
                                            <div style="text-align:center; font-weight:700; color:#58d68d;"><%= linhaXadrez.pontuacao || 0 %></div>
                                            <div style="text-align:center; color:#58d68d;"><%= linhaXadrez.vitorias || 0 %></div>
                                            <div style="text-align:center; color:#f1948a;"><%= linhaXadrez.derrotas || 0 %></div>
                                            <div style="text-align:center; color:#f5b041;"><%= linhaXadrez.empates || 0 %></div>
                                        </div>
                                        <% }) %>
                                    </div>
                            <% } %>
                        <% }) %>
                    <% } else { %>
                        <article class="panel-card" style="text-align:center; padding:1.5rem;">
                            <p class="panel-subtitle" style="margin:0;">Nenhum resultado lançado ainda.</p>
                        </article>
                    <% } %>
            <% } %>
        <% } else if (!ehAtletismo && !ehXadrez) { %>
            <article class="panel-card" style="text-align:center; padding:1.5rem;">
                <p class="panel-subtitle" style="margin:0;">Nenhum jogo encontrado para este filtro.</p>
            </article>
        <% } %>
    </div>

    <script>
        (function () {
            var mqlDesktop = window.matchMedia('(min-width: 768px) and (max-width: 1023.98px)');

            function inicializarCarrossel(car) {
                if (!car || car.dataset.inicializado) return;
                car.dataset.inicializado = '1';
                var trilho = car.querySelector('.carrossel-trilho');
                var anterior = car.querySelector('.carrossel-anterior');
                var proximo = car.querySelector('.carrossel-proximo');
                var dotsCaixa = car.querySelector('.carrossel-dots');
                var slides = Array.prototype.slice.call(trilho.children);
                if (!slides.length) return;
                var dots = [];
                slides.forEach(function (_, idx) {
                    var b = document.createElement('button');
                    b.type = 'button';
                    b.className = 'carrossel-dot';
                    b.setAttribute('aria-label', 'Ir para o jogo ' + (idx + 1));
                    b.addEventListener('click', function () { irPara(idx); });
                    dotsCaixa.appendChild(b);
                    dots.push(b);
                });
                function vertical() { return mqlDesktop.matches; }
                function indice() {
                    var atual = 0, menor = Infinity;
                    slides.forEach(function (s, k) {
                        var d = vertical()
                            ? Math.abs(s.offsetTop - trilho.scrollTop)
                            : Math.abs(s.offsetLeft - trilho.scrollLeft);
                        if (d < menor) { menor = d; atual = k; }
                    });
                    return atual;
                }
                function irPara(i) {
                    var alvo = slides[Math.min(slides.length - 1, Math.max(0, i))];
                    if (!alvo) return;
                    if (vertical()) trilho.scrollTo({ top: alvo.offsetTop, behavior: 'smooth' });
                    else trilho.scrollTo({ left: alvo.offsetLeft, behavior: 'smooth' });
                }
                function atualizar() {
                    var i = indice();
                    dots.forEach(function (d, k) { d.classList.toggle('ativo', k === i); });
                    anterior.disabled = i <= 0;
                    proximo.disabled = i >= slides.length - 1;
                }
                function aplicarModo() {
                    anterior.textContent = vertical() ? '\u25B2' : '\u276E';
                    proximo.textContent = vertical() ? '\u25BC' : '\u276F';
                    if (vertical()) {
                        var h = slides[0].offsetHeight || 170;
                        var estilos = window.getComputedStyle(trilho);
                        var g = parseFloat(estilos.rowGap || estilos.gap) || 16;
                        trilho.style.height = Math.round(h * 6 + g * 5 + h * 0.4) + 'px';
                    } else {
                        trilho.style.height = '';
                    }
                    atualizar();
                }
                anterior.addEventListener('click', function () { irPara(indice() - 1); });
                proximo.addEventListener('click', function () { irPara(indice() + 1); });
                var t = null;
                trilho.addEventListener('scroll', function () {
                    if (t) clearTimeout(t);
                    t = setTimeout(atualizar, 80);
                }, { passive: true });
                window.addEventListener('resize', aplicarModo);
                if (mqlDesktop.addEventListener) mqlDesktop.addEventListener('change', aplicarModo);
                aplicarModo();
            }

            var pillBox = document.getElementById('filtroRodadasJogos');
            if (pillBox) {
                pillBox.addEventListener('click', function (e) {
                    var btn = e.target.closest ? e.target.closest('.rodada-pill') : null;
                    if (!btn) return;
                    var chave = btn.dataset.rodada;
                    Array.prototype.forEach.call(pillBox.querySelectorAll('.rodada-pill'), function (p) {
                        p.classList.toggle('active', p === btn);
                    });
                    document.querySelectorAll('.grupo-rodada').forEach(function (car) {
                        var mostrar = car.dataset.rodada === chave;
                        car.hidden = !mostrar;
                        if (mostrar) inicializarCarrossel(car);
                    });
                });
            }

            document.querySelectorAll('.grupo-rodada:not([hidden])').forEach(inicializarCarrossel);
        })();
    </script>
</main>
