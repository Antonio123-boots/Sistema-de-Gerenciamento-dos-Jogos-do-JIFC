<% 
    const regrasEsporte = (typeof regrasClassificacao !== 'undefined' && regrasClassificacao) ? regrasClassificacao : { temSets: false, temCartoes: false, colunasTabela: ['Pts', 'PJ', 'V', 'E', 'D', 'GP', 'GC', 'SG'] };
    
    const temEsporteAtivo = Boolean(esporteAtivo && esporteAtivo === true);
    const temClassificacao = Array.isArray(classificacao) && classificacao.length > 0;
    const filtroAtivo = Boolean((typeof modalidadeSelecionada !== 'undefined' && modalidadeSelecionada) || (typeof generoSelecionado !== 'undefined' && generoSelecionado));
    const temClassificacaoIndividual = Array.isArray(classificacaoIndividual) && classificacaoIndividual.length > 0;
    const exibirTabelaClassificacao = Boolean(modalidadeSelecionada) && (
        (Array.isArray(classificacao) && classificacao.length > 0) ||
        (Array.isArray(grupos) && grupos.length > 0) ||
        temClassificacaoIndividual
    );
    const exibirCarrossel = false;
    const nomeModalidadeAtual = [
        typeof modalidadeSelecionada !== 'undefined' ? String(modalidadeSelecionada || '') : '',
        (Array.isArray(jogos) && jogos.length && jogos[0] && jogos[0].modalidade) ? String(jogos[0].modalidade) : '',
        (Array.isArray(classificacao) && classificacao.length && classificacao[0] && classificacao[0].nome_modalidade) ? String(classificacao[0].nome_modalidade) : '',
        (Array.isArray(grupos) && grupos.length && grupos[0] && grupos[0].nome_modalidade) ? String(grupos[0].nome_modalidade) : ''
    ].find((valor) => String(valor || '').trim()) || '';
    const ehAtletismo = /atletismo/i.test(nomeModalidadeAtual);
    const ehXadrez = /xadrez/i.test(nomeModalidadeAtual);
    const mostraPontuacao = ehXadrez || !ehAtletismo;
    const ehTabelaDireta = ehAtletismo || ehXadrez || !(Array.isArray(grupos) && grupos.length);
    const labelGrupo = ehAtletismo ? 'Categoria' : (ehXadrez ? 'Classificação' : 'Grupo');
    const deveAgruparPorGenero = !(ehAtletismo || ehXadrez);
    
    const ehSets = regrasEsporte.temSets;
    const ehCartoes = regrasEsporte.temCartoes;
    
    const colunasExibicao = !ehAtletismo && !ehXadrez 
        ? (temClassificacao && classificacao[0]?.colunas ? classificacao[0].colunas : regrasEsporte.colunasTabela)
        : [];
    const totalColunasExtra = colunasExibicao.length || 7;
    
    const defaultGrupo = {
        numero_chave: 1,
        letra: 'Geral',
        integrantes: [
            { nome: 'Campus 1', foto: '/imagens/avatar.svg', pontos: 0, jogos_jogados: 0, vitorias: 0, empates: 0, derrotas: 0, pontos_pro: 0, pontos_contra: 0 },
            { nome: 'Campus 2', foto: '/imagens/avatar.svg', pontos: 0, jogos_jogados: 0, vitorias: 0, empates: 0, derrotas: 0, pontos_pro: 0, pontos_contra: 0 },
            { nome: 'Campus 3', foto: '/imagens/avatar.svg', pontos: 0, jogos_jogados: 0, vitorias: 0, empates: 0, derrotas: 0, pontos_pro: 0, pontos_contra: 0 },
            { nome: 'Campus 4', foto: '/imagens/avatar.svg', pontos: 0, jogos_jogados: 0, vitorias: 0, empates: 0, derrotas: 0, pontos_pro: 0, pontos_contra: 0 }
        ]
    };
    
    // Agrupar grupos por gênero
    const gruposPorGenero = {};
    if (Array.isArray(grupos) && grupos.length) {
        grupos.forEach((grupo) => {
            const genero = String(grupo.genero_modalidade || 'Geral').trim();
            if (!gruposPorGenero[genero]) {
                gruposPorGenero[genero] = [];
            }
            gruposPorGenero[genero].push(grupo);
        });
    }
    
    const gruposExibicao = Array.isArray(grupos) && grupos.length
        ? grupos.slice().sort((a, b) => {
            const ordemGenero = (valor) => String(valor || '').toLowerCase().includes('feminino') ? 1 : 0;
            return ordemGenero(a.genero_modalidade) - ordemGenero(b.genero_modalidade);
        })
        : [defaultGrupo];
%>

<main class="<%= (exibirTabelaClassificacao && Array.isArray(jogos) && jogos.length > 0) ? 'home-layout' : 'home-layout home-layout--simples' %>">
    <% if (exibirTabelaClassificacao) { %>
        <aside class="home-classificacao">
            <% if (deveAgruparPorGenero) { %>
                <% 
                    const generosOrdenados = ['Masculino', 'Feminino'];
                    const gruposPorGeneroExibicao = {};
                    
                    generosOrdenados.forEach((genero) => {
                        gruposPorGeneroExibicao[genero] = Array.isArray(grupos) 
                            ? grupos.filter(g => String(g.genero_modalidade || '').trim().toLowerCase() === genero.toLowerCase())
                            : [];
                    });
                %>
                <% generosOrdenados.forEach((genero) => { %>
                    <% const gruposGenero = gruposPorGeneroExibicao[genero] || []; %>
                    <% if (gruposGenero.length > 0) { %>
                        <div style="margin-bottom:1.2rem;">
                            <div style="display:flex; align-items:center; justify-content:space-between; padding:0.45rem 0.3rem 0.35rem; border-bottom:1px solid rgba(255,255,255,0.07); margin-bottom:0.4rem;">
                                <div style="font-size:0.72rem; color:#dfe3e8; font-weight:700; text-transform:uppercase; letter-spacing:0.04em;">Classificação - <%= genero %></div>
                                <div style="font-size:0.72rem; color:#fff; font-weight:700;">0</div>
                            </div>

                            <% gruposGenero.forEach((grupo) => { %>
                                <div style="margin-bottom:0.7rem;">
                                    <div style="padding:0.3rem 0.2rem; color:#cfd8dc; font-size:0.62rem; font-weight:700; letter-spacing:0.04em; text-transform:uppercase; border-bottom:1px solid rgba(255,255,255,0.06); margin-bottom:0.3rem;">
                                        <%= labelGrupo %> <%= grupo.letra || grupo.numero_chave || 'Geral' %>
                                    </div>

                                    <div class="tabela-scroll tabela-scroll--larga" style="border:1px solid rgba(255,255,255,0.08); border-radius:10px; background:rgba(255,255,255,0.02);">
                                        <div style="display:grid; grid-template-columns:<%= mostraPontuacao ? '30px minmax(0, 1.9fr) repeat(' + totalColunasExtra + ', minmax(0, 0.56fr))' : '30px minmax(0, 2.1fr) minmax(0, 1.1fr)' %>; align-items:center; gap:0.12rem; font-size:0.62rem; color:#b8c2cc; padding:0.34rem 0.24rem 0.28rem; border-bottom:1px solid rgba(255,255,255,0.08); background:rgba(255,255,255,0.02);">
                                            <div style="font-weight:700; color:#dfe3e8; text-align:center;">#</div>
                                            <div style="font-weight:700; color:#dfe3e8; padding-left:0.1rem;">Campus</div>
                                            <% if (mostraPontuacao) { %>
                                                <% colunasExibicao.forEach((col) => { %>
                                                    <div style="font-weight:700; color:#dfe3e8; text-align:center;"><%= col %></div>
                                                <% }); %>
                                            <% } else { %>
                                                <div style="font-weight:700; color:#dfe3e8; text-align:center;">Resultado</div>
                                            <% } %>
                                        </div>

                                        <% const classifGenero1 = Array.isArray(classificacao) ? classificacao.filter(c => String(c.genero_modalidade || '').trim().toLowerCase() === genero.toLowerCase() && Number(c.chave_id || c.numero_chave) === Number(grupo.id || 0)) : []; %>
                                        <% const integrantesMap = Array.isArray(grupo.integrantes) ? new Map(grupo.integrantes.map(i => [Number(i.id || i.campus_id || i.campusId), i])) : new Map(); %>
                                        <% const participacoes = classifGenero1.length ? classifGenero1.map((c) => { const integ = integrantesMap.get(Number(c.campus_id)); return { ...c, nome: (integ && integ.nome) || c.participante_nome || 'Campus', foto: (integ && integ.foto) || c.participante_foto || c.foto_perfil || c.fotoPerfil || '/imagens/avatar.svg' }; }) : (Array.isArray(grupo.integrantes) && grupo.integrantes.length ? grupo.integrantes.map(i => ({ campus_id: i.id || i.campus_id, nome: i.nome || 'Campus', foto: i.foto || '/imagens/avatar.svg', pontos: 0, jogos_jogados: 0, vitorias: 0, empates: 0, derrotas: 0, pontos_pro: 0, pontos_contra: 0, saldo_pontuacao: 0, cartoes_amarelos: 0, cartoes_vermelhos: 0, sets_ganhos: 0, sets_perdidos: 0, resultado: '' })) : defaultGrupo.integrantes); %>
                                        <% participacoes.forEach((integrante, idx) => { %>
                                            <% const nomeCampus = integrante.nome || integrante.participante_nome || 'Campus'; %>
                                            <% const fotoCampus = integrante.foto || integrante.participante_foto || integrante.foto_perfil || '/imagens/avatar.svg'; %>
                                            <% const pontos = Number(integrante.pontos || 0); %>
                                            <% const jogos = Number(integrante.jogos_jogados || 0); %>
                                            <% const vitorias = Number(integrante.vitorias || 0); %>
                                            <% const empates = Number(integrante.empates || 0); %>
                                            <% const derrotas = Number(integrante.derrotas || 0); %>
                                            <% const pro = Number(integrante.pontos_pro || 0); %>
                                            <% const contra = Number(integrante.pontos_contra || 0); %>
                                            <% const saldo = Number(integrante.saldo_pontuacao || 0); %>
                                            <% const amarelos = Number(integrante.cartoes_amarelos || 0); %>
                                            <% const vermelhos = Number(integrante.cartoes_vermelhos || 0); %>
                                            <% const setsG = Number(integrante.sets_ganhos || 0); %>
                                            <% const setsP = Number(integrante.sets_perdidos || 0); %>
                                            <% const resultado = String(integrante.resultado || integrante.tempo || integrante.distancia || integrante.desempenho || integrante.medida || (mostraPontuacao ? '' : '—')).trim() || '—'; %>
                                            <div style="display:grid; grid-template-columns:<%= mostraPontuacao ? '30px minmax(0, 1.9fr) repeat(' + totalColunasExtra + ', minmax(0, 0.56fr))' : '30px minmax(0, 2.1fr) minmax(0, 1.1fr)' %>; align-items:center; gap:0.12rem; font-size:0.62rem; color:#b8c2cc; padding:0.32rem 0.24rem; border-top:1px solid rgba(255,255,255,0.06);">
                                                <div style="font-weight:700; color:#dfe3e8; text-align:center;"><%= idx + 1 %></div>
                                                <div style="display:flex; align-items:center; gap:0.3rem; min-width:0; overflow:hidden;">
                                                    <img src="<%= fotoCampus %>" alt="Foto do campus <%= nomeCampus %>" style="width:18px; height:18px; object-fit:cover; border-radius:50%; display:block; border:1px solid rgba(255,255,255,0.12); background:rgba(255,255,255,0.05); flex-shrink:0;">
                                                    <span style="color:#fff; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; font-size:0.62rem;"><%= nomeCampus %></span>
                                                </div>
                                                <% if (mostraPontuacao) { %>
                                                    <% colunasExibicao.forEach((col) => { %>
                                                        <% 
                                                            let valor = '';
                                                            switch(col) {
                                                                case 'Pts': valor = pontos; break;
                                                                case 'PJ': valor = jogos; break;
                                                                case 'V': valor = vitorias; break;
                                                                case 'E': valor = empates; break;
                                                                case 'D': valor = derrotas; break;
                                                                 case 'GP': case 'PF': valor = pro; break;
                                                                 case 'GC': case 'PC': valor = contra; break;
                                                                 case 'SG': valor = setsG > 0 || setsP > 0 ? setsG : saldo; break;
                                                                 case 'SP': valor = setsG > 0 || setsP > 0 ? setsP : saldo; break;
                                                                 case 'SA': valor = setsP > 0 ? (setsG / setsP).toFixed(2) : (setsG > 0 ? setsG.toFixed(2) : '0.00'); break;
                                                                 case 'PA': valor = contra > 0 ? (pro / contra).toFixed(2) : (pro > 0 ? pro.toFixed(2) : '0.00'); break;
                                                                 case 'CF': valor = amarelos + 'A ' + vermelhos + 'V'; break;
                                                                 default: valor = '';
                                                            }
                                                        %>
                                                        <div style="text-align:center; color:<%= col === 'V' ? '#58d68d' : (col === 'E' ? '#f5b041' : (col === 'D' ? '#f1948a' : '#dfe3e8')) %>; font-weight:<%= col === 'Pts' ? '700' : '400' %>;"><%= valor %></div>
                                                    <% }); %>
                                                <% } else { %>
                                                    <div style="text-align:center; color:#dfe3e8; font-weight:700;"><%= resultado %></div>
                                                <% } %>
                                            </div>
                                        <% }); %>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } %>
                <% }); %>
            <% } else if (ehAtletismo) { %>
                <%
                    const ordemGenerosProvas = ['Masculino', 'Feminino'];
                    const mapaProvasGenero = (typeof provasPorGenero === 'object' && provasPorGenero) ? provasPorGenero : {};
                    const generosComProvasCard = [
                        ...ordemGenerosProvas.filter((g) => Array.isArray(mapaProvasGenero[g]) && mapaProvasGenero[g].length > 0),
                        ...Object.keys(mapaProvasGenero).filter((g) => !ordemGenerosProvas.includes(g) && Array.isArray(mapaProvasGenero[g]) && mapaProvasGenero[g].length > 0)
                    ];
                    const provasDisponiveisHome = Array.isArray(provasAtletismo) ? provasAtletismo : [];
                    const provaFiltroAtual = (typeof provaFiltroSelecionada !== 'undefined' && String(provaFiltroSelecionada || '').trim())
                        ? String(provaFiltroSelecionada).trim()
                        : (provasDisponiveisHome[0] ? provasDisponiveisHome[0].slug : '');
                    // Um card por gênero para a prova selecionada
                    const cartoesProvaHome = [];
                    generosComProvasCard.forEach((generoGrupo) => {
                        const provaDoGenero = (mapaProvasGenero[generoGrupo] || []).find((prova) => prova.slug === provaFiltroAtual);
                        if (provaDoGenero) {
                            cartoesProvaHome.push({ genero: generoGrupo, prova: provaDoGenero });
                        }
                    });
                    const corGeneroCard = (g) => (String(g).toLowerCase() === 'feminino'
                        ? { bg: 'rgba(241,148,138,0.1)', bd: 'rgba(241,148,138,0.35)', tx: '#f5b7b1' }
                        : { bg: 'rgba(93,173,226,0.1)', bd: 'rgba(93,173,226,0.35)', tx: '#aed6f1' });
                    const construirLinkProva = (slugProva) => {
                        const params = new URLSearchParams();
                        if (modalidadeSelecionada) params.set('modalidade', modalidadeSelecionada);
                        if (generoSelecionado) params.set('genero', generoSelecionado);
                        if (diaSelecionado) params.set('dia', diaSelecionado);
                        params.set('prova', slugProva);
                        return '/?' + params.toString() + '#classificacao-atletismo';
                    };
                %>
                <div id="classificacao-atletismo" style="margin-bottom:1.2rem;">
                    <div style="display:flex; align-items:center; justify-content:space-between; padding:0.5rem 0.3rem 0.4rem; border-bottom:1px solid rgba(255,255,255,0.07); margin-bottom:0.6rem;">
                        <div style="font-size:0.85rem; color:#dfe3e8; font-weight:700; text-transform:uppercase; letter-spacing:0.04em;">Atletas por Prova</div>
                    </div>

                    <% if (provasDisponiveisHome.length > 0) { %>
                        <div style="display:flex; flex-wrap:wrap; gap:0.35rem; margin-bottom:0.8rem;">
                            <% provasDisponiveisHome.forEach((prova) => { %>
                                <a href="<%= construirLinkProva(prova.slug) %>" style="font-size:0.75rem; font-weight:700; text-decoration:none; padding:0.38rem 0.85rem; border-radius:999px; border:1px solid <%= provaFiltroAtual === prova.slug ? 'rgba(88,214,141,0.5)' : 'rgba(255,255,255,0.12)' %>; background:<%= provaFiltroAtual === prova.slug ? 'rgba(88,214,141,0.12)' : 'rgba(255,255,255,0.04)' %>; color:<%= provaFiltroAtual === prova.slug ? '#58d68d' : '#cfd8dc' %>;"><%= prova.nome %></a>
                            <% }) %>
                        </div>

                        <% cartoesProvaHome.forEach(({ genero, prova }) => { %>
                            <% const coresCardProva = corGeneroCard(genero); %>
                            <div style="margin-bottom:0.7rem;">
                                <div style="display:flex; align-items:center; gap:0.45rem; padding:0.32rem 0.2rem; color:#cfd8dc; font-size:0.78rem; font-weight:700; letter-spacing:0.04em; text-transform:uppercase; border-bottom:1px solid rgba(255,255,255,0.06); margin-bottom:0.3rem;">
                                    <span style="font-size:0.62rem; font-weight:700; letter-spacing:0.03em; padding:0.16rem 0.55rem; border-radius:999px; background:<%= coresCardProva.bg %>; border:1px solid <%= coresCardProva.bd %>; color:<%= coresCardProva.tx %>;"><%= genero %></span>
                                    <span><%= prova.nome %></span>
                                    <span style="color:#8a9ab5; text-transform:none; font-weight:400;">· <%= prova.atletas.length %> atleta(s)</span>
                                </div>
                                <div class="tabela-scroll tabela-scroll--media" style="border:1px solid rgba(255,255,255,0.08); border-radius:10px; background:rgba(255,255,255,0.02);">
                                    <div style="display:grid; grid-template-columns:38px minmax(0,1.6fr) minmax(0,1.1fr) 56px; align-items:center; gap:0.25rem; font-size:0.8rem; color:#b8c2cc; padding:0.45rem 0.35rem 0.4rem; border-bottom:1px solid rgba(255,255,255,0.08); background:rgba(255,255,255,0.02);">
                                        <div style="font-weight:700; color:#dfe3e8; text-align:center;">#</div>
                                        <div style="font-weight:700; color:#dfe3e8; padding-left:0.1rem;">Atleta</div>
                                        <div style="font-weight:700; color:#dfe3e8; text-align:left;">Campus</div>
                                        <div style="font-weight:700; color:#58d68d; text-align:center;">PTS</div>
                                    </div>
                                    <% prova.atletas.forEach((atleta, idx) => { %>
                                        <div style="display:grid; grid-template-columns:38px minmax(0,1.6fr) minmax(0,1.1fr) 56px; align-items:center; gap:0.25rem; font-size:0.8rem; color:#b8c2cc; padding:0.48rem 0.35rem; border-top:1px solid rgba(255,255,255,0.06);">
                                            <div style="font-weight:700; color:#dfe3e8; text-align:center;"><%= idx + 1 %></div>
                                            <div style="color:#fff; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= atleta.nome || 'Atleta sem nome' %></div>
                                            <div style="color:rgba(255,255,255,0.6); font-size:0.75rem; overflow:hidden; text-overflow:ellipsis;"><%= atleta.campus || '—' %></div>
                                            <% if (Number(atleta.pontos || 0) > 0) { %>
                                                <div style="text-align:center; font-weight:700; color:#58d68d;" title="<%= atleta.posicao ? (atleta.posicao + 'º lugar') : '' %>"><%= Number(atleta.pontos) %></div>
                                            <% } else { %>
                                                <div style="text-align:center; color:#6c757d;">—</div>
                                            <% } %>
                                        </div>
                                    <% }) %>
                                    <% if (!prova.atletas.length) { %>
                                        <div style="padding:0.6rem 0.35rem; font-size:0.75rem; color:#8a9ab5; text-align:center;">Sem atletas inscritos nesta prova.</div>
                                    <% } %>
                                </div>

                                <% const finaisDoGenero = (typeof resultadosFinaisAtletismo === 'object' && resultadosFinaisAtletismo) ? (resultadosFinaisAtletismo[genero] || {}) : {}; %>
                                <% const linhasFinal = finaisDoGenero[prova.slug] || []; %>
                                <% if (linhasFinal.length > 0) { %>
                                    <div style="margin-top:0.45rem;">
                                        <div style="display:flex; align-items:center; gap:0.45rem; padding:0.32rem 0.2rem; color:#cfd8dc; font-size:0.78rem; font-weight:700; letter-spacing:0.04em; text-transform:uppercase; border-bottom:1px solid rgba(255,255,255,0.06); margin-bottom:0.3rem;">
                                            <span style="font-size:0.62rem; font-weight:700; letter-spacing:0.03em; padding:0.16rem 0.55rem; border-radius:999px; background:rgba(88,214,141,0.12); border:1px solid rgba(88,214,141,0.4); color:#58d68d;">Final</span>
                                            <span>Resultado da Final · <%= prova.nome %></span>
                                        </div>
                                        <div class="tabela-scroll tabela-scroll--media" style="border:1px solid rgba(88,214,141,0.25); border-radius:10px; background:rgba(88,214,141,0.03);">
                                            <div style="display:grid; grid-template-columns:38px minmax(0,1.6fr) minmax(0,1.1fr) 74px 56px; align-items:center; gap:0.25rem; font-size:0.8rem; color:#b8c2cc; padding:0.45rem 0.35rem 0.4rem; border-bottom:1px solid rgba(255,255,255,0.08); background:rgba(255,255,255,0.02);">
                                                <div style="font-weight:700; color:#dfe3e8; text-align:center;">#</div>
                                                <div style="font-weight:700; color:#dfe3e8; padding-left:0.1rem;">Atleta</div>
                                                <div style="font-weight:700; color:#dfe3e8; text-align:left;">Campus</div>
                                                <div style="font-weight:700; color:#dfe3e8; text-align:center;">Tempo</div>
                                                <div style="font-weight:700; color:#58d68d; text-align:center;">PTS</div>
                                            </div>
                                            <% linhasFinal.forEach((linha) => { %>
                                                <div style="display:grid; grid-template-columns:38px minmax(0,1.6fr) minmax(0,1.1fr) 74px 56px; align-items:center; gap:0.25rem; font-size:0.8rem; color:#b8c2cc; padding:0.48rem 0.35rem; border-top:1px solid rgba(255,255,255,0.06);">
                                                    <div style="font-weight:700; color:<%= linha.posicao && linha.posicao <= 3 ? '#58d68d' : '#dfe3e8' %>; text-align:center;"><%= linha.posicao ? (linha.posicao + 'º') : '—' %></div>
                                                    <div style="color:#fff; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= linha.nome || 'Atleta sem nome' %></div>
                                                    <div style="color:rgba(255,255,255,0.6); font-size:0.75rem; overflow:hidden; text-overflow:ellipsis;"><%= linha.campus || '—' %></div>
                                                    <div style="text-align:center; font-family:monospace; color:rgba(255,255,255,0.85);"><%= linha.tempo || '—' %></div>
                                                    <% if (Number(linha.pontos || 0) > 0) { %>
                                                        <div style="text-align:center; font-weight:700; color:#58d68d;"><%= Number(linha.pontos) %></div>
                                                    <% } else { %>
                                                        <div style="text-align:center; color:#6c757d;">—</div>
                                                    <% } %>
                                                </div>
                                            <% }) %>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div style="padding:0.6rem 0.3rem; font-size:0.75rem; color:#8a9ab5;">Nenhum atleta inscrito no atletismo ainda.</div>
                    <% } %>
                </div>
            <% } else if (!ehXadrez) { %>
                <%
                    const gruposBaseTabela = Array.isArray(grupos) && grupos.length ? grupos : [];
                    const ordemGenerosTabela = ['Masculino', 'Feminino'];
                    const generosNasTabelas = [...new Set(gruposBaseTabela.map((g) => String(g.genero_modalidade || '').trim()).filter(Boolean))];
                    const secoesGeneroTabela = (!generoSelecionado && generosNasTabelas.length > 1)
                        ? [
                            ...ordemGenerosTabela.filter((g) => generosNasTabelas.includes(g)),
                            ...generosNasTabelas.filter((g) => !ordemGenerosTabela.includes(g))
                          ].map((g) => ({ genero: g, lista: gruposBaseTabela.filter((gr) => String(gr.genero_modalidade || '').trim() === g) }))
                        : [{ genero: '', lista: gruposBaseTabela.length ? gruposBaseTabela : [defaultGrupo] }];
                    const corGeneroTabela = (g) => (String(g).toLowerCase() === 'feminino'
                        ? { bg: 'rgba(241,148,138,0.1)', bd: 'rgba(241,148,138,0.35)', tx: '#f5b7b1' }
                        : { bg: 'rgba(93,173,226,0.1)', bd: 'rgba(93,173,226,0.35)', tx: '#aed6f1' });
                %>
                <div style="margin-bottom:1.2rem;">
                    <div style="display:flex; align-items:center; justify-content:space-between; padding:0.5rem 0.3rem 0.4rem; border-bottom:1px solid rgba(255,255,255,0.07); margin-bottom:0.5rem;">
                        <div style="font-size:0.85rem; color:#dfe3e8; font-weight:700; text-transform:uppercase; letter-spacing:0.04em;">
                            <%= ehXadrez ? 'Classificação Geral' : 'Classificação' %>
                        </div>
                        <div style="font-size:0.85rem; color:#fff; font-weight:700;"><%= ehXadrez ? 'Pts' : 'Resultado' %></div>
                    </div>

                    <% secoesGeneroTabela.forEach((secaoGenero) => { %>
                        <% if (secaoGenero.genero) { %>
                            <% const coresGenero = corGeneroTabela(secaoGenero.genero); %>
                            <div style="margin:0.6rem 0 0.5rem;">
                                <span style="display:inline-block; font-size:0.78rem; font-weight:700; letter-spacing:0.05em; text-transform:uppercase; padding:0.28rem 0.75rem; border-radius:999px; background:<%= coresGenero.bg %>; border:1px solid <%= coresGenero.bd %>; color:<%= coresGenero.tx %>;"><%= secaoGenero.genero %></span>
                            </div>
                        <% } %>
                    <% (secaoGenero.lista.length ? secaoGenero.lista : [defaultGrupo]).forEach((grupo) => { %>
                        <div style="margin-bottom:0.8rem;">
                            <div style="padding:0.32rem 0.2rem; color:#cfd8dc; font-size:0.75rem; font-weight:700; letter-spacing:0.04em; text-transform:uppercase; border-bottom:1px solid rgba(255,255,255,0.06); margin-bottom:0.3rem;">
                                <%= labelGrupo %> <%= grupo.letra || grupo.numero_chave || 'Geral' %>
                            </div>

                            <div class="tabela-scroll tabela-scroll--larga" style="border:1px solid rgba(255,255,255,0.08); border-radius:10px; background:rgba(255,255,255,0.02);">
                                <div style="display:grid; grid-template-columns:<%= mostraPontuacao ? '38px minmax(0, 1.9fr) repeat(' + totalColunasExtra + ', minmax(0, 0.56fr))' : '38px minmax(0, 2.1fr) minmax(0, 1.1fr)' %>; align-items:center; gap:0.25rem; font-size:0.8rem; color:#b8c2cc; padding:0.45rem 0.35rem 0.4rem; border-bottom:1px solid rgba(255,255,255,0.08); background:rgba(255,255,255,0.02);">
                                    <div style="font-weight:700; color:#dfe3e8; text-align:center;">#</div>
                                    <div style="font-weight:700; color:#dfe3e8; padding-left:0.1rem;">Campus</div>
                                    <% if (mostraPontuacao) { %>
                                        <% colunasExibicao.forEach((col) => { %>
                                            <div style="font-weight:700; color:#dfe3e8; text-align:center;"><%= col %></div>
                                        <% }); %>
                                    <% } else { %>
                                        <div style="font-weight:700; color:#dfe3e8; text-align:center;">Resultado</div>
                                    <% } %>
                                </div>

                                <% const classifGrupo2 = Array.isArray(classificacao) ? classificacao.filter(c => Number(c.chave_id || c.numero_chave) === Number(grupo.id || 0)) : []; %>
                                <% const integrantesMap2 = Array.isArray(grupo.integrantes) ? new Map(grupo.integrantes.map(i => [Number(i.id || i.campus_id || i.campusId), i])) : new Map(); %>
                                <% const participacoes = classifGrupo2.length ? classifGrupo2.map((c) => { const integ = integrantesMap2.get(Number(c.campus_id)); return { ...c, nome: (integ && integ.nome) || c.participante_nome || 'Campus', foto: (integ && integ.foto) || c.participante_foto || c.foto_perfil || c.fotoPerfil || '/imagens/avatar.svg' }; }) : (Array.isArray(grupo.integrantes) && grupo.integrantes.length ? grupo.integrantes.map(i => ({ campus_id: i.id || i.campus_id, nome: i.nome || 'Campus', foto: i.foto || '/imagens/avatar.svg', pontos: 0, jogos_jogados: 0, vitorias: 0, empates: 0, derrotas: 0, pontos_pro: 0, pontos_contra: 0, saldo_pontuacao: 0, cartoes_amarelos: 0, cartoes_vermelhos: 0, sets_ganhos: 0, sets_perdidos: 0, resultado: '' })) : defaultGrupo.integrantes); %>
                                <% participacoes.forEach((integrante, idx) => { %>
                                    <% const nomeCampus = integrante.nome || integrante.participante_nome || 'Campus'; %>
                                    <% const fotoCampus = integrante.foto || integrante.participante_foto || integrante.foto_perfil || '/imagens/avatar.svg'; %>
                                    <% const pontos = Number(integrante.pontos || 0); %>
                                    <% const jogos = Number(integrante.jogos_jogados || 0); %>
                                    <% const vitorias = Number(integrante.vitorias || 0); %>
                                    <% const empates = Number(integrante.empates || 0); %>
                                    <% const derrotas = Number(integrante.derrotas || 0); %>
                                    <% const pro = Number(integrante.pontos_pro || 0); %>
                                    <% const contra = Number(integrante.pontos_contra || 0); %>
                                    <% const saldo = Number(integrante.saldo_pontuacao || 0); %>
                                    <% const amarelos = Number(integrante.cartoes_amarelos || 0); %>
                                    <% const vermelhos = Number(integrante.cartoes_vermelhos || 0); %>
                                    <% const setsG = Number(integrante.sets_ganhos || 0); %>
                                    <% const setsP = Number(integrante.sets_perdidos || 0); %>
                                    <% const resultado = String(integrante.resultado || integrante.tempo || integrante.distancia || integrante.desempenho || integrante.medida || (mostraPontuacao ? '' : '—')).trim() || '—'; %>
                                    <div style="display:grid; grid-template-columns:<%= mostraPontuacao ? '38px minmax(0, 1.9fr) repeat(' + totalColunasExtra + ', minmax(0, 0.56fr))' : '38px minmax(0, 2.1fr) minmax(0, 1.1fr)' %>; align-items:center; gap:0.25rem; font-size:0.8rem; color:#b8c2cc; padding:0.48rem 0.35rem; border-top:1px solid rgba(255,255,255,0.06);">
                                        <div style="font-weight:700; color:#dfe3e8; text-align:center;"><%= idx + 1 %></div>
                                        <div style="display:flex; align-items:center; gap:0.4rem; min-width:0; overflow:hidden;">
                                            <img src="<%= fotoCampus %>" alt="Foto do campus <%= nomeCampus %>" style="width:22px; height:22px; object-fit:cover; border-radius:50%; display:block; border:1px solid rgba(255,255,255,0.12); background:rgba(255,255,255,0.05); flex-shrink:0;">
                                            <span style="color:#fff; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; font-size:0.8rem;"><%= nomeCampus %></span>
                                        </div>
                                        <% if (mostraPontuacao) { %>
                                            <% colunasExibicao.forEach((col) => { %>
                                                <% 
                                                    let valor = '';
                                                    switch(col) {
                                                        case 'Pts': valor = pontos; break;
                                                        case 'PJ': valor = jogos; break;
                                                        case 'V': valor = vitorias; break;
                                                        case 'E': valor = empates; break;
                                                        case 'D': valor = derrotas; break;
                                                        case 'GP': case 'PF': valor = pro; break;
                                                        case 'GC': case 'PC': valor = contra; break;
                                                        case 'SG': valor = setsG > 0 || setsP > 0 ? setsG : saldo; break;
                                                        case 'SP': valor = setsG > 0 || setsP > 0 ? setsP : saldo; break;
                                                        case 'SA': valor = setsP > 0 ? (setsG / setsP).toFixed(2) : (setsG > 0 ? setsG.toFixed(2) : '0.00'); break;
                                                        case 'PA': valor = contra > 0 ? (pro / contra).toFixed(2) : (pro > 0 ? pro.toFixed(2) : '0.00'); break;
                                                        case 'CF': valor = amarelos + 'A ' + vermelhos + 'V'; break;
                                                        default: valor = '';
                                                    }
                                                %>
                                                <div style="text-align:center; color:<%= col === 'V' ? '#58d68d' : (col === 'E' ? '#f5b041' : (col === 'D' ? '#f1948a' : '#dfe3e8')) %>; font-weight:<%= col === 'Pts' ? '700' : '400' %>;"><%= valor %></div>
                                            <% }); %>
                                        <% } else { %>
                                            <div style="text-align:center; color:#dfe3e8; font-weight:700;"><%= resultado %></div>
                                        <% } %>
                                    </div>
                                <% }); %>
                            </div>
                        </div>
                    <% }); %>
                    <% }); %>
                </div>
            <% } %>

            <% if (temClassificacaoIndividual) { %>
                <div style="margin-top:0.75rem; border-top:1px solid rgba(255,255,255,0.07); padding-top:0.75rem;">
                    <div style="font-size:0.85rem; color:#dfe3e8; font-weight:700; text-transform:uppercase; letter-spacing:0.04em; margin-bottom:0.5rem;">
                        Classificação Geral
                    </div>
                    <%
                        const ordemGenerosGeral = ['Masculino', 'Feminino'];
                        const mapaGeralGenero = (tipoClassificacaoIndividual === 'atletismo' && typeof classificacaoAtletismoPorGenero === 'object' && classificacaoAtletismoPorGenero)
                            ? classificacaoAtletismoPorGenero
                            : ((tipoClassificacaoIndividual === 'xadrez' && typeof classificacaoXadrezPorGenero !== 'undefined' && classificacaoXadrezPorGenero && typeof classificacaoXadrezPorGenero === 'object') ? classificacaoXadrezPorGenero : null);
                        const secoesGeralTabela = mapaGeralGenero
                            ? [
                                ...ordemGenerosGeral.filter((g) => Array.isArray(mapaGeralGenero[g]) && mapaGeralGenero[g].length > 0),
                                ...Object.keys(mapaGeralGenero).filter((g) => !ordemGenerosGeral.includes(g) && Array.isArray(mapaGeralGenero[g]) && mapaGeralGenero[g].length > 0)
                              ].map((g) => ({ genero: g, dados: mapaGeralGenero[g] }))
                            : [{ genero: '', dados: Array.isArray(classificacaoIndividual) ? classificacaoIndividual : [] }];
                        const corGeneroGeral = (g) => (String(g).toLowerCase() === 'feminino'
                            ? { bg: 'rgba(241,148,138,0.1)', bd: 'rgba(241,148,138,0.35)', tx: '#f5b7b1' }
                            : { bg: 'rgba(93,173,226,0.1)', bd: 'rgba(93,173,226,0.35)', tx: '#aed6f1' });
                    %>
                    <% secoesGeralTabela.forEach((secaoGeral) => { %>
                        <% if (secaoGeral.genero && secoesGeralTabela.length > 1) { %>
                            <% const coresGeral = corGeneroGeral(secaoGeral.genero); %>
                            <div style="margin:0.7rem 0 0.45rem;">
                                <span style="display:inline-block; font-size:0.78rem; font-weight:700; letter-spacing:0.05em; text-transform:uppercase; padding:0.28rem 0.75rem; border-radius:999px; background:<%= coresGeral.bg %>; border:1px solid <%= coresGeral.bd %>; color:<%= coresGeral.tx %>;"><%= secaoGeral.genero %></span>
                            </div>
                        <% } %>
                        <div class="tabela-scroll tabela-scroll--media" style="border:1px solid rgba(255,255,255,0.08); border-radius:10px; background:rgba(255,255,255,0.02); <%= secaoGeral.genero && secoesGeralTabela.length > 1 ? 'margin-bottom:0.9rem;' : '' %>">
                            <% if (tipoClassificacaoIndividual === 'atletismo') { %>
                                <div style="display:grid; grid-template-columns:34px minmax(0,1.6fr) minmax(0,0.9fr) 48px; align-items:center; gap:0.25rem; font-size:0.8rem; color:#b8c2cc; padding:0.45rem 0.35rem 0.4rem; border-bottom:1px solid rgba(255,255,255,0.08); background:rgba(255,255,255,0.02);">
                                    <div style="font-weight:700; color:#dfe3e8; text-align:center;">#</div>
                                    <div style="font-weight:700; color:#dfe3e8; padding-left:0.1rem;">Campus</div>
                                    <div style="font-weight:700; color:#dfe3e8; text-align:center;">Provas</div>
                                    <div style="font-weight:700; color:#58d68d; text-align:center;">PTS</div>
                                </div>
                            <% } else { %>
                                <div style="display:grid; grid-template-columns:34px minmax(0,1.5fr) minmax(0,1fr) 48px; align-items:center; gap:0.25rem; font-size:0.8rem; color:#b8c2cc; padding:0.45rem 0.35rem 0.4rem; border-bottom:1px solid rgba(255,255,255,0.08); background:rgba(255,255,255,0.02);">
                                    <div style="font-weight:700; color:#dfe3e8; text-align:center;">#</div>
                                    <div style="font-weight:700; color:#dfe3e8; padding-left:0.1rem;">Atleta</div>
                                    <div style="font-weight:700; color:#dfe3e8; text-align:left;">Campus</div>
                                    <div style="font-weight:700; color:#58d68d; text-align:center;">PTS</div>
                                </div>
                            <% } %>
                            <% if (tipoClassificacaoIndividual === 'xadrez') { %>
                                <div style="display:grid; grid-template-columns:34px minmax(0,1.5fr) minmax(0,1fr) repeat(4,34px); align-items:center; gap:0.25rem; font-size:0.8rem; color:#b8c2cc; padding:0.28rem 0.35rem; border-bottom:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.01);">
                                    <div></div><div></div><div></div>
                                    <div style="text-align:center; font-weight:700; color:#dfe3e8;">V</div>
                                    <div style="text-align:center; font-weight:700; color:#dfe3e8;">D</div>
                                    <div style="text-align:center; font-weight:700; color:#dfe3e8;">E</div>
                                </div>
                            <% } %>
                            <% secaoGeral.dados.forEach((c, idx) => { %>
                            <% if (tipoClassificacaoIndividual === 'atletismo') { %>
                                <div style="display:grid; grid-template-columns:34px minmax(0,1.6fr) minmax(0,0.9fr) 48px; align-items:center; gap:0.25rem; font-size:0.8rem; padding:0.48rem 0.35rem; border-top:1px solid rgba(255,255,255,0.06); <%= idx < 3 ? 'background:rgba(88,214,141,0.04);' : '' %>">
                                    <div style="font-weight:700; color:#dfe3e8; text-align:center;"><%= idx + 1 %>º</div>
                                    <div style="display:flex; align-items:center; gap:0.4rem; min-width:0;">
                                        <img src="<%= c.foto_perfil || '/imagens/avatar.svg' %>" alt="Foto do campus <%= c.campus_nome || '' %>" style="width:22px; height:22px; object-fit:cover; border-radius:50%; display:block; border:1px solid rgba(255,255,255,0.12); background:rgba(255,255,255,0.05); flex-shrink:0;">
                                        <span style="color:#fff; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= c.campus_nome || 'Campus sem nome' %></span>
                                    </div>
                                    <div style="text-align:center; color:rgba(255,255,255,0.6);"><%= Number(c.provas_pontuadas || 0) %></div>
                                    <div style="text-align:center; font-weight:700; color:#58d68d;"><%= Number(c.pontos || 0) %></div>
                                </div>
                            <% } else if (tipoClassificacaoIndividual === 'xadrez') { %>
                                <div style="display:grid; grid-template-columns:34px minmax(0,1.5fr) minmax(0,1fr) repeat(4,34px); align-items:center; gap:0.25rem; font-size:0.8rem; padding:0.48rem 0.35rem; border-top:1px solid rgba(255,255,255,0.06); <%= idx < 3 ? 'background:rgba(88,214,141,0.04);' : '' %>">
                                    <div style="font-weight:700; color:#dfe3e8; text-align:center;"><%= idx + 1 %>º</div>
                                    <div style="color:#fff; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= c.atleta_nome %></div>
                                    <div style="color:rgba(255,255,255,0.6); font-size:0.75rem;"><%= c.campus_nome %></div>
                                    <div style="text-align:center; font-weight:700; color:#58d68d;"><%= c.pontuacao || 0 %></div>
                                    <div style="text-align:center; color:#58d68d;"><%= c.vitorias || 0 %></div>
                                    <div style="text-align:center; color:#f1948a;"><%= c.derrotas || 0 %></div>
                                    <div style="text-align:center; color:#f5b041;"><%= c.empates || 0 %></div>
                                </div>
                            <% } else { %>
                                <div style="display:grid; grid-template-columns:34px minmax(0,1.5fr) minmax(0,1fr) 48px; align-items:center; gap:0.25rem; font-size:0.8rem; padding:0.48rem 0.35rem; border-top:1px solid rgba(255,255,255,0.06); <%= idx < 3 ? 'background:rgba(88,214,141,0.04);' : '' %>">
                                    <div style="font-weight:700; color:#dfe3e8; text-align:center;"><%= idx + 1 %>º</div>
                                    <div style="color:#fff; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= c.atleta_nome %></div>
                                    <div style="color:rgba(255,255,255,0.6); font-size:0.75rem;"><%= c.campus_nome %></div>
                                    <div style="text-align:center; font-weight:700; color:#58d68d;"><%= c.pontos || 0 %></div>
                                </div>
                            <% } %>
                            <% }); %>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </aside>
    <% } %>


    <details class="painel-jogos" open>
        <summary class="painel-jogos__cabecalho">
            <span class="painel-jogos__titulo">
                Jogos<% if (Array.isArray(jogos) && jogos.length > 0) { %> (<%= jogos.length %>)<% } %>
            </span>
            <span class="painel-jogos__dica" aria-hidden="true"></span>
            <span class="painel-jogos__seta" aria-hidden="true">&#9662;</span>
        </summary>

        <div style="width:100%;">
            <% if (Array.isArray(jogos) && jogos.length > 0) { %>
                <% if (esporteAtivo) { %>
                    <div class="carrossel-jogos" id="carrosselJogos">
                        <button type="button" class="carrossel-btn carrossel-anterior" aria-label="Jogo anterior">&#10094;</button>
                        <div class="carrossel-trilho">
                <% } else { %>
                    <div class="jogos-grid jogos-grid--fixa">
                <% } %>
                <% jogos.forEach((jogo) => { %>
                    <article class="panel-card" style="position:relative; padding:1rem; background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.08); border-radius:18px; display:flex; flex-direction:column; justify-content:space-between; height:100%;">
                        <% if (Boolean(jogo.wo)) { %>
                            <span style="position:absolute; top:0.6rem; right:0.75rem; font-size:0.55rem; font-weight:800; letter-spacing:0.08em; padding:0.15rem 0.45rem; border-radius:6px; line-height:1.2; background:rgba(245,176,65,0.18); color:#f5b041;">W.O.</span>
                        <% } %>
                        <%
                          const faseRotulo = jogo.fase === 'Fase de Grupos' ? 'Classificatórias'
                            : jogo.fase === 'Terceiro Lugar' ? 'Disputa de 3°' : (jogo.fase || '');
                        %>
                        <div style="display:flex; flex-direction:column; gap:0.35rem; margin-bottom:0.75rem; min-height:1.5rem;">
                            <% if (faseRotulo) { %>
                                <span style="align-self:flex-start; font-size:0.55rem; font-weight:800; letter-spacing:0.08em; text-transform:uppercase; padding:0.15rem 0.45rem; border-radius:6px; line-height:1.2; background:rgba(236,228,45,0.18); color:#ece42d;"><%= faseRotulo %></span>
                            <% } %>
                            <div style="font-size:0.75rem; color:#cfd8dc; text-transform:uppercase; letter-spacing:0.08em; line-height:1.3;"><%= jogo.modalidade %> · <%= jogo.genero %></div>
                        </div>

                        <div style="display:grid; grid-template-columns:minmax(0,1fr) auto minmax(0,1fr); gap:0.75rem; align-items:center; flex:1;">
                            <div style="text-align:center; min-width:0;">
                                <img src="<%= jogo.fotoCasa || '/imagens/avatar.svg' %>" alt="Foto do campus <%= jogo.casa %>" style="width:48px; height:48px; object-fit:cover; border-radius:50%; margin:0 auto 0.55rem; border:1px solid rgba(255,255,255,0.12); background:rgba(255,255,255,0.08); display:block;">
                                <div style="font-size:0.75rem; color:#fff; font-weight:600; line-height:1.2; word-break:break-word;"><%= (jogo.casa) ? jogo.casa : (jogo.rotuloCasa || 'A definir') %></div>
                            </div>

                            <div style="display:flex; flex-direction:column; gap:0.25rem; justify-items:center; text-align:center; align-items:center; flex-shrink:0;">
                                <% const temPlacar = jogo.status && jogo.status !== 'Agendado' && (Number(jogo.placar_casa) > 0 || Number(jogo.placar_fora) > 0 || jogo.status === 'Encerrado' || jogo.status === 'Em Andamento'); %>
                                <% if (temPlacar) { %>
                                    <% const ehVolei = jogo.sets && jogo.sets.length > 0; %>
                                    <% if (ehVolei) { %>
                                        <%
                                          let s1 = 0, s2 = 0;
                                          jogo.sets.forEach(s => {
                                            if (Number(s.pontos_1 || 0) > Number(s.pontos_2 || 0)) s1++;
                                            else if (Number(s.pontos_2 || 0) > Number(s.pontos_1 || 0)) s2++;
                                          });
                                        %>
                                        <div style="font-size:1.25rem; font-weight:800; color:#fff; line-height:1.2; letter-spacing:0.02em;">
                                            <span><%= s1 %></span>
                                            <span style="color:#6c757d; margin:0 0.15rem; font-weight:400;">x</span>
                                            <span><%= s2 %></span>
                                            <span style="font-size:0.55rem; color:#8a9ab5; font-weight:600; margin-left:0.15rem;"></span>
                                        </div>
                                        <div style="font-size:0.55rem; color:#8a9ab5; line-height:1.4; margin-top:0.15rem;">
                                            <% jogo.sets.forEach((s, idx) => { %>
                                                <%= s.pontos_1 %>-<%= s.pontos_2 %><%= idx < jogo.sets.length - 1 ? ' · ' : '' %>
                                            <% }); %>
                                        </div>
                                    <% } else { %>
                                        <div style="font-size:1.15rem; font-weight:800; color:#fff; line-height:1.2; letter-spacing:0.02em;">
                                            <span><%= jogo.placar_casa %></span>
                                            <span style="color:#6c757d; margin:0 0.15rem; font-weight:400;">x</span>
                                            <span><%= jogo.placar_fora %></span>
                                        </div>
                                    <% } %>
                                    <%
                                      const temDisputa = jogo.disputa_pontos_1 != null && jogo.disputa_pontos_2 != null
                                        && Number(jogo.disputa_pontos_1) !== Number(jogo.disputa_pontos_2);
                                    %>
                                    <% if (temDisputa) { %>
                                        <div style="font-size:0.6rem; font-weight:700; color:#f5b041; line-height:1.2; margin-top:0.2rem;">Pênaltis <%= jogo.disputa_pontos_1 %>-<%= jogo.disputa_pontos_2 %></div>
                                    <% } %>
                                    <div style="font-size:0.6rem; font-weight:700; padding:0.15rem 0.5rem; border-radius:6px; line-height:1.2; margin-top:0.2rem;
                                        <%= jogo.status === 'Encerrado' ? 'background:rgba(88,214,141,0.18); color:#58d68d;' : 'background:rgba(241,196,39,0.18); color:#f5b041;' %>
                                    "><%= jogo.status %></div>
                                <% } else { %>
                                    <div style="font-size:0.95rem; font-weight:700; color:#fff; line-height:1.2;"><%= jogo.horario %></div>
                                    <div style="font-size:0.65rem; color:#cfd8dc; text-transform:uppercase; letter-spacing:0.08em; line-height:1.2;"><%= jogo.local_jogo || 'A def' %></div>
                                    <div style="font-size:0.65rem; color:#cfd8dc; line-height:1.2;"><%= jogo.data %></div>
                                <% } %>
                            </div>

                            <div style="text-align:center; min-width:0;">
                                <img src="<%= jogo.fotoFora || '/imagens/avatar.svg' %>" alt="Foto do campus <%= jogo.fora %>" style="width:48px; height:48px; object-fit:cover; border-radius:50%; margin:0 auto 0.55rem; border:1px solid rgba(255,255,255,0.12); background:rgba(255,255,255,0.08); display:block;">
                                <div style="font-size:0.75rem; color:#fff; font-weight:600; line-height:1.2; word-break:break-word;"><%= (jogo.fora) ? jogo.fora : (jogo.rotuloFora || 'A definir') %></div>
                            </div>
                        </div>
                    </article>
                <% }); %>
                <% if (esporteAtivo) { %>
                        </div>
                        <button type="button" class="carrossel-btn carrossel-proximo" aria-label="Próximo jogo">&#10095;</button>
                        <div class="carrossel-dots"></div>
                    </div>
                <% } else { %>
            </div>
                <% } %>
        <% } else { %>
            <article class="panel-card" style="text-align:center; padding:1.5rem;">
                <p class="panel-subtitle" style="margin:0;">Nenhum jogo encontrado para este filtro.</p>
            </article>
        <% } %>
        </div>
    </details>

    <script>
        (function () {
            var car = document.getElementById('carrosselJogos');
            if (!car) return;
            var trilho = car.querySelector('.carrossel-trilho');
            var anterior = car.querySelector('.carrossel-anterior');
            var proximo = car.querySelector('.carrossel-proximo');
            var dotsCaixa = car.querySelector('.carrossel-dots');
            var mqlDesktop = window.matchMedia('(min-width: 768px) and (max-width: 1023.98px)');
            var slides = Array.prototype.slice.call(trilho.children);
            if (!slides.length) return;
            var dots = [];
            slides.forEach(function (_, idx) {
                var b = document.createElement('button');
                b.type = 'button';
                b.className = 'carrossel-dot';
                b.setAttribute('aria-label', 'Ir para o jogo ' + (idx + 1));
                b.addEventListener('click', function () { irPara(idx); });
                dotsCaixa.appendChild(b);
                dots.push(b);
            });
            function vertical() { return mqlDesktop.matches; }
            function indice() {
                var atual = 0, menor = Infinity;
                slides.forEach(function (s, k) {
                    var d = vertical()
                        ? Math.abs(s.offsetTop - trilho.scrollTop)
                        : Math.abs(s.offsetLeft - trilho.scrollLeft);
                    if (d < menor) { menor = d; atual = k; }
                });
                return atual;
            }
            function irPara(i) {
                var alvo = slides[Math.min(slides.length - 1, Math.max(0, i))];
                if (!alvo) return;
                if (vertical()) trilho.scrollTo({ top: alvo.offsetTop, behavior: 'smooth' });
                else trilho.scrollTo({ left: alvo.offsetLeft, behavior: 'smooth' });
            }
            function aplicarModo() {
                anterior.textContent = vertical() ? '\u25B2' : '\u276E';
                proximo.textContent = vertical() ? '\u25BC' : '\u276F';
                if (vertical()) {
                    var h = slides[0].offsetHeight || 170;
                    var estilos = window.getComputedStyle(trilho);
                    var g = parseFloat(estilos.rowGap || estilos.gap) || 16;
                    trilho.style.height = Math.round(h * 4 + g * 3 + h * 0.35) + 'px';
                } else {
                    trilho.style.height = '';
                }
                atualizar();
            }
            function atualizar() {
                var i = indice();
                dots.forEach(function (d, k) { d.classList.toggle('ativo', k === i); });
                anterior.disabled = i <= 0;
                proximo.disabled = i >= slides.length - 1;
            }
            anterior.addEventListener('click', function () { irPara(indice() - 1); });
            proximo.addEventListener('click', function () { irPara(indice() + 1); });
            var t = null;
            trilho.addEventListener('scroll', function () {
                if (t) clearTimeout(t);
                t = setTimeout(atualizar, 80);
            }, { passive: true });
            window.addEventListener('resize', aplicarModo);
            if (mqlDesktop.addEventListener) mqlDesktop.addEventListener('change', aplicarModo);
            aplicarModo();
        })();
    </script>
</main>
