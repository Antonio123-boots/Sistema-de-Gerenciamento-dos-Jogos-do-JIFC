<% 
    const regrasEsporte = (typeof regrasClassificacao !== 'undefined' && regrasClassificacao) ? regrasClassificacao : { temSets: false, temCartoes: false, colunasTabela: ['Pts', 'PJ', 'V', 'E', 'D', 'GP', 'GC', 'SG'] };
    
    const temEsporteAtivo = Boolean(esporteAtivo && esporteAtivo === true);
    const temClassificacao = Array.isArray(classificacao) && classificacao.length > 0;
    const filtroAtivo = Boolean((typeof modalidadeSelecionada !== 'undefined' && modalidadeSelecionada) || (typeof generoSelecionado !== 'undefined' && generoSelecionado));
    const temClassificacaoIndividual = Array.isArray(classificacaoIndividual) && classificacaoIndividual.length > 0;
    const exibirTabelaClassificacao = Boolean(modalidadeSelecionada) && (
        (Array.isArray(classificacao) && classificacao.length > 0) ||
        (Array.isArray(grupos) && grupos.length > 0) ||
        temClassificacaoIndividual
    );
    const exibirCarrossel = false;
    const nomeModalidadeAtual = [
        typeof modalidadeSelecionada !== 'undefined' ? String(modalidadeSelecionada || '') : '',
        (Array.isArray(jogos) && jogos.length && jogos[0] && jogos[0].modalidade) ? String(jogos[0].modalidade) : '',
        (Array.isArray(classificacao) && classificacao.length && classificacao[0] && classificacao[0].nome_modalidade) ? String(classificacao[0].nome_modalidade) : '',
        (Array.isArray(grupos) && grupos.length && grupos[0] && grupos[0].nome_modalidade) ? String(grupos[0].nome_modalidade) : ''
    ].find((valor) => String(valor || '').trim()) || '';
    const ehAtletismo = /atletismo/i.test(nomeModalidadeAtual);
    const ehXadrez = /xadrez/i.test(nomeModalidadeAtual);
    const ehTenisMesa = /t[eê]nis\s+de\s+mesa/i.test(nomeModalidadeAtual);
    const mostraPontuacao = ehXadrez || !ehAtletismo;
    const ehTabelaDireta = ehAtletismo || ehXadrez || !(Array.isArray(grupos) && grupos.length);
    const labelGrupo = ehAtletismo ? 'Categoria' : (ehXadrez ? 'Classificação' : 'Grupo');
    const deveAgruparPorGenero = !(ehAtletismo || ehXadrez);
    const temDadosAtletismo = Boolean(typeof classificacaoAtletismoPorGenero === 'object' && classificacaoAtletismoPorGenero && Object.keys(classificacaoAtletismoPorGenero).length > 0);
    const temDadosXadrez = Boolean(typeof classificacaoXadrezPorGenero === 'object' && classificacaoXadrezPorGenero && Object.keys(classificacaoXadrezPorGenero).length > 0);
    
    const ehSets = regrasEsporte.temSets;
    const ehCartoes = regrasEsporte.temCartoes;
    
    const colunasExibicao = !ehAtletismo && !ehXadrez 
        ? (temClassificacao && classificacao[0]?.colunas ? classificacao[0].colunas : regrasEsporte.colunasTabela)
        : [];
    const totalColunasExtra = colunasExibicao.length || 7;
    
    const defaultGrupo = {
        numero_chave: 1,
        letra: 'Geral',
        integrantes: [
            { nome: 'Campus 1', foto: '/imagens/avatar.svg', pontos: 0, jogos_jogados: 0, vitorias: 0, empates: 0, derrotas: 0, pontos_pro: 0, pontos_contra: 0 },
            { nome: 'Campus 2', foto: '/imagens/avatar.svg', pontos: 0, jogos_jogados: 0, vitorias: 0, empates: 0, derrotas: 0, pontos_pro: 0, pontos_contra: 0 },
            { nome: 'Campus 3', foto: '/imagens/avatar.svg', pontos: 0, jogos_jogados: 0, vitorias: 0, empates: 0, derrotas: 0, pontos_pro: 0, pontos_contra: 0 },
            { nome: 'Campus 4', foto: '/imagens/avatar.svg', pontos: 0, jogos_jogados: 0, vitorias: 0, empates: 0, derrotas: 0, pontos_pro: 0, pontos_contra: 0 }
        ]
    };
    
    // Agrupar grupos por gênero
    const gruposPorGenero = {};
    if (Array.isArray(grupos) && grupos.length) {
        grupos.forEach((grupo) => {
            const genero = String(grupo.genero_modalidade || 'Geral').trim();
            if (!gruposPorGenero[genero]) {
                gruposPorGenero[genero] = [];
            }
            gruposPorGenero[genero].push(grupo);
        });
    }
    
    const gruposExibicao = Array.isArray(grupos) && grupos.length
        ? grupos.slice().sort((a, b) => {
            const ordemGenero = (valor) => String(valor || '').toLowerCase().includes('feminino') ? 1 : 0;
            return ordemGenero(a.genero_modalidade) - ordemGenero(b.genero_modalidade);
        })
        : [defaultGrupo];
%>

<% if (typeof boletimDisponivel !== 'undefined' && boletimDisponivel) { %>
    <section class="boletim-cta">
        <div class="boletim-cta__row">
            <div>
                <strong class="boletim-cta__titulo">JIFC <%= (typeof boletimDisponivel.ano_jifc !== 'undefined' ? boletimDisponivel.ano_jifc : (typeof anoJifcAtual !== 'undefined' ? anoJifcAtual : '')) %> encerrado!</strong>
                <span class="boletim-cta__texto">Confira o boletim final completo com todos os jogos, resultados, tabelas e chaveamentos.</span>
            </div>
            <a href="/boletim/<%= boletimDisponivel.ano_jifc %>" class="btn btn-primary">Ver boletim final</a>
        </div>
    </section>
<% } %>

<main class="<%= (exibirTabelaClassificacao && Array.isArray(jogos) && jogos.length > 0) ? 'home-layout' : 'home-layout home-layout--simples' %>">
    <% if (exibirTabelaClassificacao) { %>
        <aside class="home-classificacao">
            <% if (deveAgruparPorGenero) { %>
                <% 
                    const generosOrdenados = ['Masculino', 'Feminino'];
                    const gruposPorGeneroExibicao = {};
                    
                    generosOrdenados.forEach((genero) => {
                        gruposPorGeneroExibicao[genero] = Array.isArray(grupos) 
                            ? grupos.filter(g => String(g.genero_modalidade || '').trim().toLowerCase() === genero.toLowerCase())
                            : [];
                    });
                %>
                <% generosOrdenados.forEach((genero) => { %>
                    <% const gruposGenero = gruposPorGeneroExibicao[genero] || []; %>
                    <% if (gruposGenero.length > 0) { %>
                        <div style="margin-bottom:1.2rem;">
                            <div style="display:flex; align-items:center; justify-content:space-between; padding:0.45rem 0.3rem 0.35rem; border-bottom:1px solid rgba(var(--fg-rgb), 0.07); margin-bottom:0.4rem;">
                                <div style="font-size:0.72rem; color:var(--text-muted); font-weight:700; text-transform:uppercase; letter-spacing:0.04em;">Classificação - <%= genero %></div>
                                <div style="font-size:0.72rem; color: var(--text); font-weight:700;">0</div>
                            </div>

                            <% gruposGenero.forEach((grupo) => { %>
                                <div style="margin-bottom:0.7rem;">
                                    <div style="padding:0.3rem 0.2rem; color:var(--text-muted); font-size:0.62rem; font-weight:700; letter-spacing:0.04em; text-transform:uppercase; border-bottom:1px solid rgba(var(--fg-rgb), 0.06); margin-bottom:0.3rem;">
                                        <%= ehTenisMesa && grupo.subCategoria && grupo.subCategoria !== 'geral' ? (grupo.subCategoria === 'dupla' ? 'Dupla - ' : 'Individual - ') : '' %><%= labelGrupo %> <%= grupo.letra || grupo.numero_chave || 'Geral' %>
                                    </div>

                                    <div class="tabela-scroll tabela-scroll--larga" style="border:1px solid rgba(var(--fg-rgb), 0.08); border-radius:10px; background:rgba(var(--fg-rgb), 0.02);">
                                        <div style="display:grid; grid-template-columns:<%= mostraPontuacao ? '30px minmax(0, 1.9fr) repeat(' + totalColunasExtra + ', minmax(0, 0.56fr))' : '30px minmax(0, 2.1fr) minmax(0, 1.1fr)' %>; align-items:center; gap:0.12rem; font-size:0.62rem; color:var(--text-muted); padding:0.34rem 0.24rem 0.28rem; border-bottom:1px solid rgba(var(--fg-rgb), 0.08); background:rgba(var(--fg-rgb), 0.02);">
                                            <div style="font-weight:700; color:var(--text-muted); text-align:center;">#</div>
                                            <div style="font-weight:700; color:var(--text-muted); padding-left:0.1rem;">Campus</div>
                                            <% if (mostraPontuacao) { %>
                                                <% colunasExibicao.forEach((col) => { %>
                                                    <div style="font-weight:700; color:var(--text-muted); text-align:center;"><%= col %></div>
                                                <% }); %>
                                            <% } else { %>
                                                <div style="font-weight:700; color:var(--text-muted); text-align:center;">Resultado</div>
                                            <% } %>
                                        </div>

                                        <% const classifGenero1 = Array.isArray(classificacao) ? classificacao.filter(c => String(c.genero_modalidade || '').trim().toLowerCase() === genero.toLowerCase() && Number(c.chave_id || c.numero_chave) === Number(grupo.id || 0)) : []; %>
                                        <% const integrantesMap = Array.isArray(grupo.integrantes) ? new Map(grupo.integrantes.map(i => [Number(i.id || i.campus_id || i.campusId), i])) : new Map(); %>
                                        <% const participacoes = classifGenero1.length ? classifGenero1.map((c) => { const integ = integrantesMap.get(Number(c.campus_id)); return { ...c, nome: (integ && integ.nome) || c.participante_nome || 'Campus', foto: (integ && integ.foto) || c.participante_foto || c.foto_perfil || c.fotoPerfil || '/imagens/avatar.svg' }; }) : (Array.isArray(grupo.integrantes) && grupo.integrantes.length ? grupo.integrantes.map(i => ({ campus_id: i.id || i.campus_id, nome: i.nome || 'Campus', foto: i.foto || '/imagens/avatar.svg', pontos: 0, jogos_jogados: 0, vitorias: 0, empates: 0, derrotas: 0, pontos_pro: 0, pontos_contra: 0, saldo_pontuacao: 0, cartoes_amarelos: 0, cartoes_vermelhos: 0, sets_ganhos: 0, sets_perdidos: 0, resultado: '' })) : defaultGrupo.integrantes); %>
                                        <% participacoes.forEach((integrante, idx) => { %>
                                            <% const nomeCampus = integrante.nome || integrante.participante_nome || 'Campus'; %>
                                            <% const fotoCampus = integrante.foto || integrante.participante_foto || integrante.foto_perfil || '/imagens/avatar.svg'; %>
                                            <% const fotoReal = fotoCampus && fotoCampus !== '/imagens/avatar.svg'; %>
                                            <% const pontos = Number(integrante.pontos || 0); %>
                                            <% const jogos = Number(integrante.jogos_jogados || 0); %>
                                            <% const vitorias = Number(integrante.vitorias || 0); %>
                                            <% const empates = Number(integrante.empates || 0); %>
                                            <% const derrotas = Number(integrante.derrotas || 0); %>
                                            <% const pro = Number(integrante.pontos_pro || 0); %>
                                            <% const contra = Number(integrante.pontos_contra || 0); %>
                                            <% const saldo = Number(integrante.saldo_pontuacao || 0); %>
                                            <% const amarelos = Number(integrante.cartoes_amarelos || 0); %>
                                            <% const vermelhos = Number(integrante.cartoes_vermelhos || 0); %>
                                            <% const setsG = Number(integrante.sets_ganhos || 0); %>
                                            <% const setsP = Number(integrante.sets_perdidos || 0); %>
                                            <% const resultado = String(integrante.resultado || integrante.tempo || integrante.distancia || integrante.desempenho || integrante.medida || (mostraPontuacao ? '' : '—')).trim() || '—'; %>
                                            <div style="display:grid; grid-template-columns:<%= mostraPontuacao ? '30px minmax(0, 1.9fr) repeat(' + totalColunasExtra + ', minmax(0, 0.56fr))' : '30px minmax(0, 2.1fr) minmax(0, 1.1fr)' %>; align-items:center; gap:0.12rem; font-size:0.62rem; color:var(--text-muted); padding:0.32rem 0.24rem; border-top:1px solid rgba(var(--fg-rgb), 0.06);">
                                                <div style="font-weight:700; color:var(--text-muted); text-align:center;"><%= idx + 1 %></div>
                                                <div style="display:flex; align-items:center; gap:0.3rem; min-width:0; overflow:hidden;">
                                                    <img src="<%= fotoCampus %>" alt="Foto do campus <%= nomeCampus %>" class="campus-photo campus-photo--xs campus-photo--badge <%= fotoReal ? 'campus-photo--real' : 'campus-photo--default' %>">
                                                    <span style="color: var(--text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; font-size:0.62rem;"><%= nomeCampus %></span>
                                                </div>
                                                <% if (mostraPontuacao) { %>
                                                    <% colunasExibicao.forEach((col) => { %>
                                                        <% 
                                                            let valor = '';
                                                            switch(col) {
                                                                case 'Pts': valor = pontos; break;
                                                                case 'PJ': valor = jogos; break;
                                                                case 'V': valor = vitorias; break;
                                                                case 'E': valor = empates; break;
                                                                case 'D': valor = derrotas; break;
                                                                 case 'GP': case 'PF': valor = pro; break;
                                                                 case 'GC': case 'PC': valor = contra; break;
                                                                 case 'SG': valor = setsG > 0 || setsP > 0 ? setsG : saldo; break;
                                                                 case 'SP': valor = setsG > 0 || setsP > 0 ? setsP : saldo; break;
                                                                 case 'SA': valor = setsP > 0 ? (setsG / setsP).toFixed(2) : (setsG > 0 ? setsG.toFixed(2) : '0.00'); break;
                                                                 case 'PA': valor = contra > 0 ? (pro / contra).toFixed(2) : (pro > 0 ? pro.toFixed(2) : '0.00'); break;
                                                                 case 'CF': valor = amarelos + 'A ' + vermelhos + 'V'; break;
                                                                 default: valor = '';
                                                            }
                                                        %>
                                                        <div style="text-align:center; color:<%= col === 'V' ? '#58d68d' : (col === 'E' ? '#f5b041' : (col === 'D' ? '#f1948a' : 'var(--text-muted)')) %>; font-weight:<%= col === 'Pts' ? '700' : '400' %>;"><%= valor %></div>
                                                    <% }); %>
                                                <% } else { %>
                                                    <div style="text-align:center; color:var(--text-muted); font-weight:700;"><%= resultado %></div>
                                                <% } %>
                                            </div>
                                        <% }); %>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } %>
                <% }); %>
            <% } else if (ehAtletismo) { %>
                <%
                    const ordemGenerosProvas = ['Masculino', 'Feminino'];
                    const mapaProvasGenero = (typeof provasPorGenero === 'object' && provasPorGenero) ? provasPorGenero : {};
                    const generosComProvasCard = [
                        ...ordemGenerosProvas.filter((g) => Array.isArray(mapaProvasGenero[g]) && mapaProvasGenero[g].length > 0),
                        ...Object.keys(mapaProvasGenero).filter((g) => !ordemGenerosProvas.includes(g) && Array.isArray(mapaProvasGenero[g]) && mapaProvasGenero[g].length > 0)
                    ];
                    const provasDisponiveisHome = Array.isArray(provasAtletismo) ? provasAtletismo : [];
                    const provaFiltroAtual = (typeof provaFiltroSelecionada !== 'undefined' && String(provaFiltroSelecionada || '').trim())
                        ? String(provaFiltroSelecionada).trim()
                        : (provasDisponiveisHome[0] ? provasDisponiveisHome[0].slug : '');
                    const corGeneroCard = (g) => (String(g).toLowerCase() === 'feminino'
                        ? { bg: 'rgba(241,148,138,0.1)', bd: 'rgba(241,148,138,0.35)', tx: '#f5b7b1' }
                        : { bg: 'rgba(93,173,226,0.1)', bd: 'rgba(93,173,226,0.35)', tx: '#aed6f1' });
                    const construirLinkProva = (slugProva) => {
                        const params = new URLSearchParams();
                        if (modalidadeSelecionada) params.set('modalidade', modalidadeSelecionada);
                        if (generoSelecionado) params.set('genero', generoSelecionado);
                        if (diaSelecionado) params.set('dia', diaSelecionado);
                        params.set('prova', slugProva);
                        return '/?' + params.toString() + '#classificacao-atletismo';
                    };
                    const eh100m = (prova) => String(prova && prova.slug || '').trim() === '100m';
                    const cartoesProvaHome = [];
                    generosComProvasCard.forEach((generoGrupo) => {
                        const provaDoGenero = (mapaProvasGenero[generoGrupo] || []).find((prova) => prova.slug && String(prova.slug).trim() === provaFiltroAtual);
                        if (provaDoGenero) {
                            cartoesProvaHome.push({ genero: generoGrupo, prova: provaDoGenero });
                        }
                    });
                %>
                <div id="classificacao-atletismo" style="margin-bottom:1.2rem;">
                    <div style="display:flex; align-items:center; justify-content:space-between; padding:0.5rem 0.3rem 0.4rem; border-bottom:1px solid rgba(var(--fg-rgb), 0.07); margin-bottom:0.6rem;">
                        <div style="font-size:0.85rem; color:var(--text-muted); font-weight:700; text-transform:uppercase; letter-spacing:0.04em;">Atletas por Prova</div>
                    </div>

                    <% if (provasDisponiveisHome.length > 0) { %>
                        <div class="filtro-categorias-atletismo filtro-provas-home">
                            <% provasDisponiveisHome.forEach((prova) => { %>
                                <a href="<%= construirLinkProva(prova.slug) %>" class="filtro-categoria <%= provaFiltroAtual === prova.slug ? 'filtro-categoria-ativo' : '' %>"><%= prova.nome %></a>
                            <% }) %>
                        </div>

                        <% if (cartoesProvaHome.length > 0) { %>
                            <% cartoesProvaHome.forEach(({ genero, prova }) => { %>
                                <%
                                    const coresCardProva = corGeneroCard(genero);
                                    const provaEh100m = eh100m(prova);
                                    const resultadosGenero = (typeof resultadosFinaisAtletismo === 'object' && resultadosFinaisAtletismo)
                                        ? (resultadosFinaisAtletismo[genero] || {}) : {};
                                    const temFinalPublicada = Object.values(resultadosGenero).some((linhas) => Array.isArray(linhas) && linhas.length > 0);
                                    const ehRevezamento = ['4x100m', '4x400m'].includes(String(prova.slug || '').trim());
                                    const atletasProva = (Array.isArray(prova.atletas) ? prova.atletas : []).slice(0, ehRevezamento ? 6 : 200);
                                    const temBateriasLancadas = !ehRevezamento && atletasProva.some((atleta) => atleta.temResultadoSalvo && atleta.numeroBateria != null);
                                    const bateriasProva = temBateriasLancadas
                                        ? [...atletasProva.reduce((grupos, atleta) => {
                                            const numero = Number(atleta.numeroBateria) || 1;
                                            if (!grupos.has(numero)) grupos.set(numero, []);
                                            grupos.get(numero).push(atleta);
                                            return grupos;
                                        }, new Map())].sort((a, b) => a[0] - b[0])
                                        : [[...atletasProva]];
                                    const gruposRevezamento = ehRevezamento ? (() => {
                                        const grupos = [];
                                        const indice = {};
                                        atletasProva.forEach((at) => {
                                            const chave = String(at.campus || '—').trim() || '—';
                                            if (!(chave in indice)) {
                                                indice[chave] = grupos.length;
                                                grupos.push({ campus: chave, atletas: [], resultadoTotal: '' , pontosTotal: 0 });
                                            }
                                            const grupo = grupos[indice[chave]];
                                            grupo.atletas.push(at);
                                            if (at.resultado) grupo.resultadoTotal = at.resultado;
                                            if (Number(at.pontos || 0) > 0) grupo.pontosTotal = Number(at.pontos);
                                        });
                                        return grupos;
                                    })() : [];
                                %>
                                <div style="margin-bottom:0.7rem;">
                                    <div style="display:flex; align-items:center; gap:0.45rem; padding:0.32rem 0.2rem; color:var(--text-muted); font-size:0.78rem; font-weight:700; letter-spacing:0.04em; text-transform:uppercase; border-bottom:1px solid rgba(var(--fg-rgb), 0.06); margin-bottom:0.3rem;">
                                        <span style="font-size:0.62rem; font-weight:700; letter-spacing:0.03em; padding:0.16rem 0.55rem; border-radius:999px; background:<%= coresCardProva.bg %>; border:1px solid <%= coresCardProva.bd %>; color:<%= coresCardProva.tx %>;"><%= genero %></span>
                                        <span><%= prova.nome %></span>
                                        <span style="color:var(--text-muted); text-transform:none; font-weight:400;">· <%= (Array.isArray(prova.atletas) ? prova.atletas : []).length %> atleta(s)</span>
                                        <% if (provaEh100m && temFinalPublicada) { %>
                                            <span style="margin-left:auto; font-size:0.62rem; font-weight:700; letter-spacing:0.03em; padding:0.16rem 0.55rem; border-radius:999px; background:rgba(88,214,141,0.1); border:1px solid rgba(88,214,141,0.35); color:#58d68d;">Pontuação na Final</span>
                                        <% } %>
                                    </div>
                                    <div class="tabela-scroll tabela-scroll--media" style="border:1px solid rgba(var(--fg-rgb), 0.08); border-radius:10px; background:rgba(var(--fg-rgb), 0.02);">
                                        <% if (provaEh100m) { %>
                                            <div style="display:grid; grid-template-columns:minmax(0,0.55fr) minmax(0,2fr) minmax(0,1.4fr) minmax(0,1fr); align-items:center; gap:0.25rem; font-size:0.8rem; color:var(--text-muted); padding:0.45rem 0.35rem 0.4rem; border-bottom:1px solid rgba(var(--fg-rgb), 0.08); background:rgba(var(--fg-rgb), 0.02);">
                                                <div style="font-weight:700; color:var(--text-muted); text-align:center;">#</div>
                                                <div style="font-weight:700; color:var(--text-muted); padding-left:0.1rem;">Atleta</div>
                                                <div style="font-weight:700; color:var(--text-muted); text-align:left;">Campus</div>
                                                <div style="font-weight:700; color:var(--text-muted); text-align:center;">Tempo</div>
                                            </div>
                                            <% bateriasProva.forEach((bateria, indiceBateria) => { %>
                                                <% if (temBateriasLancadas) { %><div style="padding:0.45rem 0.6rem; color:var(--text-muted); font-size:0.7rem; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; border-bottom:1px solid rgba(var(--fg-rgb), 0.06);">Bateria <%= bateria[0] && bateria[0].numeroBateria ? bateria[0].numeroBateria : indiceBateria + 1 %></div><% } %>
                                                <% bateria.forEach((atleta, idx) => { %>
                                                <div style="display:grid; grid-template-columns:minmax(0,0.55fr) minmax(0,2fr) minmax(0,1.4fr) minmax(0,1fr); align-items:center; gap:0.25rem; font-size:0.8rem; color:var(--text-muted); padding:0.48rem 0.35rem; border-top:1px solid rgba(var(--fg-rgb), 0.06);">
                                                    <div style="font-weight:700; color:var(--text-muted); text-align:center;"><%= atleta.numeroRaia || '—' %></div>
                                                    <div style="color: var(--text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= atleta.nome || 'Atleta sem nome' %></div>
                                                    <div style="color:rgba(var(--fg-rgb), 0.6); font-size:0.75rem; overflow:hidden; text-overflow:ellipsis;"><%= atleta.campus || '—' %></div>
                                                    <div style="text-align:center; font-family:monospace; color:rgba(var(--fg-rgb), 0.85);"><%= atleta.resultado || '—' %></div>
                                                </div>
                                                <% }) %>
                                            <% }) %>
                                        <% } else if (ehRevezamento) { %>
