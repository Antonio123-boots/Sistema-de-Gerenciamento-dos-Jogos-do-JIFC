<main style="display:grid; grid-template-columns:repeat(3, minmax(0, 1fr)); gap:1rem; align-items:stretch;">
    <% if (!Array.isArray(jogos) || jogos.length === 0) { %>
        <section class="panel-card" style="padding:2rem; background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08); border-radius:18px; text-align:center; grid-column:1 / -1;">
            <h2 style="margin:0;">Nenhum jogo publicado encontrado</h2>
            <p style="margin:1rem 0 0; color:#cfd8dc;">Aguarde a confirmação do sorteio pelo admin ou escolha outra modalidade no menu superior.</p>
        </section>
    <% } else { %>
        <% jogos.forEach((jogo) => { %>
            <article class="panel-card" style="padding:1rem; background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.08); border-radius:18px; width:100%; height:100%; display:flex; flex-direction:column; justify-content:space-between;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem; min-height:1.5rem;">
                    <div style="font-size:0.75rem; color:#cfd8dc; text-transform:uppercase; letter-spacing:0.08em; line-height:1.3;"><%= jogo.modalidade %> · <%= jogo.genero %></div>
                </div>

                <div style="display:grid; grid-template-columns:minmax(0,1fr) auto minmax(0,1fr); gap:0.75rem; align-items:center; flex:1;">
                    <div style="text-align:center; min-width:0;">
                        <img src="<%= jogo.fotoCasa || '/imagens/avatar.svg' %>" alt="Foto do campus <%= jogo.casa %>" style="width:56px; height:56px; object-fit:cover; border-radius:50%; margin:0 auto 0.55rem; border:1px solid rgba(255,255,255,0.12); background:rgba(255,255,255,0.08); display:block;">
                        <div style="font-size:0.82rem; color:#fff; font-weight:600; line-height:1.3; word-break:break-word;"><%= jogo.casa %></div>
                    </div>

                    <div style="display:flex; flex-direction:column; gap:0.25rem; justify-items:center; text-align:center; align-items:center; flex-shrink:0;">
                        <div style="font-size:1.05rem; font-weight:700; color:#fff; line-height:1.2;"><%= jogo.horario %></div>
                        <div style="font-size:0.7rem; color:#cfd8dc; text-transform:uppercase; letter-spacing:0.08em; line-height:1.3;"><%= jogo.local_jogo || 'A definir' %></div>
                        <div style="font-size:0.72rem; color:#cfd8dc; line-height:1.3;"><%= jogo.data %></div>
                    </div>

                    <div style="text-align:center; min-width:0;">
                        <img src="<%= jogo.fotoFora || '/imagens/avatar.svg' %>" alt="Foto do campus <%= jogo.fora %>" style="width:56px; height:56px; object-fit:cover; border-radius:50%; margin:0 auto 0.55rem; border:1px solid rgba(255,255,255,0.12); background:rgba(255,255,255,0.08); display:block;">
                        <div style="font-size:0.82rem; color:#fff; font-weight:600; line-height:1.3; word-break:break-word;"><%= jogo.fora %></div>
                    </div>
                </div>
            </article>
        <% }); %>
    <% } %>
</main>