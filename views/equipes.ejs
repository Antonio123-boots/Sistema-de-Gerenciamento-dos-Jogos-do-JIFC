<section class="teams-shell">
    <header class="teams-hero">
        <div class="teams-hero__content">
            <span class="teams-kicker">JIFC <%= typeof anoJifc !== 'undefined' ? anoJifc : '2026' %></span>
            <h1>Campi participantes</h1>
            <p>Escolha um campus para abrir o perfil completo.</p>
        </div>
        <a href="/" class="teams-back-link">Voltar ao início</a>
    </header>

    <div class="teams-grid">
        <% (campi || []).forEach((campus) => { %>
            <a class="team-card" href="/equipes/<%= campus.slug %>">
                <% const fotoCampus = campus.fotoPerfil || campus.foto_perfil || ''; %>
                <div class="team-card__media" style="--campus-color: <%= campus.cor || '#ece42d' %>">
                    <% if (fotoCampus) { %>
                        <img src="<%= fotoCampus %>" alt="Foto de <%= campus.nomeExibicao %>">
                    <% } else { %>
                        <div class="team-card__initials"><%= campus.logoTexto %></div>
                    <% } %>
                </div>

                <div class="team-card__content">
                    <h2><%= campus.nomeExibicao %></h2>
                    <p><%= campus.cidade || 'Campus participante' %></p>
                </div>

                <div class="team-card__footer">
                    <span>Abrir perfil</span>
                    <span class="team-card__arrow">→</span>
                </div>
            </a>
        <% }) %>
    </div>
</section>
