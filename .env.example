# Copie este arquivo para .env e preencha com seus valores reais.
# O arquivo .env NUNCA deve ser commitado no Git.

DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=jifc

# Chave secreta do JWT - gere uma com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_por_uma_chave_aleatoria_longa

# Use true apenas quando o sistema estiver rodando em HTTPS (producao).
# Em http://localhost deixe false, senao o navegador nao envia o cookie de login.
COOKIE_SECURE=false

# Senhas padrao para contas built-in (admin, juiz, campus)
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_JUIZ_PASSWORD=juiz123
DEFAULT_CAMPUS_PASSWORD=jifc2026

# Tempo de expiracao do token JWT (ex.: 8h, 12h, 1d)
JWT_EXPIRATION=12h
